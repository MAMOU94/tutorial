zscore_matrix_safe <- function(df_or_matrix) {
  mat <- as.matrix(df_or_matrix)
  storage.mode(mat) <- "double"
  if (!is.matrix(mat) || nrow(mat) == 0 || ncol(mat) == 0) {
    return(mat)
  }
  col_means <- suppressWarnings(colMeans(mat, na.rm = TRUE))
  col_sds <- suppressWarnings(apply(mat, 2, stats::sd, na.rm = TRUE))
  safe_sds <- ifelse(is.finite(col_sds) & col_sds > 0, col_sds, 1)
  centered <- sweep(mat, 2, col_means, "-")
  scaled <- sweep(centered, 2, safe_sds, "/")
  scaled[!is.finite(scaled)] <- 0
  scaled
}

robust_zscore_matrix_safe <- function(df_or_matrix) {
  mat <- as.matrix(df_or_matrix)
  storage.mode(mat) <- "double"
  if (!is.matrix(mat) || nrow(mat) == 0 || ncol(mat) == 0) {
    return(mat)
  }
  col_medians <- suppressWarnings(apply(mat, 2, stats::median, na.rm = TRUE))
  col_mads <- suppressWarnings(apply(mat, 2, stats::mad, na.rm = TRUE, constant = 1))
  col_sds <- suppressWarnings(apply(mat, 2, stats::sd, na.rm = TRUE))
  safe_scales <- ifelse(is.finite(col_mads) & col_mads > 0, col_mads, col_sds)
  safe_scales <- ifelse(is.finite(safe_scales) & safe_scales > 0, safe_scales, 1)
  centered <- sweep(mat, 2, col_medians, "-")
  scaled <- sweep(centered, 2, safe_scales, "/")
  scaled[!is.finite(scaled)] <- 0
  scaled
}

as_numeric_vector_safe <- function(x) {
  raw <- x
  if (is.factor(raw)) raw <- as.character(raw)
  suppressWarnings(as.numeric(raw))
}

make_unique_colname <- function(existing_names, desired_name) {
  base_name <- trimws(as.character(desired_name))
  if (!nzchar(base_name)) base_name <- "derived_feature"
  if (!(base_name %in% existing_names)) return(base_name)
  idx <- 2L
  repeat {
    candidate <- paste0(base_name, "_", idx)
    if (!(candidate %in% existing_names)) return(candidate)
    idx <- idx + 1L
  }
}

prepare_hclust_feature_matrix <- function(df_input, max_factor_levels = 20L, max_dummy_cols = 600L) {
  feature_notes <- character(0)
  dropped_columns <- character(0)
  encoded_factor_columns <- character(0)
  numeric_columns <- character(0)

  df <- as.data.frame(df_input, stringsAsFactors = FALSE)
  if (!is.data.frame(df) || nrow(df) == 0 || ncol(df) == 0) {
    return(list(
      matrix = matrix(numeric(0), nrow = nrow(df), ncol = 0),
      feature_notes = feature_notes,
      dropped_columns = dropped_columns,
      encoded_factor_columns = encoded_factor_columns,
      numeric_columns = numeric_columns
    ))
  }

  processed <- list()
  for (col_name in colnames(df)) {
    raw_col <- df[[col_name]]
    numeric_col <- as_numeric_vector_safe(raw_col)
    finite_numeric <- is.finite(numeric_col)
    numeric_share <- if (length(raw_col) > 0) mean(finite_numeric, na.rm = TRUE) else 0
    treat_as_numeric <- is.numeric(raw_col) || numeric_share >= 0.95

    if (isTRUE(treat_as_numeric)) {
      if (sum(finite_numeric) < 2) {
        dropped_columns <- c(dropped_columns, col_name)
        next
      }
      median_val <- suppressWarnings(stats::median(numeric_col[finite_numeric], na.rm = TRUE))
      numeric_col[!finite_numeric] <- median_val
      if (length(unique(numeric_col)) < 2) {
        dropped_columns <- c(dropped_columns, col_name)
        next
      }
      processed[[col_name]] <- numeric_col
      numeric_columns <- c(numeric_columns, col_name)
      if (any(!finite_numeric)) {
        feature_notes <- c(feature_notes, paste0("Imputed missing/non-numeric values in ", col_name, " with median."))
      }
      next
    }

    txt <- trimws(as.character(raw_col))
    txt[txt == ""] <- NA_character_
    observed <- txt[!is.na(txt)]
    if (length(observed) < 2) {
      dropped_columns <- c(dropped_columns, col_name)
      next
    }
    freq <- sort(table(observed), decreasing = TRUE)
    levels_keep <- names(freq)
    if (length(levels_keep) > max_factor_levels) {
      levels_keep <- levels_keep[1:max_factor_levels]
      txt[!(txt %in% levels_keep) & !is.na(txt)] <- "__OTHER__"
      levels_keep <- c(levels_keep, "__OTHER__")
      feature_notes <- c(feature_notes, paste0("Column ", col_name, " had many categories; rare levels grouped into __OTHER__."))
    }
    txt[is.na(txt)] <- "__MISSING__"
    levels_final <- unique(c(levels_keep, "__MISSING__"))
    fac <- factor(txt, levels = levels_final)
    if (nlevels(fac) < 2) {
      dropped_columns <- c(dropped_columns, col_name)
      next
    }
    processed[[col_name]] <- fac
    encoded_factor_columns <- c(encoded_factor_columns, col_name)
  }

  if (length(processed) == 0) {
    return(list(
      matrix = matrix(numeric(0), nrow = nrow(df), ncol = 0),
      feature_notes = unique(feature_notes),
      dropped_columns = unique(dropped_columns),
      encoded_factor_columns = unique(encoded_factor_columns),
      numeric_columns = unique(numeric_columns)
    ))
  }

  processed_df <- as.data.frame(processed, stringsAsFactors = FALSE, check.names = FALSE)
  design <- tryCatch(stats::model.matrix(~ . - 1, data = processed_df), error = function(e) NULL)
  if (is.null(design) || ncol(design) == 0) {
    return(list(
      matrix = matrix(numeric(0), nrow = nrow(df), ncol = 0),
      feature_notes = c(unique(feature_notes), "Unable to create design matrix from selected predictors."),
      dropped_columns = unique(dropped_columns),
      encoded_factor_columns = unique(encoded_factor_columns),
      numeric_columns = unique(numeric_columns)
    ))
  }

  design <- as.matrix(design)
  storage.mode(design) <- "double"
  finite_mask <- apply(design, 2, function(col) all(is.finite(col)))
  variance_mask <- apply(design, 2, function(col) stats::sd(col) > 0)
  keep_mask <- finite_mask & variance_mask
  if (!all(keep_mask)) {
    design <- design[, keep_mask, drop = FALSE]
  }

  if (ncol(design) > max_dummy_cols) {
    col_vars <- apply(design, 2, stats::var)
    ranked <- order(col_vars, decreasing = TRUE, na.last = NA)
    keep_cols <- ranked[seq_len(max_dummy_cols)]
    design <- design[, keep_cols, drop = FALSE]
    feature_notes <- c(feature_notes, paste0("Feature space truncated to top ", max_dummy_cols, " variance columns for stability."))
  }

  rownames(design) <- rownames(df)
  list(
    matrix = design,
    feature_notes = unique(feature_notes),
    dropped_columns = unique(dropped_columns),
    encoded_factor_columns = unique(encoded_factor_columns),
    numeric_columns = unique(numeric_columns)
  )
}

derive_biological_process_features <- function(df_numeric) {
  feature_df <- as.data.frame(df_numeric, stringsAsFactors = FALSE)
  if (!is.data.frame(feature_df) || ncol(feature_df) == 0) {
    return(list(
      data = feature_df,
      notes = character(0),
      added_features = character(0)
    ))
  }

  original_names <- colnames(feature_df)
  notes <- character(0)
  lower_names <- tolower(original_names)

  h1_idx <- match("hemoglobin1", lower_names)
  h2_idx <- match("hemoglobin2", lower_names)
  if (!is.na(h1_idx) && !is.na(h2_idx)) {
    h1 <- as_numeric_vector_safe(feature_df[[h1_idx]])
    h2 <- as_numeric_vector_safe(feature_df[[h2_idx]])
    if (length(h1) == nrow(feature_df) && length(h2) == nrow(feature_df)) {
      if (all(is.finite(h1)) && all(is.finite(h2))) {
        feature_df$hemoglobin_delta <- h2 - h1
        denom <- ifelse(abs(h1) < 1e-6, NA_real_, h1)
        ratio <- h2 / denom
        ratio[!is.finite(ratio)] <- NA_real_
        finite_ratio <- ratio[is.finite(ratio)]
        if (length(finite_ratio) >= 5) {
          q_bounds <- suppressWarnings(stats::quantile(finite_ratio, probs = c(0.01, 0.99), na.rm = TRUE, names = FALSE))
          if (length(q_bounds) == 2 && all(is.finite(q_bounds))) {
            ratio <- pmin(pmax(ratio, q_bounds[1]), q_bounds[2])
          }
        }
        ratio[!is.finite(ratio)] <- 0
        feature_df$hemoglobin_ratio <- ratio
        notes <- c(
          notes,
          "Biology-aware features added from hemoglobin process: hemoglobin_delta (hemoglobin2 - hemoglobin1) and hemoglobin_ratio (hemoglobin2 / hemoglobin1)."
        )
      }
    }
  }

  # Generic process-aware deltas/ratios for paired timepoint-like variables
  parsed <- lapply(original_names, function(name_value) {
    match_obj <- regexec("^(.+?)(\\d+)$", tolower(name_value))
    parts <- regmatches(tolower(name_value), match_obj)[[1]]
    if (length(parts) != 3) return(NULL)
    list(base = parts[2], idx = suppressWarnings(as.integer(parts[3])), original = name_value)
  })
  parsed <- parsed[!vapply(parsed, is.null, logical(1))]
  if (length(parsed) > 0) {
    by_base <- split(parsed, vapply(parsed, function(x) x$base, character(1)))
    for (base_key in names(by_base)) {
      seq_cols <- by_base[[base_key]]
      seq_cols <- seq_cols[order(vapply(seq_cols, function(x) x$idx, integer(1)))]
      if (length(seq_cols) < 2) next

      first_name <- seq_cols[[1]]$original
      last_name <- seq_cols[[length(seq_cols)]]$original
      if (identical(first_name, last_name)) next
      if (tolower(first_name) == "hemoglobin1" && tolower(last_name) == "hemoglobin2") next

      first_vals <- as_numeric_vector_safe(feature_df[[first_name]])
      last_vals <- as_numeric_vector_safe(feature_df[[last_name]])
      if (!(all(is.finite(first_vals)) && all(is.finite(last_vals)))) next

      safe_base <- gsub("[^a-z0-9]+", "_", base_key)
      safe_base <- gsub("^_+|_+$", "", safe_base)
      if (!nzchar(safe_base)) safe_base <- "series"
      existing_names <- colnames(feature_df)

      delta_name <- make_unique_colname(existing_names, paste0(safe_base, "_delta"))
      feature_df[[delta_name]] <- last_vals - first_vals
      existing_names <- colnames(feature_df)

      ratio_name <- make_unique_colname(existing_names, paste0(safe_base, "_ratio"))
      denom <- ifelse(abs(first_vals) < 1e-6, NA_real_, first_vals)
      ratio_vals <- last_vals / denom
      ratio_vals[!is.finite(ratio_vals)] <- 0
      feature_df[[ratio_name]] <- ratio_vals

      notes <- c(
        notes,
        paste0(
          "Process-aware features added for series '", base_key,
          "': ", delta_name, " (", last_name, " - ", first_name, "), ",
          ratio_name, " (", last_name, " / ", first_name, ")."
        )
      )
    }
  }

  added_features <- setdiff(colnames(feature_df), original_names)
  list(
    data = feature_df,
    notes = notes,
    added_features = added_features
  )
}

resolve_labels_for_plot <- function(plot_key = "default") {
  key <- tolower(trimws(as.character(plot_key[1])))
  if (key == "") key <- "default"

  if (!is.null(custom_plot_target) && custom_plot_target != "" && key != custom_plot_target) {
    return(list())
  }

  if (has_labels_by_plot) {
    if (!is.null(custom_plot_labels_by_plot[[key]]) && length(custom_plot_labels_by_plot[[key]]) > 0) {
      return(custom_plot_labels_by_plot[[key]])
    }
    if (!is.null(custom_plot_labels_by_plot[["default"]]) && length(custom_plot_labels_by_plot[["default"]]) > 0) {
      return(custom_plot_labels_by_plot[["default"]])
    }
    return(list())
  }

  # Backward-compatible fallback for legacy flat payload.
  fallback_fields <- c(
    "title", "x", "y", "caption",
    "title_size", "x_size", "y_size", "axis_tick_size",
    "x_scale_type", "y_scale_type",
    "x_tick_mode", "y_tick_mode",
    "x_tick_count", "y_tick_count",
    "x_tick_interval", "y_tick_interval",
    "x_min", "x_max", "y_min", "y_max",
    "title_position", "title_steps",
    "x_position", "x_steps",
    "y_position", "y_steps",
    "legend",
    "legend_title",
    "legend_title_color",
    "legend_text_color",
    "legend_items",
    "elements",
    "custom_elements"
  )
  out <- list()
  for (field_name in fallback_fields) {
    if (!is.null(custom_plot_labels[[field_name]])) {
      out[[field_name]] <- custom_plot_labels[[field_name]]
    }
  }
  out
}

parse_logical_flag <- function(value, default = TRUE) {
  if (is.null(value) || length(value) == 0) return(isTRUE(default))
  if (is.logical(value)) return(isTRUE(value[1]))
  if (is.numeric(value)) {
    num_val <- suppressWarnings(as.numeric(value[1]))
    if (!is.finite(num_val)) return(isTRUE(default))
    return(num_val != 0)
  }
  txt <- tolower(trimws(as.character(value[1])))
  if (txt %in% c("true", "t", "1", "yes", "y", "on")) return(TRUE)
  if (txt %in% c("false", "f", "0", "no", "n", "off")) return(FALSE)
  isTRUE(default)
}

pca_auto_clustering_enabled <- parse_logical_flag(
  plot_colors_list[["pca_auto_clustering_enabled"]],
  default = FALSE
)

manual_cluster_k_enabled <- parse_logical_flag(
  plot_colors_list[["manual_kmeans_verification_enabled"]],
  default = FALSE
)
manual_cluster_k_requested <- if (!is.null(plot_colors_list[["manual_kmeans_verification_k"]])) {
  suppressWarnings(as.integer(plot_colors_list[["manual_kmeans_verification_k"]][1]))
} else {
  NA_integer_
}

resolve_plot_element_flag <- function(labels_cfg, element_key, default = TRUE) {
  cfg <- to_plain_list(labels_cfg)
  elements_cfg <- to_plain_list(cfg$elements)
  if (!is.null(elements_cfg[[element_key]])) {
    return(parse_logical_flag(elements_cfg[[element_key]], default))
  }
  if (!is.null(cfg[[element_key]])) {
    return(parse_logical_flag(cfg[[element_key]], default))
  }
  isTRUE(default)
}

resolve_plot_element_numeric <- function(labels_cfg, element_key, default = 0, min_val = -5, max_val = 5) {
  cfg <- to_plain_list(labels_cfg)
  elements_cfg <- to_plain_list(cfg$elements)
  raw_value <- NULL
  if (!is.null(elements_cfg[[element_key]])) {
    raw_value <- elements_cfg[[element_key]]
  } else if (!is.null(cfg[[element_key]])) {
    raw_value <- cfg[[element_key]]
  }
  numeric_value <- suppressWarnings(as.numeric(raw_value[1]))
  if (length(numeric_value) == 0 || !is.finite(numeric_value[1])) {
    numeric_value <- as.numeric(default)
  }
  numeric_value <- numeric_value[1]
  numeric_value <- max(as.numeric(min_val), min(as.numeric(max_val), numeric_value))
  as.numeric(numeric_value)
}

extract_custom_elements_config <- function(value) {
  out <- list()
  if (is.null(value)) return(out)

  if (is.data.frame(value)) {
    if (nrow(value) == 0) return(out)
    for (i in seq_len(nrow(value))) {
      out[[length(out) + 1]] <- to_plain_list(value[i, , drop = FALSE])
    }
    return(out)
  }

  if (!is.list(value)) return(out)
  if (length(value) == 0) return(out)

  if (is.null(names(value))) {
    for (item in value) {
      if (is.null(item)) next
      if (is.data.frame(item)) {
        if (nrow(item) == 0) next
        for (i in seq_len(nrow(item))) {
          out[[length(out) + 1]] <- to_plain_list(item[i, , drop = FALSE])
        }
      } else if (is.list(item)) {
        out[[length(out) + 1]] <- to_plain_list(item)
      }
    }
    return(out)
  }

  child_is_object <- vapply(value, function(item) is.list(item) || is.data.frame(item), logical(1))
  if (any(child_is_object)) {
    for (item in value) {
      if (is.null(item)) next
      if (is.data.frame(item)) {
        if (nrow(item) == 0) next
        for (i in seq_len(nrow(item))) {
          out[[length(out) + 1]] <- to_plain_list(item[i, , drop = FALSE])
        }
      } else if (is.list(item)) {
        out[[length(out) + 1]] <- to_plain_list(item)
      }
    }
    if (length(out) > 0) return(out)
  }

  out[[1]] <- to_plain_list(value)
  out
}

extract_legend_items_config <- function(value) {
  out <- list()
  if (is.null(value)) return(out)

  if (is.data.frame(value)) {
