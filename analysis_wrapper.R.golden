load_or_install <- function(package) {
  tryCatch({
    # Fast-path: skip library() if already loaded in this R session
    if (isNamespaceLoaded(package)) return(TRUE)
    if (!requireNamespace(package, quietly = TRUE, lib.loc = local_lib)) {
      install.packages(package, lib = local_lib, repos = "https://cloud.r-project.org", quiet = TRUE)
    }
    status <- suppressMessages(library(package, character.only = TRUE, lib.loc = local_lib, logical.return = TRUE))
    return(status)
  }, error = function(e) {
    return(FALSE)
  })
}

# Selective dependencies
