args <- commandArgs(trailingOnly = TRUE)

read_any_file <- function(path, sheet = NULL) {
  ext <- tolower(tools::file_ext(path))
  if (ext == "csv") {
    # Force row names off to avoid: "duplicate 'row.names' are not allowed"
    # If base parser still injects synthetic "row.names", fallback to a manual
    # header-preserving read so UI options keep file column names.
    data <- read.csv(
      path,
      stringsAsFactors = FALSE,
      check.names = FALSE,
      row.names = NULL,
      comment.char = ""
    )

    if ("row.names" %in% colnames(data)) {
      header_line <- readLines(path, n = 1, warn = FALSE)
      header_parts <- if (length(header_line) > 0) strsplit(header_line, ",", fixed = TRUE)[[1]] else character(0)
      if (!("row.names" %in% header_parts)) {
        raw <- read.table(
          path,
          header = FALSE,
          sep = ",",
          quote = "\"",
          comment.char = "",
          fill = TRUE,
          stringsAsFactors = FALSE,
          check.names = FALSE
        )
        if (nrow(raw) >= 2) {
          hdr <- as.character(raw[1, , drop = TRUE])
          empty_idx <- which(is.na(hdr) | hdr == "")
          if (length(empty_idx) > 0) {
            hdr[empty_idx] <- paste0("column_", empty_idx)
          }
          hdr <- make.unique(hdr, sep = "_")
          data <- raw[-1, , drop = FALSE]
          colnames(data) <- hdr
          data[] <- lapply(data, function(col) type.convert(col, as.is = TRUE))
        }
      }
    }

    return(data)
  } else if (ext %in% c("xlsx")) {
    sheets <- tryCatch(getSheetNames(path), error = function(e) character(0))
    if (length(sheets) == 0) stop("No sheets found in workbook.")
    sheet_to_use <- if (!is.null(sheet) && sheet != "" && sheet %in% sheets) sheet else sheets[[1]]
    data <- read.xlsx(path, sheet = sheet_to_use, rowNames = FALSE, check.names = FALSE)
    attr(data, "sheet_names") <- sheets
    attr(data, "active_sheet") <- sheet_to_use
    return(data)
  } else {
    stop(paste("Unsupported file extension:", ext, ". Please use .xlsx or .csv"))
  }
}

