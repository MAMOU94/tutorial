  if (!is.list(value)) return(out)
  if (length(value) == 0) return(out)

  if (is.null(names(value))) {
    for (item in value) {
      if (is.null(item)) next
      if (is.data.frame(item)) {
        if (nrow(item) == 0) next
        for (i in seq_len(nrow(item))) {
          out[[length(out) + 1]] <- to_plain_list(item[i, , drop = FALSE])
        }
      } else if (is.list(item)) {
        out[[length(out) + 1]] <- to_plain_list(item)
      }
    }
    return(out)
  }

  child_is_object <- vapply(value, function(item) is.list(item) || is.data.frame(item), logical(1))
  if (any(child_is_object)) {
    for (item in value) {
      if (is.null(item)) next
      if (is.data.frame(item)) {
        if (nrow(item) == 0) next
        for (i in seq_len(nrow(item))) {
          out[[length(out) + 1]] <- to_plain_list(item[i, , drop = FALSE])
        }
      } else if (is.list(item)) {
        out[[length(out) + 1]] <- to_plain_list(item)
      }
    }
    if (length(out) > 0) return(out)
  }

  out[[1]] <- to_plain_list(value)
  out
}

apply_custom_labels <- function(p, plot_key = "default") {
  if (is.null(p) || !inherits(p, "ggplot")) return(p)
  labels_cfg <- to_plain_list(resolve_labels_for_plot(plot_key))
  show_caption <- resolve_plot_element_flag(labels_cfg, "show_caption", TRUE)
  new_labs <- list()
  if (!is.null(labels_cfg$title) && labels_cfg$title != "") {
    new_labs$title <- labels_cfg$title
  }
  if (!is.null(labels_cfg$x) && labels_cfg$x != "") {
    new_labs$x <- labels_cfg$x
  }
  if (!is.null(labels_cfg$y) && labels_cfg$y != "") {
    new_labs$y <- labels_cfg$y
  }
  if (!show_caption) {
    new_labs$caption <- NULL
  } else if (!is.null(labels_cfg$caption) && labels_cfg$caption != "") {
    new_labs$caption <- labels_cfg$caption
  }
  if (length(new_labs) > 0) {
    p <- p + do.call(ggplot2::labs, new_labs)
  }
  title_position <- normalize_position(labels_cfg$title_position, c("left", "center", "right"), "center")
  title_steps <- normalize_steps(labels_cfg$title_steps, fallback = 0L)
  x_position <- normalize_position(labels_cfg$x_position, c("left", "center", "right"), "center")
  x_steps <- normalize_steps(labels_cfg$x_steps, fallback = 0L)
  y_position <- normalize_position(labels_cfg$y_position, c("up", "center", "down"), "center")
  y_steps <- normalize_steps(labels_cfg$y_steps, fallback = 0L)
  title_size <- suppressWarnings(as.numeric(labels_cfg$title_size))
  x_size <- suppressWarnings(as.numeric(labels_cfg$x_size))
  y_size <- suppressWarnings(as.numeric(labels_cfg$y_size))
  axis_tick_size <- suppressWarnings(as.numeric(labels_cfg$axis_tick_size))
  if ((length(axis_tick_size) == 0 || !is.finite(axis_tick_size[1])) && !is.null(labels_cfg$tick_size)) {
    axis_tick_size <- suppressWarnings(as.numeric(labels_cfg$tick_size))
  }
  first_text_or_fallback <- function(value, fallback = "") {
    if (is.null(value) || length(value) == 0) return(fallback)
    txt <- trimws(as.character(value[1]))
    if (!nzchar(txt)) return(fallback)
    txt
  }
  normalize_axis_scale_type <- function(value, fallback = "auto") {
    txt <- tolower(first_text_or_fallback(value, fallback))
    if (txt %in% c("auto", "linear", "log10")) return(txt)
    fallback
  }
  normalize_axis_tick_mode <- function(value, fallback = "auto") {
    txt <- tolower(first_text_or_fallback(value, fallback))
    if (txt %in% c("auto", "count", "interval")) return(txt)
    fallback
  }
  parse_positive_number <- function(value) {
    if (is.null(value) || length(value) == 0) return(NA_real_)
    num <- suppressWarnings(as.numeric(value[1]))
    if (length(num) == 0 || !is.finite(num[1]) || num[1] <= 0) return(NA_real_)
    as.numeric(num[1])
  }
  parse_optional_number <- function(value) {
    if (is.null(value) || length(value) == 0) return(NA_real_)
    num <- suppressWarnings(as.numeric(value[1]))
    if (length(num) == 0 || !is.finite(num[1])) return(NA_real_)
    as.numeric(num[1])
  }
  normalize_tick_count <- function(value, fallback = 6L) {
    if (is.null(value) || length(value) == 0) return(as.integer(fallback))
    num <- suppressWarnings(as.numeric(value[1]))
    if (length(num) == 0 || !is.finite(num[1])) num <- fallback
    as.integer(max(2, min(40, round(num[1]))))
  }

  x_scale_type <- normalize_axis_scale_type(labels_cfg$x_scale_type, "auto")
  y_scale_type <- normalize_axis_scale_type(labels_cfg$y_scale_type, "auto")
  x_tick_mode <- normalize_axis_tick_mode(labels_cfg$x_tick_mode, "auto")
  y_tick_mode <- normalize_axis_tick_mode(labels_cfg$y_tick_mode, "auto")
  x_tick_count <- normalize_tick_count(labels_cfg$x_tick_count, fallback = 6L)
  y_tick_count <- normalize_tick_count(labels_cfg$y_tick_count, fallback = 6L)
  x_tick_interval <- parse_positive_number(labels_cfg$x_tick_interval)
  y_tick_interval <- parse_positive_number(labels_cfg$y_tick_interval)
  if (is.finite(x_tick_interval) && x_tick_interval > 0) x_tick_mode <- "interval"
  if (is.finite(y_tick_interval) && y_tick_interval > 0) y_tick_mode <- "interval"
  x_min <- parse_optional_number(labels_cfg$x_min)
  x_max <- parse_optional_number(labels_cfg$x_max)
  y_min <- parse_optional_number(labels_cfg$y_min)
  y_max <- parse_optional_number(labels_cfg$y_max)

  if (length(title_size) == 0 || !is.finite(title_size[1])) title_size <- NA_real_ else title_size <- max(6, min(72, title_size[1]))
  if (length(x_size) == 0 || !is.finite(x_size[1])) x_size <- NA_real_ else x_size <- max(6, min(72, x_size[1]))
  if (length(y_size) == 0 || !is.finite(y_size[1])) y_size <- NA_real_ else y_size <- max(6, min(72, y_size[1]))
  if (length(axis_tick_size) == 0 || !is.finite(axis_tick_size[1])) axis_tick_size <- NA_real_ else axis_tick_size <- max(6, min(72, axis_tick_size[1]))

  title_theme_args <- list(
    hjust = resolve_horizontal_justification(title_position, title_steps)
  )
  if (!is.na(title_size)) title_theme_args$size <- title_size

  x_theme_args <- list(
    hjust = resolve_horizontal_justification(x_position, x_steps)
  )
  if (!is.na(x_size)) x_theme_args$size <- x_size

  y_theme_args <- list(
    vjust = resolve_vertical_justification(y_position, y_steps)
  )
  if (!is.na(y_size)) y_theme_args$size <- y_size

  theme_args <- list(
    plot.title = do.call(ggplot2::element_text, title_theme_args),
    axis.title.x = do.call(ggplot2::element_text, x_theme_args),
    axis.title.y = do.call(ggplot2::element_text, y_theme_args)
  )
  if (!is.na(axis_tick_size)) {
    theme_args$axis.text <- ggplot2::element_text(size = axis_tick_size)
  }

  p <- p + do.call(ggplot2::theme, theme_args)

  resolved_plot_key <- tolower(trimws(as.character(plot_key[1])))
  if (!nzchar(resolved_plot_key)) resolved_plot_key <- "default"

  # Apply global grid styles from Plot Elements for all non-exploratory plots.
  # Exploratory charts already manage grid style internally with color-aware logic.
  if (resolved_plot_key != "exploratory_chart_plot") {
    grid_keys <- c("show_grid", "show_paper_grid", "show_dashed_grid", "show_dotted_grid", "show_x_grid_only", "show_y_grid_only")
    elements_cfg <- to_plain_list(labels_cfg$elements)
    has_grid_control <- any(grid_keys %in% names(elements_cfg)) || any(grid_keys %in% names(labels_cfg))

    if (isTRUE(has_grid_control)) {
      show_grid <- resolve_plot_element_flag(labels_cfg, "show_grid", TRUE)
      show_paper_grid <- resolve_plot_element_flag(labels_cfg, "show_paper_grid", FALSE)
      show_dashed_grid <- resolve_plot_element_flag(labels_cfg, "show_dashed_grid", FALSE)
      show_dotted_grid <- resolve_plot_element_flag(labels_cfg, "show_dotted_grid", FALSE)
      show_x_grid_only <- resolve_plot_element_flag(labels_cfg, "show_x_grid_only", FALSE)
      show_y_grid_only <- resolve_plot_element_flag(labels_cfg, "show_y_grid_only", FALSE)

      grid_linetype <- if (isTRUE(show_dotted_grid)) "dotted" else if (isTRUE(show_dashed_grid)) "dashed" else "solid"
      minor_linetype <- if (isTRUE(show_dotted_grid) || isTRUE(show_dashed_grid)) "dotted" else "solid"

      if (!isTRUE(show_grid)) {
        p <- p + ggplot2::theme(
          panel.grid.major = ggplot2::element_blank(),
          panel.grid.minor = ggplot2::element_blank()
        )
      } else if (isTRUE(show_paper_grid)) {
        p <- p + ggplot2::theme(
          panel.background = ggplot2::element_rect(fill = "#fffdf2", color = "#d8d2b6", linewidth = 0.42),
          plot.background = ggplot2::element_rect(fill = "#fffef8", color = NA),
          panel.grid.major = ggplot2::element_line(color = "#d6d0b4", linewidth = 0.42, linetype = grid_linetype),
          panel.grid.minor = ggplot2::element_line(color = "#ece5c7", linewidth = 0.26, linetype = minor_linetype),
          panel.border = ggplot2::element_rect(color = "#d8d2b6", fill = NA, linewidth = 0.42)
        )
      } else {
        p <- p + ggplot2::theme(
          panel.grid.major = ggplot2::element_line(color = "#cbd5e1", linewidth = 0.42, linetype = grid_linetype),
          panel.grid.minor = ggplot2::element_line(color = "#e2e8f0", linewidth = 0.26, linetype = minor_linetype)
        )
      }

      if (isTRUE(show_x_grid_only) && !isTRUE(show_y_grid_only)) {
        p <- p + ggplot2::theme(
          panel.grid.major.y = ggplot2::element_blank(),
          panel.grid.minor.y = ggplot2::element_blank()
        )
      } else if (isTRUE(show_y_grid_only) && !isTRUE(show_x_grid_only)) {
        p <- p + ggplot2::theme(
          panel.grid.major.x = ggplot2::element_blank(),
          panel.grid.minor.x = ggplot2::element_blank()
        )
      }
    }
  }

  parse_optional_color <- function(value) {
    if (is.null(value) || length(value) == 0) return(NA_character_)
    color_text <- trimws(as.character(value[1]))
    if (!nzchar(color_text)) return(NA_character_)
    if (!is_valid_color_value(color_text)) return(NA_character_)
    color_text
  }

  legend_cfg <- to_plain_list(labels_cfg$legend)
  legend_title <- first_text_or_fallback(
    if (!is.null(legend_cfg$title)) legend_cfg$title else labels_cfg$legend_title,
    ""
  )
  legend_title_color <- parse_optional_color(
    if (!is.null(legend_cfg$title_color)) legend_cfg$title_color else labels_cfg$legend_title_color
  )
  legend_text_color <- parse_optional_color(
    if (!is.null(legend_cfg$text_color)) legend_cfg$text_color else labels_cfg$legend_text_color
  )

  legend_items_raw <- extract_legend_items_config(
    if (!is.null(legend_cfg$items)) legend_cfg$items else labels_cfg$legend_items
  )
  legend_item_values <- c()
  legend_item_labels <- c()
  if (length(legend_items_raw) > 0) {
    for (item_raw in legend_items_raw) {
      item_cfg <- to_plain_list(item_raw)
      if (!parse_logical_flag(item_cfg$enabled, TRUE)) next
      key_text <- first_text_or_fallback(
        if (!is.null(item_cfg$key)) item_cfg$key else item_cfg$id,
        ""
      )
      if (!nzchar(key_text)) next
      label_text <- first_text_or_fallback(item_cfg$label, key_text)
      color_text <- parse_optional_color(item_cfg$color)
      legend_item_labels[key_text] <- label_text
      if (!is.na(color_text)) {
        legend_item_values[key_text] <- color_text
      }
    }
  }

  if (nzchar(legend_title)) {
    p <- p + ggplot2::labs(color = legend_title, fill = legend_title)
  }
  legend_theme_args <- list()
  if (!is.na(legend_title_color)) {
    legend_theme_args$legend.title <- ggplot2::element_text(color = legend_title_color)
  }
  if (!is.na(legend_text_color)) {
    legend_theme_args$legend.text <- ggplot2::element_text(color = legend_text_color)
  }
  if (length(legend_theme_args) > 0) {
    p <- p + do.call(ggplot2::theme, legend_theme_args)
  }

  is_discrete_scale <- function(scale_obj) {
    if (is.null(scale_obj)) return(FALSE)
    discrete_flag <- tryCatch(scale_obj$is_discrete(), error = function(e) NA)
    if (is.logical(discrete_flag) && length(discrete_flag) > 0 && !is.na(discrete_flag[1])) {
      return(isTRUE(discrete_flag[1]))
    }
    cls <- paste(class(scale_obj), collapse = " ")
    if (grepl("Discrete", cls)) return(TRUE)
    if (grepl("Continuous", cls)) return(FALSE)
    FALSE
  }

  get_scale_levels <- function(scale_obj) {
    if (is.null(scale_obj)) return(character(0))
    levels <- character(0)
    levels <- tryCatch(as.character(scale_obj$get_limits()), error = function(e) character(0))
    levels <- levels[nzchar(levels)]
    if (length(levels) == 0) {
      levels <- tryCatch(as.character(scale_obj$range$range), error = function(e) character(0))
      levels <- levels[nzchar(levels)]
    }
    unique(levels)
  }

  get_scale_colors <- function(scale_obj, levels_vec) {
    if (is.null(scale_obj) || length(levels_vec) == 0) return(setNames(character(0), character(0)))
    mapped <- tryCatch(scale_obj$map(levels_vec), error = function(e) rep(NA_character_, length(levels_vec)))
    mapped <- as.character(mapped)
    names(mapped) <- levels_vec
    mapped
  }

  build_manual_scale_values <- function(scale_obj, levels_vec, legend_values_named) {
    values <- setNames(rep(NA_character_, length(levels_vec)), levels_vec)
    existing_colors <- get_scale_colors(scale_obj, levels_vec)
    if (length(existing_colors) > 0) {
      values[names(existing_colors)] <- existing_colors
    }
    if (length(legend_values_named) > 0) {
      matched <- intersect(names(legend_values_named), levels_vec)
      if (length(matched) > 0) values[matched] <- as.character(legend_values_named[matched])
    }
    missing_idx <- which(is.na(values) | !nzchar(values))
    if (length(missing_idx) > 0) {
      fallback_cols <- grDevices::hcl.colors(length(missing_idx), palette = "Dark 3")
      values[missing_idx] <- fallback_cols
    }
    values
  }

  apply_manual_legend_scale <- function(plot_obj, scale_obj, aesthetic = c("colour", "fill"), legend_values_named, legend_labels_named, legend_name_text = "") {
    aesthetic <- match.arg(aesthetic)
    if (!is_discrete_scale(scale_obj)) return(plot_obj)
    existing_levels <- get_scale_levels(scale_obj)
    custom_keys <- unique(c(names(legend_values_named), names(legend_labels_named)))
    all_levels <- unique(c(existing_levels, custom_keys))
    all_levels <- all_levels[nzchar(all_levels)]
    if (length(all_levels) == 0) return(plot_obj)

    values <- build_manual_scale_values(scale_obj, all_levels, legend_values_named)
    labels <- all_levels
    names(labels) <- all_levels
    if (length(legend_labels_named) > 0) {
      matched_labels <- intersect(names(legend_labels_named), all_levels)
      if (length(matched_labels) > 0) {
        labels[matched_labels] <- as.character(legend_labels_named[matched_labels])
      }
    }

    scale_args <- list(
      values = values,
      limits = all_levels,
      breaks = all_levels,
      labels = unname(labels[all_levels]),
      drop = FALSE
    )
    if (nzchar(legend_name_text)) scale_args$name <- legend_name_text

    tryCatch(
      if (identical(aesthetic, "colour")) {
        plot_obj + do.call(ggplot2::scale_colour_manual, scale_args)
      } else {
        plot_obj + do.call(ggplot2::scale_fill_manual, scale_args)
      },
      error = function(e) plot_obj
    )
  }

  if (length(legend_item_values) > 0 || length(legend_item_labels) > 0) {
    legend_built <- tryCatch(ggplot2::ggplot_build(p), error = function(e) NULL)
    colour_scale_obj <- tryCatch(if (!is.null(legend_built)) legend_built$plot$scales$get_scales("colour") else NULL, error = function(e) NULL)
    if (is.null(colour_scale_obj)) {
      colour_scale_obj <- tryCatch(if (!is.null(legend_built)) legend_built$plot$scales$get_scales("color") else NULL, error = function(e) NULL)
    }
    fill_scale_obj <- tryCatch(if (!is.null(legend_built)) legend_built$plot$scales$get_scales("fill") else NULL, error = function(e) NULL)
    p <- apply_manual_legend_scale(
      p,
      colour_scale_obj,
      aesthetic = "colour",
      legend_values_named = legend_item_values,
      legend_labels_named = legend_item_labels,
      legend_name_text = legend_title
    )
    p <- apply_manual_legend_scale(
      p,
      fill_scale_obj,
      aesthetic = "fill",
      legend_values_named = legend_item_values,
      legend_labels_named = legend_item_labels,
      legend_name_text = legend_title
    )
  }

  is_continuous_axis <- function(scale_obj) {
    if (is.null(scale_obj)) return(FALSE)
    discrete_flag <- tryCatch(scale_obj$is_discrete(), error = function(e) NA)
    if (is.logical(discrete_flag) && length(discrete_flag) > 0 && !is.na(discrete_flag[1])) {
      return(!isTRUE(discrete_flag[1]))
    }
    cls <- paste(class(scale_obj), collapse = " ")
    if (grepl("Discrete", cls)) return(FALSE)
    if (grepl("Continuous", cls)) return(TRUE)
    FALSE
  }
  resolve_breaks_spec <- function(mode, count_n, interval_val, scale_type = "linear") {
    if (mode == "count") {
      if (identical(scale_type, "log10") && requireNamespace("scales", quietly = TRUE)) {
        return(scales::log_breaks(n = max(2, as.integer(count_n))))
      }
      return(function(lims) {
        lims <- suppressWarnings(as.numeric(lims))
        lims <- lims[is.finite(lims)]
        if (length(lims) < 2) return(NULL)
        stats::pretty(range(lims), n = max(2, as.integer(count_n)))
      })
    }
    if (mode == "interval" && is.finite(interval_val) && interval_val > 0) {
      return(function(lims) {
        lims <- suppressWarnings(as.numeric(lims))
        lims <- lims[is.finite(lims)]
        if (length(lims) < 2) return(NULL)
        lo <- min(lims)
        hi <- max(lims)
        if (identical(scale_type, "log10")) lo <- max(lo, .Machine$double.eps)
        if (!is.finite(lo) || !is.finite(hi) || hi < lo) return(NULL)
        start <- floor(lo / interval_val) * interval_val
        end <- ceiling(hi / interval_val) * interval_val
        out <- seq(start, end, by = interval_val)
        out[is.finite(out)]
      })
    }
    ggplot2::waiver()
  }
  sanitize_limits <- function(min_val, max_val, scale_type = "auto") {
    lo <- if (is.finite(min_val)) as.numeric(min_val) else NA_real_
    hi <- if (is.finite(max_val)) as.numeric(max_val) else NA_real_
    if (identical(scale_type, "log10")) {
      if (is.finite(lo) && lo <= 0) lo <- NA_real_
      if (is.finite(hi) && hi <= 0) hi <- NA_real_
    }
    if (is.finite(lo) && is.finite(hi) && lo >= hi) {
      return(NULL)
    }
    if (!is.finite(lo) && !is.finite(hi)) return(NULL)
    c(lo, hi)
  }

  built_plot <- tryCatch(ggplot2::ggplot_build(p), error = function(e) NULL)
  x_scale_obj <- tryCatch(if (!is.null(built_plot)) built_plot$layout$panel_scales_x[[1]] else NULL, error = function(e) NULL)
  y_scale_obj <- tryCatch(if (!is.null(built_plot)) built_plot$layout$panel_scales_y[[1]] else NULL, error = function(e) NULL)
  x_is_continuous <- is_continuous_axis(x_scale_obj)
  y_is_continuous <- is_continuous_axis(y_scale_obj)

  if (isTRUE(x_is_continuous)) {
    x_scale_args <- list()
    if (x_scale_type == "log10") x_scale_args$trans <- "log10"
    x_breaks <- resolve_breaks_spec(x_tick_mode, x_tick_count, x_tick_interval, x_scale_type)
    if (!inherits(x_breaks, "waiver")) x_scale_args$breaks <- x_breaks
    x_limits <- sanitize_limits(x_min, x_max, x_scale_type)
    if (!is.null(x_limits)) x_scale_args$limits <- x_limits
    if (length(x_scale_args) > 0) {
      p <- tryCatch(
        p + do.call(ggplot2::scale_x_continuous, x_scale_args),
        error = function(e) p
      )
    }
  }

  if (isTRUE(y_is_continuous)) {
    y_scale_args <- list()
    if (y_scale_type == "log10") y_scale_args$trans <- "log10"
    y_breaks <- resolve_breaks_spec(y_tick_mode, y_tick_count, y_tick_interval, y_scale_type)
    if (!inherits(y_breaks, "waiver")) y_scale_args$breaks <- y_breaks
    y_limits <- sanitize_limits(y_min, y_max, y_scale_type)
    if (!is.null(y_limits)) y_scale_args$limits <- y_limits
    if (length(y_scale_args) > 0) {
      p <- tryCatch(
        p + do.call(ggplot2::scale_y_continuous, y_scale_args),
        error = function(e) p
      )
    }
  }

  parse_numeric_or_na <- function(value) {
    if (is.null(value) || length(value) == 0) return(NA_real_)
    num <- suppressWarnings(as.numeric(value[1]))
    if (length(num) == 0 || !is.finite(num[1])) return(NA_real_)
    as.numeric(num[1])
  }
  normalize_custom_line_type <- function(value, fallback = "dashed") {
    if (is.null(value) || length(value) == 0) return(fallback)
    candidate <- tolower(trimws(as.character(value[1])))
    if (!nzchar(candidate)) return(fallback)
    if (candidate %in% c("solid", "dashed", "dotted", "dotdash", "longdash", "twodash")) {
      return(candidate)
    }
    fallback
  }
  normalize_custom_color <- function(value, fallback = "#334155") {
    if (is.null(value) || length(value) == 0) return(fallback)
    candidate <- trimws(as.character(value[1]))
    if (!nzchar(candidate)) return(fallback)
    if (is_valid_color_value(candidate)) return(candidate)
    fallback
  }
  normalize_custom_line_width <- function(value, fallback = 0.8) {
    numeric_val <- parse_numeric_or_na(value)
    if (!is.finite(numeric_val) || numeric_val <= 0) return(fallback)
    max(0.2, min(4, numeric_val))
  }
  normalize_custom_text_size <- function(value, fallback = 3.6) {
    numeric_val <- parse_numeric_or_na(value)
    if (!is.finite(numeric_val) || numeric_val <= 0) return(fallback)
    max(2, min(16, numeric_val))
  }

  custom_elements_cfg <- extract_custom_elements_config(labels_cfg$custom_elements)
  if (length(custom_elements_cfg) > 0) {
    for (element_cfg_raw in custom_elements_cfg) {
      element_cfg <- to_plain_list(element_cfg_raw)
      if (!parse_logical_flag(element_cfg$enabled, TRUE)) next
      element_type <- tolower(trimws(as.character(element_cfg$type[1])))
      if (!(element_type %in% c("hline", "vline", "text"))) {
        element_type <- "hline"
      }

      if (element_type %in% c("hline", "vline")) {
        intercept_value <- parse_numeric_or_na(element_cfg$value)
        if (!is.finite(intercept_value)) next
        line_color <- normalize_custom_color(element_cfg$color, "#334155")
        line_type <- normalize_custom_line_type(element_cfg$lineType, "dashed")
        line_width <- normalize_custom_line_width(element_cfg$lineWidth, 0.8)
        p <- tryCatch(
          if (element_type == "hline") {
            p + ggplot2::geom_hline(
              yintercept = intercept_value,
              color = line_color,
              linetype = line_type,
              linewidth = line_width
            )
          } else {
            p + ggplot2::geom_vline(
              xintercept = intercept_value,
              color = line_color,
              linetype = line_type,
              linewidth = line_width
            )
          },
          error = function(e) p
        )
      } else {
        annotation_text <- if (is.null(element_cfg$text) || length(element_cfg$text) == 0) "" else as.character(element_cfg$text[1])
        annotation_text <- trimws(annotation_text)
        if (!nzchar(annotation_text)) next
        text_x <- parse_numeric_or_na(element_cfg$x)
        text_y <- parse_numeric_or_na(element_cfg$y)
        if (!is.finite(text_x) || !is.finite(text_y)) next
        text_color <- normalize_custom_color(element_cfg$color, "#0f172a")
        text_size <- normalize_custom_text_size(element_cfg$size, 3.6)
        p <- tryCatch(
          p + ggplot2::annotate(
            "text",
            x = text_x,
            y = text_y,
            label = annotation_text,
            color = text_color,
            size = text_size
          ),
          error = function(e) p
        )
      }
    }
  }

  return(p)
}

# Custom ggsave wrapper to automatically apply labels
custom_ggsave <- function(filename, plot = ggplot2::last_plot(), plot_key = NULL, ...) {
  explicit_key <- ""
  if (!is.null(plot_key) && length(plot_key) > 0) {
    explicit_key <- tolower(trimws(as.character(plot_key[1])))
  }

  resolved_plot_key <- if (nzchar(explicit_key)) {
    explicit_key
  } else {
    infer_plot_key_from_filename(filename)
  }
  if (!nzchar(resolved_plot_key)) resolved_plot_key <- "default"

  # Generic temp filenames (e.g. r_plot_*.png) cannot infer a stable key.
  # For targeted fullscreen refreshes, reuse target key so label edits apply.
  if (resolved_plot_key == "default" && !is.null(custom_plot_target) && nzchar(custom_plot_target)) {
    resolved_plot_key <- custom_plot_target
  }

  plot <- apply_custom_labels(plot, plot_key = resolved_plot_key)
  ggplot2::ggsave(filename, plot = plot, ...)
}

# Deterministic jitter keeps raw points stable across preview refreshes.
stable_jitter_position <- function(width = 0.14, height = 0, seed = 20260302L) {
  if (!requireNamespace("ggplot2", quietly = TRUE)) return(NULL)
  pos_formals <- tryCatch(names(formals(ggplot2::position_jitter)), error = function(e) character(0))
  if ("seed" %in% pos_formals) {
    return(ggplot2::position_jitter(width = width, height = height, seed = as.integer(seed)))
  }
  set.seed(as.integer(seed))
  ggplot2::position_jitter(width = width, height = height)
}

resolve_text_value <- function(value, fallback = "") {
  candidate <- if (is.null(value) || length(value) == 0) "" else as.character(value[1])
  candidate <- trimws(candidate)
  if (nzchar(candidate)) candidate else fallback
}

resolve_cex_value <- function(value, fallback_pt = 12) {
  numeric_val <- suppressWarnings(as.numeric(value[1]))
  if (length(numeric_val) == 0 || !is.finite(numeric_val[1])) {
    numeric_val <- fallback_pt
  } else {
    numeric_val <- max(6, min(72, numeric_val[1]))
  }
  as.numeric(numeric_val / 12)
}

resolve_base_label_config <- function(plot_key = "default", default_title = "", default_x = "", default_y = "", default_caption = "") {
  labels_cfg <- to_plain_list(resolve_labels_for_plot(plot_key))
  show_caption <- resolve_plot_element_flag(labels_cfg, "show_caption", TRUE)
  title_position <- normalize_position(labels_cfg$title_position, c("left", "center", "right"), "center")
  title_steps <- normalize_steps(labels_cfg$title_steps, fallback = 0L)
  x_position <- normalize_position(labels_cfg$x_position, c("left", "center", "right"), "center")
  x_steps <- normalize_steps(labels_cfg$x_steps, fallback = 0L)
  y_position <- normalize_position(labels_cfg$y_position, c("up", "center", "down"), "center")
  y_steps <- normalize_steps(labels_cfg$y_steps, fallback = 0L)

  list(
    title = resolve_text_value(labels_cfg$title, default_title),
    x = resolve_text_value(labels_cfg$x, default_x),
    y = resolve_text_value(labels_cfg$y, default_y),
    caption = if (isTRUE(show_caption)) resolve_text_value(labels_cfg$caption, default_caption) else "",
    title_cex = resolve_cex_value(labels_cfg$title_size, fallback_pt = 14),
    x_cex = resolve_cex_value(labels_cfg$x_size, fallback_pt = 12),
    y_cex = resolve_cex_value(labels_cfg$y_size, fallback_pt = 12),
    title_adj = resolve_horizontal_justification(title_position, title_steps, unit = 0.03),
    x_adj = resolve_horizontal_justification(x_position, x_steps, unit = 0.03),
    y_adj = max(0, min(1, resolve_vertical_justification(y_position, y_steps, unit = 0.04)))
  )
}

render_base_label_config <- function(cfg, title_line = 1.2, x_line = 2.6, y_line = 2.8, caption_line = 4.4) {
  if (!is.list(cfg)) return(invisible(NULL))
  if (nzchar(cfg$title)) {
    mtext(cfg$title, side = 3, line = title_line, cex = cfg$title_cex, font = 2, adj = cfg$title_adj)
  }
  if (nzchar(cfg$x)) {
    mtext(cfg$x, side = 1, line = x_line, cex = cfg$x_cex, font = 2, adj = cfg$x_adj)
  }
  if (nzchar(cfg$y)) {
    mtext(cfg$y, side = 2, line = y_line, cex = cfg$y_cex, font = 2, adj = cfg$y_adj)
  }
  if (nzchar(cfg$caption)) {
    mtext(cfg$caption, side = 1, line = caption_line, cex = 0.85, adj = 1, col = "#475569")
  }
  invisible(NULL)
}

message("ARGS: ", paste(args, collapse=" | "))
message("inferential_significant_only is: ", inferential_significant_only)
message("Custom Labels target_plot: ", ifelse(is.null(custom_plot_target) || custom_plot_target == "", "none", custom_plot_target))
message("Custom Labels map keys: ", if (length(custom_plot_labels_by_plot) > 0) paste(names(custom_plot_labels_by_plot), collapse = ",") else "none")

profile_msg("Top level ~line 500")
run_chisq_with_adjustment <- function(cont_table, adjustment_mode = "auto") {
  profile_msg("Parsed early functions (~line 500)")
  is_two_by_two <- nrow(cont_table) == 2 && ncol(cont_table) == 2
  apply_yates <- switch(
    adjustment_mode,
    "yates" = is_two_by_two,
    "none" = FALSE,
    "auto" = is_two_by_two,
    is_two_by_two
  )
  correction_label <- if (adjustment_mode == "yates" && !is_two_by_two) {
    "Yates correction requested but not applied (only valid for 2x2 tables)."
  } else if (apply_yates) {
    "Yates continuity correction applied."
  } else if (adjustment_mode == "none") {
    "No continuity correction applied."
  } else {
    "Auto mode: no continuity correction applied."
  }

  chisq_res <- tryCatch(
    chisq.test(cont_table, correct = apply_yates),
    error = function(e) NULL
  )

  list(
    result = chisq_res,
    is_two_by_two = is_two_by_two,
    correction_applied = apply_yates,
    correction_label = correction_label,
    correction_option = adjustment_mode
  )
}

run_chisq_goodness_of_fit <- function(cat_values, variable_name, alpha = 0.05, expected_probs = NULL, null_hypothesis = "Equal category proportions") {
  counts <- table(cat_values)
  if (length(counts) < 2) {
    return(list(
      variable = variable_name,
      message = sprintf("Goodness-of-fit not computed for %s (need at least 2 categories).", variable_name)
    ))
  }

  probs <- if (!is.null(expected_probs)) expected_probs else rep(1 / length(counts), length(counts))
  gof_res <- tryCatch(
    suppressWarnings(chisq.test(x = counts, p = probs)),
    error = function(e) NULL
  )

  if (is.null(gof_res)) {
    return(list(
      variable = variable_name,
      message = sprintf("Goodness-of-fit test failed for %s.", variable_name)
    ))
  }

  is_sig <- as.numeric(gof_res$p.value) < alpha
  fmt_p <- if (gof_res$p.value < 0.001) "< .001" else sprintf("%.3f", gof_res$p.value)

  list(
    variable = variable_name,
    null_hypothesis = null_hypothesis,
    statistic = as.numeric(gof_res$statistic),
    df = as.numeric(gof_res$parameter),
    p_value = as.numeric(gof_res$p.value),
    formatted_p = fmt_p,
    is_significant = is_sig,
    categories = as.character(names(counts)),
    observed = as.numeric(counts),
    expected = as.numeric(gof_res$expected),
    message = if (is_sig) {
      sprintf("Goodness-of-fit for %s is significant (p = %s): observed distribution differs from equal proportions.", variable_name, fmt_p)
    } else {
      sprintf("Goodness-of-fit for %s is not significant (p = %s): observed distribution is compatible with equal proportions.", variable_name, fmt_p)
    }
  )
}

fmt_p_value <- function(pv) {
  if (is.na(pv)) return("N/A")
  if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
  format(round(pv, 4), nsmall = 4)
}

cohens_d_label <- function(dv) {
  if (is.na(dv)) return("unknown")
  d_abs <- abs(dv)
  if (d_abs < 0.2) return("negligible")
  if (d_abs < 0.5) return("small")
  if (d_abs < 0.8) return("medium")
  "large"
}

create_one_value_publication_plot <- function(raw_values, variable_name, one_value_summary, result_list, base_output_image, alpha_level = 0.05) {
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "One-value publication plot requires ggplot2."))
  }
  if (is.null(one_value_summary) || !is.list(one_value_summary)) {
    return(list(generated = FALSE, path = NULL, error = "Missing one-value summary payload for publication plot."))
  }

  output_path <- gsub("\\.png$", "_one_value_publication.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_one_value_publication.png")
  }
  ci_level <- resolve_conf_level_from_alpha(alpha_level)
  ci_percent <- as.integer(round(ci_level * 100))

  fmt_num <- function(v, digits = 3) {
    num <- suppressWarnings(as.numeric(v[1]))
    if (!is.finite(num)) return("N/A")
    format(round(num, digits), nsmall = digits)
  }

  safe_text <- function(v, fallback = "N/A") {
    if (is.null(v) || length(v) == 0) return(fallback)
    txt <- trimws(as.character(v[1]))
    if (nzchar(txt)) txt else fallback
  }

  data_type <- tolower(safe_text(one_value_summary$data_type, fallback = "unknown"))
  palette_name <- get_plot_color(variable_name, default_color_scheme)
  var_palette <- get_palette(palette_name)

  resolve_one_value_color <- function(color_key, fallback_value) {
    override_value <- plot_colors_list[[color_key]]
    if (!is.null(override_value)) {
      candidate <- trimws(as.character(override_value[1]))
      if (is_valid_color_value(candidate)) {
        return(candidate)
      }
    }
    fallback_value
  }

  one_value_primary_fill_color <- resolve_one_value_color("one_value_primary_fill_color", var_palette$main)
  one_value_secondary_fill_color <- resolve_one_value_color("one_value_secondary_fill_color", "#94a3b8")
  one_value_density_color <- resolve_one_value_color("one_value_density_color", var_palette$accent)
  one_value_rug_color <- resolve_one_value_color("one_value_rug_color", "#334155")
  one_value_reference_line_color <- resolve_one_value_color("one_value_reference_line_color", "#dc2626")
  one_value_mean_line_color <- resolve_one_value_color("one_value_mean_line_color", "#0f766e")
  one_value_median_line_color <- resolve_one_value_color("one_value_median_line_color", "#7c3aed")
  one_value_bar_border_color <- resolve_one_value_color("one_value_bar_border_color", "#0f172a")
  one_value_label_text_color <- resolve_one_value_color("one_value_label_text_color", "#0f172a")
  one_value_reference_label_color <- resolve_one_value_color("one_value_reference_label_color", "#dc2626")
  one_value_ci_errorbar_color <- resolve_one_value_color("one_value_ci_errorbar_color", "#0f172a")
  one_value_ci_band_color <- resolve_one_value_color("one_value_ci_band_color", "#2563eb")
  one_value_annotation_text_color <- resolve_one_value_color("one_value_annotation_text_color", "#0f172a")
  one_value_annotation_fill_color <- resolve_one_value_color("one_value_annotation_fill_color", "#ffffff")
  one_value_subtitle_color <- resolve_one_value_color("one_value_subtitle_color", "#334155")
  one_value_caption_color <- resolve_one_value_color("one_value_caption_color", "#475569")
  plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("one_value_plot"))
  show_caption <- resolve_plot_element_flag(plot_labels_cfg, "show_caption", TRUE)
  show_annotation_panel <- resolve_plot_element_flag(plot_labels_cfg, "show_annotation_panel", TRUE)
  show_reference_line <- resolve_plot_element_flag(plot_labels_cfg, "show_reference_line", TRUE)
  show_reference_label <- resolve_plot_element_flag(plot_labels_cfg, "show_reference_label", TRUE)
  show_effect_line <- resolve_plot_element_flag(plot_labels_cfg, "show_effect_line", TRUE)
  show_ci_line <- resolve_plot_element_flag(plot_labels_cfg, "show_ci_line", TRUE)
  show_ci_band <- resolve_plot_element_flag(plot_labels_cfg, "show_ci_band", TRUE)
  show_normality_line <- resolve_plot_element_flag(plot_labels_cfg, "show_normality_line", TRUE)
  show_histogram <- resolve_plot_element_flag(plot_labels_cfg, "show_histogram", TRUE)
  show_density <- resolve_plot_element_flag(plot_labels_cfg, "show_density", TRUE)
  show_rug <- resolve_plot_element_flag(plot_labels_cfg, "show_rug", TRUE)
  show_mean_line <- resolve_plot_element_flag(plot_labels_cfg, "show_mean_line", TRUE)
  show_median_line <- resolve_plot_element_flag(plot_labels_cfg, "show_median_line", TRUE)
  show_bars <- resolve_plot_element_flag(plot_labels_cfg, "show_bars", TRUE)
  show_bar_labels <- resolve_plot_element_flag(plot_labels_cfg, "show_bar_labels", TRUE)
  show_ci_errorbar <- resolve_plot_element_flag(plot_labels_cfg, "show_ci_errorbar", TRUE)
  show_observed_series <- resolve_plot_element_flag(plot_labels_cfg, "show_observed_series", TRUE)
  show_expected_series <- resolve_plot_element_flag(plot_labels_cfg, "show_expected_series", TRUE)
  show_legend <- resolve_plot_element_flag(plot_labels_cfg, "show_legend", TRUE)

  plot_error <- NULL
  ok <- tryCatch({
    if (data_type == "continuous") {
      vals <- suppressWarnings(as.numeric(as.character(raw_values)))
      vals <- vals[is.finite(vals)]
      if (length(vals) < 2) {
        stop("Continuous one-value publication plot needs at least 2 finite observations.")
      }

      n <- length(vals)
      m <- mean(vals, na.rm = TRUE)
      med <- median(vals, na.rm = TRUE)
      s <- if (n > 1) sd(vals, na.rm = TRUE) else NA_real_
      q1 <- as.numeric(quantile(vals, probs = 0.25, na.rm = TRUE, names = FALSE, type = 7))
      q3 <- as.numeric(quantile(vals, probs = 0.75, na.rm = TRUE, names = FALSE, type = 7))

      ref_val <- suppressWarnings(as.numeric(one_value_summary$reference_value))
      if (!is.finite(ref_val) && !is.null(result_list$ttest$reference_mean)) {
        ref_val <- suppressWarnings(as.numeric(result_list$ttest$reference_mean))
      }
      if (!is.finite(ref_val) && !is.null(result_list$wilcoxon$reference_mu)) {
        ref_val <- suppressWarnings(as.numeric(result_list$wilcoxon$reference_mu))
      }
      if (!is.finite(ref_val)) ref_val <- m

      test_name <- "One-value test"
      stat_label <- "Statistic"
      stat_value <- NA_real_
      stat_df <- NA_real_
      p_value_fmt <- "N/A"
      effect_line <- ""
      ci_line <- ""
      ci_abs_l <- NA_real_
      ci_abs_u <- NA_real_
      if (!is.null(result_list$ttest)) {
        test_name <- safe_text(result_list$ttest$test_name, "One-sample t-test")
        stat_label <- "t"
        stat_value <- suppressWarnings(as.numeric(result_list$ttest$statistic))
        stat_df <- suppressWarnings(as.numeric(result_list$ttest$df))
        p_value_fmt <- safe_text(result_list$ttest$formatted_p, fmt_p_value(suppressWarnings(as.numeric(result_list$ttest$p_value))))
        d_val <- suppressWarnings(as.numeric(result_list$ttest$cohens_d))
        if (is.finite(d_val)) {
          effect_line <- sprintf("Cohen's d = %s (%s)", fmt_num(d_val, 3), safe_text(result_list$ttest$effect_size, "effect size"))
        }
        ci_l <- suppressWarnings(as.numeric(result_list$ttest$ci_lower))
        ci_u <- suppressWarnings(as.numeric(result_list$ttest$ci_upper))
        if (is.finite(ci_l) && is.finite(ci_u)) {
          ci_line <- sprintf("95%% CI (mean difference): [%s, %s]", fmt_num(ci_l, 3), fmt_num(ci_u, 3))
        }
        # ci_lower/ci_upper are already absolute CI bounds for the mean (from t.test$conf.int)
        ci_abs_l <- if (is.finite(ci_l)) ci_l else NA_real_
        ci_abs_u <- if (is.finite(ci_u)) ci_u else NA_real_
      } else if (!is.null(result_list$wilcoxon)) {
        test_name <- safe_text(result_list$wilcoxon$test_name, "Wilcoxon Signed-Rank Test (One-Sample)")
        stat_label <- "V"
        stat_value <- suppressWarnings(as.numeric(result_list$wilcoxon$statistic))
        p_value_fmt <- safe_text(result_list$wilcoxon$formatted_p, fmt_p_value(suppressWarnings(as.numeric(result_list$wilcoxon$p_value))))
        pseudo_med <- suppressWarnings(as.numeric(result_list$wilcoxon$pseudo_median))
        if (is.finite(pseudo_med)) {
          effect_line <- sprintf("Pseudo-median estimate = %s", fmt_num(pseudo_med, 3))
        }
        ci_abs_l <- NA_real_
        ci_abs_u <- NA_real_
      }

      normality_line <- ""
      if (!is.null(result_list$shapiro) && !is.null(result_list$shapiro[[variable_name]])) {
        sh <- result_list$shapiro[[variable_name]]
        sh_p <- safe_text(sh$formatted_p, fmt_p_value(suppressWarnings(as.numeric(sh$p_value))))
        sh_flag <- if (isTRUE(sh$is_normal)) "normal" else "non-normal"
        normality_line <- sprintf("Shapiro-Wilk p = %s (%s)", sh_p, sh_flag)
      }

      stat_df_text <- if (is.finite(stat_df)) sprintf(", df = %s", fmt_num(stat_df, 3)) else ""
      show_effect_line_cont <- isTRUE(show_effect_line) && nzchar(effect_line)
      show_ci_line_cont <- isTRUE(show_ci_line) && nzchar(ci_line)
      show_normality_line_cont <- isTRUE(show_normality_line) && nzchar(normality_line)
      show_median_line_cont <- isTRUE(show_median_line) && !is.null(result_list$wilcoxon)
      annotation_lines <- c(
        sprintf("n = %d", n),
        sprintf("Reference = %s", fmt_num(ref_val, 3)),
        sprintf("Mean = %s", fmt_num(m, 3)),
        sprintf("Median = %s", fmt_num(med, 3)),
        sprintf("%s = %s%s", stat_label, fmt_num(stat_value, 3), stat_df_text),
        sprintf("p = %s (alpha = %s)", p_value_fmt, fmt_num(alpha_level, 3))
      )
      if (isTRUE(show_effect_line_cont)) annotation_lines <- c(annotation_lines, effect_line)

      caption_parts <- c(
        sprintf("Summary: mean +- SD = %s +- %s; median [Q1, Q3] = %s [%s, %s].", fmt_num(m, 3), fmt_num(s, 3), fmt_num(med, 3), fmt_num(q1, 3), fmt_num(q3, 3)),
        sprintf("Test: %s (%s = %s%s, p = %s).", test_name, stat_label, fmt_num(stat_value, 3), stat_df_text, p_value_fmt)
      )
      if (isTRUE(show_ci_line_cont)) caption_parts <- c(caption_parts, ci_line)
      if (isTRUE(show_effect_line_cont)) caption_parts <- c(caption_parts, paste0("Effect: ", effect_line, "."))
      if (isTRUE(show_normality_line_cont)) caption_parts <- c(caption_parts, paste0("Normality: ", normality_line, "."))
      caption_text <- paste(caption_parts, collapse = "  ")

      plot_df <- data.frame(value = vals, stringsAsFactors = FALSE)
      bins_n <- max(10, min(45, ceiling(sqrt(n))))
      p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = value))

      if (isTRUE(show_histogram)) {
        p <- p + ggplot2::geom_histogram(
          ggplot2::aes(y = after_stat(density)),
          bins = bins_n,
          fill = one_value_primary_fill_color,
          color = one_value_bar_border_color,
          alpha = 0.78
        )
      }
      if (isTRUE(show_density)) {
        p <- p + ggplot2::geom_density(color = one_value_density_color, linewidth = 1.15, adjust = 1)
      }
      if (isTRUE(show_rug)) {
        p <- p + ggplot2::geom_rug(sides = "b", alpha = 0.26, color = one_value_rug_color)
      }
      if (isTRUE(show_reference_line)) {
        p <- p + ggplot2::geom_vline(xintercept = ref_val, color = one_value_reference_line_color, linetype = "dashed", linewidth = 1.05)
      }
      if (isTRUE(show_mean_line)) {
        p <- p + ggplot2::geom_vline(xintercept = m, color = one_value_mean_line_color, linewidth = 1.0)
      }
      if (isTRUE(show_median_line_cont)) {
        p <- p + ggplot2::geom_vline(xintercept = med, color = one_value_median_line_color, linetype = "dotdash", linewidth = 0.95)
      }
      if (isTRUE(show_ci_band) && is.finite(ci_abs_l) && is.finite(ci_abs_u)) {
        p <- p + ggplot2::annotate(
          "rect",
          xmin = ci_abs_l,
          xmax = ci_abs_u,
          ymin = -Inf,
          ymax = Inf,
          fill = one_value_ci_band_color,
          alpha = 0.13
        ) +
        ggplot2::geom_vline(
          xintercept = c(ci_abs_l, ci_abs_u),
          color = one_value_ci_band_color,
          linetype = "dashed",
          linewidth = 0.7,
          alpha = 0.85
        )
      }

      # ── Individual value labels on the plot ──────────────────────────
      show_mean_label           <- resolve_plot_element_flag(plot_labels_cfg, "show_mean_label",           FALSE)
      show_median_label         <- resolve_plot_element_flag(plot_labels_cfg, "show_median_label",         FALSE)
      show_reference_val_label  <- resolve_plot_element_flag(plot_labels_cfg, "show_reference_val_label",  FALSE)
      show_ci_lower_label       <- resolve_plot_element_flag(plot_labels_cfg, "show_ci_lower_label",       FALSE)
      show_ci_upper_label       <- resolve_plot_element_flag(plot_labels_cfg, "show_ci_upper_label",       FALSE)
      show_q1_label             <- resolve_plot_element_flag(plot_labels_cfg, "show_q1_label",             FALSE)
      show_q3_label             <- resolve_plot_element_flag(plot_labels_cfg, "show_q3_label",             FALSE)

      any_label <- isTRUE(show_mean_label) || isTRUE(show_median_label) || isTRUE(show_reference_val_label) ||
                   isTRUE(show_ci_lower_label) || isTRUE(show_ci_upper_label) ||
                   isTRUE(show_q1_label) || isTRUE(show_q3_label)

      if (any_label) {
        # Common y reference — top of kernel density, used to position labels cleanly
        y_top <- tryCatch({
          dens <- stats::density(vals, adjust = 1)
          max(dens$y) * 0.94
        }, error = function(e) Inf)

        lbl_size <- 3.0
        lbl_fill <- grDevices::adjustcolor(one_value_annotation_fill_color, alpha.f = 0.84)

        # ── Mean ──
        if (isTRUE(show_mean_label)) {
          p <- p + ggplot2::annotate(
            "label", x = m, y = y_top,
            label = paste0("Mean\n", fmt_num(m, 3)),
            size = lbl_size, hjust = 0.5, vjust = 1,
            fill = lbl_fill, color = one_value_mean_line_color,
            label.padding = grid::unit(0.15, "lines"), label.size = 0.22
          )
        }

        # ── Median ──
        if (isTRUE(show_median_label)) {
          p <- p + ggplot2::annotate(
            "label", x = med, y = y_top * 0.82,
            label = paste0("Median\n", fmt_num(med, 3)),
            size = lbl_size, hjust = 0.5, vjust = 1,
            fill = lbl_fill, color = one_value_median_line_color,
            label.padding = grid::unit(0.15, "lines"), label.size = 0.22
          )
        }

        # ── Reference ──
        if (isTRUE(show_reference_val_label) && is.finite(ref_val)) {
          p <- p + ggplot2::annotate(
            "label", x = ref_val, y = y_top * 0.72,
            label = paste0("Reference\n", fmt_num(ref_val, 3)),
            size = lbl_size, hjust = 0.5, vjust = 1,
            fill = lbl_fill, color = one_value_reference_line_color,
            label.padding = grid::unit(0.15, "lines"), label.size = 0.22
          )
        }

        # ── CI Low ──
        if (isTRUE(show_ci_lower_label) && is.finite(ci_abs_l)) {
          p <- p + ggplot2::annotate(
            "label", x = ci_abs_l, y = y_top * 0.62,
            label = paste0(ci_percent, "% CI Low\n", fmt_num(ci_abs_l, 3)),
            size = lbl_size - 0.2, hjust = 0.5, vjust = 1,
            fill = lbl_fill, color = one_value_ci_band_color,
            label.padding = grid::unit(0.13, "lines"), label.size = 0.18
          )
        }

        # ── CI High ──
        if (isTRUE(show_ci_upper_label) && is.finite(ci_abs_u)) {
          p <- p + ggplot2::annotate(
            "label", x = ci_abs_u, y = y_top * 0.62,
            label = paste0(ci_percent, "% CI High\n", fmt_num(ci_abs_u, 3)),
            size = lbl_size - 0.2, hjust = 0.5, vjust = 1,
            fill = lbl_fill, color = one_value_ci_band_color,
            label.padding = grid::unit(0.13, "lines"), label.size = 0.18
          )
        }

        # ── Q1 ── (adds dotted Q1 guide line + label)
        if (isTRUE(show_q1_label) && is.finite(q1)) {
          p <- p +
            ggplot2::geom_vline(xintercept = q1, color = one_value_median_line_color,
                                linetype = "dotted", linewidth = 0.7, alpha = 0.7) +
            ggplot2::annotate(
              "label", x = q1, y = y_top * 0.44,
              label = paste0("Q1\n", fmt_num(q1, 3)),
              size = lbl_size - 0.2, hjust = 0.5, vjust = 1,
              fill = lbl_fill, color = one_value_median_line_color,
              label.padding = grid::unit(0.13, "lines"), label.size = 0.18
            )
        }

        # ── Q3 ── (adds dotted Q3 guide line + label)
        if (isTRUE(show_q3_label) && is.finite(q3)) {
          p <- p +
            ggplot2::geom_vline(xintercept = q3, color = one_value_median_line_color,
                                linetype = "dotted", linewidth = 0.7, alpha = 0.7) +
            ggplot2::annotate(
              "label", x = q3, y = y_top * 0.44,
              label = paste0("Q3\n", fmt_num(q3, 3)),
              size = lbl_size - 0.2, hjust = 0.5, vjust = 1,
              fill = lbl_fill, color = one_value_median_line_color,
              label.padding = grid::unit(0.13, "lines"), label.size = 0.18
            )
        }
      }

      p <- p +
        ggplot2::scale_y_continuous(expand = ggplot2::expansion(mult = c(0, 0.18))) +
        ggplot2::labs(
          title = paste("One-Value Continuous Comparison:", variable_name),
          subtitle = sprintf("%s | reference = %s | n = %d", test_name, fmt_num(ref_val, 3), n),
          x = variable_name,
          y = "Density",
          caption = if (isTRUE(show_caption)) caption_text else NULL
        ) +
        ggplot2::theme_minimal(base_size = 13) +
        ggplot2::theme(
          plot.title = ggplot2::element_text(face = "bold", size = 15),
          plot.subtitle = ggplot2::element_text(size = 11.5, color = one_value_subtitle_color),
          plot.caption = ggplot2::element_text(size = 9.3, hjust = 0, color = one_value_caption_color),
          axis.title = ggplot2::element_text(face = "bold"),
          panel.grid.minor = ggplot2::element_blank(),
          legend.position = "none"
        )

      if (isTRUE(show_annotation_panel)) {
        p <- p + ggplot2::annotate(
          "label",
          x = Inf,
          y = Inf,
          label = paste(annotation_lines, collapse = "\n"),
          hjust = 1.03,
          vjust = 1.03,
          size = 3.35,
          linewidth = 0.18,
          label.padding = grid::unit(0.20, "lines"),
          fill = grDevices::adjustcolor(one_value_annotation_fill_color, alpha.f = 0.88),
          color = one_value_annotation_text_color
        )
      }

      custom_ggsave(output_path, plot = p, plot_key = "one_value_plot", width = 11.8, height = 8.2, dpi = 320, device = "png")
    } else if (data_type == "categorical_binary") {
      cat_vals <- as.character(raw_values)
      cat_vals <- cat_vals[!is.na(cat_vals) & trimws(cat_vals) != ""]
      if (length(cat_vals) == 0) {
        stop("Binary one-value publication plot needs non-empty categorical values.")
      }

      counts <- table(cat_vals)
      categories <- names(counts)
      ordered_categories <- as.character(one_value_summary$categories)
      if (length(ordered_categories) > 0) {
        ordered_categories <- ordered_categories[ordered_categories %in% categories]
        categories <- c(ordered_categories, setdiff(categories, ordered_categories))
      }
      counts_vec <- as.numeric(counts[categories])
      counts_vec[is.na(counts_vec)] <- 0
      n_total <- sum(counts_vec)
      if (n_total <= 0) stop("Binary one-value publication plot has zero total count.")
      props <- counts_vec / n_total

      success_level <- safe_text(one_value_summary$success_level, categories[1])
      if (!(success_level %in% categories)) success_level <- categories[1]
      success_count <- as.numeric(counts[success_level])
      if (!is.finite(success_count)) success_count <- 0
      obs_prop <- success_count / n_total
      ref_prop <- suppressWarnings(as.numeric(one_value_summary$reference_proportion))
      if (!is.finite(ref_prop)) ref_prop <- suppressWarnings(as.numeric(one_value_summary$reference_value))
      if (!is.finite(ref_prop)) ref_prop <- 0.5

      test_info <- one_value_summary$proportion_test
      method_name <- safe_text(test_info$method, "Proportion test")
      stat_label <- safe_text(test_info$statistic_label, "Statistic")
      stat_val <- suppressWarnings(as.numeric(test_info$statistic))
      p_value_fmt <- safe_text(test_info$formatted_p, fmt_p_value(suppressWarnings(as.numeric(test_info$p_value))))

      ci_l <- suppressWarnings(as.numeric(test_info$conf_int_lower[1]))
      ci_u <- suppressWarnings(as.numeric(test_info$conf_int_upper[1]))
      if (length(ci_l) == 0 || !is.finite(ci_l)) ci_l <- NA_real_
      if (length(ci_u) == 0 || !is.finite(ci_u)) ci_u <- NA_real_
      if (!(is.finite(ci_l) && is.finite(ci_u))) {
        ci_try <- tryCatch(suppressWarnings(prop.test(success_count, n_total, correct = FALSE)$conf.int), error = function(e) NULL)
        if (is.null(ci_try)) {
          ci_try <- tryCatch(suppressWarnings(binom.test(success_count, n_total)$conf.int), error = function(e) NULL)
        }
        if (!is.null(ci_try)) {
          ci_l <- as.numeric(ci_try[1])
          ci_u <- as.numeric(ci_try[2])
        }
      }

      plot_df <- data.frame(
        category = factor(categories, levels = categories),
        count = counts_vec,
        proportion = props,
        stringsAsFactors = FALSE
      )
      fill_values <- get_level_color_map(variable_name, categories, pick_cols(length(categories)))
      y_top <- max(c(plot_df$proportion, ref_prop, ci_u), na.rm = TRUE)
      if (!is.finite(y_top)) y_top <- 1
      y_upper <- max(0.25, min(1, y_top + 0.22))

      ci_df <- data.frame(
        category = factor(success_level, levels = categories),
        ymin = if (is.finite(ci_l)) ci_l else NA_real_,
        ymax = if (is.finite(ci_u)) ci_u else NA_real_,
        stringsAsFactors = FALSE
      )
      show_binary_ci <- isTRUE(show_ci_errorbar) && is.finite(ci_l) && is.finite(ci_u)

      caption_parts <- c(
        sprintf("Test: %s (%s = %s, p = %s, alpha = %s).", method_name, stat_label, fmt_num(stat_val, 3), p_value_fmt, fmt_num(alpha_level, 3)),
        sprintf("Observed success proportion for '%s': %d/%d = %s; reference p0 = %s.", success_level, as.integer(success_count), as.integer(n_total), fmt_num(obs_prop, 4), fmt_num(ref_prop, 4))
      )
      if (isTRUE(show_binary_ci)) {
        caption_parts <- c(caption_parts, sprintf("95%% CI for observed success proportion: [%s, %s].", fmt_num(ci_l, 4), fmt_num(ci_u, 4)))
      }
      caption_text <- paste(caption_parts, collapse = "  ")

      p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = category, y = proportion, fill = category))
      if (isTRUE(show_bars)) {
        p <- p + ggplot2::geom_col(width = 0.64, color = one_value_bar_border_color, alpha = 0.86)
      }
      if (isTRUE(show_bar_labels)) {
        p <- p + ggplot2::geom_text(
          ggplot2::aes(label = sprintf("%.1f%% (n=%d)", proportion * 100, count)),
          vjust = -0.48,
          size = 3.45,
          fontface = "bold",
          color = one_value_label_text_color
        )
      }
      if (isTRUE(show_reference_line)) {
        p <- p + ggplot2::geom_hline(yintercept = ref_prop, color = one_value_reference_line_color, linetype = "dashed", linewidth = 1.05)
      }
      if (isTRUE(show_reference_line) && isTRUE(show_reference_label)) {
        p <- p + ggplot2::annotate(
          "text",
          x = Inf,
          y = ref_prop,
          label = paste0("Reference p0 = ", fmt_num(ref_prop, 3)),
          vjust = -0.45,
          hjust = 1.05,
          size = 3.3,
          color = one_value_reference_label_color,
          fontface = "bold"
        )
      }
      p <- p +
        ggplot2::scale_fill_manual(values = fill_values, drop = FALSE) +
        ggplot2::scale_y_continuous(
          limits = c(0, y_upper),
          labels = function(y) paste0(round(y * 100), "%"),
          expand = ggplot2::expansion(mult = c(0, 0))
        ) +
        ggplot2::labs(
          title = paste("One-Value Binary Proportion Comparison:", variable_name),
          subtitle = sprintf("%s | success = %s | n = %d", method_name, success_level, n_total),
          x = variable_name,
          y = "Proportion",
          caption = if (isTRUE(show_caption)) caption_text else NULL
        ) +
        ggplot2::theme_minimal(base_size = 13) +
        ggplot2::theme(
          plot.title = ggplot2::element_text(face = "bold", size = 15),
          plot.subtitle = ggplot2::element_text(size = 11.5, color = one_value_subtitle_color),
          plot.caption = ggplot2::element_text(size = 9.3, hjust = 0, color = one_value_caption_color),
          axis.title = ggplot2::element_text(face = "bold"),
          panel.grid.minor = ggplot2::element_blank(),
          panel.background = ggplot2::element_rect(fill = "#ffffff", color = NA),
          plot.background = ggplot2::element_rect(fill = "#ffffff", color = NA),
          legend.position = "none"
        )

      if (isTRUE(show_binary_ci)) {
        p <- p + ggplot2::geom_errorbar(
          data = ci_df,
          ggplot2::aes(x = category, ymin = ymin, ymax = ymax),
          inherit.aes = FALSE,
          width = 0.12,
          linewidth = 0.95,
          color = one_value_ci_errorbar_color
        )
      }

      custom_ggsave(output_path, plot = p, plot_key = "one_value_plot", width = 11.4, height = 7.8, dpi = 320, device = "png")
    } else if (data_type == "categorical_multiclass") {
      cat_vals <- as.character(raw_values)
      cat_vals <- cat_vals[!is.na(cat_vals) & trimws(cat_vals) != ""]
      if (length(cat_vals) == 0) {
        stop("Multiclass one-value publication plot needs non-empty categorical values.")
      }

      counts <- table(cat_vals)
      categories <- names(counts)
      ordered_categories <- as.character(one_value_summary$categories)
      if (length(ordered_categories) > 0) {
        ordered_categories <- ordered_categories[ordered_categories %in% categories]
        categories <- c(ordered_categories, setdiff(categories, ordered_categories))
      }

      observed_counts <- as.numeric(counts[categories])
      observed_counts[is.na(observed_counts)] <- 0
      n_total <- sum(observed_counts)
      if (n_total <= 0) stop("Multiclass one-value publication plot has zero total count.")
      observed_prop <- observed_counts / n_total

      expected_prop <- suppressWarnings(as.numeric(one_value_summary$expected_proportions))
      if (length(expected_prop) != length(categories) || any(!is.finite(expected_prop)) || sum(expected_prop) <= 0) {
        expected_prop <- rep(1 / length(categories), length(categories))
      } else {
        expected_prop <- expected_prop / sum(expected_prop)
      }
      expected_counts <- expected_prop * n_total

      plot_long <- rbind(
        data.frame(
          category = factor(categories, levels = categories),
          series = "Observed",
          proportion = observed_prop,
          count = observed_counts,
          stringsAsFactors = FALSE
        ),
        data.frame(
          category = factor(categories, levels = categories),
          series = "Expected",
          proportion = expected_prop,
          count = expected_counts,
          stringsAsFactors = FALSE
        )
      )

      gof <- one_value_summary$chisq_gof
      if (is.null(gof) && !is.null(result_list$chisq_gof)) gof <- result_list$chisq_gof
      chi_sq <- suppressWarnings(as.numeric(gof$statistic))
      gof_df <- suppressWarnings(as.numeric(gof$df))
      p_value_fmt <- safe_text(gof$formatted_p, fmt_p_value(suppressWarnings(as.numeric(gof$p_value))))
      proportions_note <- safe_text(one_value_summary$proportions_note, "")
      if (identical(proportions_note, "N/A")) proportions_note <- ""

      delta_prop <- observed_prop - expected_prop
      ord <- order(abs(delta_prop), decreasing = TRUE)
      top_k <- min(3, length(ord))
      deviation_text <- ""
      if (top_k > 0) {
        top_idx <- ord[seq_len(top_k)]
        deviation_text <- paste(
          sprintf(
            "%s (%+0.1f pp)",
            categories[top_idx],
            delta_prop[top_idx] * 100
          ),
          collapse = ", "
        )
      }

      caption_parts <- c(
        sprintf(
          "Chi-square goodness-of-fit: X2 = %s, df = %s, p = %s (alpha = %s), n = %d.",
          fmt_num(chi_sq, 3),
          fmt_num(gof_df, 3),
          p_value_fmt,
          fmt_num(alpha_level, 3),
          as.integer(n_total)
        )
      )
      if (nzchar(deviation_text)) {
        caption_parts <- c(caption_parts, paste0("Largest observed-expected deviations: ", deviation_text, "."))
      }
      if (nzchar(proportions_note)) {
        caption_parts <- c(caption_parts, proportions_note)
      }
      caption_text <- paste(caption_parts, collapse = "  ")

      dodge_w <- 0.72
      active_series <- c()
      if (isTRUE(show_observed_series)) active_series <- c(active_series, "Observed")
      if (isTRUE(show_expected_series)) active_series <- c(active_series, "Expected")
      if (length(active_series) == 0) active_series <- "Observed"

      plot_long_active <- plot_long[plot_long$series %in% active_series, , drop = FALSE]
      fill_map <- c()
      if ("Observed" %in% active_series) fill_map["Observed"] <- one_value_primary_fill_color
      if ("Expected" %in% active_series) fill_map["Expected"] <- one_value_secondary_fill_color

      p <- ggplot2::ggplot(plot_long_active, ggplot2::aes(x = category, y = proportion, fill = series))
      if (isTRUE(show_bars)) {
        p <- p + ggplot2::geom_col(
          position = ggplot2::position_dodge(width = dodge_w),
          width = 0.62,
          color = one_value_bar_border_color,
          alpha = 0.9
        )
      }
      if (isTRUE(show_bar_labels) && ("Observed" %in% active_series)) {
        p <- p + ggplot2::geom_text(
          data = plot_long_active[plot_long_active$series == "Observed", , drop = FALSE],
          ggplot2::aes(label = sprintf("%.1f%%", proportion * 100), group = series),
          position = ggplot2::position_dodge(width = dodge_w),
          vjust = -0.48,
          size = 3.35,
          color = one_value_label_text_color,
          fontface = "bold"
        )
      }
      p <- p +
        ggplot2::scale_fill_manual(values = fill_map, drop = FALSE) +
        ggplot2::scale_y_continuous(
          labels = function(y) paste0(round(y * 100), "%"),
          expand = ggplot2::expansion(mult = c(0, 0.16))
        ) +
        ggplot2::labs(
          title = paste("Chi-square Goodness-of-Fit:", variable_name),
          subtitle = sprintf("Observed vs expected category proportions | n = %d", n_total),
          x = variable_name,
          y = "Proportion",
          fill = if (isTRUE(show_legend) && length(active_series) > 1) "" else NULL,
          caption = if (isTRUE(show_caption)) caption_text else NULL
        ) +
        ggplot2::theme_minimal(base_size = 13) +
        ggplot2::theme(
          plot.title = ggplot2::element_text(face = "bold", size = 15),
          plot.subtitle = ggplot2::element_text(size = 11.5, color = one_value_subtitle_color),
          plot.caption = ggplot2::element_text(size = 9.3, hjust = 0, color = one_value_caption_color),
          axis.title = ggplot2::element_text(face = "bold"),
          axis.text.x = ggplot2::element_text(angle = if (max(nchar(categories)) > 10) 22 else 0, hjust = 1),
          panel.grid.minor = ggplot2::element_blank(),
          panel.background = ggplot2::element_rect(fill = "#ffffff", color = NA),
          plot.background = ggplot2::element_rect(fill = "#ffffff", color = NA),
          legend.position = if (isTRUE(show_legend) && length(active_series) > 1) "top" else "none"
        )

      custom_ggsave(output_path, plot = p, plot_key = "one_value_plot", width = 12.0, height = 8.1, dpi = 320, device = "png")
    } else {
      stop(sprintf("Unsupported one-value data type for publication plot: %s", data_type))
    }

    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0("Failed to generate one-value publication plot image: ", plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = "Failed to generate one-value publication plot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_three_group_publication_plot <- function(data, group_var, response_var, result_list, base_output_image, alpha_level = 0.05) {
  if (!(group_var %in% colnames(data)) || !(response_var %in% colnames(data))) {
    return(list(generated = FALSE, path = NULL, error = "Three-group publication plot could not be generated: missing group/response columns."))
  }
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "Three-group publication plot requires ggplot2."))
  }

  plot_df <- data[, c(group_var, response_var), drop = FALSE]
  colnames(plot_df) <- c("group", "value")
  plot_df$value <- suppressWarnings(as.numeric(as.character(plot_df$value)))
  plot_df <- plot_df[!is.na(plot_df$group) & is.finite(plot_df$value), , drop = FALSE]
  if (nrow(plot_df) < 6) {
    return(list(generated = FALSE, path = NULL, error = "Three-group publication plot needs at least 6 finite observations."))
  }

  plot_df$group <- as.factor(as.character(plot_df$group))
  group_levels <- levels(plot_df$group)
  if (length(group_levels) < 3) {
    return(list(generated = FALSE, path = NULL, error = "Three-group publication plot requires at least 3 groups."))
  }
  ci_level <- resolve_conf_level_from_alpha(alpha_level)
  ci_prob <- (1 + ci_level) / 2

  output_path <- gsub("\\.png$", "_three_group_publication.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_three_group_publication.png")
  }

  fmt_num <- function(v, digits = 3) {
    num <- suppressWarnings(as.numeric(v[1]))
    if (!is.finite(num)) return("N/A")
    format(round(num, digits), nsmall = digits)
  }

  safe_text <- function(v, fallback = "N/A") {
    if (is.null(v) || length(v) == 0) return(fallback)
    txt <- trimws(as.character(v[1]))
    if (nzchar(txt)) txt else fallback
  }

  summary_rows <- lapply(group_levels, function(g) {
    vals <- plot_df$value[plot_df$group == g]
    vals <- vals[is.finite(vals)]
    n <- length(vals)
    if (n == 0) return(NULL)
    m <- mean(vals, na.rm = TRUE)
    s <- if (n > 1) sd(vals, na.rm = TRUE) else NA_real_
    med <- median(vals, na.rm = TRUE)
    q1 <- as.numeric(stats::quantile(vals, probs = 0.25, na.rm = TRUE, names = FALSE, type = 7))
    q3 <- as.numeric(stats::quantile(vals, probs = 0.75, na.rm = TRUE, names = FALSE, type = 7))
    se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
    t_crit <- if (n > 1) stats::qt(ci_prob, df = n - 1) else NA_real_
    ci_half <- if (is.finite(se) && is.finite(t_crit)) se * t_crit else NA_real_
    ci_low <- if (is.finite(ci_half)) m - ci_half else m
    ci_up <- if (is.finite(ci_half)) m + ci_half else m
    list(
      group = as.character(g),
      n = as.numeric(n),
      mean = as.numeric(m),
      sd = as.numeric(s),
      median = as.numeric(med),
      q1 = as.numeric(q1),
      q3 = as.numeric(q3),
      ci_low = as.numeric(ci_low),
      ci_up = as.numeric(ci_up)
    )
  })
  summary_rows <- Filter(Negate(is.null), summary_rows)
  if (length(summary_rows) < 3) {
    return(list(generated = FALSE, path = NULL, error = "Three-group publication plot could not compute group summaries."))
  }

  summary_df <- data.frame(
    group = factor(sapply(summary_rows, function(r) r$group), levels = group_levels),
    n = as.numeric(sapply(summary_rows, function(r) r$n)),
    mean = as.numeric(sapply(summary_rows, function(r) r$mean)),
    sd = as.numeric(sapply(summary_rows, function(r) r$sd)),
    median = as.numeric(sapply(summary_rows, function(r) r$median)),
    q1 = as.numeric(sapply(summary_rows, function(r) r$q1)),
    q3 = as.numeric(sapply(summary_rows, function(r) r$q3)),
    ci_low = as.numeric(sapply(summary_rows, function(r) r$ci_low)),
    ci_up = as.numeric(sapply(summary_rows, function(r) r$ci_up)),
    stringsAsFactors = FALSE
  )

  test_name <- "One-way group comparison"
  stat_label <- "Statistic"
  stat_value <- NA_real_
  p_fmt <- "N/A"
  df_text <- ""
  effect_line <- ""

  if (!is.null(result_list$anova)) {
    an <- result_list$anova
    test_type <- tolower(safe_text(an$test_type, "standard"))
    test_name <- if (grepl("welch", test_type, ignore.case = TRUE)) "Welch One-Way ANOVA" else "One-Way ANOVA"
    stat_label <- "F"
    stat_value <- suppressWarnings(as.numeric(an$statistic))
    p_fmt <- safe_text(an$formatted_p, fmt_p_value(suppressWarnings(as.numeric(an$p_value))))
    df1 <- suppressWarnings(as.numeric(if (!is.null(an$df_between)) an$df_between else an$df1))
    df2 <- suppressWarnings(as.numeric(if (!is.null(an$df_within)) an$df_within else an$df2))
    if (is.finite(df1) || is.finite(df2)) {
      df_text <- paste0(
        " | df = ",
        if (is.finite(df1)) fmt_num(df1, 3) else "N/A",
        ", ",
        if (is.finite(df2)) fmt_num(df2, 3) else "N/A"
      )
    }
    eta_val <- suppressWarnings(as.numeric(if (!is.null(an$eta_squared)) an$eta_squared else an$effect_size))
    if (is.finite(eta_val)) {
      effect_line <- sprintf("Eta-squared = %s (%s)", fmt_num(eta_val, 3), safe_text(an$effect_size_label, "effect size"))
    }
  } else if (!is.null(result_list$kruskal)) {
    kw <- result_list$kruskal
    test_name <- "Kruskal-Wallis"
    stat_label <- "Chi-squared"
    stat_value <- suppressWarnings(as.numeric(kw$statistic))
    p_fmt <- safe_text(kw$formatted_p, fmt_p_value(suppressWarnings(as.numeric(kw$p_value))))
    df_kw <- suppressWarnings(as.numeric(kw$df))
    if (is.finite(df_kw)) {
      df_text <- paste0(" | df = ", fmt_num(df_kw, 3))
    }
    eps_val <- suppressWarnings(as.numeric(kw$epsilon_squared))
    if (is.finite(eps_val)) {
      effect_line <- sprintf("Epsilon-squared = %s (%s)", fmt_num(eps_val, 3), safe_text(kw$effect_size_label, "effect size"))
    }
  }

  subtitle_text <- sprintf("%s | %s = %s%s | p = %s", test_name, stat_label, fmt_num(stat_value, 3), df_text, p_fmt)

  caption_group_lines <- apply(summary_df, 1, function(row) {
    sprintf(
      "%s: n=%d | mean +- SD=%s +- %s | median [Q1,Q3]=%s [%s,%s]",
      as.character(row[["group"]]),
      as.integer(as.numeric(row[["n"]])),
      fmt_num(as.numeric(row[["mean"]]), 3),
      fmt_num(as.numeric(row[["sd"]]), 3),
      fmt_num(as.numeric(row[["median"]]), 3),
      fmt_num(as.numeric(row[["q1"]]), 3),
      fmt_num(as.numeric(row[["q3"]]), 3)
    )
  })

  caption_parts <- c(
    caption_group_lines,
    sprintf("Inference: %s (%s = %s%s, p = %s, alpha = %s).", test_name, stat_label, fmt_num(stat_value, 3), df_text, p_fmt, fmt_num(alpha_level, 3))
  )

  annotation_lines <- c(
    sprintf("groups = %d", length(group_levels)),
    sprintf("n = %d", nrow(plot_df)),
    sprintf("%s = %s%s", stat_label, fmt_num(stat_value, 3), df_text),
    sprintf("p = %s", p_fmt)
  )

  group_fill_values <- get_level_color_map(group_var, group_levels, pick_cols(length(group_levels)))
  group_color_intensity <- get_custom_plot_intensity("three_group_group_color_intensity", 1)
  group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
  box_border_color <- get_custom_plot_color("three_group_box_border_color", "#1f2937")
  outlier_color <- get_custom_plot_color("three_group_outlier_color", "#f59e0b")
  mean_overlay_color <- get_custom_plot_color("three_group_mean_overlay_color", "#dc2626")
  label_color <- get_custom_plot_color("three_group_label_color", "#0f172a")
  jitter_color <- NA_character_
  jitter_size <- get_custom_plot_point_size("three_group_jitter_size", 2.4)
  jitter_use_box_mode <- get_custom_plot_flag("three_group_jitter_use_box", FALSE)
  ci_point_color <- get_custom_plot_color("three_group_ci_point_color", mean_overlay_color)
  ci_errorbar_color <- get_custom_plot_color("three_group_ci_errorbar_color", "#334155")
  plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("three_group_publication_plot"))
  show_box <- resolve_plot_element_flag(plot_labels_cfg, "show_box", TRUE)
  show_raw_points <- resolve_plot_element_flag(plot_labels_cfg, "show_raw_points", TRUE)
  show_mean_ci <- resolve_plot_element_flag(plot_labels_cfg, "show_mean_ci", TRUE)
  show_mean_point <- resolve_plot_element_flag(plot_labels_cfg, "show_mean_point", TRUE)
  show_median <- resolve_plot_element_flag(plot_labels_cfg, "show_median", TRUE)
  show_annotation_panel <- resolve_plot_element_flag(plot_labels_cfg, "show_annotation_panel", TRUE)
  show_caption <- resolve_plot_element_flag(plot_labels_cfg, "show_caption", TRUE)
  show_effect_line <- resolve_plot_element_flag(plot_labels_cfg, "show_effect_line", TRUE)
  show_posthoc_letters <- resolve_plot_element_flag(plot_labels_cfg, "show_posthoc_letters", TRUE)

  use_jitter_override <- FALSE
  if (!isTRUE(jitter_use_box_mode)) {
    jitter_color_override <- plot_colors_list[["three_group_jitter_color"]]
    if (!is.null(jitter_color_override)) {
      jitter_color_candidate <- trimws(as.character(jitter_color_override[1]))
      if (is_valid_color_value(jitter_color_candidate)) {
        jitter_color <- jitter_color_candidate
        use_jitter_override <- TRUE
      }
    }
  }
  if (!is_valid_color_value(ci_point_color)) ci_point_color <- mean_overlay_color
  if (!is_valid_color_value(ci_errorbar_color)) ci_errorbar_color <- "#334155"
  show_effect_line <- isTRUE(show_effect_line) && nzchar(effect_line)

  y_vals <- plot_df$value
  y_range <- range(y_vals, na.rm = TRUE)
  y_span <- diff(y_range)
  if (!is.finite(y_span) || y_span <= 0) y_span <- max(abs(y_range), na.rm = TRUE)
  if (!is.finite(y_span) || y_span <= 0) y_span <- 1
  max_ci <- max(summary_df$ci_up, na.rm = TRUE)
  if (!is.finite(max_ci)) max_ci <- max(y_vals, na.rm = TRUE)
  if (!is.finite(max_ci)) max_ci <- 1

  parse_pair_from_comparison <- function(comparison_text, known_groups) {
    if (is.null(comparison_text) || length(comparison_text) == 0) {
      return(c(NA_character_, NA_character_))
    }
    txt <- trimws(as.character(comparison_text[1]))
    if (!nzchar(txt)) return(c(NA_character_, NA_character_))

    try_split <- function(pattern) {
      parts <- strsplit(txt, pattern, perl = TRUE)[[1]]
      if (length(parts) != 2) return(c(NA_character_, NA_character_))
      g1 <- trimws(parts[1])
      g2 <- trimws(parts[2])
      if (g1 %in% known_groups && g2 %in% known_groups && g1 != g2) return(c(g1, g2))
      c(NA_character_, NA_character_)
    }

    split_dash <- try_split("\\s+-\\s+")
    if (all(!is.na(split_dash))) return(split_dash)
    split_vs <- try_split("\\s+vs\\.?\\s+")
    if (all(!is.na(split_vs))) return(split_vs)

    matched <- known_groups[vapply(known_groups, function(g) grepl(g, txt, fixed = TRUE), logical(1))]
    matched <- unique(as.character(matched))
    if (length(matched) >= 2) return(matched[1:2])
    c(NA_character_, NA_character_)
  }

  extract_rows <- function(x) {
    if (is.null(x)) return(list())
    if (is.data.frame(x)) return(split(x, seq_len(nrow(x))))
    if (is.list(x)) return(x)
    list()
  }

  p_matrix <- matrix(1, nrow = length(group_levels), ncol = length(group_levels), dimnames = list(group_levels, group_levels))
  diag(p_matrix) <- 0
  has_posthoc_pairs <- FALSE

  register_pair <- function(g1, g2, p_value = NA_real_, is_sig = NA) {
    if (!(g1 %in% group_levels) || !(g2 %in% group_levels) || identical(g1, g2)) return(invisible(NULL))
    effective_p <- p_value
    if (!is.finite(effective_p)) {
      if (is.logical(is_sig) && length(is_sig) > 0 && !is.na(is_sig[1])) {
        effective_p <- if (isTRUE(is_sig[1])) 0 else 1
      } else {
        effective_p <- 1
      }
    }
    effective_p <- max(0, min(1, as.numeric(effective_p)))
    p_matrix[g1, g2] <<- effective_p
    p_matrix[g2, g1] <<- effective_p
    has_posthoc_pairs <<- TRUE
    invisible(NULL)
  }

  collect_posthoc_rows <- function(rows) {
    for (row_item in rows) {
      row_cfg <- to_plain_list(row_item)
      if (length(row_cfg) == 0) next
      g1 <- if (!is.null(row_cfg$group1)) trimws(as.character(row_cfg$group1[1])) else NA_character_
      g2 <- if (!is.null(row_cfg$group2)) trimws(as.character(row_cfg$group2[1])) else NA_character_
      if (!is.finite(match(g1, group_levels)) || !is.finite(match(g2, group_levels)) || identical(g1, g2)) {
        parsed <- parse_pair_from_comparison(row_cfg$comparison, group_levels)
        g1 <- parsed[1]
        g2 <- parsed[2]
      }
      p_adj <- suppressWarnings(as.numeric(if (!is.null(row_cfg$p_adj)) row_cfg$p_adj else if (!is.null(row_cfg$p_value)) row_cfg$p_value else NA_real_))
      is_sig <- NA
      if (!is.null(row_cfg$is_significant) && length(row_cfg$is_significant) > 0) {
        sig_txt <- tolower(trimws(as.character(row_cfg$is_significant[1])))
        if (sig_txt %in% c("true", "t", "1", "yes", "y")) is_sig <- TRUE
        if (sig_txt %in% c("false", "f", "0", "no", "n")) is_sig <- FALSE
      }
      register_pair(g1, g2, p_value = p_adj, is_sig = is_sig)
    }
    invisible(NULL)
  }

  tukey_rows_source <- if (!is.null(result_list$tukey_all)) result_list$tukey_all else result_list$tukey
  collect_posthoc_rows(extract_rows(tukey_rows_source))
  collect_posthoc_rows(extract_rows(result_list$games_howell))
  collect_posthoc_rows(extract_rows(result_list$dunn))

  posthoc_letters_df <- NULL
  if (isTRUE(show_posthoc_letters) && isTRUE(has_posthoc_pairs) && requireNamespace("multcompView", quietly = TRUE)) {
    letters_map <- tryCatch(multcompView::multcompLetters(p_matrix < alpha_level)$Letters, error = function(e) NULL)
    if (!is.null(letters_map)) {
      whiskers_df <- aggregate(
        value ~ group,
        data = plot_df,
        FUN = function(x) as.numeric(grDevices::boxplot.stats(x)$stats[5])
      )
      posthoc_letters_df <- data.frame(
        group = factor(names(letters_map), levels = group_levels),
        letter = as.character(letters_map),
        stringsAsFactors = FALSE
      )
      posthoc_letters_df <- merge(
        posthoc_letters_df,
        whiskers_df,
        by = "group",
        all.x = TRUE
      )
      posthoc_letters_df$y <- as.numeric(posthoc_letters_df$value) + max(y_span * 0.05, 0.05)
      posthoc_letters_df <- posthoc_letters_df[is.finite(posthoc_letters_df$y), , drop = FALSE]
    }
  }
  show_posthoc_letters <- isTRUE(show_posthoc_letters) && !is.null(posthoc_letters_df) && nrow(posthoc_letters_df) > 0

  if (isTRUE(show_effect_line) && nzchar(effect_line)) {
    caption_parts <- c(caption_parts, effect_line)
    annotation_lines <- c(annotation_lines, effect_line)
  }
  if (isTRUE(show_posthoc_letters)) {
    caption_parts <- c(caption_parts, "Compact letters: groups sharing a letter are not significantly different (adjusted post-hoc comparisons).")
    annotation_lines <- c(annotation_lines, "post-hoc letters = shown")
  }
  caption_text <- paste(caption_parts, collapse = "  ")

  y_annotation <- max_ci + y_span * 0.10
  if (isTRUE(show_posthoc_letters) && !is.null(posthoc_letters_df)) {
    top_letter <- suppressWarnings(max(posthoc_letters_df$y, na.rm = TRUE))
    if (is.finite(top_letter)) {
      y_annotation <- max(y_annotation, top_letter + y_span * 0.08)
    }
  }

  plot_error <- NULL
  ok <- tryCatch({
    p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = group, y = value, fill = group))

    if (isTRUE(show_box)) {
      p <- p + ggplot2::geom_boxplot(
        width = 0.56,
        alpha = 0.78,
        outlier.alpha = 0.28,
        color = box_border_color,
        outlier.colour = outlier_color
      )
    }

    if (isTRUE(show_raw_points)) {
      if (use_jitter_override) {
        p <- p +
          ggplot2::geom_jitter(
            color = jitter_color,
            position = stable_jitter_position(width = 0.14, height = 0, seed = 202603021L),
            shape = 16,
            alpha = 1.0,
            size = jitter_size,
            show.legend = FALSE
          )
      } else {
        p <- p +
          ggplot2::geom_jitter(
            ggplot2::aes(color = group),
            position = stable_jitter_position(width = 0.14, height = 0, seed = 202603021L),
            shape = 16,
            alpha = 1.0,
            size = jitter_size,
            show.legend = FALSE
          )
      }
    }

    if (isTRUE(show_mean_ci)) {
      p <- p + ggplot2::geom_errorbar(
        data = summary_df,
        ggplot2::aes(x = group, ymin = ci_low, ymax = ci_up),
        inherit.aes = FALSE,
        width = 0.09,
        linewidth = 0.9,
        color = ci_errorbar_color
      )
    }

    if (isTRUE(show_mean_point)) {
      p <- p + ggplot2::geom_point(
        data = summary_df,
        ggplot2::aes(x = group, y = mean),
        inherit.aes = FALSE,
        shape = 23,
        fill = ci_point_color,
        color = "white",
        stroke = 0.28,
        size = 3.2
      )
    }

    if (isTRUE(show_median)) {
      p <- p + ggplot2::geom_point(
        data = summary_df,
        ggplot2::aes(x = group, y = median),
        inherit.aes = FALSE,
        shape = 95,
        size = 9,
        color = "#0f766e"
      )
    }

    if (isTRUE(show_posthoc_letters)) {
      p <- p + ggplot2::geom_text(
        data = posthoc_letters_df,
        ggplot2::aes(x = group, y = y, label = letter),
        inherit.aes = FALSE,
        vjust = -0.15,
        size = 4.3,
        fontface = "bold",
        color = label_color
      )
    }

    p <- p +
      ggplot2::scale_fill_manual(values = group_fill_values, drop = FALSE) +
      ggplot2::scale_color_manual(values = group_fill_values, drop = FALSE) +
      ggplot2::expand_limits(y = y_annotation + y_span * 0.12) +
      ggplot2::labs(
        title = paste("Publication Plot (One-Way):", response_var),
        subtitle = subtitle_text,
        x = group_var,
        y = response_var,
        caption = if (isTRUE(show_caption)) caption_text else NULL
      ) +
      ggplot2::theme_minimal(base_size = 13) +
      ggplot2::theme(
        plot.title = ggplot2::element_text(face = "bold", size = 15),
        plot.subtitle = ggplot2::element_text(size = 11.5, color = "#334155"),
        plot.caption = ggplot2::element_text(size = 9.2, hjust = 0, color = "#475569"),
        axis.title = ggplot2::element_text(face = "bold"),
        panel.grid.minor = ggplot2::element_blank(),
        legend.position = "none"
      )

    if (isTRUE(show_annotation_panel)) {
      p <- p +
        ggplot2::annotate(
          "label",
          x = Inf,
          y = Inf,
          label = paste(annotation_lines, collapse = "\n"),
          hjust = 1.03,
          vjust = 1.03,
          size = 3.25,
          linewidth = 0.18,
          label.padding = grid::unit(0.20, "lines"),
          fill = grDevices::adjustcolor("#ffffff", alpha.f = 0.90),
          color = label_color
        )
    }

    custom_ggsave(output_path, plot = p, plot_key = "three_group_publication_plot", width = 12.0, height = 8.4, dpi = 320, device = "png")
    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0("Failed to generate three-group publication plot image: ", plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = "Failed to generate three-group publication plot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_two_group_publication_plot <- function(data, group_var, response_var, result_list, base_output_image, alpha_level = 0.05, is_paired = FALSE, subject_var = NULL) {
  if (!(group_var %in% colnames(data)) || !(response_var %in% colnames(data))) {
    return(list(generated = FALSE, path = NULL, error = "Two-group publication plot could not be generated: missing group/response columns."))
  }
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "Two-group publication plot requires ggplot2."))
  }

  plot_df <- data[, c(group_var, response_var), drop = FALSE]
  colnames(plot_df) <- c("group", "value")
  plot_df$value <- suppressWarnings(as.numeric(as.character(plot_df$value)))
  plot_df <- plot_df[!is.na(plot_df$group) & is.finite(plot_df$value), , drop = FALSE]
  if (nrow(plot_df) < 4) {
    return(list(generated = FALSE, path = NULL, error = "Two-group publication plot needs at least 4 finite observations."))
  }

  plot_df$group <- as.factor(as.character(plot_df$group))
  group_levels <- levels(plot_df$group)
  if (length(group_levels) != 2) {
    return(list(generated = FALSE, path = NULL, error = "Two-group publication plot requires exactly 2 groups."))
  }
  ci_level <- resolve_conf_level_from_alpha(alpha_level)
  ci_prob <- (1 + ci_level) / 2
  ci_percent <- as.integer(round(ci_level * 100))

  output_path <- gsub("\\.png$", "_two_group_publication.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_two_group_publication.png")
  }

  fmt_num <- function(v, digits = 3) {
    num <- suppressWarnings(as.numeric(v[1]))
    if (!is.finite(num)) return("N/A")
    format(round(num, digits), nsmall = digits)
  }

  safe_text <- function(v, fallback = "N/A") {
    if (is.null(v) || length(v) == 0) return(fallback)
    txt <- trimws(as.character(v[1]))
    if (nzchar(txt)) txt else fallback
  }

  build_paired_dataset <- function() {
    subject_name <- if (!is.null(subject_var) && length(subject_var) > 0) trimws(as.character(subject_var[1])) else ""

    # Preferred: pair using explicit subject IDs when available.
    if (nzchar(subject_name) && subject_name %in% colnames(data)) {
      pair_df <- data[, c(subject_name, group_var, response_var), drop = FALSE]
      colnames(pair_df) <- c("pair_id", "group", "value")
      pair_df$pair_id <- as.character(pair_df$pair_id)
      pair_df$group <- as.character(pair_df$group)
      pair_df$value <- suppressWarnings(as.numeric(as.character(pair_df$value)))
      pair_df <- pair_df[
        !is.na(pair_df$pair_id) & pair_df$pair_id != "" &
          pair_df$group %in% group_levels &
          is.finite(pair_df$value),
        ,
        drop = FALSE
      ]

      if (nrow(pair_df) > 0) {
        pair_agg <- stats::aggregate(value ~ pair_id + group, data = pair_df, FUN = mean)
        pair_wide <- reshape(pair_agg, idvar = "pair_id", timevar = "group", direction = "wide")
        col_a <- paste0("value.", group_levels[1])
        col_b <- paste0("value.", group_levels[2])
        if (col_a %in% colnames(pair_wide) && col_b %in% colnames(pair_wide)) {
          pair_wide <- pair_wide[
            stats::complete.cases(pair_wide[, c(col_a, col_b), drop = FALSE]),
            c("pair_id", col_a, col_b),
            drop = FALSE
          ]
          if (nrow(pair_wide) >= 2) {
            pair_long <- rbind(
              data.frame(
                pair_id = pair_wide$pair_id,
                group = factor(rep(group_levels[1], nrow(pair_wide)), levels = group_levels),
                value = as.numeric(pair_wide[[col_a]]),
                stringsAsFactors = FALSE
              ),
              data.frame(
                pair_id = pair_wide$pair_id,
                group = factor(rep(group_levels[2], nrow(pair_wide)), levels = group_levels),
                value = as.numeric(pair_wide[[col_b]]),
                stringsAsFactors = FALSE
              )
            )
            return(list(
              ok = TRUE,
              method = "subject",
              pair_n = nrow(pair_wide),
              long = pair_long,
              diff = as.numeric(pair_wide[[col_a]] - pair_wide[[col_b]]),
              note = ""
            ))
          }
        }
      }
    }

    # Fallback: pair by row order within each group (matches current paired test fallback).
    x_a <- plot_df$value[plot_df$group == group_levels[1]]
    x_b <- plot_df$value[plot_df$group == group_levels[2]]
    n_pairs <- min(length(x_a), length(x_b))
    if (n_pairs >= 2) {
      pair_wide <- data.frame(
        pair_id = paste0("pair_", seq_len(n_pairs)),
        value_a = x_a[seq_len(n_pairs)],
        value_b = x_b[seq_len(n_pairs)],
        stringsAsFactors = FALSE
      )
      pair_long <- rbind(
        data.frame(
          pair_id = pair_wide$pair_id,
          group = factor(rep(group_levels[1], n_pairs), levels = group_levels),
          value = pair_wide$value_a,
          stringsAsFactors = FALSE
        ),
        data.frame(
          pair_id = pair_wide$pair_id,
          group = factor(rep(group_levels[2], n_pairs), levels = group_levels),
          value = pair_wide$value_b,
          stringsAsFactors = FALSE
        )
      )
      return(list(
        ok = TRUE,
        method = "row_order",
        pair_n = n_pairs,
        long = pair_long,
        diff = as.numeric(pair_wide$value_a - pair_wide$value_b),
        note = "Pairs were matched by within-group row order (subject ID unavailable or incomplete)."
      ))
    }

    list(
      ok = FALSE,
      method = NULL,
      pair_n = 0,
      long = NULL,
      diff = numeric(0),
      note = "Paired overlay unavailable: fewer than 2 matched pairs."
    )
  }

  summary_rows <- lapply(group_levels, function(g) {
    vals <- plot_df$value[plot_df$group == g]
    vals <- vals[is.finite(vals)]
    n <- length(vals)
    if (n == 0) return(NULL)
    m <- mean(vals, na.rm = TRUE)
    s <- if (n > 1) sd(vals, na.rm = TRUE) else NA_real_
    med <- median(vals, na.rm = TRUE)
    q1 <- as.numeric(stats::quantile(vals, probs = 0.25, na.rm = TRUE, names = FALSE, type = 7))
    q3 <- as.numeric(stats::quantile(vals, probs = 0.75, na.rm = TRUE, names = FALSE, type = 7))
    se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
    t_crit <- if (n > 1) stats::qt(ci_prob, df = n - 1) else NA_real_
    ci_half <- if (is.finite(se) && is.finite(t_crit)) se * t_crit else NA_real_
    ci_low <- if (is.finite(ci_half)) m - ci_half else m
    ci_up <- if (is.finite(ci_half)) m + ci_half else m
    list(
      group = as.character(g),
      n = as.numeric(n),
      mean = as.numeric(m),
      sd = as.numeric(s),
      median = as.numeric(med),
      q1 = as.numeric(q1),
      q3 = as.numeric(q3),
      ci_low = as.numeric(ci_low),
      ci_up = as.numeric(ci_up)
    )
  })
  summary_rows <- Filter(Negate(is.null), summary_rows)
  if (length(summary_rows) != 2) {
    return(list(generated = FALSE, path = NULL, error = "Two-group publication plot could not compute group summaries."))
  }

  summary_df <- data.frame(
    group = factor(sapply(summary_rows, function(r) r$group), levels = group_levels),
    n = as.numeric(sapply(summary_rows, function(r) r$n)),
    mean = as.numeric(sapply(summary_rows, function(r) r$mean)),
    sd = as.numeric(sapply(summary_rows, function(r) r$sd)),
    median = as.numeric(sapply(summary_rows, function(r) r$median)),
    q1 = as.numeric(sapply(summary_rows, function(r) r$q1)),
    q3 = as.numeric(sapply(summary_rows, function(r) r$q3)),
    ci_low = as.numeric(sapply(summary_rows, function(r) r$ci_low)),
    ci_up = as.numeric(sapply(summary_rows, function(r) r$ci_up)),
    stringsAsFactors = FALSE
  )

  test_kind <- "unknown"
  test_name <- "Two-group comparison"
  stat_label <- "Statistic"
  stat_value <- NA_real_
  df_value <- NA_real_
  p_fmt <- "N/A"
  effect_line <- ""
  diff_line <- ""
  subtitle_text <- sprintf("%s vs %s", group_levels[1], group_levels[2])
  paired_overlay <- FALSE
  paired_method <- NULL
  paired_n <- NA_integer_
  paired_summary_line <- ""
  paired_note <- ""
  paired_mean_diff <- NA_real_
  paired_long_df <- NULL

  if (!is.null(result_list$ttest)) {
    test_kind <- "ttest"
    tt <- result_list$ttest
    test_name <- safe_text(tt$test_name, "t-test")
    stat_label <- "t"
    stat_value <- suppressWarnings(as.numeric(tt$statistic))
    df_value <- suppressWarnings(as.numeric(tt$df))
    p_fmt <- safe_text(tt$formatted_p, fmt_p_value(suppressWarnings(as.numeric(tt$p_value))))
    d_val <- suppressWarnings(as.numeric(tt$cohens_d))
    if (is.finite(d_val)) {
      effect_line <- sprintf("Cohen's d = %s (%s)", fmt_num(d_val, 3), safe_text(tt$effect_size, "effect size"))
    }
    md <- suppressWarnings(as.numeric(tt$mean_diff))
    cil <- suppressWarnings(as.numeric(tt$ci_lower))
    ciu <- suppressWarnings(as.numeric(tt$ci_upper))
    if (is.finite(md)) {
      diff_line <- sprintf("Mean difference = %s", fmt_num(md, 3))
      if (is.finite(cil) && is.finite(ciu)) {
        diff_line <- paste0(diff_line, sprintf(" [%d%% CI: %s, %s]", ci_percent, fmt_num(cil, 3), fmt_num(ciu, 3)))
      }
    }
    subtitle_text <- sprintf("%s | %s = %s, df = %s, p = %s", test_name, stat_label, fmt_num(stat_value, 3), fmt_num(df_value, 3), p_fmt)
  } else if (!is.null(result_list$mann_whitney)) {
    test_kind <- "mann_whitney"
    mw <- result_list$mann_whitney
    test_name <- safe_text(mw$test_name, "Mann-Whitney U Test")
    stat_label <- "U"
    stat_value <- suppressWarnings(as.numeric(mw$statistic))
    p_fmt <- safe_text(mw$formatted_p, fmt_p_value(suppressWarnings(as.numeric(mw$p_value))))
    rb <- suppressWarnings(as.numeric(mw$rank_biserial))
    if (is.finite(rb)) {
      effect_line <- sprintf("Rank-biserial r = %s (%s)", fmt_num(rb, 3), safe_text(mw$rank_biserial_effect, "effect size"))
    }
    subtitle_text <- sprintf("%s | %s = %s, p = %s", test_name, stat_label, fmt_num(stat_value, 3), p_fmt)
  } else if (!is.null(result_list$wilcoxon)) {
    test_kind <- "wilcoxon"
    wx <- result_list$wilcoxon
    test_name <- safe_text(wx$test_name, "Wilcoxon Signed-Rank Test")
    stat_label <- "V"
    stat_value <- suppressWarnings(as.numeric(wx$statistic))
    p_fmt <- safe_text(wx$formatted_p, fmt_p_value(suppressWarnings(as.numeric(wx$p_value))))
    rb <- suppressWarnings(as.numeric(wx$rank_biserial))
    if (is.finite(rb)) {
      effect_line <- sprintf("Rank-biserial r = %s (%s)", fmt_num(rb, 3), safe_text(wx$rank_biserial_effect, "effect size"))
    }
    subtitle_text <- sprintf("%s | %s = %s, p = %s", test_name, stat_label, fmt_num(stat_value, 3), p_fmt)
  } else {
    return(list(generated = FALSE, path = NULL, error = "Two-group publication plot requires t-test, Mann-Whitney, or Wilcoxon results."))
  }

  is_fallback_test <- grepl("fallback", test_name, ignore.case = TRUE)
  is_true_paired_test <- FALSE
  if (test_kind == "ttest") {
    is_true_paired_test <- grepl("paired", test_name, ignore.case = TRUE) && !is_fallback_test
  } else if (test_kind == "wilcoxon") {
    is_true_paired_test <- grepl("signed-rank", test_name, ignore.case = TRUE) && !is_fallback_test
  }
  if (isTRUE(is_paired) && !is_fallback_test && (test_kind %in% c("ttest", "wilcoxon"))) {
    is_true_paired_test <- TRUE
  }

  if (is_true_paired_test) {
    pair_info <- build_paired_dataset()
    if (isTRUE(pair_info$ok)) {
      paired_overlay <- TRUE
      paired_method <- pair_info$method
      paired_n <- as.integer(pair_info$pair_n)
      paired_long_df <- pair_info$long
      diffs <- as.numeric(pair_info$diff)
      diffs <- diffs[is.finite(diffs)]

      if (length(diffs) > 0) {
        paired_mean <- mean(diffs, na.rm = TRUE)
        paired_median <- median(diffs, na.rm = TRUE)
        paired_mean_diff <- as.numeric(paired_mean)
        ci_txt <- ""
        if (length(diffs) > 1) {
          sd_diff <- stats::sd(diffs, na.rm = TRUE)
          se_diff <- if (is.finite(sd_diff) && length(diffs) > 0) sd_diff / sqrt(length(diffs)) else NA_real_
          t_crit <- stats::qt(ci_prob, df = length(diffs) - 1)
          if (is.finite(se_diff) && is.finite(t_crit)) {
            ci_low <- paired_mean - t_crit * se_diff
            ci_up <- paired_mean + t_crit * se_diff
            ci_txt <- sprintf(" [%d%% CI: %s, %s]", ci_percent, fmt_num(ci_low, 3), fmt_num(ci_up, 3))
          }
        }
        paired_summary_line <- sprintf(
          "Paired difference (%s - %s): n_pairs=%d | mean=%s%s | median=%s",
          group_levels[1],
          group_levels[2],
          as.integer(length(diffs)),
          fmt_num(paired_mean, 3),
          ci_txt,
          fmt_num(paired_median, 3)
        )
      }
      if (!is.null(pair_info$note) && nzchar(pair_info$note)) {
        paired_note <- pair_info$note
      }
    } else if (!is.null(pair_info$note) && nzchar(pair_info$note)) {
      paired_note <- pair_info$note
    }
  }

  plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("two_group_publication_plot"))
  show_box <- resolve_plot_element_flag(plot_labels_cfg, "show_box", TRUE)
  show_raw_points <- resolve_plot_element_flag(plot_labels_cfg, "show_raw_points", TRUE)
  show_mean_ci <- resolve_plot_element_flag(plot_labels_cfg, "show_mean_ci", TRUE)
  show_mean_point <- resolve_plot_element_flag(plot_labels_cfg, "show_mean_point", TRUE)
  show_median <- resolve_plot_element_flag(plot_labels_cfg, "show_median", TRUE)
  show_violin_right <- resolve_plot_element_flag(plot_labels_cfg, "show_violin_right", FALSE)
  show_points_left <- resolve_plot_element_flag(plot_labels_cfg, "show_points_left", FALSE)
  show_violin_replace_box <- resolve_plot_element_flag(plot_labels_cfg, "show_violin_replace_box", FALSE)
  show_annotation_panel <- resolve_plot_element_flag(plot_labels_cfg, "show_annotation_panel", TRUE)
  show_caption <- resolve_plot_element_flag(plot_labels_cfg, "show_caption", TRUE)
  show_effect_line <- resolve_plot_element_flag(plot_labels_cfg, "show_effect_line", TRUE)
  show_difference_line <- resolve_plot_element_flag(plot_labels_cfg, "show_difference_line", TRUE)
  show_paired_overlay <- resolve_plot_element_flag(plot_labels_cfg, "show_paired_overlay", TRUE)
  show_pairing_details <- resolve_plot_element_flag(plot_labels_cfg, "show_pairing_details", TRUE)
  show_stat_guides_mean <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_mean", FALSE)
  show_stat_guides_median <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_median", FALSE)
  show_stat_guides_q1 <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_q1", FALSE)
  show_stat_guides_q3 <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_q3", FALSE)
  show_stat_guides_ci_low <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_ci_low", FALSE)
  show_stat_guides_ci_high <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_ci_high", FALSE)
  show_stat_guides_values <- resolve_plot_element_flag(plot_labels_cfg, "show_stat_guides_values", FALSE)

  show_effect_line <- isTRUE(show_effect_line) && nzchar(effect_line)
  show_difference_line <- isTRUE(show_difference_line) && nzchar(diff_line)
  show_paired_overlay <- isTRUE(show_paired_overlay) && isTRUE(paired_overlay) && !is.null(paired_long_df) && nrow(paired_long_df) > 0
  show_pairing_details <- isTRUE(show_pairing_details) && (nzchar(paired_summary_line) || nzchar(paired_note))
  use_violin_replace <- isTRUE(show_violin_replace_box)
  use_violin_side <- isTRUE(show_violin_right) && !isTRUE(use_violin_replace)

  g1 <- summary_df[1, ]
  g2 <- summary_df[2, ]
  group_1_line <- sprintf(
    "%s: n=%d | mean +- SD=%s +- %s | median [Q1,Q3]=%s [%s,%s]",
    as.character(g1$group),
    as.integer(g1$n),
    fmt_num(g1$mean, 3),
    fmt_num(g1$sd, 3),
    fmt_num(g1$median, 3),
    fmt_num(g1$q1, 3),
    fmt_num(g1$q3, 3)
  )
  group_2_line <- sprintf(
    "%s: n=%d | mean +- SD=%s +- %s | median [Q1,Q3]=%s [%s,%s]",
    as.character(g2$group),
    as.integer(g2$n),
    fmt_num(g2$mean, 3),
    fmt_num(g2$sd, 3),
    fmt_num(g2$median, 3),
    fmt_num(g2$q1, 3),
    fmt_num(g2$q3, 3)
  )
  caption_parts <- c(
    group_1_line,
    group_2_line,
    sprintf("Inference: %s (%s = %s%s, p = %s, alpha = %s).",
      test_name,
      stat_label,
      fmt_num(stat_value, 3),
      if (is.finite(df_value)) paste0(", df = ", fmt_num(df_value, 3)) else "",
      p_fmt,
      fmt_num(alpha_level, 3)
    )
  )
  if (isTRUE(show_difference_line)) caption_parts <- c(caption_parts, diff_line)
  if (isTRUE(show_effect_line)) caption_parts <- c(caption_parts, effect_line)
  if (isTRUE(show_pairing_details) && nzchar(paired_summary_line)) caption_parts <- c(caption_parts, paired_summary_line)
  if (isTRUE(show_pairing_details) && nzchar(paired_note)) caption_parts <- c(caption_parts, paired_note)
  caption_text <- paste(caption_parts, collapse = "  ")

  annotation_lines <- c(
    sprintf("%s = %s%s", stat_label, fmt_num(stat_value, 3), if (is.finite(df_value)) paste0(" | df=", fmt_num(df_value, 3)) else ""),
    sprintf("p = %s", p_fmt)
  )
  if (isTRUE(show_effect_line)) annotation_lines <- c(annotation_lines, effect_line)
  if (isTRUE(show_difference_line)) annotation_lines <- c(annotation_lines, diff_line)
  if (isTRUE(show_pairing_details) && paired_overlay && is.finite(paired_n)) {
    annotation_lines <- c(annotation_lines,
      sprintf(
        "paired n = %d (%s)",
        as.integer(paired_n),
        if (identical(paired_method, "subject")) "subject ID matching" else "row-order matching"
      )
    )
  }
  if (isTRUE(show_pairing_details) && is.finite(paired_mean_diff)) {
    annotation_lines <- c(annotation_lines, sprintf("paired mean diff = %s", fmt_num(paired_mean_diff, 3)))
  }
  if (isTRUE(show_pairing_details) && is_true_paired_test && !paired_overlay && nzchar(paired_note)) {
    annotation_lines <- c(annotation_lines, "paired overlay unavailable")
  }

  group_fill_values <- get_level_color_map(group_var, group_levels, pick_cols(length(group_levels)))
  group_color_intensity <- get_custom_plot_intensity("two_group_group_color_intensity", 1)
  group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
  point_color_value <- NA_character_
  use_point_color_override <- FALSE
  whisker_color_value <- "#334155"
  outlier_color_value <- "#f59e0b"
  mean_point_color_value <- "#dc2626"
  mean_ci_color_value <- "#dc2626"
  guide_mean_color_value <- "#2563eb"
  guide_median_color_value <- "#0f766e"
  guide_q1_color_value <- "#7c3aed"
  guide_q3_color_value <- "#ea580c"
  guide_ci_low_color_value <- "#0284c7"
  guide_ci_high_color_value <- "#0369a1"
  guide_line_type_value <- "dashed"
  guide_line_width_value <- 0.62
  point_size_value <- get_custom_plot_point_size("two_group_publication_point_size", 2.4)
  point_use_box_mode <- get_custom_plot_flag("two_group_publication_point_use_box", FALSE)
  if (!isTRUE(point_use_box_mode)) {
    point_color_override <- plot_colors_list[["two_group_publication_point_color"]]
    if (!is.null(point_color_override)) {
      point_color_candidate <- trimws(as.character(point_color_override[1]))
      if (is_valid_color_value(point_color_candidate)) {
        point_color_value <- point_color_candidate
        use_point_color_override <- TRUE
      }
    }
  }
  whisker_color_override <- plot_colors_list[["two_group_publication_whisker_color"]]
  if (!is.null(whisker_color_override)) {
    whisker_color_candidate <- trimws(as.character(whisker_color_override[1]))
    if (is_valid_color_value(whisker_color_candidate)) {
      whisker_color_value <- whisker_color_candidate
    }
  }
  outlier_color_override <- plot_colors_list[["two_group_publication_outlier_color"]]
  if (!is.null(outlier_color_override)) {
    outlier_color_candidate <- trimws(as.character(outlier_color_override[1]))
    if (is_valid_color_value(outlier_color_candidate)) {
      outlier_color_value <- outlier_color_candidate
    }
  }
  mean_point_color_override <- plot_colors_list[["two_group_publication_mean_point_color"]]
  if (!is.null(mean_point_color_override)) {
    mean_point_color_candidate <- trimws(as.character(mean_point_color_override[1]))
    if (is_valid_color_value(mean_point_color_candidate)) {
      mean_point_color_value <- mean_point_color_candidate
    }
  }
  mean_ci_color_override <- plot_colors_list[["two_group_publication_mean_ci_color"]]
  if (!is.null(mean_ci_color_override)) {
    mean_ci_color_candidate <- trimws(as.character(mean_ci_color_override[1]))
    if (is_valid_color_value(mean_ci_color_candidate)) {
      mean_ci_color_value <- mean_ci_color_candidate
    }
  }
  guide_mean_color_value <- get_custom_plot_color("two_group_publication_guide_mean_color", guide_mean_color_value)
  guide_median_color_value <- get_custom_plot_color("two_group_publication_guide_median_color", guide_median_color_value)
  guide_q1_color_value <- get_custom_plot_color("two_group_publication_guide_q1_color", guide_q1_color_value)
  guide_q3_color_value <- get_custom_plot_color("two_group_publication_guide_q3_color", guide_q3_color_value)
  guide_ci_low_color_value <- get_custom_plot_color("two_group_publication_guide_ci_low_color", guide_ci_low_color_value)
  guide_ci_high_color_value <- get_custom_plot_color("two_group_publication_guide_ci_high_color", guide_ci_high_color_value)
  guide_line_type_value <- get_custom_plot_line_type("two_group_publication_guide_line_type", guide_line_type_value)
  guide_line_width_value <- get_custom_plot_line_width("two_group_publication_guide_line_width", guide_line_width_value)
  y_vals <- plot_df$value
  y_range <- range(y_vals, na.rm = TRUE)
  y_span <- diff(y_range)
  if (!is.finite(y_span) || y_span <= 0) y_span <- max(abs(y_range), na.rm = TRUE)
  if (!is.finite(y_span) || y_span <= 0) y_span <- 1
  max_ci <- max(summary_df$ci_up, na.rm = TRUE)
  if (!is.finite(max_ci)) max_ci <- max(y_vals, na.rm = TRUE)
  if (!is.finite(max_ci)) max_ci <- 1
  y_annotation <- max_ci + y_span * 0.10
  box_width_value <- 0.56
  violin_width_value <- 0.48
  violin_nudge_value <- 0.22
  point_left_nudge_value <- -0.22
  if (isTRUE(use_violin_replace)) {
    box_width_value <- if (isTRUE(show_points_left)) 0.46 else 0.56
    violin_width_value <- if (isTRUE(show_points_left)) 0.52 else 0.62
    violin_nudge_value <- 0
    if (isTRUE(show_points_left)) point_left_nudge_value <- -0.24
  } else if (isTRUE(use_violin_side) && isTRUE(show_points_left)) {
    box_width_value <- 0.38
    violin_width_value <- 0.40
    violin_nudge_value <- 0.29
    point_left_nudge_value <- -0.29
  } else if (isTRUE(use_violin_side)) {
    box_width_value <- 0.46
    violin_width_value <- 0.44
    violin_nudge_value <- 0.24
  } else if (isTRUE(show_points_left)) {
    box_width_value <- 0.46
    point_left_nudge_value <- -0.24
  }

  plot_error <- NULL
  ok <- tryCatch({
    p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = group, y = value, fill = group))

    if (isTRUE(use_violin_replace) || isTRUE(use_violin_side)) {
      p <- p + ggplot2::geom_violin(
        data = plot_df,
        ggplot2::aes(x = group, y = value, fill = group),
        inherit.aes = FALSE,
        position = ggplot2::position_nudge(x = violin_nudge_value),
        width = violin_width_value,
        alpha = 0.24,
        trim = FALSE,
        color = whisker_color_value,
        linewidth = 0.34,
        show.legend = FALSE
      )
    }

    if (isTRUE(show_box) && !isTRUE(use_violin_replace)) {
      p <- p + ggplot2::geom_boxplot(
        width = box_width_value,
        alpha = 0.78,
        outlier.alpha = if (show_paired_overlay) 0.0 else 0.25,
        color = whisker_color_value,
        outlier.colour = outlier_color_value
      )
    }

    if (isTRUE(show_paired_overlay)) {
      point_nudge <- if (isTRUE(show_points_left)) point_left_nudge_value else 0
      p <- p +
        ggplot2::geom_line(
          data = paired_long_df,
          ggplot2::aes(x = group, y = value, group = pair_id),
          inherit.aes = FALSE,
          position = ggplot2::position_nudge(x = point_nudge),
          linewidth = 0.55,
          color = "#94a3b8",
          alpha = 0.68
        )
      if (isTRUE(show_raw_points)) {
        if (isTRUE(use_point_color_override)) {
          p <- p +
            ggplot2::geom_point(
              data = paired_long_df,
              ggplot2::aes(x = group, y = value),
              inherit.aes = FALSE,
              position = ggplot2::position_nudge(x = point_nudge),
              alpha = 1.0,
              size = point_size_value,
              stroke = 0,
              color = point_color_value,
              show.legend = FALSE
            )
        } else {
          p <- p +
            ggplot2::geom_point(
              data = paired_long_df,
              ggplot2::aes(x = group, y = value, color = group),
              inherit.aes = FALSE,
              position = ggplot2::position_nudge(x = point_nudge),
              shape = 16,
              alpha = 1.0,
              size = point_size_value,
              show.legend = FALSE
            )
        }
      }
    } else if (isTRUE(show_raw_points)) {
      if (isTRUE(show_points_left)) {
        if (isTRUE(use_point_color_override)) {
          p <- p +
            ggplot2::geom_point(
              data = plot_df,
              ggplot2::aes(x = group, y = value),
              inherit.aes = FALSE,
              position = ggplot2::position_nudge(x = point_left_nudge_value),
              color = point_color_value,
              alpha = 1.0,
              size = point_size_value,
              show.legend = FALSE
            )
        } else {
          p <- p +
            ggplot2::geom_point(
              data = plot_df,
              ggplot2::aes(x = group, y = value, color = group),
              inherit.aes = FALSE,
              position = ggplot2::position_nudge(x = point_left_nudge_value),
              shape = 16,
              alpha = 1.0,
              size = point_size_value,
              show.legend = FALSE
            )
        }
      } else {
        if (isTRUE(use_point_color_override)) {
          p <- p +
            ggplot2::geom_jitter(
              color = point_color_value,
              position = stable_jitter_position(width = 0.14, height = 0, seed = 202603022L),
              alpha = 1.0,
              size = point_size_value,
              show.legend = FALSE
            )
        } else {
          p <- p +
            ggplot2::geom_jitter(
              ggplot2::aes(color = group),
              position = stable_jitter_position(width = 0.14, height = 0, seed = 202603022L),
              shape = 16,
              alpha = 1.0,
              size = point_size_value,
              show.legend = FALSE
            )
        }
      }
    }

    if (isTRUE(show_mean_ci)) {
      p <- p + ggplot2::geom_errorbar(
        data = summary_df,
        ggplot2::aes(x = group, ymin = ci_low, ymax = ci_up),
        inherit.aes = FALSE,
        width = 0.08,
        linewidth = 0.9,
        color = mean_ci_color_value
      )
    }

    if (isTRUE(show_mean_point)) {
      p <- p + ggplot2::geom_point(
        data = summary_df,
        ggplot2::aes(x = group, y = mean),
        inherit.aes = FALSE,
        shape = 23,
        fill = mean_point_color_value,
        color = "white",
        stroke = 0.3,
        size = 3.1
      )
    }

    if (isTRUE(show_median)) {
      p <- p + ggplot2::geom_point(
        data = summary_df,
        ggplot2::aes(x = group, y = median),
        inherit.aes = FALSE,
        shape = 95,
        size = 10,
        color = "#0f766e"
      )
    }

    p <- add_box_to_axis_guides(
      p,
      summary_df = summary_df,
      group_levels = group_levels,
      y_span = y_span,
      box_width = box_width_value,
      show_mean = show_stat_guides_mean,
      show_median = show_stat_guides_median,
      show_q1 = show_stat_guides_q1,
      show_q3 = show_stat_guides_q3,
      show_ci_low = show_stat_guides_ci_low,
      show_ci_high = show_stat_guides_ci_high,
      show_values = show_stat_guides_values,
      mean_color = guide_mean_color_value,
      median_color = guide_median_color_value,
      q1_color = guide_q1_color_value,
      q3_color = guide_q3_color_value,
      ci_low_color = guide_ci_low_color_value,
      ci_high_color = guide_ci_high_color_value,
      line_type = guide_line_type_value,
      line_width = guide_line_width_value,
      value_digits = 3
    )

    p <- p +
      ggplot2::scale_fill_manual(values = group_fill_values, drop = FALSE) +
      ggplot2::scale_color_manual(values = group_fill_values, drop = FALSE) +
      ggplot2::expand_limits(y = y_annotation + y_span * 0.12) +
      ggplot2::labs(
        title = paste(if (is_true_paired_test) "Paired Two-Group Comparison:" else "Two-Group Comparison:", response_var),
        subtitle = subtitle_text,
        x = group_var,
        y = response_var,
        caption = if (isTRUE(show_caption)) caption_text else NULL
      ) +
      ggplot2::theme_minimal(base_size = 13) +
      ggplot2::theme(
        plot.title = ggplot2::element_text(face = "bold", size = 15),
        plot.subtitle = ggplot2::element_text(size = 11.5, color = "#334155"),
        plot.caption = ggplot2::element_text(size = 9.2, hjust = 0, color = "#475569"),
        axis.title = ggplot2::element_text(face = "bold"),
        panel.grid.minor = ggplot2::element_blank(),
        legend.position = "none"
      )

    if (isTRUE(show_annotation_panel)) {
      p <- p +
        ggplot2::annotate(
          "label",
          x = Inf,
          y = Inf,
          label = paste(annotation_lines, collapse = "\n"),
          hjust = 1.03,
          vjust = 1.03,
          size = 3.32,
          linewidth = 0.18,
          label.padding = grid::unit(0.20, "lines"),
          fill = grDevices::adjustcolor("#ffffff", alpha.f = 0.90),
          color = "#0f172a"
        )
    }

    custom_ggsave(output_path, plot = p, plot_key = "two_group_publication_plot", width = 12.0, height = 8.4, dpi = 320, device = "png")
    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0("Failed to generate two-group publication plot image: ", plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = "Failed to generate two-group publication plot image."))
  }

  list(
    generated = TRUE,
    path = output_path,
    error = NULL,
    test_kind = test_kind,
    paired_overlay = isTRUE(paired_overlay),
    paired_n = if (is.finite(paired_n)) as.integer(paired_n) else NULL,
    pairing_method = paired_method
  )
}

parse_expected_proportions <- function(raw_text, n_categories) {
  default_probs <- rep(1 / n_categories, n_categories)
  if (is.null(raw_text) || trimws(raw_text) == "") {
    return(list(
      probs = default_probs,
      note = "No expected proportions provided; equal proportions were used."
    ))
  }

  tokens <- unlist(strsplit(raw_text, "[,;[:space:]]+"))
  tokens <- tokens[tokens != ""]
  vals <- suppressWarnings(as.numeric(tokens))
  vals <- vals[!is.na(vals)]

  if (length(vals) != n_categories) {
    return(list(
      probs = default_probs,
      note = sprintf("Expected proportions length mismatch (got %d, need %d); equal proportions were used.", length(vals), n_categories)
    ))
  }

  if (any(vals < 0)) {
    return(list(
      probs = default_probs,
      note = "Expected proportions contained negative values; equal proportions were used."
    ))
  }

  vals_sum <- sum(vals)
  if (!is.finite(vals_sum) || vals_sum <= 0) {
    return(list(
      probs = default_probs,
      note = "Expected proportions sum must be > 0; equal proportions were used."
    ))
  }

  # Accept percentages (e.g. 30, 40, 30) or proportions (0.3, 0.4, 0.3)
  if (vals_sum > 1.5) {
    vals <- vals / 100
  }

  vals <- vals / sum(vals)
  list(
    probs = vals,
    note = "Custom expected proportions were used."
  )
}

calc_pairwise_paired_t <- function(df, subject_col, factor_col, value_col, term_label, alpha = 0.05, adjust_method = "holm") {
  out <- list()
  if (is.null(subject_col) || !(subject_col %in% colnames(df))) return(out)
  if (!(factor_col %in% colnames(df)) || !(value_col %in% colnames(df))) return(out)

  tmp <- df[, c(subject_col, factor_col, value_col), drop = FALSE]
  names(tmp) <- c("SubjectID", "Factor", "Value")
  tmp <- tmp[!is.na(tmp$SubjectID) & !is.na(tmp$Factor) & !is.na(tmp$Value), , drop = FALSE]
  if (nrow(tmp) == 0) return(out)

  # In crossed repeated designs (e.g., within x within), a Subject x Factor
  # cell can appear multiple times because of the second within factor.
  # Aggregate to one value per cell before reshaping to wide format.
  dup_key <- paste(tmp$SubjectID, tmp$Factor, sep = "\r")
  if (any(duplicated(dup_key))) {
    tmp <- aggregate(Value ~ SubjectID + Factor, data = tmp, FUN = function(x) mean(x, na.rm = TRUE))
  }

  tmp$SubjectID <- as.factor(tmp$SubjectID)
  tmp$Factor <- as.factor(tmp$Factor)
  levels_factor <- levels(tmp$Factor)
  if (length(levels_factor) < 2) return(out)
  pair_ci_level <- resolve_conf_level_from_alpha(alpha)

  wide <- reshape(tmp, idvar = "SubjectID", timevar = "Factor", direction = "wide")
  value_cols <- grep("^Value[.]", names(wide), value = TRUE)
  if (length(value_cols) < 2) return(out)

  cmp <- list()
  cmp_idx <- 1
  for (i in 1:(length(value_cols) - 1)) {
    for (j in (i + 1):length(value_cols)) {
      col_i <- value_cols[i]
      col_j <- value_cols[j]
      lvl_i <- sub("^Value[.]", "", col_i)
      lvl_j <- sub("^Value[.]", "", col_j)
      x1 <- wide[[col_i]]
      x2 <- wide[[col_j]]
      keep <- complete.cases(x1, x2)
      x1 <- x1[keep]
      x2 <- x2[keep]
      if (length(x1) < 2 || length(x2) < 2) next

      tt <- tryCatch(t.test(x1, x2, paired = TRUE, conf.level = pair_ci_level), error = function(e) NULL)
      if (is.null(tt)) next

      p_raw <- as.numeric(tt$p.value)
      cmp[[cmp_idx]] <- list(
        term = term_label,
        comparison = paste(lvl_i, "-", lvl_j),
        diff = as.numeric(mean(x1 - x2, na.rm = TRUE)),
        lwr = if (!is.null(tt$conf.int)) as.numeric(tt$conf.int[1]) else NA,
        upr = if (!is.null(tt$conf.int)) as.numeric(tt$conf.int[2]) else NA,
        t_stat = as.numeric(tt$statistic),
        df = as.numeric(tt$parameter),
        p_raw = p_raw
      )
      cmp_idx <- cmp_idx + 1
    }
  }

  if (length(cmp) == 0) return(out)
  raw_ps <- sapply(cmp, function(x) x$p_raw)
  adj_ps <- p.adjust(raw_ps, method = adjust_method)
  for (k in seq_along(cmp)) {
    cmp[[k]]$p_adj <- as.numeric(adj_ps[k])
    cmp[[k]]$formatted_p <- fmt_p_value(cmp[[k]]$p_adj)
    cmp[[k]]$is_significant <- !is.na(cmp[[k]]$p_adj) && cmp[[k]]$p_adj < alpha
    cmp[[k]]$method <- paste("paired t-test", toupper(adjust_method))
  }
  if (inferential_significant_only) {
    cmp <- Filter(function(x) isTRUE(x$is_significant), cmp)
  }
  cmp
}

calc_pairwise_independent_tukey <- function(df, factor_col, value_col, term_label, alpha = 0.05, adjust_method = "holm") {
  out <- list()
  if (!(factor_col %in% colnames(df)) || !(value_col %in% colnames(df))) return(out)

  tmp <- df[, c(factor_col, value_col), drop = FALSE]
  names(tmp) <- c("Factor", "Value")
  tmp <- tmp[!is.na(tmp$Factor) & !is.na(tmp$Value), , drop = FALSE]
  if (nrow(tmp) == 0) return(out)
  tmp$Factor <- as.factor(tmp$Factor)
  lvls <- levels(tmp$Factor)
  if (length(lvls) < 2) return(out)
  conf_level <- resolve_conf_level_from_alpha(alpha)

  if (length(lvls) >= 3) {
    aov_mod <- tryCatch(aov(Value ~ Factor, data = tmp), error = function(e) NULL)
    tk <- if (!is.null(aov_mod)) {
      tryCatch(TukeyHSD(aov_mod, which = "Factor", conf.level = conf_level), error = function(e) NULL)
    } else NULL
    if (!is.null(tk) && !is.null(tk$Factor)) {
      tk_df <- as.data.frame(tk$Factor)
      tk_df$comparison <- rownames(tk_df)
      for (i in 1:nrow(tk_df)) {
        p_adj_val <- as.numeric(tk_df$`p adj`[i])
        out[[length(out) + 1]] <- list(
          term = term_label,
          comparison = as.character(tk_df$comparison[i]),
          diff = as.numeric(tk_df$diff[i]),
          lwr = as.numeric(tk_df$lwr[i]),
          upr = as.numeric(tk_df$upr[i]),
          p_adj = p_adj_val,
          formatted_p = fmt_p_value(p_adj_val),
          is_significant = !is.na(p_adj_val) && p_adj_val < alpha,
          method = "Tukey HSD"
        )
      }
      if (inferential_significant_only) {
        out <- Filter(function(x) isTRUE(x$is_significant), out)
      }
      return(out)
    }
  }

  cmp <- list()
  cmp_idx <- 1
  for (i in 1:(length(lvls) - 1)) {
    for (j in (i + 1):length(lvls)) {
      g1 <- lvls[i]
      g2 <- lvls[j]
      x1 <- tmp$Value[tmp$Factor == g1]
      x2 <- tmp$Value[tmp$Factor == g2]
      if (length(x1) < 2 || length(x2) < 2) next
      tt <- tryCatch(t.test(x1, x2, paired = FALSE, conf.level = conf_level), error = function(e) NULL)
      if (is.null(tt)) next
      cmp[[cmp_idx]] <- list(
        term = term_label,
        comparison = paste(g1, "-", g2),
        diff = as.numeric(mean(x1, na.rm = TRUE) - mean(x2, na.rm = TRUE)),
        lwr = if (!is.null(tt$conf.int)) as.numeric(tt$conf.int[1]) else NA,
        upr = if (!is.null(tt$conf.int)) as.numeric(tt$conf.int[2]) else NA,
        t_stat = as.numeric(tt$statistic),
        df = as.numeric(tt$parameter),
        p_raw = as.numeric(tt$p.value)
      )
      cmp_idx <- cmp_idx + 1
    }
  }
  if (length(cmp) == 0) return(out)
  raw_ps <- sapply(cmp, function(x) x$p_raw)
  adj_ps <- if (length(cmp) == 1) raw_ps else p.adjust(raw_ps, method = adjust_method)
  for (k in seq_along(cmp)) {
    cmp[[k]]$p_adj <- as.numeric(adj_ps[k])
    cmp[[k]]$formatted_p <- fmt_p_value(cmp[[k]]$p_adj)
    cmp[[k]]$is_significant <- !is.na(cmp[[k]]$p_adj) && cmp[[k]]$p_adj < alpha
    cmp[[k]]$method <- if (length(cmp) == 1) "independent t-test" else paste("independent t-test", toupper(adjust_method))
  }
  if (inferential_significant_only) {
    cmp <- Filter(function(x) isTRUE(x$is_significant), cmp)
  }
  cmp
}

calc_pairwise_independent_t <- function(df, factor_col, value_col, term_label, alpha = 0.05, adjust_method = "holm") {
  out <- list()
  if (!(factor_col %in% colnames(df)) || !(value_col %in% colnames(df))) return(out)

  tmp <- df[, c(factor_col, value_col), drop = FALSE]
  names(tmp) <- c("Factor", "Value")
  tmp <- tmp[!is.na(tmp$Factor) & !is.na(tmp$Value), , drop = FALSE]
  if (nrow(tmp) == 0) return(out)
  tmp$Factor <- as.factor(tmp$Factor)
  lvls <- levels(tmp$Factor)
  if (length(lvls) < 2) return(out)
  pair_ci_level <- resolve_conf_level_from_alpha(alpha)

  cmp <- list()
  cmp_idx <- 1
  for (i in 1:(length(lvls) - 1)) {
    for (j in (i + 1):length(lvls)) {
      g1 <- lvls[i]
      g2 <- lvls[j]
      x1 <- tmp$Value[tmp$Factor == g1]
      x2 <- tmp$Value[tmp$Factor == g2]
      if (length(x1) < 2 || length(x2) < 2) next
      tt <- tryCatch(t.test(x1, x2, paired = FALSE, conf.level = pair_ci_level), error = function(e) NULL)
      if (is.null(tt)) next
      cmp[[cmp_idx]] <- list(
        term = term_label,
        comparison = paste(g1, "-", g2),
        diff = as.numeric(mean(x1, na.rm = TRUE) - mean(x2, na.rm = TRUE)),
        lwr = if (!is.null(tt$conf.int)) as.numeric(tt$conf.int[1]) else NA,
        upr = if (!is.null(tt$conf.int)) as.numeric(tt$conf.int[2]) else NA,
        t_stat = as.numeric(tt$statistic),
        df = as.numeric(tt$parameter),
        p_raw = as.numeric(tt$p.value)
      )
      cmp_idx <- cmp_idx + 1
    }
  }
  if (length(cmp) == 0) return(out)
  raw_ps <- sapply(cmp, function(x) x$p_raw)
  adj_ps <- if (length(cmp) == 1) raw_ps else p.adjust(raw_ps, method = adjust_method)
  for (k in seq_along(cmp)) {
    cmp[[k]]$p_adj <- as.numeric(adj_ps[k])
    cmp[[k]]$formatted_p <- fmt_p_value(cmp[[k]]$p_adj)
    cmp[[k]]$is_significant <- !is.na(cmp[[k]]$p_adj) && cmp[[k]]$p_adj < alpha
    cmp[[k]]$method <- if (length(cmp) == 1) "independent t-test" else paste("independent t-test", toupper(adjust_method))
  }
  if (inferential_significant_only) {
    cmp <- Filter(function(x) isTRUE(x$is_significant), cmp)
  }
  cmp
}

calc_pairwise_dunn <- function(values, groups, term_label, alpha = 0.05, adjust_method = "bonferroni") {
  out <- list()
  if (is.null(values) || is.null(groups)) return(out)
  if (!isTRUE(ensure_optional_pkg("dunn.test", "Dunn post-hoc comparisons"))) return(out)
  g <- as.factor(groups)
  keep <- !is.na(values) & !is.na(g)
  x <- values[keep]
  g <- g[keep]
  if (length(unique(g)) < 2) return(out)
  d_res <- tryCatch({
    res <- NULL
    suppressWarnings(suppressMessages(capture.output({
      res <- dunn.test::dunn.test(x, g, method = adjust_method, list = TRUE, table = FALSE)
    })))
    res
  }, error = function(e) NULL)
  if (is.null(d_res) || length(d_res$comparisons) == 0) return(out)
  for (i in seq_along(d_res$comparisons)) {
    p_adj <- as.numeric(d_res$P.adjusted[i])
    out[[i]] <- list(
      term = term_label,
      comparison = as.character(d_res$comparisons[i]),
      statistic = as.numeric(d_res$Z[i]),
      z_value = as.numeric(d_res$Z[i]),
      p_adj = p_adj,
      formatted_p = fmt_p_value(p_adj),
      is_significant = !is.na(p_adj) && p_adj < alpha,
      method = paste("Dunn", toupper(adjust_method))
    )
  }
  if (inferential_significant_only) {
    out <- Filter(function(x) isTRUE(x$is_significant), out)
  }
  out
}

compute_sphericity_profile <- function(df, subject_col, within_col, value_col, alpha = 0.05) {
  if (is.null(subject_col) || !(subject_col %in% colnames(df))) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: Subject ID is missing."))
  }
  if (!(within_col %in% colnames(df)) || !(value_col %in% colnames(df))) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: required columns are missing."))
  }

  rm_data <- df[, c(subject_col, within_col, value_col), drop = FALSE]
  names(rm_data) <- c("SubjectID", "Condition", "Value")
  rm_data <- rm_data[!is.na(rm_data$SubjectID) & !is.na(rm_data$Condition) & !is.na(rm_data$Value), , drop = FALSE]
  if (nrow(rm_data) == 0) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: no complete rows."))
  }

  rm_data$SubjectID <- as.factor(rm_data$SubjectID)
  rm_data$Condition <- as.factor(rm_data$Condition)
  lvl_count <- length(levels(rm_data$Condition))
  if (lvl_count <= 2) {
    return(list(
      applicable = FALSE,
      levels = lvl_count,
      message = sprintf("Sphericity is not required for %d level(s).", lvl_count)
    ))
  }

  wide <- reshape(rm_data, idvar = "SubjectID", timevar = "Condition", direction = "wide")
  value_cols <- grep("^Value[.]", names(wide), value = TRUE)
  if (length(value_cols) <= 2) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: not enough repeated levels after reshaping."))
  }
  wide <- wide[complete.cases(wide[, value_cols, drop = FALSE]), c("SubjectID", value_cols), drop = FALSE]
  if (nrow(wide) < 3) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: fewer than 3 complete subjects."))
  }

  y <- as.matrix(wide[, value_cols, drop = FALSE])
  fit <- tryCatch(lm(y ~ 1), error = function(e) NULL)
  if (is.null(fit)) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: failed to fit repeated model."))
  }
  cond_labels <- sub("^Value[.]", "", value_cols)
  idata <- data.frame(Condition = factor(cond_labels, levels = cond_labels))

  rm_tbl <- tryCatch(anova(fit, M = ~Condition, X = ~1, idata = idata, test = "Spherical"), error = function(e) NULL)
  mau <- tryCatch(mauchly.test(fit, M = ~Condition, X = ~1, idata = idata), error = function(e) NULL)
  if (is.null(rm_tbl)) {
    return(list(applicable = FALSE, message = "Sphericity check skipped: ANOVA table could not be computed."))
  }

  row <- rm_tbl[1, , drop = FALSE]
  p_unc <- as.numeric(row[["Pr(>F)"]][1])
  gg_p <- if ("G-G Pr" %in% names(row)) as.numeric(row[["G-G Pr"]][1]) else NA
  hf_p <- if ("H-F Pr" %in% names(row)) as.numeric(row[["H-F Pr"]][1]) else NA

  heading <- attr(rm_tbl, "heading")
  gg_eps <- NA
  hf_eps <- NA
  if (!is.null(heading)) {
    gg_line <- heading[grep("Greenhouse-Geisser epsilon", heading)]
    hf_line <- heading[grep("Huynh-Feldt epsilon", heading)]
    if (length(gg_line) > 0) gg_eps <- suppressWarnings(as.numeric(sub(".*epsilon:\\s*", "", gg_line[1])))
    if (length(hf_line) > 0) hf_eps <- suppressWarnings(as.numeric(sub(".*epsilon:\\s*", "", hf_line[1])))
  }

  mauchly_w <- if (!is.null(mau)) as.numeric(mau$statistic[["W"]]) else NA
  mauchly_p <- if (!is.null(mau)) as.numeric(mau$p.value) else NA
  violated <- !is.na(mauchly_p) && mauchly_p < alpha

  correction_used <- "none"
  p_final <- p_unc
  if (violated) {
    use_hf <- !is.na(hf_p) && !is.na(hf_eps) && hf_eps > 0.75
    use_gg <- !is.na(gg_p)
    if (use_hf) {
      correction_used <- "HF"
      p_final <- hf_p
    } else if (use_gg) {
      correction_used <- "GG"
      p_final <- gg_p
    }
  }

  list(
    applicable = TRUE,
    levels = lvl_count,
    mauchly_w = mauchly_w,
    mauchly_p = mauchly_p,
    mauchly_formatted_p = fmt_p_value(mauchly_p),
    sphericity_violated = violated,
    correction_used = correction_used,
    p_uncorrected = p_unc,
    p_gg = gg_p,
    p_hf = hf_p,
    p_final = p_final,
    formatted_p_final = fmt_p_value(p_final),
    gg_epsilon = gg_eps,
    hf_epsilon = hf_eps,
    message = if (violated && correction_used != "none") {
      sprintf("Mauchly p = %s; %s correction applied (corrected p = %s).", fmt_p_value(mauchly_p), correction_used, fmt_p_value(p_final))
    } else if (violated) {
      sprintf("Mauchly p = %s; sphericity violated but no corrected p was available.", fmt_p_value(mauchly_p))
    } else {
      sprintf("Mauchly p = %s; sphericity assumption is not violated.", fmt_p_value(mauchly_p))
    }
  )
}

profile_msg("Top level ~line 1000")
compute_factorial_sphericity_checks <- function(df, factorial_design, subject_col, factor_a, factor_b, value_col, alpha = 0.05) {
  profile_msg("Parsed to line ~1000")
  checks <- list()
  if (is.null(df) || nrow(df) == 0) return(checks)
  if (is.null(subject_col) || !(subject_col %in% colnames(df))) return(checks)
  if (is.null(factor_b) || !(factor_b %in% colnames(df))) return(checks)
  if (!(value_col %in% colnames(df))) return(checks)

  if (factorial_design == "mixed") {
    # Mixed design: sphericity is relevant for the within factor only.
    checks[[factor_b]] <- compute_sphericity_profile(df, subject_col, factor_b, value_col, alpha)
    return(checks)
  }

  if (factorial_design == "within") {
    # Within x within: evaluate each within main effect and their interaction.
    if (is.null(factor_a) || !(factor_a %in% colnames(df))) return(checks)

    data_a <- aggregate(as.formula(paste(value_col, "~", subject_col, "+", factor_a)), data = df, FUN = mean)
    data_b <- aggregate(as.formula(paste(value_col, "~", subject_col, "+", factor_b)), data = df, FUN = mean)
    data_ab <- df[, c(subject_col, factor_a, factor_b, value_col), drop = FALSE]
    data_ab$..AB <- interaction(data_ab[[factor_a]], data_ab[[factor_b]], drop = TRUE, sep = ":")
    data_ab <- data_ab[, c(subject_col, "..AB", value_col), drop = FALSE]

    checks[[factor_a]] <- compute_sphericity_profile(data_a, subject_col, factor_a, value_col, alpha)
    checks[[factor_b]] <- compute_sphericity_profile(data_b, subject_col, factor_b, value_col, alpha)
    checks[[paste(factor_a, factor_b, sep = ":")]] <- compute_sphericity_profile(data_ab, subject_col, "..AB", value_col, alpha)
  }

  checks
}

create_sphericity_overview_plot <- function(sphericity_checks, base_output_image, alpha = 0.05) {
  if (is.null(sphericity_checks) || length(sphericity_checks) == 0) {
    return(list(generated = FALSE, path = NULL, error = "No sphericity checks available."))
  }

  effects <- names(sphericity_checks)
  if (is.null(effects) || length(effects) == 0) {
    return(list(generated = FALSE, path = NULL, error = "No named sphericity effects available."))
  }

  mauchly_vals <- rep(NA_real_, length(effects))
  final_vals <- rep(NA_real_, length(effects))
  for (i in seq_along(effects)) {
    sph <- sphericity_checks[[effects[i]]]
    if (is.null(sph) || !isTRUE(sph$applicable)) next
    mauchly_vals[i] <- suppressWarnings(as.numeric(sph$mauchly_p))
    final_vals[i] <- suppressWarnings(as.numeric(sph$p_final))
  }

  has_any <- any(is.finite(mauchly_vals)) || any(is.finite(final_vals))
  if (!has_any) {
    return(list(generated = FALSE, path = NULL, error = "No finite p-values available for sphericity plot."))
  }

  finite_pos <- c(
    as.numeric(mauchly_vals)[is.finite(as.numeric(mauchly_vals)) & as.numeric(mauchly_vals) > 0],
    as.numeric(final_vals)[is.finite(as.numeric(final_vals)) & as.numeric(final_vals) > 0],
    alpha
  )
  min_pos <- if (length(finite_pos) > 0) min(finite_pos, na.rm = TRUE) else 1e-6
  if (!is.finite(min_pos) || min_pos <= 0) min_pos <- 1e-6
  floor_pos <- min(1e-6, min_pos)

  mauchly_plot <- ifelse(
    is.finite(mauchly_vals),
    pmax(as.numeric(mauchly_vals), floor_pos),
    NA_real_
  )
  final_plot <- ifelse(
    is.finite(final_vals),
    pmax(as.numeric(final_vals), floor_pos),
    NA_real_
  )

  sphericity_plot_path <- gsub("\\.png$", "_sphericity.png", base_output_image)
  label_cfg <- resolve_base_label_config(
    "sphericity_plot",
    default_title = "Mauchly and Final Corrected p-values by Effect",
    default_x = "",
    default_y = "p-value (log scale)"
  )
  ok <- tryCatch({
    png(sphericity_plot_path, width = 1100, height = 700)
    old_par <- par(no.readonly = TRUE)
    on.exit({
      par(old_par)
      dev.off()
    }, add = TRUE)
    par(mar = c(8, 5, 4, 2) + 0.1)

    x <- seq_along(effects)
    y_base <- if (any(is.finite(mauchly_plot))) mauchly_plot else final_plot
    plot(
      x, y_base,
      type = "n",
      xaxt = "n",
      log = "y",
      xlab = "",
      ylab = "",
      main = ""
    )
    axis(1, at = x, labels = effects, las = 2, cex.axis = 0.9)
    abline(h = alpha, col = "#d97706", lty = 2, lwd = 2)

    if (any(is.finite(mauchly_plot))) {
      lines(x, mauchly_plot, type = "b", pch = 19, col = "#7c3aed", lwd = 2)
    }
    if (any(is.finite(final_plot))) {
      lines(x, final_plot, type = "b", pch = 17, col = "#0f766e", lwd = 2)
    }

    legend(
      "topright",
      legend = c("Mauchly p", "Final corrected p", paste0("alpha = ", alpha)),
      col = c("#7c3aed", "#0f766e", "#d97706"),
      pch = c(19, 17, NA),
      lty = c(1, 1, 2),
      lwd = c(2, 2, 2),
      bty = "n"
    )
    render_base_label_config(label_cfg, title_line = 1.3, x_line = 3.8, y_line = 3.2, caption_line = 5.3)
    TRUE
  }, error = function(e) {
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(sphericity_plot_path)) {
    return(list(generated = FALSE, path = NULL, error = "Failed to generate sphericity plot image."))
  }

  list(generated = TRUE, path = sphericity_plot_path, error = NULL)
}

create_residual_qq_plot <- function(residual_values, base_output_image, title_text = "Q-Q Plot of ANOVA Residuals") {
  vals <- suppressWarnings(as.numeric(residual_values))
  vals <- vals[is.finite(vals)]
  if (length(vals) < 3) {
    return(list(generated = FALSE, path = NULL, error = "Not enough residuals to draw a Q-Q plot (need at least 3)."))
  }

  qq_path <- gsub("\\.png$", "_residual_qq.png", base_output_image)
  label_cfg <- resolve_base_label_config(
    "residual_qq_plot",
    default_title = title_text,
    default_x = "Theoretical Quantiles",
    default_y = "Sample Quantiles"
  )
  ok <- tryCatch({
    png(qq_path, width = 900, height = 700)
    old_par <- par(no.readonly = TRUE)
    on.exit({
      par(old_par)
      dev.off()
    }, add = TRUE)
    par(mar = c(5, 5, 4, 2) + 0.1)
    qqnorm(
      vals,
      pch = 19,
      col = "#2563eb",
      main = "",
      xlab = "",
      ylab = ""
    )
    qqline(vals, col = "#dc2626", lty = 2, lwd = 2)
    mtext(sprintf("n = %d residuals", length(vals)), side = 3, adj = 1, cex = 0.9, col = "#475569")
    render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.1, caption_line = 4.5)
    TRUE
  }, error = function(e) {
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(qq_path)) {
    return(list(generated = FALSE, path = NULL, error = "Failed to generate residual Q-Q plot image."))
  }

  list(generated = TRUE, path = qq_path, error = NULL)
}

create_group_qq_plot <- function(group_values, base_output_image, title_text = "Shapiro-Wilk Q-Q Plots by Group") {
  if (is.null(group_values) || length(group_values) == 0) {
    return(list(generated = FALSE, path = NULL, error = "No groups available to generate Shapiro Q-Q plots."))
  }

  valid_groups <- list()
  for (grp_name in names(group_values)) {
    vals <- suppressWarnings(as.numeric(group_values[[grp_name]]))
    vals <- vals[is.finite(vals)]
    if (length(vals) >= 3) {
      valid_groups[[grp_name]] <- vals
    }
  }

  if (length(valid_groups) == 0) {
    return(list(generated = FALSE, path = NULL, error = "Not enough observations (n >= 3) in any group to draw Shapiro Q-Q plots."))
  }

  qq_path <- gsub("\\.png$", "_shapiro_group_qq.png", base_output_image)
  label_cfg <- resolve_base_label_config(
    "shapiro_group_qq_plot",
    default_title = title_text,
    default_x = "Theoretical Quantiles",
    default_y = "Sample Quantiles"
  )
  omitted_count <- length(group_values) - length(valid_groups)
  ok <- tryCatch({
    png(qq_path, width = 1200, height = 850)
    old_par <- par(no.readonly = TRUE)
    on.exit({
      par(old_par)
      dev.off()
    }, add = TRUE)

    plot_count <- length(valid_groups)
    n_cols <- ceiling(sqrt(plot_count))
    n_rows <- ceiling(plot_count / n_cols)
    par(
      mfrow = c(n_rows, n_cols),
      mar = c(4.2, 4.2, 3.2, 1.2),
      oma = c(0, 0, if (omitted_count > 0) 4.2 else 3.4, 0)
    )

    for (grp_name in names(valid_groups)) {
      vals <- valid_groups[[grp_name]]
      qqnorm(
        vals,
        pch = 19,
        col = "#2563eb",
        main = sprintf("%s (n=%d)", grp_name, length(vals)),
        xlab = label_cfg$x,
        ylab = label_cfg$y,
        cex.lab = max(label_cfg$x_cex, label_cfg$y_cex)
      )
      qqline(vals, col = "#dc2626", lty = 2, lwd = 2)
    }

    mtext(label_cfg$title, side = 3, outer = TRUE, line = 1.2, cex = label_cfg$title_cex, font = 2, adj = label_cfg$title_adj)
    if (omitted_count > 0) {
      mtext(
        sprintf("%d group(s) omitted (n < 3).", omitted_count),
        side = 3,
        outer = TRUE,
        line = -0.2,
        cex = 0.8,
        col = "#64748b"
      )
    }
    if (nzchar(label_cfg$caption)) {
      mtext(label_cfg$caption, side = 1, outer = TRUE, line = 0.5, cex = 0.85, col = "#475569", adj = 1)
    }
    TRUE
  }, error = function(e) {
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(qq_path)) {
    return(list(generated = FALSE, path = NULL, error = "Failed to generate Shapiro Q-Q plot image."))
  }

  list(generated = TRUE, path = qq_path, error = NULL)
}

create_residual_fitted_plot <- function(fitted_values, residual_values, base_output_image, title_text = "Residuals vs Fitted (ANOVA)") {
  fit_vals <- suppressWarnings(as.numeric(fitted_values))
  res_vals <- suppressWarnings(as.numeric(residual_values))
  keep <- is.finite(fit_vals) & is.finite(res_vals)
  fit_vals <- fit_vals[keep]
  res_vals <- res_vals[keep]

  if (length(res_vals) < 3 || length(fit_vals) < 3) {
    return(list(generated = FALSE, path = NULL, error = "Not enough finite fitted/residual values to draw residual diagnostics (need at least 3)."))
  }

  diag_path <- gsub("\\.png$", "_anova_residuals.png", base_output_image)
  label_cfg <- resolve_base_label_config(
    "anova_residual_plot",
    default_title = title_text,
    default_x = "Fitted Values",
    default_y = "Residuals"
  )
  ok <- tryCatch({
    png(diag_path, width = 950, height = 700)
    old_par <- par(no.readonly = TRUE)
    on.exit({
      par(old_par)
      dev.off()
    }, add = TRUE)
    par(mar = c(5, 5, 4, 2) + 0.1)
    plot(
      fit_vals,
      res_vals,
      pch = 19,
      col = "#2563eb",
      xlab = "",
      ylab = "",
      main = ""
    )
    abline(h = 0, col = "#dc2626", lty = 2, lwd = 2)
    lines(lowess(fit_vals, res_vals), col = "#0f766e", lwd = 2)
    mtext(sprintf("n = %d observations", length(res_vals)), side = 3, adj = 1, cex = 0.9, col = "#475569")
    render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.1, caption_line = 4.5)
    TRUE
  }, error = function(e) {
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(diag_path)) {
    return(list(generated = FALSE, path = NULL, error = "Failed to generate residual-vs-fitted diagnostic image."))
  }

  list(generated = TRUE, path = diag_path, error = NULL)
}

create_regression_publication_plot <- function(model, coefficients_df, response_var, predictors, base_output_image, alpha_level = 0.05, options = list()) {
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "Regression publication plot requires ggplot2."))
  }
  if (is.null(model) || is.null(coefficients_df) || !is.data.frame(coefficients_df)) {
    return(list(generated = FALSE, path = NULL, error = "Regression publication plot requires a fitted model and coefficient table."))
  }

  plot_df <- coefficients_df
  required_cols <- c("Estimate", "StdError", "Term", "pValue")
  if (!all(required_cols %in% colnames(plot_df))) {
    return(list(generated = FALSE, path = NULL, error = "Regression publication plot could not find estimate, standard error, term, and p-value columns."))
  }

  coefficient_type_col <- if ("CoefficientType" %in% colnames(plot_df)) {
    "CoefficientType"
  } else if ("coefficient_type" %in% colnames(plot_df)) {
    "coefficient_type"
  } else {
    NULL
  }
  include_threshold_terms <- isTRUE(options$include_threshold_terms)
  if (!is.null(coefficient_type_col) && !include_threshold_terms) {
    plot_df <- plot_df[tolower(as.character(plot_df[[coefficient_type_col]])) != "threshold", , drop = FALSE]
  }

  plot_df <- plot_df[plot_df$Term != "(Intercept)", , drop = FALSE]
  plot_df <- plot_df[is.finite(plot_df$Estimate) & is.finite(plot_df$StdError), , drop = FALSE]
  if (nrow(plot_df) == 0) {
    return(list(generated = FALSE, path = NULL, error = "Regression publication plot needs at least one non-intercept coefficient."))
  }

  df_resid <- suppressWarnings(as.numeric(model$df.residual))
  ci_alpha <- suppressWarnings(as.numeric(alpha_level))
  if (!is.finite(ci_alpha) || ci_alpha <= 0 || ci_alpha >= 1) ci_alpha <- 0.05
  ci_percent <- as.integer(round((1 - ci_alpha) * 100))
  crit_value <- if (is.finite(df_resid) && df_resid > 0) qt(1 - (ci_alpha / 2), df = df_resid) else qnorm(1 - (ci_alpha / 2))

  wrap_term_label <- function(value, width = 24) {
    paste(strwrap(as.character(value), width = width), collapse = "\n")
  }

  plot_df$ci_low <- plot_df$Estimate - (crit_value * plot_df$StdError)
  plot_df$ci_high <- plot_df$Estimate + (crit_value * plot_df$StdError)
  plot_df$significance_band <- ifelse(is.finite(plot_df$pValue) & plot_df$pValue < ci_alpha, "Significant", "Not significant")
  plot_df$term_label <- vapply(plot_df$Term, wrap_term_label, character(1))
  plot_df <- plot_df[order(plot_df$Estimate, decreasing = FALSE), , drop = FALSE]
  plot_df$term_label <- factor(plot_df$term_label, levels = plot_df$term_label)

  regression_title <- if (!is.null(options$title) && nzchar(as.character(options$title))) {
    as.character(options$title)
  } else if (length(predictors) > 1) {
    "Multiple Linear Regression Coefficients"
  } else {
    "Simple Linear Regression Coefficients"
  }
  regression_subtitle <- if (!is.null(options$subtitle) && nzchar(as.character(options$subtitle))) {
    as.character(options$subtitle)
  } else {
    paste0("Outcome: ", response_var)
  }
  x_axis_label <- if (!is.null(options$x_label) && nzchar(as.character(options$x_label))) {
    as.character(options$x_label)
  } else {
    sprintf("Coefficient estimate (%d%% CI)", ci_percent)
  }
  caption_text <- if (!is.null(options$caption) && nzchar(as.character(options$caption))) {
    as.character(options$caption)
  } else {
    sprintf("Unstandardized coefficients with %d%% confidence intervals; intercept omitted.", ci_percent)
  }

  output_path <- gsub("\\.png$", "_regression_publication.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_regression_publication.png")
  }

  plot_error <- NULL
  ok <- tryCatch({
    p <- ggplot2::ggplot(
      plot_df,
      ggplot2::aes(x = Estimate, y = term_label, color = significance_band)
    ) +
      ggplot2::geom_vline(xintercept = 0, linetype = "dashed", linewidth = 0.7, color = "#94a3b8") +
      ggplot2::geom_segment(
        ggplot2::aes(x = ci_low, xend = ci_high, y = term_label, yend = term_label),
        linewidth = 0.9,
        lineend = "round"
      ) +
      ggplot2::geom_point(size = 3.2) +
      ggplot2::scale_color_manual(
        values = c("Significant" = "#0f766e", "Not significant" = "#64748b"),
        drop = FALSE
      ) +
      ggplot2::labs(
        title = regression_title,
        subtitle = regression_subtitle,
        x = x_axis_label,
        y = "",
        color = "Result",
        caption = caption_text
      ) +
      ggplot2::theme_bw() +
      ggplot2::theme(
        panel.grid.major.y = ggplot2::element_blank(),
        panel.grid.minor = ggplot2::element_blank(),
        legend.position = "top",
        plot.title = ggplot2::element_text(face = "bold", size = 14),
        plot.subtitle = ggplot2::element_text(size = 10),
        axis.title.x = ggplot2::element_text(face = "bold"),
        axis.text.y = ggplot2::element_text(face = "bold")
      )

    custom_ggsave(
      output_path,
      plot = p,
      plot_key = "regression_publication_plot",
      width = 10.2,
      height = max(4.8, 2.8 + (0.62 * nrow(plot_df))),
      dpi = 320,
      device = "png"
    )
    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0("Failed to generate regression publication plot image: ", plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = "Failed to generate regression publication plot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_simple_linear_scatter_plot <- function(model, response_var, predictor_var, base_output_image, alpha_level = 0.05) {
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "Simple linear scatterplot requires ggplot2."))
  }
  if (is.null(model) || !inherits(model, "lm")) {
    return(list(generated = FALSE, path = NULL, error = "Simple linear scatterplot requires a fitted linear model."))
  }

  model_frame <- tryCatch(stats::model.frame(model), error = function(e) NULL)
  if (is.null(model_frame) || ncol(model_frame) < 2) {
    return(list(generated = FALSE, path = NULL, error = "Simple linear scatterplot could not recover the model frame."))
  }

  response_vals <- suppressWarnings(as.numeric(model_frame[[1]]))
  predictor_vals <- model_frame[[2]]
  if (!(is.numeric(predictor_vals) || is.integer(predictor_vals))) {
    return(list(
      generated = FALSE,
      path = NULL,
      error = sprintf("Simple linear scatterplot requires a numeric predictor (%s).", as.character(predictor_var))
    ))
  }

  predictor_vals <- suppressWarnings(as.numeric(predictor_vals))
  keep <- is.finite(response_vals) & is.finite(predictor_vals)
  plot_df <- data.frame(
    predictor = predictor_vals[keep],
    response = response_vals[keep]
  )

  if (nrow(plot_df) < 3) {
    return(list(generated = FALSE, path = NULL, error = "Simple linear scatterplot needs at least 3 finite observations."))
  }
  if (length(unique(plot_df$predictor)) < 2) {
    return(list(generated = FALSE, path = NULL, error = "Simple linear scatterplot needs at least 2 distinct predictor values."))
  }

  safe_alpha <- suppressWarnings(as.numeric(alpha_level))
  if (!is.finite(safe_alpha) || safe_alpha <= 0 || safe_alpha >= 1) safe_alpha <- 0.05
  ci_level <- 1 - safe_alpha
  ci_percent <- round(ci_level * 100)
  plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("regression_scatter_plot"))
  show_points <- resolve_plot_element_flag(plot_labels_cfg, "show_points", TRUE)
  show_trend_line <- resolve_plot_element_flag(plot_labels_cfg, "show_trend_line", TRUE)
  show_ci_band <- resolve_plot_element_flag(plot_labels_cfg, "show_ci_band", TRUE)
  show_grid <- resolve_plot_element_flag(plot_labels_cfg, "show_grid", TRUE)
  show_paper_grid <- resolve_plot_element_flag(plot_labels_cfg, "show_paper_grid", FALSE)
  show_dashed_grid <- resolve_plot_element_flag(plot_labels_cfg, "show_dashed_grid", FALSE)
  show_dotted_grid <- resolve_plot_element_flag(plot_labels_cfg, "show_dotted_grid", FALSE)
  show_x_grid_only <- resolve_plot_element_flag(plot_labels_cfg, "show_x_grid_only", FALSE)
  show_y_grid_only <- resolve_plot_element_flag(plot_labels_cfg, "show_y_grid_only", FALSE)
  grid_linetype <- if (isTRUE(show_dotted_grid)) {
    "dotted"
  } else if (isTRUE(show_dashed_grid)) {
    "dashed"
  } else {
    "solid"
  }
  grid_color <- get_custom_plot_color("exploratory_grid_color", "#dbe4ef")
  point_color <- get_custom_plot_color("regression_scatter_point_color", "#1d4ed8")
  point_fill_color <- get_custom_plot_color("regression_scatter_point_fill_color", "#bfdbfe")
  trend_line_color <- get_custom_plot_color("regression_scatter_line_color", "#b91c1c")
  ci_fill_color <- get_custom_plot_color("regression_scatter_ci_fill_color", "#fecaca")
  caption_text <- if (isTRUE(show_trend_line) && isTRUE(show_ci_band)) {
    paste0("Observed values with OLS fit and ", ci_percent, "% confidence band.")
  } else if (isTRUE(show_trend_line)) {
    "Observed values with OLS fit (confidence band hidden)."
  } else {
    "Observed values only (OLS fit and confidence band hidden)."
  }

  predictor_label <- gsub("`", "", as.character(predictor_var), fixed = TRUE)
  response_label <- gsub("`", "", as.character(response_var), fixed = TRUE)
  model_summary <- tryCatch(summary(model), error = function(e) NULL)
  r_squared <- suppressWarnings(as.numeric(model_summary$r.squared)[1])
  if (length(r_squared) == 0 || !is.finite(r_squared)) r_squared <- NA_real_
  model_p <- tryCatch({
    fstat <- model_summary$fstatistic
    if (length(fstat) < 3) return(NA_real_)
    pf(
      as.numeric(fstat[1]),
      as.numeric(fstat[2]),
      as.numeric(fstat[3]),
      lower.tail = FALSE
    )
  }, error = function(e) NA_real_)

  subtitle_parts <- c(
    paste0("n = ", nrow(plot_df)),
    if (is.finite(r_squared)) paste0("R^2 = ", format(round(r_squared, 3), nsmall = 3)) else NULL,
    if (is.finite(model_p)) {
      if (model_p < 0.001) {
        "Model p < .001"
      } else {
        paste0("Model p = ", format(round(model_p, 4), nsmall = 4))
      }
    } else NULL
  )

  output_path <- gsub("\\.png$", "_regression_scatter.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_regression_scatter.png")
  }

  plot_error <- NULL
  ok <- tryCatch({
    p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = predictor, y = response))

    if (isTRUE(show_points)) {
      p <- p + ggplot2::geom_point(
        shape = 21,
        size = 3,
        stroke = 0.7,
        alpha = 0.9,
        color = point_color,
        fill = point_fill_color
      )
    }

    if (isTRUE(show_trend_line)) {
      p <- p + ggplot2::geom_smooth(
        method = "lm",
        formula = y ~ x,
        se = isTRUE(show_ci_band),
        level = ci_level,
        color = trend_line_color,
        fill = ci_fill_color,
        linewidth = 1
      )
    }

    p <- p + ggplot2::labs(
        title = "Simple Linear Regression Scatterplot",
        subtitle = paste(subtitle_parts, collapse = " | "),
        x = predictor_label,
        y = response_label,
        caption = caption_text
      ) +
      ggplot2::theme_bw() +
      ggplot2::theme(
        plot.title = ggplot2::element_text(face = "bold", size = 14),
        plot.subtitle = ggplot2::element_text(size = 10),
        axis.title = ggplot2::element_text(face = "bold")
      )

    if (!isTRUE(show_grid)) {
      p <- p + ggplot2::theme(
        panel.grid.major = ggplot2::element_blank(),
        panel.grid.minor = ggplot2::element_blank()
      )
    } else {
      major_line <- ggplot2::element_line(
        color = grid_color,
        linewidth = if (isTRUE(show_paper_grid)) 0.45 else 0.30,
        linetype = grid_linetype
      )
      minor_line <- ggplot2::element_line(
        color = grid_color,
        linewidth = if (isTRUE(show_paper_grid)) 0.22 else 0.16,
        linetype = grid_linetype
      )
      p <- p + ggplot2::theme(
        panel.grid.major.x = if (isTRUE(show_y_grid_only)) ggplot2::element_blank() else major_line,
        panel.grid.major.y = if (isTRUE(show_x_grid_only)) ggplot2::element_blank() else major_line,
        panel.grid.minor.x = if (isTRUE(show_y_grid_only)) ggplot2::element_blank() else minor_line,
        panel.grid.minor.y = if (isTRUE(show_x_grid_only)) ggplot2::element_blank() else minor_line
      )
    }

    custom_ggsave(
      output_path,
      plot = p,
      plot_key = "regression_scatter_plot",
      width = 9.8,
      height = 6.8,
      dpi = 320,
      device = "png"
    )
    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0("Failed to generate simple linear scatterplot image: ", plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = "Failed to generate simple linear scatterplot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_mean_ci_plot <- function(data, group_var, response_var, base_output_image, title_text = NULL, subtitle_text = NULL, alpha_level = 0.05) {
  ci_level <- resolve_conf_level_from_alpha(alpha_level)
  ci_prob <- (1 + ci_level) / 2
  ci_percent <- as.integer(round(ci_level * 100))
  effective_title <- if (!is.null(title_text) && nzchar(trimws(as.character(title_text)))) {
    as.character(title_text)
  } else {
    sprintf("Mean ± %d%% CI by Group", ci_percent)
  }
  if (!(group_var %in% colnames(data)) || !(response_var %in% colnames(data))) {
    return(list(generated = FALSE, path = NULL, error = sprintf("Mean ± %d%% CI plot could not be generated: missing group/response columns.", ci_percent)))
  }
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = sprintf("Mean ± %d%% CI plot requires ggplot2.", ci_percent)))
  }

  plot_df <- data[, c(group_var, response_var), drop = FALSE]
  colnames(plot_df) <- c("group", "value")
  plot_df <- plot_df[!is.na(plot_df$group) & !is.na(plot_df$value), , drop = FALSE]

  if (nrow(plot_df) < 2) {
    return(list(generated = FALSE, path = NULL, error = sprintf("Not enough observations to generate Mean ± %d%% CI plot.", ci_percent)))
  }

  plot_df$group <- as.factor(plot_df$group)
  group_levels_plot <- levels(plot_df$group)
  group_fill_values <- get_level_color_map(
    group_var,
    group_levels_plot,
    pick_cols(length(group_levels_plot))
  )
  group_color_intensity <- get_custom_plot_intensity("three_group_group_color_intensity", 1)
  group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
  ci_point_color <- get_custom_plot_color("three_group_ci_point_color", NA_character_)
  ci_errorbar_color <- get_custom_plot_color("three_group_ci_errorbar_color", NA_character_)
  use_ci_point_override <- is_valid_color_value(ci_point_color)
  use_ci_errorbar_override <- is_valid_color_value(ci_errorbar_color)

  summary_raw <- aggregate(
    value ~ group,
    data = plot_df,
    FUN = function(x) {
      n <- length(x)
      m <- mean(x, na.rm = TRUE)
      s <- sd(x, na.rm = TRUE)
      se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
      t_crit <- if (n > 1) qt(ci_prob, df = n - 1) else NA_real_
      ci_half <- if (is.finite(se) && is.finite(t_crit)) t_crit * se else NA_real_
      c(
        n = n,
        mean = m,
        lower = if (is.finite(ci_half)) m - ci_half else NA_real_,
        upper = if (is.finite(ci_half)) m + ci_half else NA_real_
      )
    }
  )

  summary_matrix <- summary_raw$value
  if (is.null(dim(summary_matrix))) {
    summary_matrix <- matrix(summary_matrix, ncol = 4, byrow = TRUE)
    colnames(summary_matrix) <- c("n", "mean", "lower", "upper")
  }

  summary_df <- data.frame(
    group = summary_raw$group,
    n = as.numeric(summary_matrix[, "n"]),
    mean = as.numeric(summary_matrix[, "mean"]),
    lower = as.numeric(summary_matrix[, "lower"]),
    upper = as.numeric(summary_matrix[, "upper"]),
    stringsAsFactors = FALSE
  )
  summary_df$group <- factor(summary_df$group, levels = group_levels_plot)

  missing_ci <- !is.finite(summary_df$lower) | !is.finite(summary_df$upper)
  summary_df$lower[missing_ci] <- summary_df$mean[missing_ci]
  summary_df$upper[missing_ci] <- summary_df$mean[missing_ci]

  output_path <- gsub("\\.png$", "_mean_ci.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_mean_ci.png")
  }

  plot_error <- NULL
  ok <- tryCatch({
    p <- ggplot2::ggplot(summary_df, ggplot2::aes(x = group, y = mean))
    if (use_ci_point_override) {
      p <- p + ggplot2::geom_point(size = 3.2, color = ci_point_color)
    } else {
      p <- p + ggplot2::geom_point(ggplot2::aes(color = group), size = 3.2)
    }
    if (use_ci_errorbar_override) {
      p <- p + ggplot2::geom_errorbar(
        ggplot2::aes(ymin = lower, ymax = upper),
        width = 0.18,
        linewidth = 0.8,
        color = ci_errorbar_color
      )
    } else {
      p <- p + ggplot2::geom_errorbar(
        ggplot2::aes(ymin = lower, ymax = upper, color = group),
        width = 0.18,
        linewidth = 0.8
      )
    }
    if (!(use_ci_point_override && use_ci_errorbar_override)) {
      p <- p + ggplot2::scale_color_manual(values = group_fill_values, drop = FALSE)
    }
    p <- p +
      ggplot2::labs(
        title = effective_title,
        subtitle = if (!is.null(subtitle_text)) subtitle_text else "",
        x = group_var,
        y = sprintf("%s (Mean ± %d%% CI)", response_var, ci_percent)
      ) +
      ggplot2::theme_bw() +
      ggplot2::theme(
        panel.grid.major = ggplot2::element_blank(),
        panel.grid.minor = ggplot2::element_blank(),
        legend.position = "none",
        plot.title = ggplot2::element_text(face = "bold", size = 14),
        axis.title = ggplot2::element_text(face = "bold")
      )

    custom_ggsave(output_path, plot = p, width = 10, height = 8, dpi = 300, device = "png")
    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0(sprintf("Failed to generate Mean ± %d%% CI plot image: ", ci_percent), plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = sprintf("Failed to generate Mean ± %d%% CI plot image.", ci_percent)))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_publication_descriptive_table <- function(data, group_var, response_var, ci_level = 0.95) {
  if (!(group_var %in% colnames(data)) || !(response_var %in% colnames(data))) {
    return(list())
  }

  tbl_df <- data[, c(group_var, response_var), drop = FALSE]
  colnames(tbl_df) <- c("group", "value")
  tbl_df <- tbl_df[!is.na(tbl_df$group) & !is.na(tbl_df$value), , drop = FALSE]

  if (nrow(tbl_df) == 0) {
    return(list())
  }

  tbl_df$group <- as.factor(tbl_df$group)
  group_levels <- levels(tbl_df$group)
  ci_level <- suppressWarnings(as.numeric(ci_level))
  if (!is.finite(ci_level) || ci_level <= 0 || ci_level >= 1) ci_level <- 0.95
  ci_percent <- as.integer(round(ci_level * 100))
  ci_prob <- (1 + ci_level) / 2

  fmt_fixed <- function(v, digits = 3) {
    if (!is.finite(v)) return("N/A")
    format(round(v, digits), nsmall = digits)
  }

  rows <- lapply(group_levels, function(g) {
    x <- suppressWarnings(as.numeric(tbl_df$value[tbl_df$group == g]))
    x <- x[is.finite(x)]
    n <- length(x)
    if (n == 0) return(NULL)

    m <- mean(x)
    s <- if (n > 1) sd(x) else NA_real_
    se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
    t_crit <- if (n > 1) qt(ci_prob, df = n - 1) else NA_real_
    ci_half <- if (is.finite(se) && is.finite(t_crit)) t_crit * se else NA_real_
    ci_lower <- if (is.finite(ci_half)) m - ci_half else NA_real_
    ci_upper <- if (is.finite(ci_half)) m + ci_half else NA_real_
    med <- median(x)
    q1 <- as.numeric(quantile(x, probs = 0.25, na.rm = TRUE, names = FALSE, type = 7))
    q3 <- as.numeric(quantile(x, probs = 0.75, na.rm = TRUE, names = FALSE, type = 7))
    iqr_val <- IQR(x, na.rm = TRUE, type = 7)
    min_val <- min(x)
    max_val <- max(x)

    list(
      group = as.character(g),
      n = as.numeric(n),
      mean = as.numeric(m),
      sd = as.numeric(s),
      se = as.numeric(se),
      ci_level = as.numeric(ci_level),
      ci_lower = as.numeric(ci_lower),
      ci_upper = as.numeric(ci_upper),
      ci_half_width = as.numeric(ci_half),
      median = as.numeric(med),
      q1 = as.numeric(q1),
      q3 = as.numeric(q3),
      iqr = as.numeric(iqr_val),
      min = as.numeric(min_val),
      max = as.numeric(max_val),
      mean_sd = if (is.finite(m) && is.finite(s)) {
        sprintf("%s ± %s", fmt_fixed(m), fmt_fixed(s))
      } else {
        "N/A"
      },
      mean_ci = if (is.finite(m) && is.finite(ci_lower) && is.finite(ci_upper)) {
        sprintf("%s [%s, %s]", fmt_fixed(m), fmt_fixed(ci_lower), fmt_fixed(ci_upper))
      } else {
        "N/A"
      },
      mean_ci95 = if (is.finite(m) && is.finite(ci_lower) && is.finite(ci_upper)) {
        sprintf("%s [%s, %s]", fmt_fixed(m), fmt_fixed(ci_lower), fmt_fixed(ci_upper))
      } else {
        "N/A"
      },
      median_iqr = if (is.finite(med) && is.finite(q1) && is.finite(q3)) {
        sprintf("%s [%s, %s]", fmt_fixed(med), fmt_fixed(q1), fmt_fixed(q3))
      } else {
        "N/A"
      }
    )
  })

  rows <- Filter(Negate(is.null), rows)
  if (length(rows) == 0) {
    return(list())
  }

  list(
    group_var = as.character(group_var),
    response_var = as.character(response_var),
    ci_level = as.numeric(ci_level),
    ci_percent = ci_percent,
    rows = rows
  )
}

create_mann_whitney_box_raw_plot <- function(data, group_var, response_var, base_output_image, title_text = "Mann-Whitney U: Boxplot + Raw Points", subtitle_text = NULL) {
  if (!(group_var %in% colnames(data)) || !(response_var %in% colnames(data))) {
    return(list(generated = FALSE, path = NULL, error = "Mann-Whitney boxplot could not be generated: missing group/response columns."))
  }
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "Mann-Whitney boxplot requires ggplot2."))
  }

  plot_df <- data[, c(group_var, response_var), drop = FALSE]
  colnames(plot_df) <- c("group", "value")
  plot_df <- plot_df[!is.na(plot_df$group) & !is.na(plot_df$value), , drop = FALSE]
  if (nrow(plot_df) < 4) {
    return(list(generated = FALSE, path = NULL, error = "Not enough observations to generate Mann-Whitney boxplot."))
  }

  plot_df$group <- as.factor(plot_df$group)
  if (length(unique(plot_df$group)) < 2) {
    return(list(generated = FALSE, path = NULL, error = "Mann-Whitney boxplot requires at least 2 groups."))
  }

  group_levels_plot <- levels(plot_df$group)
  group_fill_values <- get_level_color_map(
    group_var,
    group_levels_plot,
    pick_cols(length(group_levels_plot))
  )

  output_path <- gsub("\\.png$", "_mann_whitney_box_raw.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_mann_whitney_box_raw.png")
  }

  plot_error <- NULL
  profile_msg("Parsed to line ~1500")
  ok <- tryCatch({
    p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = group, y = value)) +
      ggplot2::geom_boxplot(
        ggplot2::aes(fill = group),
        alpha = 0.72,
        width = 0.56,
        outlier.alpha = 0.3,
        color = "#1f2937"
      ) +
      ggplot2::geom_jitter(
        ggplot2::aes(color = group),
        position = stable_jitter_position(width = 0.11, height = 0, seed = 202603023L),
        alpha = 0.72,
        size = 2.0,
        show.legend = FALSE
      ) +
      ggplot2::scale_fill_manual(values = group_fill_values, drop = FALSE) +
      ggplot2::scale_color_manual(values = group_fill_values, drop = FALSE) +
      ggplot2::labs(
        title = title_text,
        subtitle = if (!is.null(subtitle_text)) subtitle_text else "",
        x = group_var,
        y = response_var
      ) +
      ggplot2::theme_minimal(base_size = 12) +
      ggplot2::theme(
        legend.position = "none",
        plot.title = ggplot2::element_text(face = "bold", size = 13),
        axis.title = ggplot2::element_text(face = "bold"),
        panel.grid.minor = ggplot2::element_blank()
      )

    custom_ggsave(output_path, plot = p, width = 9.2, height = 7.0, dpi = 300, device = "png")
    TRUE
  }, error = function(e) {
    call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
    plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    if (!is.null(plot_error) && nzchar(plot_error)) {
      return(list(generated = FALSE, path = NULL, error = paste0("Failed to generate Mann-Whitney boxplot image: ", plot_error)))
    }
    return(list(generated = FALSE, path = NULL, error = "Failed to generate Mann-Whitney boxplot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_rm_spaghetti_mean_ci_plot <- function(df, subject_col, condition_col, value_col, base_output_image, title_text = NULL, subtitle_text = NULL, alpha_level = 0.05) {
  ci_level <- resolve_conf_level_from_alpha(alpha_level)
  ci_prob <- (1 + ci_level) / 2
  ci_percent <- as.integer(round(ci_level * 100))
  effective_title <- if (!is.null(title_text) && nzchar(trimws(as.character(title_text)))) {
    as.character(title_text)
  } else {
    sprintf("Spaghetti Plot + Mean ± %d%% CI", ci_percent)
  }
  if (!(subject_col %in% colnames(df)) || !(condition_col %in% colnames(df)) || !(value_col %in% colnames(df))) {
    return(list(generated = FALSE, path = NULL, error = "RM spaghetti mean CI plot: missing required columns."))
  }
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "RM spaghetti mean CI plot requires ggplot2."))
  }

  plot_df <- data.frame(
    SubjectID = as.factor(df[[subject_col]]),
    Condition = df[[condition_col]],
    Value = suppressWarnings(as.numeric(df[[value_col]])),
    stringsAsFactors = FALSE
  )
  plot_df <- plot_df[!is.na(plot_df$SubjectID) & !is.na(plot_df$Condition) & is.finite(plot_df$Value), , drop = FALSE]
  if (nrow(plot_df) < 4) {
    return(list(generated = FALSE, path = NULL, error = "RM spaghetti mean CI plot requires at least 4 finite observations."))
  }

  if (is.factor(df[[condition_col]])) {
    cond_levels <- levels(df[[condition_col]])
  } else {
    cond_levels <- unique(as.character(plot_df$Condition))
  }
  plot_df$Condition <- factor(as.character(plot_df$Condition), levels = cond_levels)
  plot_df <- plot_df[!is.na(plot_df$Condition), , drop = FALSE]
  if (length(unique(plot_df$Condition)) < 2 || length(unique(plot_df$SubjectID)) < 2) {
    return(list(generated = FALSE, path = NULL, error = "RM spaghetti mean CI plot requires at least 2 conditions and 2 subjects."))
  }

  group_colors <- get_level_color_map(
    condition_col,
    levels(plot_df$Condition),
    pick_cols(length(levels(plot_df$Condition)))
  )

  summary_raw <- aggregate(
    Value ~ Condition,
    data = plot_df,
    FUN = function(x) {
      n <- length(x)
      m <- mean(x, na.rm = TRUE)
      s <- sd(x, na.rm = TRUE)
      se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
      t_crit <- if (n > 1) qt(ci_prob, df = n - 1) else NA_real_
      ci_half <- if (is.finite(se) && is.finite(t_crit)) t_crit * se else NA_real_
      c(
        n = n,
        mean = m,
        lower = if (is.finite(ci_half)) m - ci_half else NA_real_,
        upper = if (is.finite(ci_half)) m + ci_half else NA_real_
      )
    }
  )
  summary_matrix <- summary_raw$Value
  if (is.null(dim(summary_matrix))) {
    summary_matrix <- matrix(summary_matrix, ncol = 4, byrow = TRUE)
    colnames(summary_matrix) <- c("n", "mean", "lower", "upper")
  }
  summary_df <- data.frame(
    Condition = factor(summary_raw$Condition, levels = levels(plot_df$Condition)),
    n = as.numeric(summary_matrix[, "n"]),
    mean = as.numeric(summary_matrix[, "mean"]),
    lower = as.numeric(summary_matrix[, "lower"]),
    upper = as.numeric(summary_matrix[, "upper"]),
    stringsAsFactors = FALSE
  )
  missing_ci <- !is.finite(summary_df$lower) | !is.finite(summary_df$upper)
  summary_df$lower[missing_ci] <- summary_df$mean[missing_ci]
  summary_df$upper[missing_ci] <- summary_df$mean[missing_ci]

  output_path <- gsub("\\.png$", "_rm_spaghetti_ci.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_rm_spaghetti_ci.png")
  }

  ok <- tryCatch({
    p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = Condition, y = Value, group = SubjectID)) +
      ggplot2::geom_line(color = "#94a3b8", alpha = 0.45, linewidth = 0.6) +
      ggplot2::geom_point(color = "#64748b", alpha = 0.55, size = 1.5) +
      ggplot2::geom_errorbar(
        data = summary_df,
        ggplot2::aes(x = Condition, ymin = lower, ymax = upper, color = Condition),
        inherit.aes = FALSE,
        width = 0.12,
        linewidth = 0.9
      ) +
      ggplot2::geom_line(
        data = summary_df,
        ggplot2::aes(x = Condition, y = mean, group = 1),
        inherit.aes = FALSE,
        color = "#dc2626",
        linewidth = 1.1
      ) +
      ggplot2::geom_point(
        data = summary_df,
        ggplot2::aes(x = Condition, y = mean, color = Condition),
        inherit.aes = FALSE,
        size = 3
      ) +
      ggplot2::scale_color_manual(values = group_colors, drop = FALSE) +
      ggplot2::labs(
        title = effective_title,
        subtitle = if (!is.null(subtitle_text)) subtitle_text else "",
        x = condition_col,
        y = sprintf("%s (Mean ± %d%% CI)", value_col, ci_percent)
      ) +
      ggplot2::theme_bw() +
      ggplot2::theme(
        panel.grid.major = ggplot2::element_blank(),
        panel.grid.minor = ggplot2::element_blank(),
        legend.position = "none",
        plot.title = ggplot2::element_text(face = "bold", size = 14),
        axis.title = ggplot2::element_text(face = "bold")
      )

    custom_ggsave(output_path, plot = p, width = 10, height = 8, dpi = 300, device = "png")
    TRUE
  }, error = function(e) {
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    return(list(generated = FALSE, path = NULL, error = "Failed to generate RM spaghetti mean CI plot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

create_friedman_spaghetti_iqr_plot <- function(df, subject_col, condition_col, value_col, base_output_image, title_text = "Spaghetti Plot + Median ± IQR", subtitle_text = NULL) {
  if (!(subject_col %in% colnames(df)) || !(condition_col %in% colnames(df)) || !(value_col %in% colnames(df))) {
    return(list(generated = FALSE, path = NULL, error = "Friedman spaghetti IQR plot: missing required columns."))
  }
  if (!requireNamespace("ggplot2", quietly = TRUE)) {
    return(list(generated = FALSE, path = NULL, error = "Friedman spaghetti IQR plot requires ggplot2."))
  }

  plot_df <- data.frame(
    SubjectID = as.factor(df[[subject_col]]),
    Condition = df[[condition_col]],
    Value = suppressWarnings(as.numeric(df[[value_col]])),
    stringsAsFactors = FALSE
  )
  plot_df <- plot_df[!is.na(plot_df$SubjectID) & !is.na(plot_df$Condition) & is.finite(plot_df$Value), , drop = FALSE]
  if (nrow(plot_df) < 4) {
    return(list(generated = FALSE, path = NULL, error = "Friedman spaghetti IQR plot requires at least 4 finite observations."))
  }

  if (is.factor(df[[condition_col]])) {
    cond_levels <- levels(df[[condition_col]])
  } else {
    cond_levels <- unique(as.character(plot_df$Condition))
  }
  plot_df$Condition <- factor(as.character(plot_df$Condition), levels = cond_levels)
  plot_df <- plot_df[!is.na(plot_df$Condition), , drop = FALSE]
  if (length(unique(plot_df$Condition)) < 2 || length(unique(plot_df$SubjectID)) < 2) {
    return(list(generated = FALSE, path = NULL, error = "Friedman spaghetti IQR plot requires at least 2 conditions and 2 subjects."))
  }

  group_colors <- get_level_color_map(
    condition_col,
    levels(plot_df$Condition),
    pick_cols(length(levels(plot_df$Condition)))
  )

  summary_raw <- aggregate(
    Value ~ Condition,
    data = plot_df,
    FUN = function(x) {
      q1 <- as.numeric(quantile(x, 0.25, na.rm = TRUE, names = FALSE))
      med <- as.numeric(median(x, na.rm = TRUE))
      q3 <- as.numeric(quantile(x, 0.75, na.rm = TRUE, names = FALSE))
      c(q1 = q1, median = med, q3 = q3)
    }
  )
  summary_matrix <- summary_raw$Value
  if (is.null(dim(summary_matrix))) {
    summary_matrix <- matrix(summary_matrix, ncol = 3, byrow = TRUE)
    colnames(summary_matrix) <- c("q1", "median", "q3")
  }
  summary_df <- data.frame(
    Condition = factor(summary_raw$Condition, levels = levels(plot_df$Condition)),
    q1 = as.numeric(summary_matrix[, "q1"]),
    median = as.numeric(summary_matrix[, "median"]),
    q3 = as.numeric(summary_matrix[, "q3"]),
    stringsAsFactors = FALSE
  )

  output_path <- gsub("\\.png$", "_friedman_spaghetti_iqr.png", base_output_image)
  if (identical(output_path, base_output_image)) {
    output_path <- paste0(base_output_image, "_friedman_spaghetti_iqr.png")
  }

  ok <- tryCatch({
    p <- ggplot2::ggplot(plot_df, ggplot2::aes(x = Condition, y = Value, group = SubjectID)) +
      ggplot2::geom_line(color = "#94a3b8", alpha = 0.45, linewidth = 0.6) +
      ggplot2::geom_point(color = "#64748b", alpha = 0.55, size = 1.5) +
      ggplot2::geom_errorbar(
        data = summary_df,
        ggplot2::aes(x = Condition, ymin = q1, ymax = q3, color = Condition),
        inherit.aes = FALSE,
        width = 0.12,
        linewidth = 0.9
      ) +
      ggplot2::geom_line(
        data = summary_df,
        ggplot2::aes(x = Condition, y = median, group = 1),
        inherit.aes = FALSE,
        color = "#d97706",
        linewidth = 1.1
      ) +
      ggplot2::geom_point(
        data = summary_df,
        ggplot2::aes(x = Condition, y = median, color = Condition),
        inherit.aes = FALSE,
        size = 3
      ) +
      ggplot2::scale_color_manual(values = group_colors, drop = FALSE) +
      ggplot2::labs(
        title = title_text,
        subtitle = if (!is.null(subtitle_text)) subtitle_text else "",
        x = condition_col,
        y = paste0(value_col, " (Median ± IQR)")
      ) +
      ggplot2::theme_bw() +
      ggplot2::theme(
        panel.grid.major = ggplot2::element_blank(),
        panel.grid.minor = ggplot2::element_blank(),
        legend.position = "none",
        plot.title = ggplot2::element_text(face = "bold", size = 14),
        axis.title = ggplot2::element_text(face = "bold")
      )

    custom_ggsave(output_path, plot = p, width = 10, height = 8, dpi = 300, device = "png")
    TRUE
  }, error = function(e) {
    FALSE
  })

  if (!isTRUE(ok) || !file.exists(output_path)) {
    return(list(generated = FALSE, path = NULL, error = "Failed to generate Friedman spaghetti IQR plot image."))
  }

  list(generated = TRUE, path = output_path, error = NULL)
}

safe_brewer <- function(name, n) {
  if (requireNamespace("RColorBrewer", quietly = TRUE, lib.loc = local_lib)) {
    info <- RColorBrewer::brewer.pal.info
    palette_names <- rownames(info)
    matched_idx <- match(tolower(name), tolower(palette_names))
    if (!is.na(matched_idx)) {
      palette_name <- palette_names[matched_idx]
      maxn <- info[palette_name, "maxcolors"]
      target_n <- max(1, n)
      k <- max(3, min(target_n, maxn))
      cols <- RColorBrewer::brewer.pal(k, palette_name)
      if (target_n <= length(cols)) {
        return(cols[1:target_n])
      }
      return(rep(cols, length.out = target_n))
    }
  }
  rep("#4f46e5", n)
}

safe_viridis <- function(option, n) {
  if (requireNamespace("viridisLite", quietly = TRUE, lib.loc = local_lib)) {
    return(viridisLite::viridis(n, option = option))
  }
  rep("#4f46e5", n)
}

build_palette_bundle <- function(fills, palette_type = "qualitative") {
  cols <- as.character(fills)
  cols <- cols[!is.na(cols) & nzchar(trimws(cols))]
  if (length(cols) == 0) cols <- rep("#4f46e5", 12)
  if (length(cols) == 1) cols <- rep(cols, 2)
  n <- length(cols)
  type_norm <- tolower(trimws(as.character(palette_type)[1]))
  if (!(type_norm %in% c("qualitative", "diverging", "sequential"))) {
    type_norm <- "qualitative"
  }

  idx_mid <- as.integer(max(1L, min(n, round((n + 1) / 2))))
  if (type_norm == "diverging") {
    idx_main <- n
    idx_accent <- 1L
  } else if (type_norm == "sequential") {
    idx_main <- n
    idx_accent <- as.integer(max(1L, min(n, round(n * 0.72))))
  } else {
    idx_main <- 1L
    idx_accent <- min(2L, n)
  }

  list(
    type = type_norm,
    main = cols[idx_main],
    accent = cols[idx_accent],
    low = cols[1L],
    mid = cols[idx_mid],
    high = cols[n],
    fill = cols
  )
}

get_palette <- function(name) {
  raw_name <- if (is.null(name) || length(name) == 0) "" else as.character(name)[1]
  if (is.na(raw_name)) raw_name <- ""
  raw_name <- trimws(raw_name)
  nm <- tolower(raw_name)
  if (nm == "" || is.na(nm)) nm <- "set3"

  # Alias used in UI: SetN auto-expands with Set3 colors.
  if (nm == "setn") {
    fills <- safe_brewer("Set3", 12)
    return(build_palette_bundle(fills, "qualitative"))
  }

  # Support the complete RColorBrewer catalog by name (case-insensitive).
  if (requireNamespace("RColorBrewer", quietly = TRUE, lib.loc = local_lib)) {
    brewer_names <- rownames(RColorBrewer::brewer.pal.info)
    brewer_idx <- match(nm, tolower(brewer_names))
    if (!is.na(brewer_idx)) {
      brewer_name <- brewer_names[brewer_idx]
      fills <- safe_brewer(brewer_name, 12)
      brewer_category <- tolower(as.character(RColorBrewer::brewer.pal.info[brewer_name, "category"]))
      palette_type <- switch(
        brewer_category,
        "seq" = "sequential",
        "div" = "diverging",
        "qual" = "qualitative",
        "qualitative"
      )
      return(build_palette_bundle(fills, palette_type))
    }
  }

  # Viridis family
  if (nm %in% c("viridis","magma","plasma","cividis","inferno","turbo","rocket","mako")) {
    opt <- switch(nm,
      "viridis" = "D",
      "magma" = "A",
      "plasma" = "C",
      "cividis" = "E",
      "inferno" = "B",
      "turbo" = "H",
      "rocket" = "F",
      "mako" = "G",
      "D")
    fills <- safe_viridis(opt, 12)
    return(build_palette_bundle(fills, "sequential"))
  }

  # Base R palettes
  if (nm %in% c("rainbow","heat","terrain","topo")) {
    n <- 12
    fills <- switch(nm,
      "rainbow" = grDevices::rainbow(n),
      "heat"    = grDevices::heat.colors(n),
      "terrain" = grDevices::terrain.colors(n),
      "topo"    = grDevices::topo.colors(n))
    return(build_palette_bundle(fills, "sequential"))
  }

  # Manual color support: accept hex or standard R color names.
  color_ok <- tryCatch({
    grDevices::col2rgb(raw_name)
    TRUE
  }, error = function(e) FALSE)
  if (color_ok) {
    rgb_vals <- as.numeric(grDevices::col2rgb(raw_name)[, 1])
    main_hex <- grDevices::rgb(rgb_vals[1], rgb_vals[2], rgb_vals[3], maxColorValue = 255)
    light_vals <- pmin(255, round(rgb_vals + (255 - rgb_vals) * 0.65))
    dark_vals <- pmax(0, round(rgb_vals * 0.55))
    light_hex <- grDevices::rgb(light_vals[1], light_vals[2], light_vals[3], maxColorValue = 255)
    dark_hex <- grDevices::rgb(dark_vals[1], dark_vals[2], dark_vals[3], maxColorValue = 255)
    fills <- grDevices::colorRampPalette(c(light_hex, main_hex, dark_hex))(12)
    palette_bundle <- build_palette_bundle(fills, "sequential")
    palette_bundle$main <- main_hex
    palette_bundle$accent <- dark_hex
    return(palette_bundle)
  }

  # Legacy custom palettes retained for backward compatibility.
  if (nm %in% c("sunset","ocean","forest","mono","indigo")) {
    fills <- switch(nm,
      "sunset" = c("#fb7185","#f97316","#fbbf24","#22c55e","#38bdf8","#a855f7","#f43f5e","#10b981","#e11d48","#0ea5e9"),
      "ocean"  = c("#0ea5e9","#06b6d4","#22c55e","#84cc16","#a3e635","#14b8a6","#0d9488","#0891b2","#38bdf8","#8b5cf6"),
      "forest" = c("#166534","#16a34a","#22c55e","#65a30d","#a16207","#ea580c","#0f766e","#1d4ed8","#7c3aed","#dc2626"),
      "mono"   = rep(c("#111827","#4b5563","#9ca3af","#6b7280","#374151"), 3),
      c("#4f46e5","#7c3aed","#2563eb","#db2777","#22c55e","#f59e0b","#0ea5e9","#d946ef","#84cc16","#f97316")
    )
    legacy_bundle <- build_palette_bundle(fills, "qualitative")
    if (nm == "sunset") {
      legacy_bundle$main <- "#f97316"
      legacy_bundle$accent <- "#fb7185"
    } else if (nm == "ocean") {
      legacy_bundle$main <- "#0ea5e9"
      legacy_bundle$accent <- "#10b981"
    } else if (nm == "forest") {
      legacy_bundle$main <- "#16a34a"
      legacy_bundle$accent <- "#15803d"
    } else if (nm == "mono") {
      legacy_bundle$main <- "#111827"
      legacy_bundle$accent <- "#4b5563"
    }
    return(legacy_bundle)
  }

  # Fallback to a Brewer qualitative palette.
  fills <- safe_brewer("Set3", 12)
  build_palette_bundle(fills, "qualitative")
}

# Helper function to get color for specific plot type
get_plot_color <- function(plot_type, default_scheme = "set3") {
  # Check if specific color is defined for this plot type
  if (!is.null(plot_colors_list[[plot_type]]) && plot_colors_list[[plot_type]] != "") {
    return(plot_colors_list[[plot_type]])
  }
  # Check for default color
  if (!is.null(plot_colors_list[["default"]]) && plot_colors_list[["default"]] != "") {
    return(plot_colors_list[["default"]])
  }
  # Fallback to provided default
  return(default_scheme)
}

is_valid_color_value <- function(value) {
  text <- trimws(as.character(value)[1])
  if (!nzchar(text)) return(FALSE)
  tryCatch({
    grDevices::col2rgb(text)
    TRUE
  }, error = function(e) FALSE)
}

get_custom_plot_color <- function(color_key, fallback_value) {
  candidate <- plot_colors_list[[color_key]]
  if (is.null(candidate)) return(fallback_value)
  color_text <- trimws(as.character(candidate[1]))
  if (!is_valid_color_value(color_text)) return(fallback_value)
  color_text
}

get_custom_plot_line_type <- function(line_key, fallback_value = "dashed") {
  allowed_types <- c("solid", "dashed", "dotted", "dotdash", "longdash", "twodash")
  candidate <- plot_colors_list[[line_key]]
  if (is.null(candidate)) return(fallback_value)
  line_type <- tolower(trimws(as.character(candidate[1])))
  if (!(line_type %in% allowed_types)) return(fallback_value)
  line_type
}

get_custom_plot_line_width <- function(width_key, fallback_value = 0.62) {
  candidate <- plot_colors_list[[width_key]]
  if (is.null(candidate)) return(as.numeric(fallback_value))
  width_val <- suppressWarnings(as.numeric(candidate[1]))
  if (!is.finite(width_val) || width_val <= 0) return(as.numeric(fallback_value))
  pmin(4, pmax(0.2, width_val))
}

get_custom_plot_point_size <- function(size_key, fallback_value = 2.4) {
  candidate <- plot_colors_list[[size_key]]
  if (is.null(candidate)) return(as.numeric(fallback_value))
  size_val <- suppressWarnings(as.numeric(candidate[1]))
  if (!is.finite(size_val) || size_val <= 0) return(as.numeric(fallback_value))
  pmin(8, pmax(0.6, size_val))
}

get_custom_plot_flag <- function(flag_key, fallback_value = FALSE) {
  candidate <- plot_colors_list[[flag_key]]
  if (is.null(candidate)) return(isTRUE(fallback_value))
  parse_logical_flag(candidate, default = fallback_value)
}

get_custom_plot_intensity <- function(intensity_key, fallback_value = 1) {
  candidate <- plot_colors_list[[intensity_key]]
  if (is.null(candidate)) return(as.numeric(fallback_value))
  intensity_val <- suppressWarnings(as.numeric(candidate[1]))
  if (!is.finite(intensity_val)) return(as.numeric(fallback_value))
  pmin(2, pmax(0.2, intensity_val))
}

adjust_color_intensity <- function(color_value, intensity = 1) {
  color_text <- trimws(as.character(color_value[1]))
  if (!is_valid_color_value(color_text)) return(color_text)
  intensity_val <- suppressWarnings(as.numeric(intensity[1]))
  if (!is.finite(intensity_val)) intensity_val <- 1
  intensity_val <- pmin(2, pmax(0.2, intensity_val))
  rgb_vals <- as.numeric(grDevices::col2rgb(color_text))
  if (intensity_val <= 1) {
    # Intensity below 1 moves colors toward white (softer tones).
    adj_vals <- round(255 - (255 - rgb_vals) * intensity_val)
  } else {
    # Intensity above 1 increases saturation and slightly darkens for stronger tones.
    hsv_vals <- grDevices::rgb2hsv(rgb_vals[1], rgb_vals[2], rgb_vals[3], maxColorValue = 255)
    boost <- intensity_val - 1
    new_s <- pmin(1, hsv_vals["s", 1] + (1 - hsv_vals["s", 1]) * boost)
    new_v <- pmax(0, pmin(1, hsv_vals["v", 1] * (1 - 0.18 * boost)))
    stronger_col <- grDevices::hsv(h = hsv_vals["h", 1], s = new_s, v = new_v)
    adj_vals <- as.numeric(grDevices::col2rgb(stronger_col))
  }
  grDevices::rgb(adj_vals[1], adj_vals[2], adj_vals[3], maxColorValue = 255)
}

apply_intensity_to_color_map <- function(color_map, intensity = 1) {
  if (is.null(color_map) || length(color_map) == 0) return(color_map)
  adjusted <- vapply(color_map, function(clr) adjust_color_intensity(clr, intensity), character(1))
  names(adjusted) <- names(color_map)
  adjusted
}

resolve_heatmap_scale_colors <- function(palette_cfg, centered = FALSE) {
  cfg <- if (is.list(palette_cfg)) palette_cfg else get_palette("set3")
  palette_type <- tolower(trimws(as.character(if (!is.null(cfg$type)) cfg$type[1] else "qualitative")))
  if (!(palette_type %in% c("qualitative", "sequential", "diverging"))) palette_type <- "qualitative"

  pick_color <- function(value, fallback) {
    candidate <- if (is.null(value) || length(value) == 0) "" else trimws(as.character(value[1]))
    if (!is_valid_color_value(candidate)) return(fallback)
    candidate
  }

  low_color <- pick_color(
    cfg$low,
    pick_color(cfg$accent, "#dbeafe")
  )
  mid_color <- pick_color(cfg$mid, "#f8fafc")
  high_color <- pick_color(
    cfg$high,
    pick_color(cfg$main, "#1d4ed8")
  )

  if (!isTRUE(centered)) {
    return(list(type = palette_type, low = low_color, mid = mid_color, high = high_color))
  }
  if (identical(palette_type, "diverging")) {
    return(list(type = palette_type, low = low_color, mid = mid_color, high = high_color))
  }
  list(
    type = palette_type,
    low = adjust_color_intensity(low_color, 0.72),
    mid = "#ffffff",
    high = high_color
  )
}

build_heatmap_publication_features <- function(
  values,
  row_labels = NULL,
  col_labels = NULL,
  metric_name = "Value",
  context = "heatmap",
  top_n = 10L,
  rank_mode = "desc",
  exclude_diagonal = FALSE
) {
  mat_raw <- tryCatch(as.matrix(values), error = function(e) NULL)
  if (is.null(mat_raw) || length(dim(mat_raw)) != 2) return(NULL)

  n_rows <- nrow(mat_raw)
  n_cols <- ncol(mat_raw)
  if (!is.finite(n_rows) || !is.finite(n_cols) || n_rows <= 0 || n_cols <= 0) return(NULL)

  mat_num <- suppressWarnings(matrix(as.numeric(mat_raw), nrow = n_rows, ncol = n_cols))
  if (!is.matrix(mat_num)) return(NULL)

  row_names <- if (!is.null(row_labels) && length(row_labels) == n_rows) {
    as.character(row_labels)
  } else if (!is.null(rownames(mat_raw)) && length(rownames(mat_raw)) == n_rows) {
    as.character(rownames(mat_raw))
  } else {
    paste0("Row ", seq_len(n_rows))
  }
  col_names <- if (!is.null(col_labels) && length(col_labels) == n_cols) {
    as.character(col_labels)
  } else if (!is.null(colnames(mat_raw)) && length(colnames(mat_raw)) == n_cols) {
    as.character(colnames(mat_raw))
  } else {
    paste0("Column ", seq_len(n_cols))
  }
  row_names[is.na(row_names) | trimws(row_names) == ""] <- paste0("Row ", which(is.na(row_names) | trimws(row_names) == ""))
  col_names[is.na(col_names) | trimws(col_names) == ""] <- paste0("Column ", which(is.na(col_names) | trimws(col_names) == ""))

  grid_df <- data.frame(
    row_idx = rep(seq_len(n_rows), times = n_cols),
    col_idx = rep(seq_len(n_cols), each = n_rows),
    value = as.numeric(mat_num),
    stringsAsFactors = FALSE
  )
  valid_mask <- is.finite(grid_df$value)
  if (isTRUE(exclude_diagonal) && n_rows == n_cols) {
    valid_mask <- valid_mask & (grid_df$row_idx != grid_df$col_idx)
  }
  grid_df <- grid_df[valid_mask, , drop = FALSE]
  if (nrow(grid_df) == 0) {
    return(list(
      context = context,
      metric = metric_name,
      dimensions = list(rows = as.integer(n_rows), columns = as.integer(n_cols), cells = as.integer(n_rows * n_cols)),
      valid_cells = 0L,
      summary = list(min = NA_real_, q1 = NA_real_, median = NA_real_, mean = NA_real_, q3 = NA_real_, max = NA_real_),
      rank_mode = rank_mode,
      top_cells = list()
    ))
  }

  grid_df$row <- row_names[grid_df$row_idx]
  grid_df$column <- col_names[grid_df$col_idx]
  finite_vals <- grid_df$value
  q_vals <- suppressWarnings(stats::quantile(finite_vals, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE))
  if (length(q_vals) != 3) q_vals <- c(NA_real_, NA_real_, NA_real_)

  rank_mode_norm <- tolower(trimws(as.character(rank_mode[1])))
  if (!(rank_mode_norm %in% c("desc", "asc", "abs_desc"))) rank_mode_norm <- "desc"
  ord <- if (rank_mode_norm == "asc") {
    order(grid_df$value, decreasing = FALSE, na.last = NA)
  } else if (rank_mode_norm == "abs_desc") {
    order(abs(grid_df$value), decreasing = TRUE, na.last = NA)
  } else {
    order(grid_df$value, decreasing = TRUE, na.last = NA)
  }
  top_n_int <- suppressWarnings(as.integer(top_n[1]))
  if (!is.finite(top_n_int) || top_n_int <= 0) top_n_int <- 10L
  top_n_int <- as.integer(max(1L, min(40L, top_n_int)))
  top_df <- grid_df[ord, , drop = FALSE]
  if (nrow(top_df) > top_n_int) top_df <- top_df[seq_len(top_n_int), , drop = FALSE]

  top_cells <- lapply(seq_len(nrow(top_df)), function(i) {
    list(
      row = as.character(top_df$row[i]),
      column = as.character(top_df$column[i]),
      value = as.numeric(top_df$value[i])
    )
  })

  list(
    context = context,
    metric = metric_name,
    dimensions = list(
      rows = as.integer(n_rows),
      columns = as.integer(n_cols),
      cells = as.integer(n_rows * n_cols)
    ),
    valid_cells = as.integer(length(finite_vals)),
    summary = list(
      min = as.numeric(min(finite_vals, na.rm = TRUE)),
      q1 = as.numeric(q_vals[1]),
      median = as.numeric(q_vals[2]),
      mean = as.numeric(mean(finite_vals, na.rm = TRUE)),
      q3 = as.numeric(q_vals[3]),
      max = as.numeric(max(finite_vals, na.rm = TRUE))
    ),
    rank_mode = rank_mode_norm,
    top_cells = top_cells
  )
}

add_box_to_axis_guides <- function(
  p,
  summary_df,
  group_levels,
  y_span = 1,
  box_width = 0.56,
  show_mean = FALSE,
  show_median = FALSE,
  show_q1 = FALSE,
  show_q3 = FALSE,
  show_min = FALSE,
  show_max = FALSE,
  show_ci_low = FALSE,
  show_ci_high = FALSE,
  show_values = FALSE,
  mean_color = "#2563eb",
  median_color = "#0f766e",
  q1_color = "#7c3aed",
  q3_color = "#ea580c",
  min_color = "#b45309",
  max_color = "#92400e",
  ci_low_color = "#0284c7",
  ci_high_color = "#0369a1",
  line_type = "dashed",
  line_width = 0.62,
  value_digits = 3
) {
  if (is.null(p) || !inherits(p, "ggplot")) return(p)
  if (is.null(summary_df) || !is.data.frame(summary_df) || nrow(summary_df) == 0) return(p)

  safe_group_levels <- as.character(group_levels)
  safe_group_levels <- safe_group_levels[!is.na(safe_group_levels)]
  safe_group_levels <- safe_group_levels[nzchar(trimws(safe_group_levels))]
  if (length(safe_group_levels) == 0) {
    safe_group_levels <- unique(as.character(summary_df$group))
  }
  if (length(safe_group_levels) == 0) return(p)

  safe_span <- suppressWarnings(as.numeric(y_span[1]))
  if (!is.finite(safe_span) || safe_span <= 0) safe_span <- 1
  label_nudge <- max(safe_span * 0.018, 0.015)

  group_index <- match(as.character(summary_df$group), safe_group_levels)
  if (all(!is.finite(group_index))) return(p)

  safe_box_width <- suppressWarnings(as.numeric(box_width[1]))
  if (!is.finite(safe_box_width) || safe_box_width <= 0) safe_box_width <- 0.56
  safe_box_width <- min(1.0, max(0.22, safe_box_width))
  box_half_width <- min(0.45, max(0.09, safe_box_width * 0.38))
  safe_line_type <- if (line_type %in% c("solid", "dashed", "dotted", "dotdash", "longdash", "twodash")) line_type else "dashed"
  safe_line_width <- suppressWarnings(as.numeric(line_width[1]))
  if (!is.finite(safe_line_width) || safe_line_width <= 0) safe_line_width <- 0.62
  safe_line_width <- min(4, max(0.2, safe_line_width))
  safe_digits <- suppressWarnings(as.integer(value_digits[1]))
  if (!is.finite(safe_digits) || safe_digits < 1) safe_digits <- 3L
  safe_digits <- min(safe_digits, 6L)

  add_single_stat <- function(stat_col, is_enabled, stat_color, label_x_shift = 0) {
    if (!isTRUE(is_enabled)) return(invisible(NULL))
    if (!(stat_col %in% colnames(summary_df))) return(invisible(NULL))
    if (!is_valid_color_value(stat_color)) return(invisible(NULL))

    stat_values <- suppressWarnings(as.numeric(summary_df[[stat_col]]))
    keep <- is.finite(stat_values) & is.finite(group_index)
    if (!any(keep)) return(invisible(NULL))

    stat_values <- stat_values[keep]
    stat_x_idx <- as.numeric(group_index[keep])
    x_start <- stat_x_idx - box_half_width
    x_end <- stat_x_idx + box_half_width

    p <<- p + ggplot2::annotate(
      "segment",
      x = x_start,
      xend = x_end,
      y = stat_values,
      yend = stat_values,
      color = stat_color,
      linetype = safe_line_type,
      linewidth = safe_line_width,
      alpha = 0.95
    )

    if (isTRUE(show_values)) {
      stat_labels <- format(round(stat_values, safe_digits), nsmall = safe_digits)
      p <<- p + ggplot2::annotate(
        "text",
        x = stat_x_idx + label_x_shift,
        y = stat_values + label_nudge,
        label = stat_labels,
        color = stat_color,
        size = 3.0,
        hjust = 0.5,
        vjust = 0,
        fontface = "bold"
      )
    }

    invisible(NULL)
  }

  add_single_stat("mean", show_mean, mean_color, label_x_shift = -0.09)
  add_single_stat("median", show_median, median_color, label_x_shift = -0.03)
  add_single_stat("q1", show_q1, q1_color, label_x_shift = 0.03)
  add_single_stat("q3", show_q3, q3_color, label_x_shift = 0.09)
  add_single_stat("min", show_min, min_color, label_x_shift = -0.15)
  add_single_stat("max", show_max, max_color, label_x_shift = 0.15)
  add_single_stat("ci_low", show_ci_low, ci_low_color, label_x_shift = -0.15)
  add_single_stat("ci_up", show_ci_high, ci_high_color, label_x_shift = 0.15)

  p
}

get_level_color <- function(var_name, level_value) {
  factor_name <- trimws(as.character(var_name)[1])
  level_name <- trimws(as.character(level_value)[1])
  if (!nzchar(factor_name) || !nzchar(level_name)) return(NULL)

  level_key <- paste0("level::", factor_name, "::", level_name)
  candidate <- plot_colors_list[[level_key]]
  if (is.null(candidate)) return(NULL)

  color_text <- trimws(as.character(candidate)[1])
  if (!is_valid_color_value(color_text)) return(NULL)
  color_text
}

get_level_color_map <- function(var_name, levels, fallback_cols = NULL) {
  safe_levels <- as.character(levels)
  safe_levels <- safe_levels[!is.na(safe_levels)]
  safe_levels <- trimws(safe_levels)
  safe_levels <- safe_levels[nzchar(safe_levels)]
  safe_levels <- safe_levels[!duplicated(safe_levels)]
  if (length(safe_levels) == 0) {
    return(setNames(character(0), character(0)))
  }

  base_cols <- fallback_cols
  if (is.null(base_cols) || length(base_cols) == 0) {
    base_cols <- pick_cols(length(safe_levels))
  }
  base_cols <- rep(base_cols, length.out = length(safe_levels))
  names(base_cols) <- safe_levels

  for (i in seq_along(safe_levels)) {
    level_override <- get_level_color(var_name, safe_levels[i])
    if (!is.null(level_override)) {
      base_cols[i] <- level_override
    }
  }
  base_cols
}

# Set up default palette (for backward compatibility)
default_color_scheme <- get_plot_color("default", "set3")
palette_cfg <- get_palette(default_color_scheme)
palette_main <- palette_cfg$main
palette_accent <- palette_cfg$accent
palette_fill <- palette_cfg$fill

pick_cols <- function(n) {
  if (length(palette_fill) >= n) palette_fill[1:n] else rep(palette_fill, length.out = n)
}

# Helper for logging to mimic console echo
log_entry <- function(msg) {
  cat(paste0("> ", msg, "\n"), file = stderr())
}

sanitize_progress_field <- function(value) {
  text <- if (is.null(value) || length(value) == 0) "" else as.character(value[1])
  text <- gsub("[\r\n]+", " ", text, perl = TRUE)
  text <- gsub("\\|+", " ", text, perl = TRUE)
  trimws(text)
}

emit_progress <- function(percent, pass_label, test_label, path_label = "") {
  pct_num <- suppressWarnings(as.numeric(percent))
  if (length(pct_num) == 0 || !is.finite(pct_num[1])) pct_num <- 0
  pct <- max(0, min(100, round(pct_num[1])))
  pass <- sanitize_progress_field(pass_label)
  test <- sanitize_progress_field(test_label)
  path <- sanitize_progress_field(path_label)
  if (!nzchar(pass)) pass <- "Pass"
  if (!nzchar(test)) test <- "Step"
  cat(sprintf("PROGRESS|%d|%s|%s|%s\n", pct, pass, test, path), file = stderr())
}

# Helper function for univariate analysis
analyze_variable <- function(data_vector, var_name, output_dir = "/tmp") {
  clean_data <- data_vector[!is.na(data_vector)]
  n <- length(clean_data)
  
  if (n == 0) return(NULL)
  
  stats <- list(n = n)
  # Generate safe filename without external dependencies
  safe_var_name <- gsub("[^a-zA-Z0-9]", "", var_name)
  plot_path <- file.path(output_dir, paste0("plot_", safe_var_name, "_", as.numeric(Sys.time()), "_", sample(10000, 1), ".png"))
  
  tryCatch({
    png(plot_path, width = 600, height = 400)
    
    # Get plot-specific palette for this variable
    var_palette_name <- get_plot_color(var_name, default_color_scheme)
    var_palette <- get_palette(var_palette_name)
    distribution_plot_key <- paste0("distribution_", tolower(trimws(as.character(var_name))))
    
    if (is.numeric(clean_data)) {
      # Numeric variable
      stats$type <- "numeric"
      stats$mean <- mean(clean_data)
      stats$median <- median(clean_data)
      stats$sd <- sd(clean_data)
      stats$iqr <- IQR(clean_data)
      stats$min <- min(clean_data)
      stats$max <- max(clean_data)

      label_cfg <- resolve_base_label_config(
        distribution_plot_key,
        default_title = paste("Distribution of", var_name),
        default_x = var_name,
        default_y = "Density"
      )
      
      # Histogram with density
      hist(
        clean_data,
        probability = TRUE,
        main = "",
        xlab = "",
        ylab = "",
        col = var_palette$main,
        border = "white"
      )
      lines(density(clean_data), col = var_palette$accent, lwd = 2)
      render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
      
    } else {
      # Categorical variable
      stats$type <- "categorical"
      counts <- table(clean_data)
      props <- prop.table(counts)
      
      stats$counts <- as.list(counts)
      stats$percentages <- as.list(round(props * 100, 1))
      
      # Bar plot
      # Local pick_cols helper
      local_pick_cols <- function(n) {
        if (length(var_palette$fill) >= n) var_palette$fill[1:n] else rep(var_palette$fill, length.out = n)
      }
      
      fill_cols <- local_pick_cols(length(counts))
      label_cfg <- resolve_base_label_config(
        distribution_plot_key,
        default_title = paste("Distribution of", var_name),
        default_x = var_name,
        default_y = "Count"
      )
      barplot(
        counts,
        main = "",
        xlab = "",
        ylab = "",
        col = fill_cols,
        border = "white",
        las = 2
      )
      render_base_label_config(label_cfg, title_line = 1.2, x_line = 3.2, y_line = 3.4, caption_line = 4.8)
    }
    
    dev.off()
    stats$plot_path <- plot_path
    
  }, error = function(e) {
    stats$error <- e$message
    if (file.exists(plot_path)) file.remove(plot_path)
    stats$plot_path <- NULL
  })
  
  return(stats)
}

is_effectively_numeric <- function(vec, threshold = 0.85) {
  if (is.numeric(vec)) return(TRUE)
  vec_chr <- as.character(vec)
  vec_chr <- trimws(vec_chr)
  vec_chr <- vec_chr[!is.na(vec_chr) & vec_chr != ""]
  if (length(vec_chr) == 0) return(FALSE)
  converted <- suppressWarnings(as.numeric(vec_chr))
  ratio <- mean(is.finite(converted))
  is.finite(ratio) && ratio >= threshold
}

summarize_numeric_vector <- function(vec) {
  total_n <- length(vec)
  vec_num <- suppressWarnings(as.numeric(vec))
  valid <- vec_num[is.finite(vec_num)]
  n <- length(valid)
  missing_n <- total_n - n
  if (n == 0) {
    return(list(
      type = "numeric",
      n = 0,
      total_n = as.numeric(total_n),
      missing_n = as.numeric(missing_n)
    ))
  }
  q <- stats::quantile(valid, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE, type = 7)
  list(
    type = "numeric",
    n = as.numeric(n),
    total_n = as.numeric(total_n),
    missing_n = as.numeric(missing_n),
    mean = as.numeric(mean(valid)),
    median = as.numeric(q[2]),
    sd = as.numeric(stats::sd(valid)),
    variance = as.numeric(stats::var(valid)),
    min = as.numeric(min(valid)),
    q1 = as.numeric(q[1]),
    q3 = as.numeric(q[3]),
    iqr = as.numeric(stats::IQR(valid, type = 7)),
    max = as.numeric(max(valid))
  )
}

summarize_categorical_vector <- function(vec, top_n = 8) {
  vec_chr <- as.character(vec)
  total_n <- length(vec_chr)
  vec_chr <- trimws(vec_chr)
  valid <- vec_chr[!is.na(vec_chr) & vec_chr != ""]
  n <- length(valid)
  missing_n <- total_n - n
  if (n == 0) {
    return(list(
      type = "categorical",
      n = 0,
      total_n = as.numeric(total_n),
      missing_n = as.numeric(missing_n),
      levels = 0,
      top_levels = list()
    ))
  }
  counts <- sort(table(valid), decreasing = TRUE)
  level_names <- names(counts)
  n_keep <- min(top_n, length(level_names))
  keep_levels <- level_names[seq_len(n_keep)]
  top_levels <- lapply(keep_levels, function(lvl) {
    cnt <- as.numeric(counts[[lvl]])
    list(
      level = lvl,
      count = cnt,
      percent = as.numeric((cnt / n) * 100)
    )
  })
  list(
    type = "categorical",
    n = as.numeric(n),
    total_n = as.numeric(total_n),
    missing_n = as.numeric(missing_n),
    levels = as.numeric(length(level_names)),
    mode = if (length(level_names) > 0) level_names[1] else NA_character_,
    mode_count = if (length(level_names) > 0) as.numeric(counts[[level_names[1]]]) else NA_real_,
    top_levels = top_levels
  )
}

summarize_numeric_pair <- function(x_vec, y_vec) {
  x_num <- suppressWarnings(as.numeric(x_vec))
  y_num <- suppressWarnings(as.numeric(y_vec))
  keep <- is.finite(x_num) & is.finite(y_num)
  x <- x_num[keep]
  y <- y_num[keep]
  n <- length(x)
  if (n < 2) {
    return(list(
      type = "numeric_numeric",
      n = as.numeric(n)
    ))
  }
  pearson <- suppressWarnings(stats::cor(x, y, method = "pearson"))
  spearman <- suppressWarnings(stats::cor(x, y, method = "spearman"))
  covariance <- suppressWarnings(stats::cov(x, y))
  slope <- NA_real_
  intercept <- NA_real_
  r_squared <- NA_real_
  if (is.finite(stats::sd(x)) && stats::sd(x) > 0) {
    lm_fit <- tryCatch(stats::lm(y ~ x), error = function(e) NULL)
    if (!is.null(lm_fit)) {
      coef_vals <- tryCatch(stats::coef(lm_fit), error = function(e) NULL)
      if (!is.null(coef_vals) && length(coef_vals) >= 2) {
        intercept <- as.numeric(coef_vals[[1]])
        slope <- as.numeric(coef_vals[[2]])
      }
      r_squared <- tryCatch(as.numeric(summary(lm_fit)$r.squared), error = function(e) NA_real_)
    }
  }
  list(
    type = "numeric_numeric",
    n = as.numeric(n),
    pearson = as.numeric(pearson),
    spearman = as.numeric(spearman),
    covariance = as.numeric(covariance),
    slope = as.numeric(slope),
    intercept = as.numeric(intercept),
    r_squared = as.numeric(r_squared)
  )
}

summarize_grouped_numeric_pair <- function(group_vec, value_vec, top_n_groups = 10) {
  groups <- as.character(group_vec)
  values <- suppressWarnings(as.numeric(value_vec))
  groups <- trimws(groups)
  keep <- !is.na(groups) & groups != "" & is.finite(values)
  groups <- groups[keep]
  values <- values[keep]
  n <- length(values)
  if (n == 0) {
    return(list(
      type = "categorical_numeric",
      n = 0,
      group_count = 0,
      groups = list()
    ))
  }
  counts <- sort(table(groups), decreasing = TRUE)
  all_levels <- names(counts)
  n_keep <- min(top_n_groups, length(all_levels))
  keep_levels <- all_levels[seq_len(n_keep)]
  groups_summary <- lapply(keep_levels, function(lvl) {
    vals <- values[groups == lvl]
    q <- stats::quantile(vals, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE, type = 7)
    list(
      group = lvl,
      n = as.numeric(length(vals)),
      mean = as.numeric(mean(vals, na.rm = TRUE)),
      median = as.numeric(q[2]),
      sd = as.numeric(stats::sd(vals, na.rm = TRUE)),
      variance = as.numeric(stats::var(vals, na.rm = TRUE)),
      q1 = as.numeric(q[1]),
      q3 = as.numeric(q[3]),
      iqr = as.numeric(stats::IQR(vals, na.rm = TRUE, type = 7)),
      min = as.numeric(min(vals, na.rm = TRUE)),
      max = as.numeric(max(vals, na.rm = TRUE))
    )
  })
  list(
    type = "categorical_numeric",
    n = as.numeric(n),
    group_count = as.numeric(length(all_levels)),
    truncated = length(all_levels) > length(keep_levels),
    groups = groups_summary,
    overall = summarize_numeric_vector(values)
  )
}

summarize_contingency_pair <- function(x_vec, y_vec, max_levels = 10, max_pairs = 12) {
  x <- as.character(x_vec)
  y <- as.character(y_vec)
  x <- trimws(x)
  y <- trimws(y)
  keep <- !is.na(x) & !is.na(y) & x != "" & y != ""
  x <- x[keep]
  y <- y[keep]
  n <- length(x)
  if (n == 0) {
    return(list(
      type = "categorical_categorical",
      n = 0,
      row_levels = 0,
      col_levels = 0,
      contingency_table = list(
        table = list(),
        row_names = list(),
        col_names = list(),
        displayed_n = 0,
        total_n = 0,
        truncated = FALSE,
        other_count = 0
      ),
      top_x_levels = list(),
      top_y_levels = list(),
      top_pairs = list()
    ))
  }

  tbl <- table(x, y)
  row_totals <- sort(rowSums(tbl), decreasing = TRUE)
  col_totals <- sort(colSums(tbl), decreasing = TRUE)

  top_rows <- names(row_totals)[seq_len(min(max_levels, length(row_totals)))]
  top_cols <- names(col_totals)[seq_len(min(max_levels, length(col_totals)))]
  top_x_levels <- lapply(top_rows, function(lvl) {
    cnt <- as.numeric(row_totals[[lvl]])
    list(level = lvl, count = cnt, percent = as.numeric((cnt / n) * 100))
  })
  top_y_levels <- lapply(top_cols, function(lvl) {
    cnt <- as.numeric(col_totals[[lvl]])
    list(level = lvl, count = cnt, percent = as.numeric((cnt / n) * 100))
  })

  pair_df <- as.data.frame(tbl, stringsAsFactors = FALSE)
  colnames(pair_df) <- c("x_level", "y_level", "count")
  pair_df <- pair_df[pair_df$count > 0, , drop = FALSE]
  if (nrow(pair_df) > 0) {
    pair_df <- pair_df[order(pair_df$count, decreasing = TRUE), , drop = FALSE]
    pair_df <- utils::head(pair_df, max_pairs)
  }
  top_pairs <- lapply(seq_len(nrow(pair_df)), function(i) {
    row_i <- pair_df[i, ]
    list(
      x_level = as.character(row_i$x_level),
      y_level = as.character(row_i$y_level),
      count = as.numeric(row_i$count),
      percent = as.numeric((as.numeric(row_i$count) / n) * 100)
    )
  })

  displayed_tbl <- tbl[top_rows, top_cols, drop = FALSE]
  displayed_n <- as.numeric(sum(displayed_tbl))
  is_truncated <- nrow(tbl) > length(top_rows) || ncol(tbl) > length(top_cols)
  other_count <- if (isTRUE(is_truncated)) as.numeric(max(0, n - displayed_n)) else 0

  list(
    type = "categorical_categorical",
    n = as.numeric(n),
    row_levels = as.numeric(nrow(tbl)),
    col_levels = as.numeric(ncol(tbl)),
    contingency_table = list(
      table = unclass(as.matrix(displayed_tbl)),
      row_names = as.character(top_rows),
      col_names = as.character(top_cols),
      displayed_n = displayed_n,
      total_n = as.numeric(n),
      truncated = isTRUE(is_truncated),
      other_count = other_count
    ),
    top_x_levels = top_x_levels,
    top_y_levels = top_y_levels,
    top_pairs = top_pairs
  )
}

# Generate a single exploratory chart based on chart_type
plot_exploratory_chart <- function(data, chart_type, x_var, y_var = NULL, output_path) {
  chart_type <- tolower(chart_type)
  if (is.null(output_path) || output_path == "") stop("Output path is required.")

  var_palette <- get_palette(default_color_scheme)
  plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("exploratory_chart_plot"))
  element_flag <- function(key, default = TRUE) {
    resolve_plot_element_flag(plot_labels_cfg, key, default)
  }
  exploratory_main_color <- get_custom_plot_color("exploratory_main_color", var_palette$main)
  exploratory_accent_color <- get_custom_plot_color("exploratory_accent_color", var_palette$accent)
  exploratory_border_color <- get_custom_plot_color("exploratory_border_color", "#ffffff")
  exploratory_label_color <- get_custom_plot_color("exploratory_label_color", "#0f172a")
  exploratory_line_color <- get_custom_plot_color("exploratory_line_color", exploratory_accent_color)
  exploratory_point_color <- get_custom_plot_color("exploratory_point_color", exploratory_main_color)
  exploratory_area_fill_color <- get_custom_plot_color("exploratory_area_fill_color", exploratory_main_color)
  exploratory_grid_color <- get_custom_plot_color("exploratory_grid_color", "#cbd5e1")
  exploratory_heatmap_low_color <- get_custom_plot_color("exploratory_heatmap_low_color", "#eef2ff")
  exploratory_heatmap_high_color <- get_custom_plot_color("exploratory_heatmap_high_color", exploratory_main_color)
  local_pick_cols <- function(n) {
    base_cols <- if (length(var_palette$fill) >= n) var_palette$fill[1:n] else rep(var_palette$fill, length.out = n)
    if (n >= 1) base_cols[1] <- exploratory_main_color
    if (n >= 2) base_cols[2] <- exploratory_accent_color
    base_cols
  }
  add_grid_toggle <- function(
    plot_obj,
    show_grid = TRUE,
    grid_color = "#cbd5e1",
    show_paper_grid = FALSE,
    show_dashed_grid = FALSE,
    show_dotted_grid = FALSE,
    show_x_grid_only = FALSE,
    show_y_grid_only = FALSE,
    force_white_background = FALSE
  ) {
    white_bg_theme <- if (isTRUE(force_white_background)) {
      ggplot2::theme(
        panel.background = ggplot2::element_rect(fill = "#ffffff", color = NA),
        plot.background = ggplot2::element_rect(fill = "#ffffff", color = NA)
      )
    } else {
      NULL
    }

    if (!isTRUE(show_grid)) {
      return(
        plot_obj +
          ggplot2::theme(
            panel.grid.major = ggplot2::element_blank(),
            panel.grid.minor = ggplot2::element_blank()
          ) +
          white_bg_theme
      )
    }
    safe_grid_color <- if (is_valid_color_value(grid_color)) grid_color else "#cbd5e1"
    safe_minor_color <- tryCatch(grDevices::adjustcolor(safe_grid_color, alpha.f = 0.58), error = function(e) safe_grid_color)
    grid_linetype <- if (isTRUE(show_dotted_grid)) "dotted" else if (isTRUE(show_dashed_grid)) "dashed" else "solid"
    minor_linetype <- if (isTRUE(show_dotted_grid) || isTRUE(show_dashed_grid)) "dotted" else "solid"

    if (!isTRUE(show_paper_grid)) {
      out <- plot_obj + ggplot2::theme(
        panel.grid.major = ggplot2::element_line(color = safe_grid_color, linewidth = 0.45, linetype = grid_linetype),
        panel.grid.minor = ggplot2::element_line(color = safe_minor_color, linewidth = 0.3, linetype = minor_linetype)
      ) + white_bg_theme
      if (isTRUE(show_x_grid_only) && !isTRUE(show_y_grid_only)) {
        out <- out + ggplot2::theme(
          panel.grid.major.y = ggplot2::element_blank(),
          panel.grid.minor.y = ggplot2::element_blank()
        )
      } else if (isTRUE(show_y_grid_only) && !isTRUE(show_x_grid_only)) {
        out <- out + ggplot2::theme(
          panel.grid.major.x = ggplot2::element_blank(),
          panel.grid.minor.x = ggplot2::element_blank()
        )
      }
      return(out)
    }
    paper_major_color <- tryCatch(grDevices::adjustcolor(safe_grid_color, alpha.f = 0.92), error = function(e) safe_grid_color)
    paper_minor_color <- tryCatch(grDevices::adjustcolor(safe_grid_color, alpha.f = 0.46), error = function(e) safe_minor_color)
    panel_fill <- if (isTRUE(force_white_background)) "#ffffff" else "#fffdf2"
    plot_fill <- if (isTRUE(force_white_background)) "#ffffff" else "#fffef8"
    panel_border <- if (isTRUE(force_white_background)) "#e2e8f0" else "#d8d2b6"
    out <- plot_obj + ggplot2::theme(
      panel.background = ggplot2::element_rect(fill = panel_fill, color = panel_border, linewidth = 0.45),
      plot.background = ggplot2::element_rect(fill = plot_fill, color = NA),
      panel.grid.major = ggplot2::element_line(color = safe_grid_color, linewidth = 0.45, linetype = grid_linetype),
      panel.grid.minor = ggplot2::element_line(color = safe_minor_color, linewidth = 0.3, linetype = minor_linetype),
      panel.grid.major.x = ggplot2::element_line(color = paper_major_color, linewidth = 0.45, linetype = grid_linetype),
      panel.grid.major.y = ggplot2::element_line(color = paper_major_color, linewidth = 0.45, linetype = grid_linetype),
      panel.grid.minor.x = ggplot2::element_line(color = paper_minor_color, linewidth = 0.27, linetype = minor_linetype),
      panel.grid.minor.y = ggplot2::element_line(color = paper_minor_color, linewidth = 0.27, linetype = minor_linetype),
      panel.border = ggplot2::element_rect(color = panel_border, fill = NA, linewidth = 0.45)
    )
    if (isTRUE(show_x_grid_only) && !isTRUE(show_y_grid_only)) {
      out <- out + ggplot2::theme(
        panel.grid.major.y = ggplot2::element_blank(),
        panel.grid.minor.y = ggplot2::element_blank()
      )
    } else if (isTRUE(show_y_grid_only) && !isTRUE(show_x_grid_only)) {
      out <- out + ggplot2::theme(
        panel.grid.major.x = ggplot2::element_blank(),
        panel.grid.minor.x = ggplot2::element_blank()
      )
    }
    out
  }
  add_legend_toggle <- function(plot_obj, show_legend = TRUE) {
    if (isTRUE(show_legend)) return(plot_obj)
    plot_obj + ggplot2::theme(
      legend.position = "none"
    )
  }
  is_interval_like_axis_label <- function(label_value) {
    label_text <- trimws(as.character(label_value))
    if (!nzchar(label_text)) return(FALSE)
    grepl(
      "^\\s*[\\[(]\\s*[-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?\\s*,\\s*[-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?\\s*[\\])]\\s*$",
      label_text,
      perl = TRUE
    )
  }
  format_interval_axis_labels <- function(label_values, show_short_names = FALSE, hide_values = FALSE, prefix = "Int") {
    labels_chr <- as.character(label_values)
    if (length(labels_chr) == 0) return(character(0))
    interval_mask <- vapply(labels_chr, is_interval_like_axis_label, logical(1))
    if (!any(interval_mask)) return(labels_chr)
    if (!isTRUE(show_short_names) && !isTRUE(hide_values)) return(labels_chr)

    formatted <- labels_chr
    interval_alias <- paste0(prefix, seq_len(sum(interval_mask)))
    if (isTRUE(hide_values)) {
      formatted[interval_mask] <- interval_alias
    } else {
      formatted[interval_mask] <- paste0(labels_chr[interval_mask], "\n", interval_alias)
    }
    formatted
  }

  # Helpers
  to_numeric <- function(v) {
    if (is.numeric(v)) return(v)
    suppressWarnings(as.numeric(as.character(v)))
  }
  prep_cat_counts <- function(vec, max_cats = 15) {
    cats <- as.character(vec)
    tab <- sort(table(cats), decreasing = TRUE)
    if (length(tab) > max_cats) {
      top <- tab[1:max_cats]
      other <- sum(tab[(max_cats + 1):length(tab)])
      tab <- c(top, Other = other)
    }
    data.frame(category = names(tab), count = as.numeric(tab))
  }
  limit_categories <- function(vec, max_cats = 10) {
    cats <- as.character(vec)
    tab <- sort(table(cats), decreasing = TRUE)
    if (length(tab) > max_cats) {
      keep <- names(tab)[1:max_cats]
      cats[!(cats %in% keep)] <- "Other"
    }
    cats
  }
  summarize_numeric_for_overlay <- function(vec) {
    vals <- suppressWarnings(as.numeric(vec))
    vals <- vals[is.finite(vals)]
    if (length(vals) == 0) return(NULL)
    q <- stats::quantile(vals, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE, type = 7)
    list(
      n = as.numeric(length(vals)),
      mean = as.numeric(mean(vals, na.rm = TRUE)),
      median = as.numeric(q[2]),
      sd = as.numeric(stats::sd(vals, na.rm = TRUE)),
      variance = as.numeric(stats::var(vals, na.rm = TRUE)),
      q1 = as.numeric(q[1]),
      q3 = as.numeric(q[3]),
      iqr = as.numeric(stats::IQR(vals, na.rm = TRUE, type = 7)),
      min = as.numeric(min(vals, na.rm = TRUE)),
      max = as.numeric(max(vals, na.rm = TRUE))
    )
  }
  fmt_overlay_num <- function(v, digits = 3) {
    if (is.null(v) || length(v) == 0) return("N/A")
    num <- suppressWarnings(as.numeric(v[1]))
    if (length(num) == 0 || !is.finite(num)) return("N/A")
    format(round(num, digits), nsmall = digits)
  }
  fmt_overlay_p <- function(v, digits = 4) {
    if (is.null(v) || length(v) == 0) return("N/A")
    num <- suppressWarnings(as.numeric(v[1]))
    if (length(num) == 0 || !is.finite(num)) return("N/A")
    if (num < 0.001) return("< 0.001")
    format(round(num, digits), nsmall = digits)
  }
  safe_overlay_text <- function(v, fallback = "N/A") {
    txt <- trimws(as.character(v[1]))
    if (length(txt) == 0 || is.na(txt) || txt == "") return(fallback)
    txt
  }
  add_numeric_reference_layers <- function(
    plot_obj,
    stats_payload,
    orientation = "x",
    show_mean_label = FALSE,
    show_median_label = FALSE,
    show_q1_label = FALSE,
    show_q3_label = FALSE,
    show_min_label = FALSE,
    show_max_label = FALSE,
    show_stats_panel = FALSE
  ) {
    if (is.null(stats_payload) || !is.list(stats_payload)) return(plot_obj)

    stat_specs <- list(
      list(key = "mean", show = isTRUE(show_mean_label), value = stats_payload$mean, color = "#2563eb", label = "Mean"),
      list(key = "median", show = isTRUE(show_median_label), value = stats_payload$median, color = "#0f766e", label = "Median"),
      list(key = "q1", show = isTRUE(show_q1_label), value = stats_payload$q1, color = "#7c3aed", label = "Q1"),
      list(key = "q3", show = isTRUE(show_q3_label), value = stats_payload$q3, color = "#7c3aed", label = "Q3"),
      list(key = "min", show = isTRUE(show_min_label), value = stats_payload$min, color = "#b45309", label = "Min"),
      list(key = "max", show = isTRUE(show_max_label), value = stats_payload$max, color = "#b45309", label = "Max")
    )

    label_idx <- 0
    for (spec in stat_specs) {
      if (!isTRUE(spec$show) || !is.finite(spec$value)) next
      label_idx <- label_idx + 1
      value_label <- paste0(spec$label, ": ", fmt_overlay_num(spec$value, 3))
      if (orientation == "y") {
        plot_obj <- plot_obj +
          ggplot2::geom_hline(
            yintercept = spec$value,
            color = spec$color,
            linetype = "longdash",
            linewidth = 0.58,
            alpha = 0.95
          ) +
          ggplot2::annotate(
            "label",
            x = Inf,
            y = spec$value,
            label = value_label,
            hjust = 1.02 + (label_idx - 1) * 0.11,
            vjust = 0.5,
            size = 3.0,
            label.size = 0.12,
            fill = "#ffffffee",
            color = spec$color
          )
      } else {
        plot_obj <- plot_obj +
          ggplot2::geom_vline(
            xintercept = spec$value,
            color = spec$color,
            linetype = "longdash",
            linewidth = 0.58,
            alpha = 0.95
          ) +
          ggplot2::annotate(
            "label",
            x = spec$value,
            y = Inf,
            label = value_label,
            vjust = 1.2 + (label_idx - 1) * 0.82,
            size = 3.0,
            label.size = 0.12,
            fill = "#ffffffee",
            color = spec$color
          )
      }
    }

    if (isTRUE(show_stats_panel)) {
      stat_lines <- c(
        paste0("N: ", fmt_overlay_num(stats_payload$n, 0)),
        paste0("Mean: ", fmt_overlay_num(stats_payload$mean, 3)),
        paste0("Median: ", fmt_overlay_num(stats_payload$median, 3)),
        paste0("SD: ", fmt_overlay_num(stats_payload$sd, 3)),
        paste0("Variance: ", fmt_overlay_num(stats_payload$variance, 3)),
        paste0("Q1: ", fmt_overlay_num(stats_payload$q1, 3)),
        paste0("Q3: ", fmt_overlay_num(stats_payload$q3, 3)),
        paste0("IQR: ", fmt_overlay_num(stats_payload$iqr, 3)),
        paste0("Min: ", fmt_overlay_num(stats_payload$min, 3)),
        paste0("Max: ", fmt_overlay_num(stats_payload$max, 3))
      )
      plot_obj <- plot_obj + ggplot2::annotate(
        "label",
        x = -Inf,
        y = Inf,
        label = paste(stat_lines, collapse = "\n"),
        hjust = 0.02,
        vjust = 1.04,
        size = 2.9,
        label.size = 0.16,
        fill = "#fffef4ee",
        color = "#334155"
      )
    }

    plot_obj
  }
  add_result_values_panel <- function(
    plot_obj,
    lines,
    anchor = "top_left"
  ) {
    if (is.null(plot_obj)) return(plot_obj)
    panel_lines <- trimws(as.character(lines))
    panel_lines <- panel_lines[!is.na(panel_lines) & panel_lines != ""]
    if (length(panel_lines) == 0) return(plot_obj)

    use_top_right <- identical(anchor, "top_right")
    x_pos <- if (use_top_right) Inf else -Inf
    y_pos <- Inf
    hjust <- if (use_top_right) 1.02 else 0.02
    vjust <- 1.04

    plot_obj + ggplot2::annotate(
      "label",
      x = x_pos,
      y = y_pos,
      label = paste(panel_lines, collapse = "\n"),
      hjust = hjust,
      vjust = vjust,
      size = 2.9,
      label.size = 0.16,
      lineheight = 1.03,
      fill = "#fffef4ee",
      color = "#334155"
    )
  }
  build_numeric_vector_panel_lines <- function(summary_payload) {
    payload <- to_plain_list(summary_payload)
    if (length(payload) == 0) return(character(0))
    c(
      paste0("N: ", fmt_overlay_num(payload$n, 0)),
      paste0("Missing: ", fmt_overlay_num(payload$missing_n, 0)),
      paste0("Mean: ", fmt_overlay_num(payload$mean, 3)),
      paste0("Median: ", fmt_overlay_num(payload$median, 3)),
      paste0("SD: ", fmt_overlay_num(payload$sd, 3)),
      paste0("IQR: ", fmt_overlay_num(payload$iqr, 3)),
      paste0("Min: ", fmt_overlay_num(payload$min, 3)),
      paste0("Max: ", fmt_overlay_num(payload$max, 3))
    )
  }
  build_categorical_panel_lines <- function(summary_payload) {
    payload <- to_plain_list(summary_payload)
    if (length(payload) == 0) return(character(0))
    n <- suppressWarnings(as.numeric(payload$n[1]))
    mode_count <- suppressWarnings(as.numeric(payload$mode_count[1]))
    mode_pct <- if (is.finite(mode_count) && is.finite(n) && n > 0) (mode_count / n) * 100 else NA_real_
    lines <- c(
      paste0("N: ", fmt_overlay_num(payload$n, 0)),
      paste0("Missing: ", fmt_overlay_num(payload$missing_n, 0)),
      paste0("Levels: ", fmt_overlay_num(payload$levels, 0)),
      paste0("Mode: ", safe_overlay_text(payload$mode), " (", fmt_overlay_num(mode_count, 0), ", ", fmt_overlay_num(mode_pct, 1), "%)")
    )
    top_levels <- if (is.list(payload$top_levels)) payload$top_levels else list()
    if (length(top_levels) > 0) {
      top1 <- to_plain_list(top_levels[[1]])
      lines <- c(
        lines,
        paste0(
          "Top 1: ",
          safe_overlay_text(top1$level),
          " (",
          fmt_overlay_num(top1$count, 0),
          ", ",
          fmt_overlay_num(top1$percent, 1),
          "%)"
        )
      )
    }
    lines
  }
  build_numeric_pair_panel_lines <- function(summary_payload, include_model = TRUE) {
    payload <- to_plain_list(summary_payload)
    if (length(payload) == 0) return(character(0))
    lines <- c(
      paste0("Pairs: ", fmt_overlay_num(payload$n, 0)),
      paste0("Pearson r: ", fmt_overlay_num(payload$pearson, 3)),
      paste0("Spearman rho: ", fmt_overlay_num(payload$spearman, 3))
    )
    if (isTRUE(include_model)) {
      lines <- c(
        lines,
        paste0("Slope: ", fmt_overlay_num(payload$slope, 3)),
        paste0("R^2: ", fmt_overlay_num(payload$r_squared, 3))
      )
    }
    lines
  }
  build_grouped_numeric_panel_lines <- function(summary_payload) {
    payload <- to_plain_list(summary_payload)
    if (length(payload) == 0) return(character(0))
    overall <- to_plain_list(payload$overall)
    lines <- c(
      paste0("N: ", fmt_overlay_num(payload$n, 0)),
      paste0("Groups: ", fmt_overlay_num(payload$group_count, 0)),
      paste0("Overall mean: ", fmt_overlay_num(overall$mean, 3)),
      paste0("Overall SD: ", fmt_overlay_num(overall$sd, 3))
    )
    groups <- if (is.list(payload$groups)) payload$groups else list()
    if (length(groups) > 0) {
      max_groups <- min(length(groups), 8)
      group_lines <- vapply(seq_len(max_groups), function(i) {
        grp <- to_plain_list(groups[[i]])
        paste0(
          safe_overlay_text(grp$group),
          ": n=",
          fmt_overlay_num(grp$n, 0),
          ", mean=",
          fmt_overlay_num(grp$mean, 3),
          ", median=",
          fmt_overlay_num(grp$median, 3)
        )
      }, character(1))
      lines <- c(lines, group_lines)
      if (isTRUE(payload$truncated) || length(groups) > max_groups) {
        lines <- c(lines, paste0("... +", max(0, length(groups) - max_groups), " more groups"))
      }
    }
    lines
  }
  build_contingency_panel_lines <- function(summary_payload) {
    payload <- to_plain_list(summary_payload)
    if (length(payload) == 0) return(character(0))
    contingency_payload <- to_plain_list(payload$contingency_table)
    lines <- c(
      paste0("Pairs: ", fmt_overlay_num(payload$n, 0)),
      paste0("Levels: ", fmt_overlay_num(payload$row_levels, 0), " x ", fmt_overlay_num(payload$col_levels, 0))
    )
    if (isTRUE(contingency_payload$truncated)) {
      lines <- c(
        lines,
        paste0(
          "Displayed N: ",
          fmt_overlay_num(contingency_payload$displayed_n, 0),
          "/",
          fmt_overlay_num(contingency_payload$total_n, 0)
        )
      )
    }
    top_pairs <- if (is.list(payload$top_pairs)) payload$top_pairs else list()
    if (length(top_pairs) > 0) {
      top1 <- to_plain_list(top_pairs[[1]])
      lines <- c(
        lines,
        paste0(
          "Top cell: ",
          safe_overlay_text(top1$x_level),
          " x ",
          safe_overlay_text(top1$y_level),
          " (",
          fmt_overlay_num(top1$count, 0),
          ", ",
          fmt_overlay_num(top1$percent, 1),
          "%)"
        )
      )
    }
    lines
  }

  # Stem-and-leaf is text-based; render to image directly
  if (chart_type == "stem") {
    show_stem_text <- element_flag("show_stem_text", TRUE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    x_raw <- data[[x_var]]
    x_num <- to_numeric(x_raw)
    if (all(is.na(x_num))) stop("Stem-and-leaf requires numeric data.")
    x_num <- x_num[!is.na(x_num)]
    stem_summary <- summarize_numeric_vector(x_num)
    if (length(x_num) > 200) x_num <- x_num[1:200]
    stem_lines <- capture.output(stem(x_num))
    label_cfg <- resolve_base_label_config(
      "exploratory_chart_plot",
      default_title = paste("Stem-and-Leaf Plot:", x_var),
      default_x = "",
      default_y = ""
    )
    png(output_path, width = 800, height = 500)
    par(mar = c(2.2, 2.2, 3.5, 2.2))
    plot.new()
    if (isTRUE(show_stem_text)) {
      text(x = 0, y = 1, labels = stem_lines[1], adj = c(0, 1), family = "mono", cex = 0.9, col = exploratory_label_color)
      if (length(stem_lines) > 1) {
        for (i in 2:length(stem_lines)) {
          text(x = 0, y = 1 - (i - 1) * 0.05, labels = stem_lines[i], adj = c(0, 1), family = "mono", cex = 0.9, col = exploratory_label_color)
        }
      }
    } else {
      text(
        x = 0.5,
        y = 0.52,
        labels = "Stem text layer hidden.\nEnable 'Show Stem Text' in Plot Elements.",
        cex = 0.95,
        col = "#475569"
      )
    }
    if (isTRUE(show_result_values_panel)) {
      panel_lines <- build_numeric_vector_panel_lines(stem_summary)
      panel_lines <- panel_lines[seq_len(min(length(panel_lines), 6))]
      if (length(panel_lines) > 0) {
        text(
          x = 1,
          y = 1,
          labels = paste(panel_lines, collapse = "\n"),
          adj = c(1, 1),
          cex = 0.72,
          col = "#334155"
        )
      }
    }
    render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 2.8, caption_line = 4.2)
    dev.off()
    return(invisible(TRUE))
  }

  if (!requireNamespace("ggplot2", quietly = TRUE, lib.loc = local_lib)) {
    stop("ggplot2 package required for exploratory charts.")
  }
  library(ggplot2)

  if (chart_type %in% c("bar", "pie", "pareto")) {
    show_bars <- element_flag("show_bars", TRUE)
    show_slices <- element_flag("show_slices", TRUE)
    show_value_labels <- element_flag("show_value_labels", chart_type == "pie")
    show_percentage_labels <- element_flag("show_percentage_labels", chart_type == "pie")
    show_legend <- element_flag("show_legend", TRUE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)
    show_cumulative_line <- element_flag("show_cumulative_line", TRUE)
    show_cumulative_points <- element_flag("show_cumulative_points", TRUE)

    df <- prep_cat_counts(data[[x_var]])
    if (nrow(df) == 0) stop("No categorical data available.")
    df$category <- as.character(df$category)
    total_count <- sum(df$count)
    if (!is.finite(total_count) || total_count <= 0) total_count <- 1
    df$percent <- (df$count / total_count) * 100
    df$percent_text <- paste0(format(round(df$percent, 1), trim = TRUE), "%")
    df$count_text <- as.character(df$count)
    df$label_text <- if (isTRUE(show_percentage_labels)) {
      paste0(df$count_text, " (", df$percent_text, ")")
    } else {
      df$count_text
    }
    df$pie_label_text <- if (isTRUE(show_percentage_labels)) {
      paste0(df$percent_text, " (", df$count_text, ")")
    } else {
      df$count_text
    }
    categorical_panel_lines <- if (isTRUE(show_result_values_panel)) {
      build_categorical_panel_lines(summarize_categorical_vector(data[[x_var]]))
    } else {
      character(0)
    }

    if (chart_type == "bar") {
      p <- ggplot(df, aes(x = reorder(category, count), y = count)) +
        labs(title = paste("Bar Chart of", x_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_bars)) {
        p <- p + geom_col(fill = exploratory_main_color, color = exploratory_border_color, linewidth = 0.28)
      }
      if (isTRUE(show_value_labels)) {
        p <- p + geom_text(aes(label = label_text), hjust = -0.05, color = exploratory_label_color, size = 3.1)
      }
      p <- p +
        coord_flip() +
        labs(title = paste("Bar Chart of", x_var), x = x_var, y = "Count") +
        scale_y_continuous(expand = expansion(mult = c(0, 0.08)))
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only,
        force_white_background = TRUE
      )
    } else if (chart_type == "pie") {
      p <- ggplot(df, aes(x = "", y = count, fill = category)) +
        labs(title = paste("Pie Chart of", x_var), x = NULL, y = NULL) +
        theme_void() +
        theme(legend.position = "right")
      if (isTRUE(show_slices)) {
        p <- p + geom_col(width = 1, color = exploratory_border_color, linewidth = 0.24)
      }
      if (isTRUE(show_value_labels)) {
        p <- p + geom_text(aes(label = pie_label_text), position = position_stack(vjust = 0.5), size = 3.1, color = exploratory_label_color)
      }
      p <- p +
        coord_polar("y", start = 0) +
        scale_fill_manual(values = local_pick_cols(nrow(df))) +
        labs(title = paste("Pie Chart of", x_var), x = NULL, y = NULL) +
        theme(
          panel.background = element_rect(fill = "#ffffff", color = NA),
          plot.background = element_rect(fill = "#ffffff", color = NA)
        )
      p <- add_legend_toggle(p, show_legend = show_legend)
    } else {
      df <- df[order(-df$count), ]
      df$cum_pct <- cumsum(df$count) / sum(df$count) * 100
      max_count <- max(df$count)
      p <- ggplot(df, aes(x = factor(category, levels = category))) +
        labs(title = paste("Pareto Chart of", x_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_bars)) {
        p <- p + geom_col(fill = exploratory_main_color, color = exploratory_border_color, linewidth = 0.28)
      }
      if (isTRUE(show_cumulative_line)) {
        p <- p + geom_line(aes(y = cum_pct * max_count / 100, group = 1), color = exploratory_line_color, linewidth = 1)
      }
      if (isTRUE(show_cumulative_points)) {
        p <- p + geom_point(aes(y = cum_pct * max_count / 100), color = exploratory_point_color, size = 2)
      }
      if (isTRUE(show_value_labels)) {
        p <- p + geom_text(aes(y = count, label = label_text), hjust = -0.05, color = exploratory_label_color, size = 3.0)
      }
      p <- p +
        scale_y_continuous(sec.axis = sec_axis(~ . / max_count * 100, name = "Cumulative %")) +
        coord_flip() +
        labs(title = paste("Pareto Chart of", x_var), x = x_var, y = "Count")
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only,
        force_white_background = TRUE
      )
    }

    if (isTRUE(show_result_values_panel) && length(categorical_panel_lines) > 0) {
      if (chart_type == "pie") {
        compact_lines <- categorical_panel_lines[seq_len(min(length(categorical_panel_lines), 3))]
        p <- p + labs(subtitle = paste(compact_lines, collapse = " | ")) +
          theme(plot.subtitle = element_text(size = 9.1, color = "#475569", hjust = 0.5))
      } else {
        p <- add_result_values_panel(p, categorical_panel_lines, anchor = "top_left")
      }
    }

    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 7, height = 4.5, dpi = 200)
    return(invisible(TRUE))
  }

  # Numeric single-variable charts
  if (chart_type %in% c("histogram", "box", "density", "frequency_polygon")) {
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)
    show_histogram <- element_flag("show_histogram", TRUE)
    show_density <- element_flag("show_density", FALSE)
    show_rug <- element_flag("show_rug", FALSE)
    show_box <- element_flag("show_box", TRUE)
    show_jitter_points <- element_flag("show_jitter_points", FALSE)
    show_density_fill <- element_flag("show_density_fill", TRUE)
    show_density_line <- element_flag("show_density_line", TRUE)
    show_frequency_line <- element_flag("show_frequency_line", TRUE)
    show_frequency_points <- element_flag("show_frequency_points", FALSE)
    show_mean_label <- element_flag("show_mean_label", FALSE)
    show_median_label <- element_flag("show_median_label", FALSE)
    show_q1_label <- element_flag("show_q1_label", FALSE)
    show_q3_label <- element_flag("show_q3_label", FALSE)
    show_min_label <- element_flag("show_min_label", FALSE)
    show_max_label <- element_flag("show_max_label", FALSE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_stats_panel <- element_flag("show_stats_panel", FALSE) || isTRUE(show_result_values_panel)

    x_raw <- data[[x_var]]
    x_num <- to_numeric(x_raw)
    if (all(is.na(x_num))) stop("Selected variable must be numeric for this chart.")
    df <- data.frame(value = x_num)
    df <- df[!is.na(df$value), , drop = FALSE]
    numeric_overlay_stats <- summarize_numeric_for_overlay(df$value)

    if (chart_type == "histogram") {
      p <- ggplot(df, aes(x = value)) +
        labs(title = paste("Histogram of", x_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_histogram)) {
        p <- p + geom_histogram(bins = 30, fill = exploratory_main_color, color = exploratory_border_color, alpha = 0.88)
      }
      if (isTRUE(show_density)) {
        p <- p + geom_density(aes(y = after_stat(count)), color = exploratory_line_color, linewidth = 1.1, alpha = 0.95)
      }
      if (isTRUE(show_rug)) {
        p <- p + geom_rug(sides = "b", alpha = 0.22, color = exploratory_point_color)
      }
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only
      )
      p <- add_numeric_reference_layers(
        p,
        stats_payload = numeric_overlay_stats,
        orientation = "x",
        show_mean_label = show_mean_label,
        show_median_label = show_median_label,
        show_q1_label = show_q1_label,
        show_q3_label = show_q3_label,
        show_min_label = show_min_label,
        show_max_label = show_max_label,
        show_stats_panel = show_stats_panel
      )
    } else if (chart_type == "box") {
      p <- ggplot(df, aes(x = "", y = value)) +
        labs(title = paste("Box Plot of", x_var), x = NULL, y = x_var) +
        theme_minimal() +
        theme(axis.text.x = element_blank(), axis.ticks.x = element_blank())
      if (isTRUE(show_box)) {
        p <- p + geom_boxplot(fill = exploratory_main_color, color = exploratory_border_color, outlier.alpha = 0.28)
      }
      if (isTRUE(show_jitter_points)) {
        p <- p + geom_jitter(
          position = stable_jitter_position(width = 0.12, height = 0, seed = 202603024L),
          alpha = 0.45,
          color = exploratory_point_color,
          size = 1.3
        )
      }
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only
      )
      p <- add_numeric_reference_layers(
        p,
        stats_payload = numeric_overlay_stats,
        orientation = "y",
        show_mean_label = show_mean_label,
        show_median_label = show_median_label,
        show_q1_label = show_q1_label,
        show_q3_label = show_q3_label,
        show_min_label = show_min_label,
        show_max_label = show_max_label,
        show_stats_panel = show_stats_panel
      )
    } else if (chart_type == "density") {
      p <- ggplot(df, aes(x = value)) +
        labs(title = paste("Density Plot of", x_var), x = x_var, y = "Density") +
        theme_minimal()
      if (isTRUE(show_density_fill) || isTRUE(show_density_line)) {
        p <- p + geom_density(
          fill = if (isTRUE(show_density_fill)) exploratory_area_fill_color else NA,
          alpha = if (isTRUE(show_density_fill)) 0.35 else 0,
          color = if (isTRUE(show_density_line)) exploratory_line_color else NA,
          linewidth = if (isTRUE(show_density_line)) 1.0 else 0
        )
      }
      if (isTRUE(show_rug)) {
        p <- p + geom_rug(sides = "b", alpha = 0.24, color = exploratory_point_color)
      }
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only
      )
      p <- add_numeric_reference_layers(
        p,
        stats_payload = numeric_overlay_stats,
        orientation = "x",
        show_mean_label = show_mean_label,
        show_median_label = show_median_label,
        show_q1_label = show_q1_label,
        show_q3_label = show_q3_label,
        show_min_label = show_min_label,
        show_max_label = show_max_label,
        show_stats_panel = show_stats_panel
      )
    } else if (chart_type == "frequency_polygon") {
      p <- ggplot(df, aes(x = value)) +
        labs(title = paste("Frequency Polygon of", x_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_frequency_line)) {
        p <- p + geom_freqpoly(bins = 30, color = exploratory_line_color, linewidth = 1.1)
      }
      if (isTRUE(show_frequency_points)) {
        p <- p + stat_bin(
          aes(y = after_stat(count)),
          bins = 30,
          geom = "point",
          color = exploratory_point_color,
          size = 1.8
        )
      }
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only
      )
      p <- add_numeric_reference_layers(
        p,
        stats_payload = numeric_overlay_stats,
        orientation = "x",
        show_mean_label = show_mean_label,
        show_median_label = show_median_label,
        show_q1_label = show_q1_label,
        show_q3_label = show_q3_label,
        show_min_label = show_min_label,
        show_max_label = show_max_label,
        show_stats_panel = show_stats_panel
      )
    }

    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 6, height = 4, dpi = 200)
    return(invisible(TRUE))
  }

  # Dot plot (numeric or categorical)
  if (chart_type == "dot") {
    show_dots <- element_flag("show_dots", TRUE)
    show_value_labels <- element_flag("show_value_labels", FALSE)
    show_percentage_labels <- element_flag("show_percentage_labels", FALSE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)
    show_mean_label <- element_flag("show_mean_label", FALSE)
    show_median_label <- element_flag("show_median_label", FALSE)
    show_q1_label <- element_flag("show_q1_label", FALSE)
    show_q3_label <- element_flag("show_q3_label", FALSE)
    show_min_label <- element_flag("show_min_label", FALSE)
    show_max_label <- element_flag("show_max_label", FALSE)
    show_stats_panel <- element_flag("show_stats_panel", FALSE) || isTRUE(show_result_values_panel)

    x_raw <- data[[x_var]]
    x_num <- to_numeric(x_raw)
    if (!all(is.na(x_num))) {
      df <- data.frame(value = x_num)
      df <- df[!is.na(df$value), , drop = FALSE]
      bw <- diff(range(df$value, na.rm = TRUE)) / 30
      if (!is.finite(bw) || bw <= 0) bw <- 1
      p <- ggplot(df, aes(x = value)) +
        labs(title = paste("Dot Plot of", x_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_dots)) {
        p <- p + geom_dotplot(
          binaxis = "x",
          stackdir = "center",
          binwidth = bw,
          fill = exploratory_main_color,
          color = exploratory_border_color,
          dotsize = 0.6
        )
      }
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only
      )
      numeric_overlay_stats <- summarize_numeric_for_overlay(df$value)
      p <- add_numeric_reference_layers(
        p,
        stats_payload = numeric_overlay_stats,
        orientation = "x",
        show_mean_label = show_mean_label,
        show_median_label = show_median_label,
        show_q1_label = show_q1_label,
        show_q3_label = show_q3_label,
        show_min_label = show_min_label,
        show_max_label = show_max_label,
        show_stats_panel = show_stats_panel
      )
      custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 6, height = 4, dpi = 200)
      return(invisible(TRUE))
    }

    df <- prep_cat_counts(x_raw)
    if (nrow(df) == 0) stop("No data available.")
    dot_total <- sum(df$count, na.rm = TRUE)
    if (!is.finite(dot_total) || dot_total <= 0) dot_total <- 1
    df$percent <- (df$count / dot_total) * 100
    df$label_text <- if (isTRUE(show_percentage_labels)) {
      paste0(df$count, " (", format(round(df$percent, 1), trim = TRUE), "%)")
    } else {
      as.character(df$count)
    }
    p <- ggplot(df, aes(x = count, y = reorder(category, count))) +
      labs(title = paste("Dot Plot of", x_var), x = "Count", y = x_var) +
      theme_minimal()
    if (isTRUE(show_dots)) {
      p <- p + geom_point(size = 3, color = exploratory_point_color)
    }
    if (isTRUE(show_value_labels)) {
      p <- p + geom_text(aes(label = label_text), hjust = -0.12, size = 3.0, color = exploratory_label_color)
    }
    p <- p +
      scale_x_continuous(expand = expansion(mult = c(0, 0.1)))
    p <- add_grid_toggle(
      p,
      show_grid = show_grid,
      grid_color = exploratory_grid_color,
      show_paper_grid = show_paper_grid,
      show_dashed_grid = show_dashed_grid,
      show_dotted_grid = show_dotted_grid,
      show_x_grid_only = show_x_grid_only,
      show_y_grid_only = show_y_grid_only,
      force_white_background = TRUE
    )
    if (isTRUE(show_result_values_panel)) {
      p <- add_result_values_panel(
        p,
        build_categorical_panel_lines(summarize_categorical_vector(x_raw)),
        anchor = "top_left"
      )
    }
    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 6, height = 4, dpi = 200)
    return(invisible(TRUE))
  }

  # Categorical vs Categorical charts
  if (chart_type %in% c("stacked_bar", "grouped_bar", "cat_heatmap", "mosaic")) {
    show_bars <- element_flag("show_bars", TRUE)
    show_tiles <- element_flag("show_tiles", TRUE)
    show_mosaic <- element_flag("show_mosaic", TRUE)
    show_value_labels <- element_flag("show_value_labels", FALSE)
    show_percentage_labels <- element_flag("show_percentage_labels", FALSE)
    show_interval_short_names <- element_flag("show_interval_short_names", FALSE)
    hide_interval_values <- element_flag("hide_interval_values", FALSE)
    show_legend <- element_flag("show_legend", TRUE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)

    if (is.null(y_var) || y_var == "") stop("Selected chart requires both X and Y categorical variables.")
    x_vals <- limit_categories(data[[x_var]])
    y_vals <- limit_categories(data[[y_var]])
    df <- data.frame(x = as.factor(x_vals), y = as.factor(y_vals))
    df <- df[!is.na(df$x) & !is.na(df$y), , drop = FALSE]
    if (nrow(df) == 0) stop("No data available for selected categorical variables.")
    contingency_summary <- if (isTRUE(show_result_values_panel)) summarize_contingency_pair(x_vals, y_vals) else NULL

    if (chart_type == "mosaic") {
      label_cfg <- resolve_base_label_config(
        "exploratory_chart_plot",
        default_title = paste("Mosaic Plot:", x_var, "vs", y_var),
        default_x = x_var,
        default_y = y_var
      )
      tab <- table(df$x, df$y)
      png(output_path, width = 800, height = 500)
      par(mar = c(3.1, 3.0, 3.6, 2.2))
      if (isTRUE(show_mosaic)) {
        mosaicplot(
          tab,
          main = "",
          xlab = "",
          ylab = "",
          color = local_pick_cols(max(2, ncol(tab))),
          border = exploratory_border_color
        )
      } else {
        plot.new()
        text(
          x = 0.5,
          y = 0.5,
          labels = "Mosaic layer hidden.\nEnable 'Show Mosaic Tiles' in Plot Elements.",
          cex = 0.95,
          col = exploratory_label_color
        )
      }
      if (isTRUE(show_result_values_panel)) {
        mosaic_lines <- build_contingency_panel_lines(contingency_summary)
        mosaic_lines <- mosaic_lines[seq_len(min(length(mosaic_lines), 5))]
        if (length(mosaic_lines) > 0) {
          usr <- par("usr")
          text(
            x = usr[1] + 0.02 * (usr[2] - usr[1]),
            y = usr[4] - 0.02 * (usr[4] - usr[3]),
            labels = paste(mosaic_lines, collapse = "\n"),
            adj = c(0, 1),
            cex = 0.72,
            col = "#334155"
          )
        }
      }
      render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 2.9, caption_line = 4.2)
      dev.off()
      return(invisible(TRUE))
    }

    if (!requireNamespace("ggplot2", quietly = TRUE, lib.loc = local_lib)) {
      stop("ggplot2 package required for categorical charts.")
    }
    library(ggplot2)

    if (chart_type == "cat_heatmap") {
      tab_df <- as.data.frame(table(df$x, df$y))
      colnames(tab_df) <- c("x", "y", "count")
      show_short_names_effective <- isTRUE(show_interval_short_names) || isTRUE(hide_interval_values)
      x_levels_raw <- levels(df$x)
      y_levels_raw <- levels(df$y)
      x_levels_display <- format_interval_axis_labels(
        x_levels_raw,
        show_short_names = show_short_names_effective,
        hide_values = isTRUE(hide_interval_values),
        prefix = "Int"
      )
      y_levels_display <- format_interval_axis_labels(
        y_levels_raw,
        show_short_names = show_short_names_effective,
        hide_values = isTRUE(hide_interval_values),
        prefix = "Int"
      )
      x_map <- setNames(x_levels_display, x_levels_raw)
      y_map <- setNames(y_levels_display, y_levels_raw)
      tab_df$x_display <- unname(x_map[as.character(tab_df$x)])
      tab_df$y_display <- unname(y_map[as.character(tab_df$y)])
      tab_df$x_display[is.na(tab_df$x_display) | tab_df$x_display == ""] <- as.character(tab_df$x)[is.na(tab_df$x_display) | tab_df$x_display == ""]
      tab_df$y_display[is.na(tab_df$y_display) | tab_df$y_display == ""] <- as.character(tab_df$y)[is.na(tab_df$y_display) | tab_df$y_display == ""]
      tab_df$x_display <- factor(tab_df$x_display, levels = unique(x_levels_display))
      tab_df$y_display <- factor(tab_df$y_display, levels = unique(y_levels_display))
      tab_total <- sum(tab_df$count, na.rm = TRUE)
      if (!is.finite(tab_total) || tab_total <= 0) tab_total <- 1
      tab_df$percent <- (tab_df$count / tab_total) * 100
      tab_df$label_text <- if (isTRUE(show_percentage_labels)) {
        paste0(tab_df$count, " (", format(round(tab_df$percent, 1), trim = TRUE), "%)")
      } else {
        as.character(tab_df$count)
      }
      p <- ggplot(tab_df, aes(x = x_display, y = y_display, fill = count)) +
        labs(title = paste("Category Heatmap:", x_var, "vs", y_var), x = x_var, y = y_var) +
        theme_minimal()
      if (isTRUE(show_tiles)) {
        p <- p + geom_tile(color = exploratory_border_color)
      }
      if (isTRUE(show_value_labels)) {
        p <- p + geom_text(aes(label = label_text), size = 3.0, color = exploratory_label_color)
      }
      p <- p +
        scale_fill_gradient(low = exploratory_heatmap_low_color, high = exploratory_heatmap_high_color)
      p <- add_legend_toggle(p, show_legend = show_legend)
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only,
        force_white_background = TRUE
      )
      if (isTRUE(show_result_values_panel)) {
        p <- add_result_values_panel(p, build_contingency_panel_lines(contingency_summary), anchor = "top_left")
      }
      custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 6.5, height = 4.5, dpi = 200)
      return(invisible(TRUE))
    }

    tab_df <- as.data.frame(table(df$x, df$y))
    colnames(tab_df) <- c("x", "y", "count")
    tab_total <- sum(tab_df$count, na.rm = TRUE)
    if (!is.finite(tab_total) || tab_total <= 0) tab_total <- 1
    tab_df$percent <- (tab_df$count / tab_total) * 100
    tab_df$label_text <- if (isTRUE(show_percentage_labels)) {
      paste0(tab_df$count, " (", format(round(tab_df$percent, 1), trim = TRUE), "%)")
    } else {
      as.character(tab_df$count)
    }
    if (chart_type == "grouped_bar") {
      grouped_dodge_width <- 0.78
      grouped_bar_width <- 0.66
      p <- ggplot(tab_df, aes(x = x, y = count, fill = y)) +
        scale_fill_manual(values = local_pick_cols(length(unique(tab_df$y)))) +
        labs(title = paste("Grouped Bar:", x_var, "by", y_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_bars)) {
        p <- p + geom_col(
          position = position_dodge(width = grouped_dodge_width),
          width = grouped_bar_width,
          color = exploratory_border_color,
          linewidth = 0.24
        )
      }
      if (isTRUE(show_value_labels)) {
        p <- p + geom_text(
          aes(label = label_text, group = y),
          position = position_dodge(width = grouped_dodge_width),
          vjust = -0.2,
          size = 2.9,
          color = exploratory_label_color
        )
      }
      p <- p + scale_y_continuous(expand = expansion(mult = c(0, 0.12)))
    } else {
      p <- ggplot(tab_df, aes(x = x, y = count, fill = y)) +
        scale_fill_manual(values = local_pick_cols(length(unique(tab_df$y)))) +
        labs(title = paste("Stacked Bar:", x_var, "by", y_var), x = x_var, y = "Count") +
        theme_minimal()
      if (isTRUE(show_bars)) {
        p <- p + geom_col(color = exploratory_border_color, linewidth = 0.24)
      }
      if (isTRUE(show_value_labels)) {
        p <- p + geom_text(
          aes(label = label_text),
          position = position_stack(vjust = 0.5),
          size = 2.8,
          color = exploratory_label_color
        )
      }
    }
    p <- add_legend_toggle(p, show_legend = show_legend)
    p <- add_grid_toggle(
      p,
      show_grid = show_grid,
      grid_color = exploratory_grid_color,
      show_paper_grid = show_paper_grid,
      show_dashed_grid = show_dashed_grid,
      show_dotted_grid = show_dotted_grid,
      show_x_grid_only = show_x_grid_only,
      show_y_grid_only = show_y_grid_only,
      force_white_background = TRUE
    )
    if (isTRUE(show_result_values_panel)) {
      p <- add_result_values_panel(p, build_contingency_panel_lines(contingency_summary), anchor = "top_left")
    }
    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 7, height = 4.5, dpi = 200)
    return(invisible(TRUE))
  }

  # Violin: univariate numeric ("violin") or grouped categorical-numeric ("grouped_violin")
  if (chart_type %in% c("violin", "grouped_violin")) {
    show_violin <- element_flag("show_violin", TRUE)
    show_inner_box <- element_flag("show_inner_box", TRUE)
    show_legend <- element_flag("show_legend", TRUE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)
    show_mean_label <- element_flag("show_mean_label", FALSE)
    show_median_label <- element_flag("show_median_label", FALSE)
    show_q1_label <- element_flag("show_q1_label", FALSE)
    show_q3_label <- element_flag("show_q3_label", FALSE)
    show_min_label <- element_flag("show_min_label", FALSE)
    show_max_label <- element_flag("show_max_label", FALSE)
    show_stats_panel <- element_flag("show_stats_panel", FALSE) || isTRUE(show_result_values_panel)

    if (chart_type == "grouped_violin" && (is.null(y_var) || y_var == "")) {
      stop("Grouped violin plot requires X and Y variables.")
    }

    if (!is.null(y_var) && y_var != "") {
      x_vals <- as.factor(data[[x_var]])
      y_vals <- to_numeric(data[[y_var]])
      if (all(is.na(y_vals))) stop("Y variable must be numeric for violin plot.")
      df <- data.frame(group = x_vals, value = y_vals)
      df <- df[!is.na(df$value) & !is.na(df$group), , drop = FALSE]
      group_levels <- levels(df$group)
      if (length(group_levels) == 0) {
        group_levels <- unique(as.character(df$group))
      }
      group_fill_map <- get_level_color_map(
        x_var,
        group_levels,
        local_pick_cols(length(group_levels))
      )
      p <- ggplot(df, aes(x = group, y = value, fill = group)) +
        labs(title = paste("Violin Plot of", y_var, "by", x_var), x = x_var, y = y_var, fill = x_var) +
        theme_minimal()
      if (isTRUE(show_violin)) {
        p <- p + geom_violin(color = exploratory_border_color, alpha = 0.8)
      }
      if (isTRUE(show_inner_box)) {
        p <- p + geom_boxplot(
          width = 0.15,
          fill = exploratory_accent_color,
          color = exploratory_border_color,
          outlier.alpha = 0.2,
          show.legend = FALSE
        )
      }
      p <- p + scale_fill_manual(values = group_fill_map)
      p <- add_grid_toggle(
        p,
        show_grid = show_grid,
        grid_color = exploratory_grid_color,
        show_paper_grid = show_paper_grid,
        show_dashed_grid = show_dashed_grid,
        show_dotted_grid = show_dotted_grid,
        show_x_grid_only = show_x_grid_only,
        show_y_grid_only = show_y_grid_only
      )
      p <- add_legend_toggle(p, show_legend = show_legend)
      grouped_overlay <- summarize_grouped_numeric_pair(
        df$group,
        df$value,
        top_n_groups = length(unique(as.character(df$group)))
      )
      grouped_overlay$group_var <- x_var
      grouped_overlay$value_var <- y_var

      show_group_stat_guides <- isTRUE(show_mean_label) || isTRUE(show_median_label) ||
        isTRUE(show_q1_label) || isTRUE(show_q3_label) ||
        isTRUE(show_min_label) || isTRUE(show_max_label)
      if (isTRUE(show_group_stat_guides)) {
        group_rows <- if (is.list(grouped_overlay$groups)) grouped_overlay$groups else list()
        if (length(group_rows) > 0) {
          group_levels_plot <- levels(df$group)
          if (length(group_levels_plot) == 0) {
            group_levels_plot <- unique(as.character(df$group))
          }
          grouped_summary_df <- data.frame(
            group = factor(vapply(group_rows, function(r) safe_overlay_text(to_plain_list(r)$group, ""), character(1)), levels = group_levels_plot),
            mean = as.numeric(vapply(group_rows, function(r) suppressWarnings(as.numeric(to_plain_list(r)$mean[1])), numeric(1))),
            median = as.numeric(vapply(group_rows, function(r) suppressWarnings(as.numeric(to_plain_list(r)$median[1])), numeric(1))),
            q1 = as.numeric(vapply(group_rows, function(r) suppressWarnings(as.numeric(to_plain_list(r)$q1[1])), numeric(1))),
            q3 = as.numeric(vapply(group_rows, function(r) suppressWarnings(as.numeric(to_plain_list(r)$q3[1])), numeric(1))),
            min = as.numeric(vapply(group_rows, function(r) suppressWarnings(as.numeric(to_plain_list(r)$min[1])), numeric(1))),
            max = as.numeric(vapply(group_rows, function(r) suppressWarnings(as.numeric(to_plain_list(r)$max[1])), numeric(1))),
            stringsAsFactors = FALSE
          )
          grouped_summary_df <- grouped_summary_df[!is.na(grouped_summary_df$group), , drop = FALSE]
          y_vals_plot <- df$value[is.finite(df$value)]
          y_span_plot <- suppressWarnings(diff(range(y_vals_plot, na.rm = TRUE)))
          if (!is.finite(y_span_plot) || y_span_plot <= 0) {
            y_span_plot <- suppressWarnings(stats::sd(y_vals_plot, na.rm = TRUE))
          }
          if (!is.finite(y_span_plot) || y_span_plot <= 0) y_span_plot <- 1

          p <- add_box_to_axis_guides(
            p,
            summary_df = grouped_summary_df,
            group_levels = group_levels_plot,
            y_span = y_span_plot,
            box_width = 0.22,
            show_mean = show_mean_label,
            show_median = show_median_label,
            show_q1 = show_q1_label,
            show_q3 = show_q3_label,
            show_min = show_min_label,
            show_max = show_max_label,
            show_ci_low = FALSE,
            show_ci_high = FALSE,
            show_values = TRUE,
            mean_color = "#2563eb",
            median_color = "#0f766e",
            q1_color = "#7c3aed",
            q3_color = "#ea580c",
            min_color = "#b45309",
            max_color = "#92400e",
            line_type = "longdash",
            line_width = 0.58,
            value_digits = 3
          )
        }
      }

      if (isTRUE(show_stats_panel) || isTRUE(show_result_values_panel)) {
        p <- add_result_values_panel(p, build_grouped_numeric_panel_lines(grouped_overlay), anchor = "top_left")
      }
      custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 7, height = 4.5, dpi = 200)
      return(invisible(TRUE))
    }

    y_vals <- to_numeric(data[[x_var]])
    if (all(is.na(y_vals))) stop("Selected variable must be numeric for violin plot.")
    df <- data.frame(value = y_vals)
    df <- df[!is.na(df$value), , drop = FALSE]
    p <- ggplot(df, aes(x = "", y = value)) +
      labs(title = paste("Violin Plot of", x_var), x = NULL, y = x_var) +
      theme_minimal() +
      theme(axis.text.x = element_blank(), axis.ticks.x = element_blank())
    if (isTRUE(show_violin)) {
      p <- p + geom_violin(fill = exploratory_main_color, color = exploratory_border_color, alpha = 0.8)
    }
    if (isTRUE(show_inner_box)) {
      p <- p + geom_boxplot(width = 0.15, fill = exploratory_accent_color, color = exploratory_border_color, outlier.alpha = 0.2)
    }
    p <- add_grid_toggle(
      p,
      show_grid = show_grid,
      grid_color = exploratory_grid_color,
      show_paper_grid = show_paper_grid,
      show_dashed_grid = show_dashed_grid,
      show_dotted_grid = show_dotted_grid,
      show_x_grid_only = show_x_grid_only,
      show_y_grid_only = show_y_grid_only
    )
    numeric_overlay_stats <- summarize_numeric_for_overlay(df$value)
    p <- add_numeric_reference_layers(
      p,
      stats_payload = numeric_overlay_stats,
      orientation = "y",
      show_mean_label = show_mean_label,
      show_median_label = show_median_label,
      show_q1_label = show_q1_label,
      show_q3_label = show_q3_label,
      show_min_label = show_min_label,
      show_max_label = show_max_label,
      show_stats_panel = show_stats_panel
    )
    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 5, height = 4, dpi = 200)
    return(invisible(TRUE))
  }

  # Scatter plot
  if (chart_type == "scatter") {
    show_points <- element_flag("show_points", TRUE)
    show_trend_line <- element_flag("show_trend_line", FALSE)
    show_ci_band <- element_flag("show_ci_band", FALSE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)
    scatter_ci_level <- resolve_conf_level_from_alpha(alpha_val)

    if (is.null(y_var) || y_var == "") stop("Scatter plot requires X and Y variables.")
    x_num <- to_numeric(data[[x_var]])
    y_num <- to_numeric(data[[y_var]])
    if (all(is.na(x_num)) || all(is.na(y_num))) stop("Scatter plot requires numeric variables.")
    df <- data.frame(x = x_num, y = y_num)
    df <- df[!is.na(df$x) & !is.na(df$y), , drop = FALSE]
    p <- ggplot(df, aes(x = x, y = y)) +
      labs(title = paste("Scatter Plot:", x_var, "vs", y_var), x = x_var, y = y_var) +
      theme_minimal()
    if (isTRUE(show_points)) {
      p <- p + geom_point(color = exploratory_point_color, alpha = 0.7)
    }
    if (isTRUE(show_trend_line) && nrow(df) >= 3) {
      p <- p + geom_smooth(
        method = "lm",
        formula = y ~ x,
        se = isTRUE(show_ci_band),
        level = scatter_ci_level,
        color = exploratory_line_color,
        linewidth = 1.0
      )
    }
    p <- add_grid_toggle(
      p,
      show_grid = show_grid,
      grid_color = exploratory_grid_color,
      show_paper_grid = show_paper_grid,
      show_dashed_grid = show_dashed_grid,
      show_dotted_grid = show_dotted_grid,
      show_x_grid_only = show_x_grid_only,
      show_y_grid_only = show_y_grid_only
    )
    if (isTRUE(show_result_values_panel)) {
      pair_overlay <- summarize_numeric_pair(df$x, df$y)
      p <- add_result_values_panel(p, build_numeric_pair_panel_lines(pair_overlay, include_model = TRUE), anchor = "top_left")
    }
    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 6.5, height = 4.5, dpi = 200)
    return(invisible(TRUE))
  }

  # Line / Area charts
  if (chart_type %in% c("line", "area")) {
    show_line <- element_flag("show_line", TRUE)
    show_points <- element_flag("show_points", chart_type == "line")
    show_area <- element_flag("show_area", TRUE)
    show_result_values_panel <- element_flag("show_result_values_panel", FALSE)
    show_grid <- element_flag("show_grid", TRUE)
    show_paper_grid <- element_flag("show_paper_grid", FALSE)
    show_dashed_grid <- element_flag("show_dashed_grid", FALSE)
    show_dotted_grid <- element_flag("show_dotted_grid", FALSE)
    show_x_grid_only <- element_flag("show_x_grid_only", FALSE)
    show_y_grid_only <- element_flag("show_y_grid_only", FALSE)

    if (is.null(y_var) || y_var == "") stop("Line/Area chart requires X and Y variables.")
    x_raw <- data[[x_var]]
    y_num <- to_numeric(data[[y_var]])
    if (all(is.na(y_num))) stop("Y variable must be numeric for line/area charts.")

    x_date <- rep(as.Date(NA), length(x_raw))
    if (is.character(x_raw) || is.factor(x_raw)) {
      x_char <- as.character(x_raw)
      x_date <- tryCatch(
        suppressWarnings(as.Date(
          x_char,
          tryFormats = c("%Y-%m-%d", "%m/%d/%Y", "%d/%m/%Y", "%Y/%m/%d")
        )),
        error = function(e) rep(as.Date(NA), length(x_char))
      )
    }
    x_num <- to_numeric(x_raw)
    if (!all(is.na(x_date))) {
      x_vals <- x_date
    } else if (!all(is.na(x_num))) {
      x_vals <- x_num
    } else {
      x_vals <- factor(as.character(x_raw), levels = unique(as.character(x_raw)))
    }

    df <- data.frame(x = x_vals, y = y_num)
    df <- df[!is.na(df$y) & !is.na(df$x), , drop = FALSE]
    if (is.numeric(df$x) || inherits(df$x, "Date")) {
      df <- df[order(df$x), , drop = FALSE]
    }

    if (chart_type == "line") {
      p <- ggplot(df, aes(x = x, y = y, group = 1)) +
        labs(title = paste("Line Chart:", y_var, "over", x_var), x = x_var, y = y_var) +
        theme_minimal()
      if (isTRUE(show_line)) {
        p <- p + geom_line(color = exploratory_line_color, linewidth = 1.1)
      }
      if (isTRUE(show_points)) {
        p <- p + geom_point(color = exploratory_point_color, size = 1.6)
      }
    } else {
      p <- ggplot(df, aes(x = x, y = y, group = 1)) +
        labs(title = paste("Area Chart:", y_var, "over", x_var), x = x_var, y = y_var) +
        theme_minimal()
      if (isTRUE(show_area)) {
        p <- p + geom_area(fill = exploratory_area_fill_color, alpha = 0.4)
      }
      if (isTRUE(show_line)) {
        p <- p + geom_line(color = exploratory_line_color, linewidth = 1.1)
      }
      if (isTRUE(show_points)) {
        p <- p + geom_point(color = exploratory_point_color, size = 1.4)
      }
    }
    p <- add_grid_toggle(
      p,
      show_grid = show_grid,
      grid_color = exploratory_grid_color,
      show_paper_grid = show_paper_grid,
      show_dashed_grid = show_dashed_grid,
      show_dotted_grid = show_dotted_grid,
      show_x_grid_only = show_x_grid_only,
      show_y_grid_only = show_y_grid_only
    )
    if (isTRUE(show_result_values_panel)) {
      if (is.numeric(df$x) || inherits(df$x, "Date")) {
        pair_overlay <- summarize_numeric_pair(as.numeric(df$x), df$y)
        p <- add_result_values_panel(p, build_numeric_pair_panel_lines(pair_overlay, include_model = TRUE), anchor = "top_left")
      } else {
        grouped_overlay <- summarize_grouped_numeric_pair(as.character(df$x), df$y)
        p <- add_result_values_panel(p, build_grouped_numeric_panel_lines(grouped_overlay), anchor = "top_left")
      }
    }
    custom_ggsave(output_path, plot = p, plot_key = "exploratory_chart_plot", width = 6.5, height = 4.5, dpi = 200)
    return(invisible(TRUE))
  }

  stop(paste("Unknown chart type:", chart_type))
}

tryCatch({
  profile_msg("Starting data read (read_any_file)")
  # log_entry(paste0('data <- read_any_file("', input_file, '")'))
  data <- read_any_file(input_file)
  emit_progress(6, "Pass 0", "Dataset loaded", "")
  profile_msg("Data read complete")

  if (base_analysis_mode == "inferential" && inferential_workflow == "anova_factorial" && is.null(group_var2)) {
    cat(toJSON(list(error = "ANOVA Factorial workflow requires a second factor (Factor 2)."), auto_unbox = TRUE))
    quit(save = "no")
  }
  
  # Check if this is color-only mode (regenerate plots with new colors, no re-computation)
  is_color_only <- grepl("_color_only$", analysis_mode)
  
  is_inferential_correlation_mode <- startsWith(base_analysis_mode, "inferential_correlation_matrix")

  # Set the global mode label so the quit() override can emit the correct TIMING line.
  t_mode_label <<- analysis_mode

  profile_msg(paste("Mode determined:", base_analysis_mode))

  # Load only the packages this specific sub-workflow needs.
  # This avoids loading dunn.test/multcompView for one_value, or cluster for group_comparison, etc.
  if (!startsWith(base_analysis_mode, "descriptive") &&
      !is_inferential_correlation_mode &&
      !startsWith(base_analysis_mode, "regression") &&
      !startsWith(base_analysis_mode, "multivariate")) {
    wf_pkgs <- if (base_analysis_mode == "predict_logistic") {
      wf_predict_log_pkgs
    } else {
      # analysis_mode is "inferential" — branch on inferential_workflow
      switch(inferential_workflow,
        "group_comparison"    = wf_group_cmp_pkgs,
        "anova_factorial"     = wf_anova_pkgs,
        "one_value_comparison"= wf_one_value_pkgs,
        "correlation_matrix"  = wf_corr_pkgs,
        wf_group_cmp_pkgs   # safe fallback
      )
    }
    profile_msg(paste("Loading workflow pkgs:", paste(wf_pkgs, collapse=",")))
    invisible(load_pkgs(wf_pkgs))
    profile_msg("Workflow pkgs loaded")
  }


  # DESCRIPTIVE STATISTICS MODE (+ inferential correlation workflow reusing matrix engine)
  if (startsWith(base_analysis_mode, "descriptive") || is_inferential_correlation_mode) {
    profile_msg("Loading descriptive pkgs")
    invisible(load_pkgs(c(descriptive_pkgs)))
    profile_msg("Descriptive pkgs loaded")
    
    if (startsWith(base_analysis_mode, "descriptive_exploratory_multi_")) {
      relation_type <- tolower(sub("^descriptive_exploratory_multi_?", "", base_analysis_mode))
      if (!(relation_type %in% c("cat_num", "cat_cat", "num_num"))) {
        cat(toJSON(list(error = paste("Unsupported multi exploratory relation type:", relation_type)), auto_unbox = TRUE))
        quit(save = "no")
      }

      parse_var_list <- function(text) {
        if (is.null(text)) return(character(0))
        txt <- trimws(as.character(text))
        if (length(txt) == 0 || txt[1] == "") return(character(0))
        out <- trimws(unlist(strsplit(txt[1], ",")))
        out <- out[out != ""]
        unique(out)
      }

      requested_numeric <- parse_var_list(group_var)
      requested_categorical <- parse_var_list(response_var)

      missing_numeric <- setdiff(requested_numeric, colnames(data))
      if (length(missing_numeric) > 0) {
        cat(toJSON(list(error = paste("Numeric candidate variables not found:", paste(missing_numeric, collapse = ", "))), auto_unbox = TRUE))
        quit(save = "no")
      }
      missing_categorical <- setdiff(requested_categorical, colnames(data))
      if (length(missing_categorical) > 0) {
        cat(toJSON(list(error = paste("Categorical candidate variables not found:", paste(missing_categorical, collapse = ", "))), auto_unbox = TRUE))
        quit(save = "no")
      }

      auto_numeric <- colnames(data)[sapply(data, is_effectively_numeric)]
      auto_categorical <- setdiff(colnames(data), auto_numeric)

      numeric_candidates <- if (length(requested_numeric) > 0) requested_numeric else auto_numeric
      categorical_candidates <- if (length(requested_categorical) > 0) requested_categorical else auto_categorical

      numeric_candidates <- unique(numeric_candidates[numeric_candidates %in% colnames(data)])
      categorical_candidates <- unique(categorical_candidates[categorical_candidates %in% colnames(data)])

      if (relation_type == "num_num" && length(numeric_candidates) < 2) {
        cat(toJSON(list(error = "Multi-analyse Num × Num requires at least 2 numeric variables."), auto_unbox = TRUE))
        quit(save = "no")
      }
      if (relation_type == "cat_cat" && length(categorical_candidates) < 2) {
        cat(toJSON(list(error = "Multi-analyse Cat × Cat requires at least 2 categorical variables."), auto_unbox = TRUE))
        quit(save = "no")
      }
      if (relation_type == "cat_num") {
        distinct_pairs <- sum(outer(categorical_candidates, numeric_candidates, FUN = "!="))
        if (length(categorical_candidates) < 1 || length(numeric_candidates) < 1 || distinct_pairs <= 0) {
          cat(toJSON(list(error = "Multi-analyse Cat × Num requires at least one categorical variable and one different numeric variable."), auto_unbox = TRUE))
          quit(save = "no")
        }
      }

      build_pair_entry <- function(x_name, y_name, pair_type) {
        x_values <- data[[x_name]]
        y_values <- data[[y_name]]
        if (pair_type == "num_num") {
          relationship <- summarize_numeric_pair(x_values, y_values)
          return(list(
            pair_id = paste0(x_name, "__", y_name),
            pair_type = pair_type,
            x_var = x_name,
            y_var = y_name,
            x_type = "numeric",
            y_type = "numeric",
            summary = list(
              x_summary = summarize_numeric_vector(x_values),
              y_summary = summarize_numeric_vector(y_values),
              relationship = relationship
            )
          ))
        }
        if (pair_type == "cat_cat") {
          relationship <- summarize_contingency_pair(x_values, y_values)
          return(list(
            pair_id = paste0(x_name, "__", y_name),
            pair_type = pair_type,
            x_var = x_name,
            y_var = y_name,
            x_type = "categorical",
            y_type = "categorical",
            summary = list(
              x_summary = summarize_categorical_vector(x_values),
              y_summary = summarize_categorical_vector(y_values),
              relationship = relationship
            )
          ))
        }
        relationship <- summarize_grouped_numeric_pair(x_values, y_values)
        relationship$group_var <- x_name
        relationship$value_var <- y_name
        list(
          pair_id = paste0(x_name, "__", y_name),
          pair_type = pair_type,
          x_var = x_name,
          y_var = y_name,
          x_type = "categorical",
          y_type = "numeric",
          summary = list(
            x_summary = summarize_categorical_vector(x_values),
            y_summary = summarize_numeric_vector(y_values),
            relationship = relationship
          )
        )
      }

      pair_results <- list()

      if (relation_type == "num_num") {
        num_pairs <- utils::combn(numeric_candidates, 2, simplify = FALSE)
        for (pair_item in num_pairs) {
          entry <- build_pair_entry(pair_item[1], pair_item[2], "num_num")
          pair_results[[length(pair_results) + 1]] <- entry
        }
      } else if (relation_type == "cat_cat") {
        cat_pairs <- utils::combn(categorical_candidates, 2, simplify = FALSE)
        for (pair_item in cat_pairs) {
          entry <- build_pair_entry(pair_item[1], pair_item[2], "cat_cat")
          pair_results[[length(pair_results) + 1]] <- entry
        }
      } else {
        for (cat_name in categorical_candidates) {
          for (num_name in numeric_candidates) {
            if (cat_name == num_name) next
            entry <- build_pair_entry(cat_name, num_name, "cat_num")
            pair_results[[length(pair_results) + 1]] <- entry
          }
        }
      }

      message_text <- if (length(pair_results) > 0) {
        paste0("Computed ", length(pair_results), " pair summaries for ", relation_type, ".")
      } else {
        paste0("No valid pairs were generated for ", relation_type, ".")
      }

      result_list <- list(
        mode = "descriptive",
        exploratory_multi = list(
          relation_type = relation_type,
          alpha = as.numeric(alpha_val),
          requested_numeric = requested_numeric,
          requested_categorical = requested_categorical,
          numeric_columns = numeric_candidates,
          categorical_columns = categorical_candidates,
          pair_count = as.numeric(length(pair_results)),
          message = message_text,
          pairs = pair_results
        )
      )

      cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
      quit(save = "no")
    }

    # Exploratory charts mode
    if (startsWith(base_analysis_mode, "descriptive_exploratory")) {
      chart_type <- sub("^descriptive_exploratory_?", "", base_analysis_mode)
      if (chart_type == "") chart_type <- "histogram"

      x_var <- group_var
      y_var <- response_var

      if (is.null(x_var) || x_var == "" || !(x_var %in% colnames(data))) {
        cat(toJSON(list(error = "Exploratory charts require a valid X variable."), auto_unbox = TRUE))
        quit(save = "no")
      }

      needs_y <- chart_type %in% c("scatter", "line", "area", "grouped_violin", "stacked_bar", "grouped_bar", "cat_heatmap", "mosaic")
      if (needs_y && (is.null(y_var) || y_var == "" || !(y_var %in% colnames(data)))) {
        cat(toJSON(list(error = "Selected chart type requires a valid Y variable."), auto_unbox = TRUE))
        quit(save = "no")
      }

      x_values <- data[[x_var]]
      y_values <- if (needs_y) data[[y_var]] else NULL

      force_numeric_x <- chart_type %in% c("histogram", "box", "violin", "density", "stem", "frequency_polygon", "scatter")
      force_categorical_x <- chart_type %in% c("bar", "pie", "pareto", "grouped_violin", "stacked_bar", "grouped_bar", "mosaic", "cat_heatmap")
      force_numeric_y <- chart_type %in% c("scatter", "line", "area", "grouped_violin")
      force_categorical_y <- chart_type %in% c("stacked_bar", "grouped_bar", "mosaic", "cat_heatmap")

      x_is_numeric <- if (force_numeric_x) TRUE else if (force_categorical_x) FALSE else is_effectively_numeric(x_values)
      y_is_numeric <- if (!needs_y) FALSE else if (force_numeric_y) TRUE else if (force_categorical_y) FALSE else is_effectively_numeric(y_values)

      x_summary <- if (x_is_numeric) summarize_numeric_vector(x_values) else summarize_categorical_vector(x_values)
      y_summary <- if (needs_y) {
        if (y_is_numeric) summarize_numeric_vector(y_values) else summarize_categorical_vector(y_values)
      } else NULL

      relationship_summary <- NULL
      if (needs_y) {
        if (x_is_numeric && y_is_numeric) {
          relationship_summary <- summarize_numeric_pair(x_values, y_values)
        } else if (!x_is_numeric && !y_is_numeric) {
          relationship_summary <- summarize_contingency_pair(x_values, y_values)
        } else {
          if (!x_is_numeric) {
            relationship_summary <- summarize_grouped_numeric_pair(x_values, y_values)
            relationship_summary$group_var <- x_var
            relationship_summary$value_var <- y_var
          } else {
            relationship_summary <- summarize_grouped_numeric_pair(y_values, x_values)
            relationship_summary$group_var <- y_var
            relationship_summary$value_var <- x_var
          }
        }
      }

      plot_ok <- TRUE
      plot_err <- NULL
      tryCatch({
        plot_exploratory_chart(data, chart_type, x_var, y_var, output_image)
      }, error = function(e) {
        plot_ok <<- FALSE
        plot_err <<- e$message
      })

      result_list <- list(
        mode = "descriptive",
        exploratory_chart = list(
          chart_type = chart_type,
          x_var = x_var,
          y_var = if (needs_y) y_var else "",
          x_type = if (x_is_numeric) "numeric" else "categorical",
          y_type = if (needs_y) if (y_is_numeric) "numeric" else "categorical" else "",
          summary = list(
            x_summary = x_summary,
            y_summary = y_summary,
            relationship = relationship_summary
          ),
          plot_generated = plot_ok,
          plot_error = plot_err
        )
      )

      cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
      quit(save = "no")
    }

    # Check if this is scatter-only mode (quick refresh of scatter plots only)
    is_scatter_only <- (base_analysis_mode == "descriptive_scatter_only" || base_analysis_mode == "inferential_correlation_matrix_scatter_only")
    
    # Initialize univariate results
    univariate_results <- list()
    
    corr_mode <- is_inferential_correlation_mode || (group_var == "" || group_var == "CORRELATION_MATRIX" || grepl(",", group_var))
    
    if (corr_mode) {
      # Correlation matrix: allow all numeric or user-selected vars (group_var comma-separated)
      corr_vars <- NULL
      if (group_var == "" || group_var == "CORRELATION_MATRIX") {
        corr_vars <- colnames(data)[sapply(data, is.numeric)]
      } else {
        corr_vars <- unique(trimws(unlist(strsplit(group_var, ","))))
        corr_vars <- corr_vars[corr_vars != ""]
        missing <- setdiff(corr_vars, colnames(data))
        if (length(missing) > 0) {
          cat(toJSON(list(error = paste("Variables not found:", paste(missing, collapse = ", "))), auto_unbox = TRUE))
          quit(save = "no")
        }
      }
      
      numeric_cols <- corr_vars[sapply(data[, corr_vars, drop = FALSE], is.numeric)]
      if (length(numeric_cols) < 2) {
        cat(toJSON(list(error = "Correlation matrix requires at least 2 numeric variables"), auto_unbox = TRUE))
        quit(save = "no")
      }
      
      numeric_data <- data[, numeric_cols, drop = FALSE]
      n_vars <- ncol(numeric_data)
      var_names <- colnames(numeric_data)
      
      # Shapiro-first decision rule for correlation method selection
      shapiro_results <- list()
      all_normal <- TRUE
      for (var_name in var_names) {
        vals <- numeric_data[[var_name]]
        vals <- vals[!is.na(vals)]
        n_obs <- length(vals)
        tested_n <- n_obs
        p_val <- NA
        stat_val <- NA
        is_normal_var <- FALSE
        msg <- ""

        if (n_obs < 3) {
          msg <- sprintf("%s: Shapiro-Wilk requires n >= 3 (n=%d). Marked as non-normal.", var_name, n_obs)
        } else {
          test_vals <- vals
          if (n_obs > 5000) {
            tested_n <- 5000
            set.seed(123)
            test_vals <- sample(vals, 5000)
          }
          sh_res <- tryCatch(shapiro.test(test_vals), error = function(e) NULL)
          if (is.null(sh_res)) {
            msg <- sprintf("%s: Shapiro-Wilk failed. Marked as non-normal.", var_name)
          } else {
            p_val <- as.numeric(sh_res$p.value)
            stat_val <- as.numeric(sh_res$statistic)
            is_normal_var <- !is.na(p_val) && (p_val >= alpha_val)
            msg <- if (is_normal_var) {
              sprintf("%s: Shapiro p = %s (>= %.3f).", var_name, fmt_p_value(p_val), alpha_val)
            } else {
              sprintf("%s: Shapiro p = %s (< %.3f).", var_name, fmt_p_value(p_val), alpha_val)
            }
          }
        }

        shapiro_results[[var_name]] <- list(
          n = n_obs,
          tested_n = tested_n,
          p_value = p_val,
          formatted_p = fmt_p_value(p_val),
          statistic = stat_val,
          is_normal = is_normal_var,
          message = msg
        )
        if (!is_normal_var) all_normal <- FALSE
      }

      selected_method <- if (all_normal) "pearson" else "spearman"
      available_methods <- if (correlation_force_both) c("pearson", "spearman") else c(selected_method)
      method_decision_message <- if (correlation_force_both) {
        sprintf("Bypass enabled: both Pearson and Spearman are returned. Shapiro suggested %s.", selected_method)
      } else if (all_normal) {
        "All selected variables passed Shapiro normality checks; Pearson selected."
      } else {
        "At least one selected variable failed Shapiro normality checks; Spearman selected."
      }

      # Calculate full matrices once, then expose only requested methods
      log_entry("cor(numeric_data, method = 'pearson')")
      cor_pearson_full <- cor(numeric_data, use = "pairwise.complete.obs", method = "pearson")
      cor_spearman_full <- cor(numeric_data, use = "pairwise.complete.obs", method = "spearman")
      cor_pearson <- if ("pearson" %in% available_methods) cor_pearson_full else NULL
      cor_spearman <- if ("spearman" %in% available_methods) cor_spearman_full else NULL
      
      # Perform univariate analysis for each numeric variable
      for (var_name in var_names) {
        univariate_results[[var_name]] <- analyze_variable(numeric_data[[var_name]], var_name)
      }

      
      
      # Generate correlation heatmaps and linearity plots using ggplot2
      heatmap_image <- NULL
      spearman_heatmap_image <- NULL
      pearson_heatmap_features <- NULL
      spearman_heatmap_features <- NULL
      linearity_plot_image <- NULL
      spearman_linearity_plot_image <- NULL
      
      plot_generated <- FALSE
      plot_error <- NULL
      tryCatch({
        if (!requireNamespace("ggplot2", quietly = TRUE) || !requireNamespace("reshape2", quietly = TRUE)) {
          stop("ggplot2 and reshape2 packages required for correlation heatmap")
        }
        library(ggplot2)
        library(reshape2)
        
        # Generate heatmaps only when not in scatter-only mode
        if (!is_scatter_only) {
          if (!is.null(cor_pearson)) {
            cor_melted <- melt(cor_pearson)
            colnames(cor_melted) <- c("Var1", "Var2", "value")
            pearson_heatmap_features <- build_heatmap_publication_features(
              cor_pearson,
              row_labels = rownames(cor_pearson),
              col_labels = colnames(cor_pearson),
              metric_name = "Pearson r",
              context = "correlation_pearson",
              top_n = 12L,
              rank_mode = "abs_desc",
              exclude_diagonal = TRUE
            )

            pearson_palette <- get_palette(get_plot_color("heatmap_pearson", default_color_scheme))
            pearson_scale <- resolve_heatmap_scale_colors(pearson_palette, centered = TRUE)
            pearson_heatmap_labels_cfg <- to_plain_list(resolve_labels_for_plot("heatmap_plot"))
            pearson_show_values <- resolve_plot_element_flag(pearson_heatmap_labels_cfg, "show_heatmap_values", n_vars <= 12)
            pearson_show_legend <- resolve_plot_element_flag(pearson_heatmap_labels_cfg, "show_legend", TRUE)
            pearson_show_row_labels <- resolve_plot_element_flag(pearson_heatmap_labels_cfg, "show_heatmap_row_labels", TRUE)
            pearson_show_column_labels <- resolve_plot_element_flag(pearson_heatmap_labels_cfg, "show_heatmap_column_labels", TRUE)
            pearson_show_cell_borders <- resolve_plot_element_flag(pearson_heatmap_labels_cfg, "show_heatmap_cell_borders", TRUE)
            cor_melted$label_color <- ifelse(abs(cor_melted$value) >= 0.55, "#f8fafc", "#0f172a")

            p_pearson <- ggplot(cor_melted, aes(x = Var1, y = Var2, fill = value)) +
              geom_tile(color = if (isTRUE(pearson_show_cell_borders)) "#ffffff" else NA) +
              scale_fill_gradient2(low = pearson_scale$low, high = pearson_scale$high, mid = pearson_scale$mid,
                                   midpoint = 0, limit = c(-1, 1), space = "Lab",
                                   name = "Pearson\nCorrelation") +
              theme_minimal() +
              theme(
                axis.text.x = if (isTRUE(pearson_show_column_labels)) element_text(angle = 45, vjust = 1, hjust = 1, size = 10) else element_blank(),
                axis.text.y = if (isTRUE(pearson_show_row_labels)) element_text(size = 10) else element_blank(),
                axis.ticks.x = if (isTRUE(pearson_show_column_labels)) element_line() else element_blank(),
                axis.ticks.y = if (isTRUE(pearson_show_row_labels)) element_line() else element_blank(),
                axis.title = element_blank(),
                panel.grid.major = element_blank(),
                panel.grid.minor = element_blank(),
                plot.title = element_text(face = "bold", size = 14, hjust = 0.5)
              ) +
              labs(title = "Pearson Correlation Matrix") +
              coord_fixed()
            if (isTRUE(pearson_show_values)) {
              p_pearson <- p_pearson +
                geom_text(
                  aes(label = sprintf("%.2f", value), color = label_color),
                  size = 3.1,
                  show.legend = FALSE
                ) +
                scale_color_identity()
            }
            if (!isTRUE(pearson_show_legend)) {
              p_pearson <- p_pearson + theme(legend.position = "none")
            }

            custom_ggsave(output_image, plot = p_pearson, plot_key = "heatmap_plot", width = 10, height = 10, dpi = 300, device = "png")
            heatmap_image <- output_image
          }

          if (!is.null(cor_spearman)) {
            spear_melted <- melt(cor_spearman)
            colnames(spear_melted) <- c("Var1", "Var2", "value")
            spearman_heatmap_features <- build_heatmap_publication_features(
              cor_spearman,
              row_labels = rownames(cor_spearman),
              col_labels = colnames(cor_spearman),
              metric_name = "Spearman rho",
              context = "correlation_spearman",
              top_n = 12L,
              rank_mode = "abs_desc",
              exclude_diagonal = TRUE
            )

            spearman_target <- if (!is.null(cor_pearson)) sub("\\.png$", "_spearman.png", output_image) else output_image
            spearman_palette <- get_palette(get_plot_color("heatmap_spearman", default_color_scheme))
            spearman_scale <- resolve_heatmap_scale_colors(spearman_palette, centered = TRUE)
            spearman_heatmap_labels_cfg <- to_plain_list(resolve_labels_for_plot("spearman_heatmap_plot"))
            spearman_show_values <- resolve_plot_element_flag(spearman_heatmap_labels_cfg, "show_heatmap_values", n_vars <= 12)
            spearman_show_legend <- resolve_plot_element_flag(spearman_heatmap_labels_cfg, "show_legend", TRUE)
            spearman_show_row_labels <- resolve_plot_element_flag(spearman_heatmap_labels_cfg, "show_heatmap_row_labels", TRUE)
            spearman_show_column_labels <- resolve_plot_element_flag(spearman_heatmap_labels_cfg, "show_heatmap_column_labels", TRUE)
            spearman_show_cell_borders <- resolve_plot_element_flag(spearman_heatmap_labels_cfg, "show_heatmap_cell_borders", TRUE)
            spear_melted$label_color <- ifelse(abs(spear_melted$value) >= 0.55, "#f8fafc", "#0f172a")

            p_spearman <- ggplot(spear_melted, aes(x = Var1, y = Var2, fill = value)) +
              geom_tile(color = if (isTRUE(spearman_show_cell_borders)) "#ffffff" else NA) +
              scale_fill_gradient2(low = spearman_scale$low, high = spearman_scale$high, mid = spearman_scale$mid,
                                   midpoint = 0, limit = c(-1, 1), space = "Lab",
                                   name = "Spearman\nCorrelation") +
              theme_minimal() +
              theme(
                axis.text.x = if (isTRUE(spearman_show_column_labels)) element_text(angle = 45, vjust = 1, hjust = 1, size = 10) else element_blank(),
                axis.text.y = if (isTRUE(spearman_show_row_labels)) element_text(size = 10) else element_blank(),
                axis.ticks.x = if (isTRUE(spearman_show_column_labels)) element_line() else element_blank(),
                axis.ticks.y = if (isTRUE(spearman_show_row_labels)) element_line() else element_blank(),
                axis.title = element_blank(),
                panel.grid.major = element_blank(),
                panel.grid.minor = element_blank(),
                plot.title = element_text(face = "bold", size = 14, hjust = 0.5)
              ) +
              labs(title = "Spearman Correlation Matrix (Rank-based)") +
              coord_fixed()
            if (isTRUE(spearman_show_values)) {
              p_spearman <- p_spearman +
                geom_text(
                  aes(label = sprintf("%.2f", value), color = label_color),
                  size = 3.1,
                  show.legend = FALSE
                ) +
                scale_color_identity()
            }
            if (!isTRUE(spearman_show_legend)) {
              p_spearman <- p_spearman + theme(legend.position = "none")
            }

            custom_ggsave(spearman_target, plot = p_spearman, plot_key = "spearman_heatmap_plot", width = 10, height = 10, dpi = 300, device = "png")
            spearman_heatmap_image <- spearman_target
            if (is.null(cor_pearson)) {
              heatmap_image <- spearman_target
            }
          }
        }
        
        
        # 3. Simple Scatter Plot for Linearity Check
        # Use user-selected variables if provided, otherwise first two
        linearity_plot_image <- NULL
        spearman_linearity_plot_image <- NULL
        correlation_ci_level <- resolve_conf_level_from_alpha(alpha_val)
        
        if (n_vars >= 2) {
          # Use custom variables if provided and valid, otherwise use first two
          var1 <- var_names[1]
          var2 <- var_names[2]
          
          if (!is.null(scatter_var_x) && scatter_var_x %in% var_names) {
            var1 <- scatter_var_x
          }
          if (!is.null(scatter_var_y) && scatter_var_y %in% var_names) {
            var2 <- scatter_var_y
          }
          
          if (!is.null(cor_pearson)) {
            linearity_file <- sub("\\.png$", "_linearity.png", output_image)
            pearson_scatter_palette <- get_palette(get_plot_color("scatter_pearson", default_color_scheme))
            pearson_subtitle <- if (!is.na(cor_pearson[var1, var2])) sprintf("Correlation: %.3f", cor_pearson[var1, var2]) else "Correlation: NA"
            pearson_linearity_labels_cfg <- to_plain_list(resolve_labels_for_plot("linearity_plot"))
            pearson_show_points <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_points", TRUE)
            pearson_show_trend_line <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_trend_line", TRUE)
            pearson_show_ci_band <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_ci_band", TRUE)
            pearson_show_grid <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_grid", TRUE)
            pearson_show_paper_grid <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_paper_grid", FALSE)
            pearson_show_dashed_grid <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_dashed_grid", FALSE)
            pearson_show_dotted_grid <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_dotted_grid", FALSE)
            pearson_show_x_grid_only <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_x_grid_only", FALSE)
            pearson_show_y_grid_only <- resolve_plot_element_flag(pearson_linearity_labels_cfg, "show_y_grid_only", FALSE)
            pearson_grid_linetype <- if (isTRUE(pearson_show_dotted_grid)) {
              "dotted"
            } else if (isTRUE(pearson_show_dashed_grid)) {
              "dashed"
            } else {
              "solid"
            }
            pearson_grid_color <- get_custom_plot_color("exploratory_grid_color", "#dbe4ef")

            p_linearity <- ggplot(numeric_data, aes(x = .data[[var1]], y = .data[[var2]])) +
              labs(
                title = sprintf("Linearity Check: %s vs %s (Pearson)", var1, var2),
                subtitle = pearson_subtitle,
                x = var1,
                y = var2
              ) +
              theme_minimal() +
              theme(
                plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
                plot.subtitle = element_text(size = 11, hjust = 0.5, color = "gray40"),
                axis.title = element_text(size = 11, face = "bold")
              )

            if (isTRUE(pearson_show_points)) {
              p_linearity <- p_linearity +
                geom_point(alpha = 0.6, size = 2.5, color = pearson_scatter_palette$main)
            }

            if (isTRUE(pearson_show_trend_line)) {
              p_linearity <- p_linearity +
                geom_smooth(
                  method = "lm",
                  formula = y ~ x,
                  se = isTRUE(pearson_show_ci_band),
                  level = correlation_ci_level,
                  color = pearson_scatter_palette$accent,
                  fill = pearson_scatter_palette$accent,
                  alpha = 0.2,
                  linewidth = 1.2
                )
            }

            if (!isTRUE(pearson_show_grid)) {
              p_linearity <- p_linearity + theme(
                panel.grid.major = element_blank(),
                panel.grid.minor = element_blank()
              )
            } else {
              pearson_major_line <- element_line(
                color = pearson_grid_color,
                linewidth = if (isTRUE(pearson_show_paper_grid)) 0.45 else 0.30,
                linetype = pearson_grid_linetype
              )
              pearson_minor_line <- element_line(
                color = pearson_grid_color,
                linewidth = if (isTRUE(pearson_show_paper_grid)) 0.22 else 0.16,
                linetype = pearson_grid_linetype
              )
              p_linearity <- p_linearity + theme(
                panel.grid.major.x = if (isTRUE(pearson_show_y_grid_only)) element_blank() else pearson_major_line,
                panel.grid.major.y = if (isTRUE(pearson_show_x_grid_only)) element_blank() else pearson_major_line,
                panel.grid.minor.x = if (isTRUE(pearson_show_y_grid_only)) element_blank() else pearson_minor_line,
                panel.grid.minor.y = if (isTRUE(pearson_show_x_grid_only)) element_blank() else pearson_minor_line
              )
            }

            custom_ggsave(linearity_file, plot = p_linearity, plot_key = "linearity_plot", width = 8, height = 6, dpi = 200, device = "png")
            linearity_plot_image <- linearity_file
          }

          if (!is.null(cor_spearman)) {
            spearman_linearity_file <- sub("\\.png$", "_spearman_linearity.png", output_image)
            rank_data <- as.data.frame(lapply(numeric_data[c(var1, var2)], rank, na.last = "keep"))
            colnames(rank_data) <- c(paste0(var1, "_rank"), paste0(var2, "_rank"))

            spearman_scatter_palette <- get_palette(get_plot_color("scatter_spearman", default_color_scheme))
            spearman_subtitle <- if (!is.na(cor_spearman[var1, var2])) sprintf("Spearman Correlation: %.3f", cor_spearman[var1, var2]) else "Spearman Correlation: NA"
            spearman_linearity_labels_cfg <- to_plain_list(resolve_labels_for_plot("spearman_linearity_plot"))
            spearman_show_points <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_points", TRUE)
            spearman_show_trend_line <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_trend_line", TRUE)
            spearman_show_ci_band <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_ci_band", TRUE)
            spearman_show_grid <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_grid", TRUE)
            spearman_show_paper_grid <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_paper_grid", FALSE)
            spearman_show_dashed_grid <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_dashed_grid", FALSE)
            spearman_show_dotted_grid <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_dotted_grid", FALSE)
            spearman_show_x_grid_only <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_x_grid_only", FALSE)
            spearman_show_y_grid_only <- resolve_plot_element_flag(spearman_linearity_labels_cfg, "show_y_grid_only", FALSE)
            spearman_grid_linetype <- if (isTRUE(spearman_show_dotted_grid)) {
              "dotted"
            } else if (isTRUE(spearman_show_dashed_grid)) {
              "dashed"
            } else {
              "solid"
            }
            spearman_grid_color <- get_custom_plot_color("exploratory_grid_color", "#dbe4ef")

            rank_x <- paste0(var1, "_rank")
            rank_y <- paste0(var2, "_rank")
            p_spearman_linearity <- ggplot(rank_data, aes(x = .data[[rank_x]], y = .data[[rank_y]])) +
              labs(
                title = sprintf("Linearity Check: %s vs %s (Spearman - Ranks)", var1, var2),
                subtitle = spearman_subtitle,
                x = paste0(var1, " (rank)"),
                y = paste0(var2, " (rank)")
              ) +
              theme_minimal() +
              theme(
                plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
                plot.subtitle = element_text(size = 11, hjust = 0.5, color = "gray40"),
                axis.title = element_text(size = 11, face = "bold")
              )

            if (isTRUE(spearman_show_points)) {
              p_spearman_linearity <- p_spearman_linearity +
                geom_point(alpha = 0.6, size = 2.5, color = spearman_scatter_palette$main)
            }

            if (isTRUE(spearman_show_trend_line)) {
              p_spearman_linearity <- p_spearman_linearity +
                geom_smooth(
                  method = "lm",
                  formula = y ~ x,
                  se = isTRUE(spearman_show_ci_band),
                  level = correlation_ci_level,
                  color = spearman_scatter_palette$accent,
                  fill = spearman_scatter_palette$accent,
                  alpha = 0.2,
                  linewidth = 1.2
                )
            }

            if (!isTRUE(spearman_show_grid)) {
              p_spearman_linearity <- p_spearman_linearity + theme(
                panel.grid.major = element_blank(),
                panel.grid.minor = element_blank()
              )
            } else {
              spearman_major_line <- element_line(
                color = spearman_grid_color,
                linewidth = if (isTRUE(spearman_show_paper_grid)) 0.45 else 0.30,
                linetype = spearman_grid_linetype
              )
              spearman_minor_line <- element_line(
                color = spearman_grid_color,
                linewidth = if (isTRUE(spearman_show_paper_grid)) 0.22 else 0.16,
                linetype = spearman_grid_linetype
              )
              p_spearman_linearity <- p_spearman_linearity + theme(
                panel.grid.major.x = if (isTRUE(spearman_show_y_grid_only)) element_blank() else spearman_major_line,
                panel.grid.major.y = if (isTRUE(spearman_show_x_grid_only)) element_blank() else spearman_major_line,
                panel.grid.minor.x = if (isTRUE(spearman_show_y_grid_only)) element_blank() else spearman_minor_line,
                panel.grid.minor.y = if (isTRUE(spearman_show_x_grid_only)) element_blank() else spearman_minor_line
              )
            }

            custom_ggsave(spearman_linearity_file, plot = p_spearman_linearity, plot_key = "spearman_linearity_plot", width = 8, height = 6, dpi = 200, device = "png")
            spearman_linearity_plot_image <- spearman_linearity_file
          }
        }
        
        plot_generated <- TRUE
      }, error = function(e) {
        plot_generated <- FALSE
        plot_error <- e$message
      })
      
      # Build result
      result_mode <- "descriptive"
      result_list <- list(
        mode = result_mode,
        workflow = if (is_inferential_correlation_mode) "correlation_matrix" else NULL,
        correlation_matrix = list(
          type = "correlation_matrix",
          variables = var_names,
          n_variables = n_vars,
          pearson = if (!is.null(cor_pearson)) unclass(cor_pearson) else NULL,
          spearman = if (!is.null(cor_spearman)) unclass(cor_spearman) else NULL,
          selected_method = selected_method,
          available_methods = available_methods,
          use_both_override = correlation_force_both,
          method_decision_message = method_decision_message,
          shapiro = shapiro_results,
          all_normal = all_normal,
          descriptive_stats = univariate_results,
          plot_generated = plot_generated,
          plot_error = plot_error,
          heatmap_image = heatmap_image,
          pearson_heatmap_features = pearson_heatmap_features,
          spearman_heatmap_image = spearman_heatmap_image,
          spearman_heatmap_features = spearman_heatmap_features,
          linearity_plot_image = linearity_plot_image,
          spearman_linearity_plot_image = spearman_linearity_plot_image
        ),
        univariate_analysis = univariate_results
      )
      
      cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
      quit(save = "no")
    }
    
    # BIVARIATE ANALYSIS MODE (existing code)
    # Read data without forcing types - let R detect them naturally
    # Detect variable types based on original data
    group_is_numeric <- is.numeric(data[[group_var]])
    response_is_numeric <- is.numeric(data[[response_var]])
    
    # Process Group Variable
    univariate_results[[group_var]] <- analyze_variable(data[[group_var]], group_var)
    
    # Process Response Variable
    univariate_results[[response_var]] <- analyze_variable(data[[response_var]], response_var)

    
    # Initialize result components
    summary_stats <- NULL
    overall_summary <- NULL
    bivariate <- NULL
    
    if (group_is_numeric && response_is_numeric) {
      # QUANTITATIVE vs QUANTITATIVE
      # ... (Logic remains similar, just removing redundant setup if any)
      
      # Calculate descriptive association metrics (no inferential test in descriptive mode)
      log_entry(paste0('cor(data[["', group_var, '"]], data[["', response_var, '"]])'))
      pearson <- tryCatch(cor(data[[group_var]], data[[response_var]], method = "pearson"), error = function(e) NA)
      spearman <- tryCatch(cor(data[[group_var]], data[[response_var]], method = "spearman"), error = function(e) NA)
      cov_val <- tryCatch(cov(data[[group_var]], data[[response_var]]), error = function(e) NA)
      
      bivariate <- list(
        type = "quantitative_quantitative",
        correlation = list(
          pearson = as.numeric(pearson),
          spearman = as.numeric(spearman),
          covariance = as.numeric(cov_val)
        )
      )
      
      # Generate Scatter Plot
      tryCatch({
        png(output_image, width = 800, height = 600)
        plot(data[[group_var]], data[[response_var]], 
             xlab = group_var, ylab = response_var,
             main = paste("Scatter Plot:", group_var, "vs", response_var),
             pch = 19, col = rgb(0, 0, 1, 0.5))
        abline(lm(data[[response_var]] ~ data[[group_var]]), col = "red", lwd = 2)
        dev.off()
        bivariate$plot_generated <- TRUE
      }, error = function(e) {
        bivariate$plot_generated <- FALSE
      })
      
    } else if (!group_is_numeric && !response_is_numeric) {
       # QUALITATIVE vs QUALITATIVE
       # Ensure both are factors
       data[[group_var]] <- as.factor(data[[group_var]])
       data[[response_var]] <- as.factor(data[[response_var]])
       
       # Create contingency table
       log_entry(paste0('table(data[["', group_var, '"]], data[["', response_var, '"]])'))
       cont_table <- table(data[[group_var]], data[[response_var]])
       
       bivariate <- list(
         type = "qualitative_qualitative",
         contingency_table = list(
           table = unclass(as.matrix(cont_table)),  # Convert to plain matrix
           row_names = as.character(rownames(cont_table)),
           col_names = as.character(colnames(cont_table))
         )
       )
       
       # Generate mosaic plot
       tryCatch({
         png(output_image, width = 800, height = 600)
         mosaicplot(cont_table, 
                    main = "Contingency Table",
                    xlab = group_var, ylab = response_var,
                    col = pick_cols(length(cont_table)))
         dev.off()
         bivariate$plot_generated <- TRUE
       }, error = function(e) {
         bivariate$plot_generated <- FALSE
       })
       
    } else {
      # MIXED (One numeric, one qualitative)
      # Identify which is which
      cat_var <- if (group_is_numeric) response_var else group_var
      quant_var <- if (group_is_numeric) group_var else response_var
      
      data[[cat_var]] <- as.factor(data[[cat_var]])
      quant_values_all <- suppressWarnings(as.numeric(data[[quant_var]]))
      cat_values_all <- as.character(data[[cat_var]])
      valid_mask <- !is.na(cat_values_all) & cat_values_all != "" & is.finite(quant_values_all)
      total_valid_n <- sum(valid_mask)
      total_n <- length(cat_values_all)
      missing_n <- total_n - total_valid_n
      
      # Calculate Summary Stats by Group
      log_entry(paste0('aggregate(data[["', quant_var, '"]] ~ data[["', cat_var, '"]], FUN = summary)'))
      summary_stats <- list()
      levels_list <- levels(data[[cat_var]])
      overall_summary <- NULL
      if (total_valid_n > 0) {
        overall_vals <- quant_values_all[valid_mask]
        overall_q <- stats::quantile(overall_vals, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE, type = 7)
        overall_summary <- list(
          n = as.numeric(total_valid_n),
          total_n = as.numeric(total_n),
          missing_n = as.numeric(missing_n),
          mean = as.numeric(mean(overall_vals, na.rm = TRUE)),
          median = as.numeric(overall_q[2]),
          sd = as.numeric(stats::sd(overall_vals, na.rm = TRUE)),
          variance = as.numeric(stats::var(overall_vals, na.rm = TRUE)),
          q1 = as.numeric(overall_q[1]),
          q3 = as.numeric(overall_q[3]),
          iqr = as.numeric(stats::IQR(overall_vals, na.rm = TRUE, type = 7)),
          min = as.numeric(min(overall_vals, na.rm = TRUE)),
          max = as.numeric(max(overall_vals, na.rm = TRUE))
        )
      }
      
      for (lvl in levels_list) {
        subset_vals <- quant_values_all[(cat_values_all == lvl) & valid_mask]
        
        if (length(subset_vals) > 0) {
          q <- stats::quantile(subset_vals, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE, type = 7)
          summary_stats[[lvl]] <- list(
            n = as.numeric(length(subset_vals)),
            percent = if (is.finite(total_valid_n) && total_valid_n > 0) as.numeric((length(subset_vals) / total_valid_n) * 100) else NA_real_,
            mean = as.numeric(mean(subset_vals, na.rm = TRUE)),
            median = as.numeric(median(subset_vals, na.rm = TRUE)),
            sd = as.numeric(stats::sd(subset_vals, na.rm = TRUE)),
            variance = as.numeric(stats::var(subset_vals, na.rm = TRUE)),
            q1 = as.numeric(q[1]),
            q3 = as.numeric(q[3]),
            iqr = as.numeric(stats::IQR(subset_vals, na.rm = TRUE, type = 7)),
            min = as.numeric(min(subset_vals, na.rm = TRUE)),
            max = as.numeric(max(subset_vals, na.rm = TRUE))
          )
        }
      }
      
      bivariate <- list(
        type = "mixed",
        categorical_var = cat_var,
        quantitative_var = quant_var,
        total_n = as.numeric(total_n),
        valid_n = as.numeric(total_valid_n),
        missing_n = as.numeric(missing_n),
        n_groups = as.numeric(length(summary_stats))
      )
      
      # Generate Boxplot
      tryCatch({
        png(output_image, width = 800, height = 600)
        boxplot(data[[quant_var]] ~ data[[cat_var]], 
                main = paste("Boxplot of", quant_var, "by", cat_var),
                xlab = cat_var, ylab = quant_var,
                col = "lightblue")
        dev.off()
        bivariate$plot_generated <- TRUE
      }, error = function(e) {
        bivariate$plot_generated <- FALSE
      })
    }
    
    result_list <- list(
      mode = "descriptive",
      bivariate = bivariate,
      univariate_analysis = univariate_results
    )
    
    # Add summary stats if calculated (for mixed case)
    if (!is.null(summary_stats)) {
      result_list$summary_stats <- summary_stats
    }
    if (!is.null(overall_summary)) {
      result_list$summary_stats_overall <- overall_summary
    }
    
    cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
    quit(save = "no")
  }
  
  # REGRESSION ANALYSIS MODE
  if (startsWith(base_analysis_mode, "regression")) {
    invisible(load_pkgs(regression_pkgs))
    
    auto_mode <- grepl("_auto$", base_analysis_mode)
    analysis_mode_base <- if (auto_mode) sub("_auto$", "", base_analysis_mode) else base_analysis_mode
    
    # Parse predictors from group_var (comma separated)
    predictors <- trimws(unlist(strsplit(group_var, ",")))
    predictors <- predictors[predictors != ""]
    predictors <- setdiff(predictors, response_var)
    
    if (auto_mode && length(predictors) == 0) {
      predictors <- setdiff(colnames(data), response_var)
    }
    
    if (length(predictors) == 0) {
      cat(toJSON(list(error = "No independent variables (predictors) selected."), auto_unbox = TRUE))
      quit(save = "no")
    }
    
    # Check if variables exist
    missing_vars <- setdiff(c(response_var, predictors), colnames(data))
    if (length(missing_vars) > 0) {
      cat(toJSON(list(error = paste("Variables not found in data:", paste(missing_vars, collapse = ", "))), auto_unbox = TRUE))
      quit(save = "no")
    }
    
    # Remove predictors with zero variance
    valid_predictors <- c()
    for (p in predictors) {
      uniq_vals <- unique(na.omit(data[[p]]))
      if (length(uniq_vals) > 1) valid_predictors <- c(valid_predictors, p)
    }
    predictors <- valid_predictors
    if (length(predictors) == 0) {
      cat(toJSON(list(error = "All selected predictors have zero variance."), auto_unbox = TRUE))
      quit(save = "no")
    }
    
    candidate_predictors <- predictors
    
    calc_auc <- function(actual, predicted_probs) {
      actual <- as.numeric(actual)
      if (length(unique(actual)) < 2) return(NA)
      n1 <- sum(actual == 1)
      n0 <- sum(actual == 0)
      if (n1 == 0 || n0 == 0) return(NA)
      r <- rank(predicted_probs, ties.method = "average")
      (sum(r[actual == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
    }
    
    calc_log_loss <- function(actual, predicted_probs) {
      eps <- 1e-15
      p <- pmin(pmax(predicted_probs, eps), 1 - eps)
      -mean(actual * log(p) + (1 - actual) * log(1 - p))
    }
    
    calc_brier <- function(actual, predicted_probs) {
      mean((predicted_probs - actual)^2)
    }
    
    calc_rmse <- function(actual, predicted) {
      sqrt(mean((predicted - actual)^2))
    }
    
    calc_mae <- function(actual, predicted) {
      mean(abs(predicted - actual))
    }
    
    calc_r2 <- function(actual, predicted) {
      ss_res <- sum((actual - predicted)^2)
      ss_tot <- sum((actual - mean(actual))^2)
      if (ss_tot == 0) return(NA)
      1 - ss_res / ss_tot
    }

    calc_linear_accuracy <- function(actual, predicted) {
      actual_num <- suppressWarnings(as.numeric(actual))
      predicted_num <- suppressWarnings(as.numeric(predicted))
      keep <- is.finite(actual_num) & is.finite(predicted_num)
      if (!any(keep)) return(NA_real_)

      actual_num <- actual_num[keep]
      predicted_num <- predicted_num[keep]
      nonzero_mask <- abs(actual_num) > 1e-8

      if (sum(nonzero_mask) >= 1) {
        mape <- mean(abs((predicted_num[nonzero_mask] - actual_num[nonzero_mask]) / actual_num[nonzero_mask]))
        accuracy_pct <- (1 - mape) * 100
      } else {
        mae_val <- mean(abs(predicted_num - actual_num))
        scale_ref <- mean(abs(actual_num))
        if (!is.finite(scale_ref) || scale_ref <= 1e-8) {
          scale_ref <- max(abs(actual_num), na.rm = TRUE)
        }
        if (!is.finite(scale_ref) || scale_ref <= 1e-8) scale_ref <- 1
        accuracy_pct <- (1 - (mae_val / scale_ref)) * 100
      }

      if (!is.finite(accuracy_pct)) return(NA_real_)
      as.numeric(max(0, min(100, accuracy_pct)))
    }
    
    align_factor_levels <- function(train_df, test_df, vars) {
      for (v in vars) {
        if (is.character(train_df[[v]]) || is.factor(train_df[[v]])) {
          train_df[[v]] <- as.factor(train_df[[v]])
          test_df[[v]] <- factor(test_df[[v]], levels = levels(train_df[[v]]))
        }
      }
      list(train = train_df, test = test_df)
    }

    make_random_validation_split <- function(df, validation_fraction = 0.2) {
      n <- nrow(df)
      if (!is.finite(n) || n < 4) return(NULL)
      val_size <- floor(validation_fraction * n)
      if (!is.finite(val_size)) val_size <- 1
      val_size <- max(1, val_size)
      if (val_size >= n) val_size <- n - 1
      if (val_size < 1) return(NULL)
      val_idx <- sample(seq_len(n), size = val_size)
      train_idx <- setdiff(seq_len(n), val_idx)
      if (length(train_idx) < 2 || length(val_idx) < 1) return(NULL)
      list(
        train = df[train_idx, , drop = FALSE],
        validation = df[val_idx, , drop = FALSE]
      )
    }

    make_stratified_validation_split <- function(df, response_name, validation_fraction = 0.2) {
      if (!response_name %in% colnames(df)) return(NULL)
      n <- nrow(df)
      if (!is.finite(n) || n < 6) return(NULL)
      y <- df[[response_name]]
      class0_idx <- which(y == 0)
      class1_idx <- which(y == 1)
      if (length(class0_idx) < 3 || length(class1_idx) < 3) return(NULL)

      val_size0 <- floor(validation_fraction * length(class0_idx))
      val_size1 <- floor(validation_fraction * length(class1_idx))
      val_size0 <- max(1, val_size0)
      val_size1 <- max(1, val_size1)
      if (val_size0 >= length(class0_idx)) val_size0 <- length(class0_idx) - 1
      if (val_size1 >= length(class1_idx)) val_size1 <- length(class1_idx) - 1
      if (val_size0 < 1 || val_size1 < 1) return(NULL)

      val_idx <- c(sample(class0_idx, size = val_size0), sample(class1_idx, size = val_size1))
      train_idx <- setdiff(seq_len(n), val_idx)
      if (length(train_idx) < 2 || length(val_idx) < 2) return(NULL)

      list(
        train = df[train_idx, , drop = FALSE],
        validation = df[val_idx, , drop = FALSE]
      )
    }
    
    better_logistic <- function(auc, log_loss, aic, best_auc, best_log_loss, best_aic) {
      if (!is.na(auc) && (is.na(best_auc) || auc > best_auc + 1e-6)) return(TRUE)
      if (!is.na(auc) && !is.na(best_auc) && abs(auc - best_auc) <= 1e-6) {
        if (log_loss < best_log_loss - 1e-6) return(TRUE)
        if (abs(log_loss - best_log_loss) <= 1e-6 && aic < best_aic) return(TRUE)
      }
      if (is.na(auc) && is.na(best_auc)) {
        if (log_loss < best_log_loss - 1e-6) return(TRUE)
        if (abs(log_loss - best_log_loss) <= 1e-6 && aic < best_aic) return(TRUE)
      }
      return(FALSE)
    }
    
    better_linear <- function(rmse, r2, aic, best_rmse, best_r2, best_aic) {
      if (rmse < best_rmse - 1e-6) return(TRUE)
      if (abs(rmse - best_rmse) <= 1e-6) {
        if (!is.na(r2) && (is.na(best_r2) || r2 > best_r2 + 1e-6)) return(TRUE)
        if ((is.na(r2) && is.na(best_r2)) || (!is.na(r2) && !is.na(best_r2) && abs(r2 - best_r2) <= 1e-6)) {
          if (aic < best_aic) return(TRUE)
        }
      }
      return(FALSE)
    }
    
    forward_select_logistic <- function(candidates, train_data, validation_data) {
      selected <- c()
      evaluated <- 0
      best_auc <- NA
      best_log_loss <- Inf
      best_aic <- Inf
      improved <- TRUE
      
      while (length(candidates) > 0 && improved) {
        improved <- FALSE
        best_candidate <- NULL
        best_candidate_metrics <- NULL
        
        for (cand in candidates) {
          vars <- c(selected, cand)
          aligned <- align_factor_levels(train_data, validation_data, vars)
          formula_str <- paste(response_var, "~", paste(vars, collapse = " + "))
          model <- tryCatch(glm(as.formula(formula_str), data = aligned$train, family = binomial), error = function(e) NULL)
          if (is.null(model)) next
          
          preds <- tryCatch(predict(model, newdata = aligned$test, type = "response"), error = function(e) NULL)
          if (is.null(preds) || all(is.na(preds))) next
          
          auc <- calc_auc(aligned$test[[response_var]], preds)
          log_loss <- calc_log_loss(aligned$test[[response_var]], preds)
          aic <- AIC(model)
          evaluated <- evaluated + 1
          
          if (is.null(best_candidate) || better_logistic(auc, log_loss, aic, best_candidate_metrics$auc, best_candidate_metrics$log_loss, best_candidate_metrics$aic)) {
            best_candidate <- cand
            best_candidate_metrics <- list(auc = auc, log_loss = log_loss, aic = aic)
          }
        }
        
        if (!is.null(best_candidate)) {
          if (is.na(best_auc)) {
            improved <- TRUE
          } else if (better_logistic(best_candidate_metrics$auc, best_candidate_metrics$log_loss, best_candidate_metrics$aic, best_auc, best_log_loss, best_aic)) {
            improved <- TRUE
          }
          
          if (improved) {
            selected <- c(selected, best_candidate)
            candidates <- setdiff(candidates, best_candidate)
            best_auc <- best_candidate_metrics$auc
            best_log_loss <- best_candidate_metrics$log_loss
            best_aic <- best_candidate_metrics$aic
          }
        }
      }
      
      list(selected = selected, evaluated = evaluated, best_metrics = list(auc = best_auc, log_loss = best_log_loss, aic = best_aic))
    }
    
    forward_select_linear <- function(candidates, train_data, validation_data) {
      selected <- c()
      evaluated <- 0
      best_rmse <- Inf
      best_r2 <- NA
      best_aic <- Inf
      improved <- TRUE
      
      while (length(candidates) > 0 && improved) {
        improved <- FALSE
        best_candidate <- NULL
        best_candidate_metrics <- NULL
        
        for (cand in candidates) {
          vars <- c(selected, cand)
          aligned <- align_factor_levels(train_data, validation_data, vars)
          formula_str <- paste(response_var, "~", paste(vars, collapse = " + "))
          model <- tryCatch(lm(as.formula(formula_str), data = aligned$train), error = function(e) NULL)
          if (is.null(model)) next
          
          preds <- tryCatch(predict(model, newdata = aligned$test), error = function(e) NULL)
          if (is.null(preds) || all(is.na(preds))) next
          
          rmse <- calc_rmse(aligned$test[[response_var]], preds)
          r2 <- calc_r2(aligned$test[[response_var]], preds)
          aic <- AIC(model)
          evaluated <- evaluated + 1
          
          if (is.null(best_candidate) || better_linear(rmse, r2, aic, best_candidate_metrics$rmse, best_candidate_metrics$r2, best_candidate_metrics$aic)) {
            best_candidate <- cand
            best_candidate_metrics <- list(rmse = rmse, r2 = r2, aic = aic)
          }
        }
        
        if (!is.null(best_candidate)) {
          if (better_linear(best_candidate_metrics$rmse, best_candidate_metrics$r2, best_candidate_metrics$aic, best_rmse, best_r2, best_aic)) {
            improved <- TRUE
          }
          
          if (improved) {
            selected <- c(selected, best_candidate)
            candidates <- setdiff(candidates, best_candidate)
            best_rmse <- best_candidate_metrics$rmse
            best_r2 <- best_candidate_metrics$r2
            best_aic <- best_candidate_metrics$aic
          }
        }
      }
      
      list(selected = selected, evaluated = evaluated, best_metrics = list(rmse = best_rmse, r2 = best_r2, aic = best_aic))
    }
    
    result_list <- list(
      mode = analysis_mode_base,
      response_variable = response_var,
      predictors = predictors
    )
    infer_ordinal_levels <- function(raw_values) {
      values_chr <- trimws(as.character(raw_values))
      values_chr <- values_chr[!is.na(values_chr) & values_chr != ""]
      values_unique <- unique(values_chr)
      if (length(values_unique) == 0) {
        return(list(levels = character(0), source = "unknown"))
      }

      numeric_values <- suppressWarnings(as.numeric(values_unique))
      if (length(values_unique) > 0 && all(is.finite(numeric_values))) {
        ord <- order(numeric_values, values_unique)
        return(list(levels = values_unique[ord], source = "numeric_ascending"))
      }

      normalized_unique <- tolower(values_unique)
      original_lookup <- list()
      for (idx in seq_along(values_unique)) {
        key <- normalized_unique[[idx]]
        if (!nzchar(key) || !is.null(original_lookup[[key]])) next
        original_lookup[[key]] <- values_unique[[idx]]
      }

      known_scales <- list(
        c("very low", "low", "medium", "high", "very high"),
        c("low", "medium", "high"),
        c("strongly disagree", "disagree", "neutral", "agree", "strongly agree"),
        c("very dissatisfied", "dissatisfied", "neutral", "satisfied", "very satisfied"),
        c("poor", "fair", "good", "very good", "excellent")
      )
      normalized_set <- unique(normalized_unique)
      for (scale_levels in known_scales) {
        if (!all(normalized_set %in% scale_levels)) next
        matched <- scale_levels[scale_levels %in% normalized_set]
        ordered <- vapply(matched, function(level_name) {
          original_lookup[[level_name]]
        }, character(1))
        return(list(levels = ordered, source = "recognized_labels"))
      }

      list(levels = values_unique, source = "first_appearance")
    }
    
    if (analysis_mode_base == "regression_linear") {
      # LINEAR REGRESSION (OLS)
      result_list$model_type <- if (length(predictors) > 1) "Multiple Linear Regression" else "Simple Linear Regression"
      
      model_data <- data[, unique(c(response_var, predictors)), drop = FALSE]
      model_data[[response_var]] <- suppressWarnings(as.numeric(model_data[[response_var]]))
      for (p in predictors) {
        if (is.character(model_data[[p]])) model_data[[p]] <- as.factor(model_data[[p]])
      }
      model_data <- na.omit(model_data)
      
      set.seed(42)
      n_samples <- nrow(model_data)
      if (n_samples < 5) {
        cat(toJSON(list(error = "Not enough complete observations for linear regression train/test split (need at least 5)."), auto_unbox = TRUE))
        quit(save = "no")
      }
      train_size <- floor(regression_train_fraction * n_samples)
      if (!is.finite(train_size)) train_size <- floor(0.8 * n_samples)
      train_size <- max(2, train_size)
      if (train_size >= n_samples) train_size <- n_samples - 1
      if (train_size < 2 || (n_samples - train_size) < 1) {
        cat(toJSON(list(error = "Unable to create a valid train/test split for linear regression."), auto_unbox = TRUE))
        quit(save = "no")
      }
      train_indices <- sample(seq_len(n_samples), size = train_size)
      test_indices <- setdiff(seq_len(n_samples), train_indices)
      train_data <- model_data[train_indices, , drop = FALSE]
      test_data <- model_data[test_indices, , drop = FALSE]
      if (nrow(test_data) < 1) {
        cat(toJSON(list(error = "Train/test split failed for linear regression (empty test set)."), auto_unbox = TRUE))
        quit(save = "no")
      }
      result_list$train_test_split <- list(
        train_percent = as.numeric(regression_train_percent),
        test_percent = as.numeric(regression_test_percent),
        train_fraction = as.numeric(regression_train_fraction),
        test_fraction = as.numeric(regression_test_fraction),
        split_seed = 42,
        split_method = "random",
        train_size = nrow(train_data),
        test_size = nrow(test_data)
      )

      if (auto_mode) {
        selection_train <- train_data
        selection_validation <- train_data
        selection_scope <- "train_resubstitution_fallback"

        set.seed(4242)
        validation_split <- make_random_validation_split(train_data, validation_fraction = 0.2)
        if (!is.null(validation_split)) {
          selection_train <- validation_split$train
          selection_validation <- validation_split$validation
          selection_scope <- "train_internal_holdout"
        }

        sel <- forward_select_linear(predictors, selection_train, selection_validation)
        if (length(sel$selected) == 0) {
          cat(toJSON(list(error = "Auto-selection could not find a valid predictor set."), auto_unbox = TRUE))
          quit(save = "no")
        }
        
        predictors <- sel$selected
        result_list$auto_selection <- list(
          enabled = TRUE,
          strategy = "forward_selection",
          metric = "validation_rmse",
          candidate_count = length(candidate_predictors),
          evaluated_models = sel$evaluated,
          selected_predictors = predictors,
          best_metric = "validation_rmse",
          best_metrics = list(value = sel$best_metrics$rmse, r2 = sel$best_metrics$r2, aic = sel$best_metrics$aic),
          selection_scope = selection_scope,
          selection_train_size = nrow(selection_train),
          selection_validation_size = nrow(selection_validation)
        )
      }
      
      formula_str <- paste(response_var, "~", paste(predictors, collapse = " + "))
      result_list$formula <- formula_str
      result_list$predictors <- predictors
      
      log_entry(paste0("lm(", formula_str, ")"))
      model <- lm(as.formula(formula_str), data = train_data)
      model_summary <- summary(model)
      
      # Coefficients
      coefs <- as.data.frame(model_summary$coefficients)
      coefs$Term <- rownames(coefs)
      rownames(coefs) <- NULL
      colnames(coefs) <- c("Estimate", "StdError", "tValue", "pValue", "Term")
      
      # Format p-values
      coefs$formatted_p <- sapply(coefs$pValue, function(p) {
        if (p < 0.001) "< .001" else format(round(p, 4), nsmall = 4)
      })
      coefs$significance <- sapply(coefs$pValue, function(p) {
        if (p < 0.001) "***" else if (p < 0.01) "**" else if (p < 0.05) "*" else if (p < 0.1) "." else ""
      })
      
      # Model Stats
      model_stats <- list(
        r_squared = model_summary$r.squared,
        adj_r_squared = model_summary$adj.r.squared,
        sigma = model_summary$sigma,
        f_statistic = as.numeric(model_summary$fstatistic[1]),
        df_num = as.numeric(model_summary$fstatistic[2]),
        df_den = as.numeric(model_summary$fstatistic[3]),
        p_value_model = pf(model_summary$fstatistic[1], model_summary$fstatistic[2], model_summary$fstatistic[3], lower.tail = FALSE)
      )
      
      result_list$coefficients <- coefs
      result_list$model_stats <- model_stats
      
      aligned <- align_factor_levels(train_data, test_data, predictors)
      model_train <- model
      if (!is.null(model_train)) {
        train_preds <- tryCatch(predict(model_train, newdata = aligned$train), error = function(e) NULL)
        test_preds <- tryCatch(predict(model_train, newdata = aligned$test), error = function(e) NULL)
        if (!is.null(train_preds) && !is.null(test_preds)) {
          result_list$linear_evaluation <- list(
            train = list(
              rmse = calc_rmse(aligned$train[[response_var]], train_preds),
              mae = calc_mae(aligned$train[[response_var]], train_preds),
              r2 = calc_r2(aligned$train[[response_var]], train_preds),
              accuracy = calc_linear_accuracy(aligned$train[[response_var]], train_preds)
            ),
            test = list(
              rmse = calc_rmse(aligned$test[[response_var]], test_preds),
              mae = calc_mae(aligned$test[[response_var]], test_preds),
              r2 = calc_r2(aligned$test[[response_var]], test_preds),
              accuracy = calc_linear_accuracy(aligned$test[[response_var]], test_preds)
            ),
            split_info = list(
              train_size = nrow(aligned$train),
              test_size = nrow(aligned$test),
              train_percent = as.numeric(regression_train_percent),
              test_percent = as.numeric(regression_test_percent),
              train_fraction = as.numeric(regression_train_fraction),
              test_fraction = as.numeric(regression_test_fraction),
              split_seed = 42,
              split_method = "random"
            )
          )
        }
      }
      
       # Diagnostic Plots
       tryCatch({
        label_cfg <- resolve_base_label_config(
          "diagnostic_plot",
          default_title = "Regression Diagnostic Plots",
          default_x = "",
          default_y = ""
        )
        png(output_image, width = 1000, height = 800)
        par(mfrow = c(2, 2), oma = c(0, 0, 3.2, 0))
        plot(model, col = palette_main)
        if (nzchar(label_cfg$title)) {
          mtext(label_cfg$title, outer = TRUE, side = 3, line = 1.3, cex = label_cfg$title_cex, font = 2, adj = label_cfg$title_adj)
        }
        if (nzchar(label_cfg$caption)) {
          mtext(label_cfg$caption, outer = TRUE, side = 1, line = 0.8, cex = 0.85, adj = 1, col = "#475569")
        }
       dev.off()
        result_list$plot_generated <- TRUE
        result_list$plot_path <- output_image
      }, error = function(e) {
        result_list$plot_error <- e$message
      })

      publication_plot <- create_regression_publication_plot(
        model = model,
        coefficients_df = coefs,
        response_var = response_var,
        predictors = predictors,
        base_output_image = output_image,
        alpha_level = alpha_val
      )
      result_list$regression_publication_plot_generated <- isTRUE(publication_plot$generated)
      if (isTRUE(publication_plot$generated) && !is.null(publication_plot$path)) {
        result_list$regression_publication_plot_path <- publication_plot$path
      } else if (!is.null(publication_plot$error)) {
        result_list$regression_publication_plot_error <- publication_plot$error
      }

      if (length(predictors) == 1) {
        scatter_plot <- create_simple_linear_scatter_plot(
          model = model,
          response_var = response_var,
          predictor_var = predictors[[1]],
          base_output_image = output_image,
          alpha_level = alpha_val
        )
        result_list$regression_scatter_plot_generated <- isTRUE(scatter_plot$generated)
        if (isTRUE(scatter_plot$generated) && !is.null(scatter_plot$path)) {
          result_list$regression_scatter_plot_path <- scatter_plot$path
        } else if (!is.null(scatter_plot$error)) {
          result_list$regression_scatter_plot_error <- scatter_plot$error
        }
      }
      
    } else if (analysis_mode_base == "regression_logistic") {
      # LOGISTIC REGRESSION (GLM)
      result_list$model_type <- "Logistic Regression"
      
      # Normalize common yes/no style labels to 0/1 before validation
      to_binary <- function(v) {
        s <- trimws(tolower(as.character(v)))
        neg_tokens <- c("0","no","n","false","f","neg","negative","off")
        pos_tokens <- c("1","yes","y","true","t","pos","positive","on")
        s[s %in% neg_tokens] <- "0"
        s[s %in% pos_tokens] <- "1"
        s[s == ""] <- NA
        suppressWarnings(as.numeric(s))
      }
      
      model_data <- data[, unique(c(response_var, predictors)), drop = FALSE]
      raw_vals <- model_data[[response_var]]
      if (!is.numeric(raw_vals)) {
         bin <- to_binary(raw_vals)
         model_data[[response_var]] <- bin
         # Capture which raw tokens mapped where (for UI display)
         neg_hits <- unique(trimws(tolower(as.character(raw_vals)[bin == 0])))
         pos_hits <- unique(trimws(tolower(as.character(raw_vals)[bin == 1])))
         result_list$binary_mapping <- list(
            class0 = paste(neg_hits, collapse = ", "),
            class1 = paste(pos_hits, collapse = ", ")
         )
         raw_vals <- bin
      } else {
         raw_vals <- suppressWarnings(as.numeric(raw_vals))
         model_data[[response_var]] <- raw_vals
      }
      
      # Ensure response is suitable (0/1 numeric with exactly 2 levels)
      uniq <- sort(unique(na.omit(raw_vals)))
      if (length(uniq) != 2) {
         cat(toJSON(list(error = "Logistic regression requires a binary response (0/1) or a factor with 2 levels."), auto_unbox = TRUE))
         quit(save = "no")
      }
      if (!all(uniq %in% c(0, 1))) {
         model_data[[response_var]] <- ifelse(raw_vals == uniq[1], 0, ifelse(raw_vals == uniq[2], 1, NA_real_))
         result_list$binary_mapping <- list(class0 = as.character(uniq[1]), class1 = as.character(uniq[2]))
      } else if (is.null(result_list$binary_mapping)) {
         result_list$binary_mapping <- list(class0 = "0", class1 = "1")
      }
      for (p in predictors) {
        if (is.character(model_data[[p]])) model_data[[p]] <- as.factor(model_data[[p]])
      }
      model_data <- model_data[
        is.finite(model_data[[response_var]]) & model_data[[response_var]] %in% c(0, 1),
        ,
        drop = FALSE
      ]
      model_data <- na.omit(model_data)

      # Train/Test Split (stratified) to ensure both classes are present
       set.seed(42) # Reproducibility
       n_samples <- nrow(model_data)
       if (n_samples < 5) {
         cat(toJSON(list(error = "Not enough complete observations for logistic regression train/test split (need at least 5)."), auto_unbox = TRUE))
         quit(save = "no")
       }
       
       y_bin <- model_data[[response_var]]
       class0_idx <- which(y_bin == 0)
       class1_idx <- which(y_bin == 1)
       if (length(class0_idx) < 2 || length(class1_idx) < 2) {
         cat(toJSON(list(error = "Not enough samples in both classes to split (need at least 2 per class)."), auto_unbox = TRUE))
         quit(save = "no")
       }
       
       train_size0 <- max(1, floor(regression_train_fraction * length(class0_idx)))
       train_size1 <- max(1, floor(regression_train_fraction * length(class1_idx)))
       if (train_size0 >= length(class0_idx)) train_size0 <- length(class0_idx) - 1
       if (train_size1 >= length(class1_idx)) train_size1 <- length(class1_idx) - 1
       if (train_size0 < 1 || train_size1 < 1) {
         cat(toJSON(list(error = "Unable to create a valid train/test split with both classes present."), auto_unbox = TRUE))
         quit(save = "no")
       }
       
       train_indices <- c(sample(class0_idx, size = train_size0), sample(class1_idx, size = train_size1))
       test_indices <- setdiff(seq_len(n_samples), train_indices)
       if (length(test_indices) == 0) {
         cat(toJSON(list(error = "Train/test split failed (empty test set)."), auto_unbox = TRUE))
         quit(save = "no")
       }
       
       train_data <- model_data[train_indices, , drop = FALSE]
       test_data <- model_data[test_indices, , drop = FALSE]
       result_list$train_test_split <- list(
         train_percent = as.numeric(regression_train_percent),
         test_percent = as.numeric(regression_test_percent),
         train_fraction = as.numeric(regression_train_fraction),
         test_fraction = as.numeric(regression_test_fraction),
         split_seed = 42,
         split_method = "stratified",
         train_size = nrow(train_data),
         test_size = nrow(test_data),
         train_class0 = sum(train_data[[response_var]] == 0),
         train_class1 = sum(train_data[[response_var]] == 1),
         test_class0 = sum(test_data[[response_var]] == 0),
         test_class1 = sum(test_data[[response_var]] == 1)
       )
       if (auto_mode) {
         selection_train <- train_data
         selection_validation <- train_data
         selection_scope <- "train_resubstitution_fallback"

         set.seed(4242)
         validation_split <- make_stratified_validation_split(train_data, response_var, validation_fraction = 0.2)
         if (!is.null(validation_split)) {
           selection_train <- validation_split$train
           selection_validation <- validation_split$validation
           selection_scope <- "train_internal_holdout"
         }

         sel <- forward_select_logistic(predictors, selection_train, selection_validation)
         if (length(sel$selected) == 0) {
           cat(toJSON(list(error = "Auto-selection could not find a valid predictor set."), auto_unbox = TRUE))
           quit(save = "no")
         }
         predictors <- sel$selected
         result_list$auto_selection <- list(
           enabled = TRUE,
           strategy = "forward_selection",
           metric = "validation_auc",
           candidate_count = length(candidate_predictors),
           evaluated_models = sel$evaluated,
           selected_predictors = predictors,
           best_metric = "validation_auc",
           best_metrics = list(value = sel$best_metrics$auc, log_loss = sel$best_metrics$log_loss, aic = sel$best_metrics$aic),
           selection_scope = selection_scope,
           selection_train_size = nrow(selection_train),
           selection_validation_size = nrow(selection_validation)
         )
       }
       
       formula_str <- paste(response_var, "~", paste(predictors, collapse = " + "))
       result_list$formula <- formula_str
       result_list$predictors <- predictors
       
       aligned_final <- align_factor_levels(train_data, test_data, predictors)
       train_data <- aligned_final$train
       test_data <- aligned_final$test
       
       log_entry(paste0("glm(", formula_str, ", family = 'binomial', data = train_data)"))
       model <- glm(as.formula(formula_str), data = train_data, family = binomial)
       model_summary <- summary(model)
       
       # Coefficients
       coefs <- as.data.frame(model_summary$coefficients)
       coefs$Term <- rownames(coefs)
       rownames(coefs) <- NULL
       colnames(coefs) <- c("Estimate", "StdError", "zValue", "pValue", "Term")
       
       # Odds Ratios (Exp(Estimate))
       coefs$OddsRatio <- exp(coefs$Estimate)
       
       # Calculate CIs safely
       tryCatch({
         ci <- confint.default(model, level = selected_ci_level) # Wald CI for speed
         coefs$CI_2_5 <- exp(ci[,1])
         coefs$CI_97_5 <- exp(ci[,2])
       }, error = function(e) {
         coefs$CI_2_5 <- NA
         coefs$CI_97_5 <- NA
       })
       
       # Format p-values
       coefs$formatted_p <- sapply(coefs$pValue, function(p) {
         if (is.na(p)) return("NA")
         if (p < 0.001) "< .001" else format(round(p, 4), nsmall = 4)
       })
       coefs$significance <- sapply(coefs$pValue, function(p) {
         if (is.na(p)) return("")
         if (p < 0.001) return("***")
         if (p < 0.01) return("**")
         if (p < alpha_val) return("*")
         if (alpha_val < 0.1 && p < 0.1) return(".")
         ""
       })
       
       # --- Model Evaluation (Train vs Test) ---
       
       calc_auc <- function(actual, predicted_probs) {
         actual <- as.numeric(actual)
         if (length(unique(actual)) < 2) return(NA)
         n1 <- sum(actual == 1)
         n0 <- sum(actual == 0)
         if (n1 == 0 || n0 == 0) return(NA)
         r <- rank(predicted_probs, ties.method = "average")
         (sum(r[actual == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
       }
       
       calc_log_loss <- function(actual, predicted_probs) {
         eps <- 1e-15
         p <- pmin(pmax(predicted_probs, eps), 1 - eps)
         -mean(actual * log(p) + (1 - actual) * log(1 - p))
       }
       
       calc_brier <- function(actual, predicted_probs) {
         mean((predicted_probs - actual)^2)
       }
       
       # Function to calculate metrics
       calc_metrics <- function(actual, predicted_probs, threshold = 0.5) {
         predicted_class <- ifelse(predicted_probs > threshold, 1, 0)
         
         # Confusion Matrix
         cm <- table(Factor_Actual = factor(actual, levels=c(0, 1)), 
                    Factor_Predicted = factor(predicted_class, levels=c(0, 1)))
         
         tn <- cm[1,1]
         fp <- cm[1,2]
         fn <- cm[2,1]
         tp <- cm[2,2]
         
         accuracy <- (tp + tn) / sum(cm)
         precision <- if((tp + fp) > 0) tp / (tp + fp) else 0
         recall <- if((tp + fn) > 0) tp / (tp + fn) else 0 # Sensitivity
         specificity <- if((tn + fp) > 0) tn / (tn + fp) else 0
         npv <- if((tn + fn) > 0) tn / (tn + fn) else 0
         f1 <- if((precision + recall) > 0) 2 * (precision * recall) / (precision + recall) else 0
         balanced_accuracy <- (recall + specificity) / 2
         mcc_den <- (tp + fp) * (tp + fn) * (tn + fp) * (tn + fn)
         mcc <- if (mcc_den > 0) (tp * tn - fp * fn) / sqrt(mcc_den) else 0
         
         list(
           confusion_matrix = list(tn=as.numeric(tn), fp=as.numeric(fp), fn=as.numeric(fn), tp=as.numeric(tp)),
           accuracy = accuracy,
           precision = precision,
           recall = recall,
           specificity = specificity,
           npv = npv,
           f1_score = f1,
           balanced_accuracy = balanced_accuracy,
           mcc = mcc,
           auc = calc_auc(actual, predicted_probs),
           log_loss = calc_log_loss(actual, predicted_probs),
           brier = calc_brier(actual, predicted_probs)
         )
       }

       hosmer_lemeshow <- function(actual, predicted_probs, g = 10) {
         df <- data.frame(actual = actual, probs = predicted_probs)
         df <- df[!is.na(df$actual) & !is.na(df$probs), ]
         n <- nrow(df)
         if (n < 5 || length(unique(df$actual)) < 2) {
           return(list(statistic = NA, df = NA, p_value = NA, groups = NA))
         }
         g <- min(g, max(2, floor(n / 5)))
         cuts <- quantile(df$probs, probs = seq(0, 1, length.out = g + 1), na.rm = TRUE, type = 7)
         cuts <- unique(cuts)
         if (length(cuts) <= 2) {
           return(list(statistic = NA, df = NA, p_value = NA, groups = NA))
         }
         df$group <- cut(df$probs, breaks = cuts, include.lowest = TRUE, labels = FALSE)
         o <- tapply(df$actual, df$group, sum)
         n_i <- tapply(df$actual, df$group, length)
         e <- tapply(df$probs, df$group, sum)
         valid <- !is.na(o) & !is.na(e) & e > 0 & e < n_i
         hl <- sum((o[valid] - e[valid])^2 / (e[valid] * (1 - e[valid] / n_i[valid])))
         df_hl <- sum(valid) - 2
         p_val <- if (df_hl > 0) 1 - pchisq(hl, df = df_hl) else NA
         list(statistic = as.numeric(hl), df = as.numeric(df_hl), p_value = p_val, groups = sum(valid))
       }
       
       # Predict on Train
       train_probs <- predict(model, newdata = train_data, type = "response")
       train_metrics <- calc_metrics(
         train_data[[response_var]],
         train_probs,
         threshold = regression_classification_threshold
       )
       
       # Predict on Test
       # Handle potential new levels in factors for test data by removing rows with new levels if necessary?
       # For now, standard predict. If robust handling needed, we can wrap in tryCatch.
       test_probs <- predict(model, newdata = test_data, type = "response")
       test_metrics <- calc_metrics(
         test_data[[response_var]],
         test_probs,
         threshold = regression_classification_threshold
       )
       
       # Model Stats
       # Pseudo R-squared (McFadden) on Training Data
       ll.null <- model$null.deviance / -2
       ll.proposed <- model$deviance / -2
       pseudo_r2 <- (ll.null - ll.proposed) / ll.null
       n_train <- nrow(train_data)
       cox_snell_r2 <- 1 - exp((2 / n_train) * (ll.null - ll.proposed))
       nagelkerke_r2 <- cox_snell_r2 / (1 - exp((2 / n_train) * ll.null))
       
       lr_stat <- model$null.deviance - model$deviance
       lr_df <- model$df.null - model$df.residual
       lr_p <- 1 - pchisq(lr_stat, df = lr_df)
       
       model_stats <- list(
         aic = model_summary$aic,
         bic = BIC(model),
         log_likelihood = ll.proposed,
         log_likelihood_null = ll.null,
         null_deviance = model_summary$null.deviance,
         resid_deviance = model_summary$deviance,
         residual_deviance = model_summary$deviance,
         df_null = model_summary$df.null,
         df_resid = model_summary$df.residual,
         pseudo_r2_mcfadden = pseudo_r2,
         pseudo_r2_cox_snell = cox_snell_r2,
         pseudo_r2_nagelkerke = nagelkerke_r2,
         lr_statistic = lr_stat,
         lr_df = lr_df,
         lr_p_value = lr_p
       )
       
       result_list$coefficients <- coefs
       result_list$model_stats <- model_stats
       hl_test <- hosmer_lemeshow(test_data[[response_var]], test_probs, g = 10)
       
       result_list$fit_tests <- list(
         hosmer_lemeshow = hl_test
       )
       
       result_list$evaluation <- list(
         classification_threshold = as.numeric(regression_classification_threshold),
         train = train_metrics,
         test = test_metrics,
         split_info = list(
           train_size = nrow(train_data),
           test_size = nrow(test_data),
           train_percent = as.numeric(regression_train_percent),
           test_percent = as.numeric(regression_test_percent),
           train_fraction = as.numeric(regression_train_fraction),
           test_fraction = as.numeric(regression_test_fraction),
           classification_threshold = as.numeric(regression_classification_threshold),
           split_seed = 42,
           split_method = "stratified",
           train_class0 = sum(train_data[[response_var]] == 0),
           train_class1 = sum(train_data[[response_var]] == 1),
           test_class0 = sum(test_data[[response_var]] == 0),
           test_class1 = sum(test_data[[response_var]] == 1)
         )
       )
      
      # Plot: ROC Curve using pROC
       tryCatch({
           # Check if pROC is available, install if not (use local lib path)
           if (!requireNamespace("pROC", quietly = TRUE, lib.loc = local_lib)) {
               install.packages("pROC", lib = local_lib, repos = "https://cloud.r-project.org", quiet = TRUE)
           }
           
           if (requireNamespace("pROC", quietly = TRUE, lib.loc = local_lib)) {
               # Calculate ROC on TEST data
               roc_obj <- pROC::roc(test_data[[response_var]], test_probs, quiet = TRUE)
               auc_val <- as.numeric(pROC::auc(roc_obj))
               
               # Add AUC to evaluation metrics
               result_list$evaluation$test$auc <- auc_val
               
               # Include ROC points only if reasonably small to avoid huge payloads
               sens <- roc_obj$sensitivities
               spec <- roc_obj$specificities
               if (length(sens) <= 2000) {
                   result_list$evaluation$test$roc_data <- list(
                       sens = sens,
                       spec = spec
                   )
               } else {
                   result_list$evaluation$test$roc_data_truncated <- TRUE
                   result_list$evaluation$test$roc_points <- length(sens)
               }
               
               # Generate ROC Plot
               roc_title <- paste("ROC Curve (Test Data)\nAUC =", round(auc_val, 4))
               label_cfg <- resolve_base_label_config(
                 "diagnostic_plot",
                 default_title = roc_title,
                 default_x = "1 - Specificity",
                 default_y = "Sensitivity"
               )
               png(output_image, width = 800, height = 600)
               pROC::plot.roc(roc_obj, 
                    main = "",
                    xlab = "",
                    ylab = "",
                    col = palette_main, lwd = 3, legacy.axes = TRUE,
                    print.auc = FALSE, grid = TRUE)
               render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
               dev.off()
               
               result_list$plot_generated <- TRUE
               result_list$plot_path <- output_image
               
           } else {
               # Fallback if pROC fails
               result_list$plot_error <- "pROC package not available"
               result_list$plot_generated <- FALSE
           }
       }, error = function(e) {
          result_list$plot_error <- paste("ROC Plot Error:", e$message)
          result_list$plot_generated <- FALSE
       })

      publication_plot <- create_regression_publication_plot(
        model = model,
        coefficients_df = coefs,
        response_var = response_var,
        predictors = predictors,
        base_output_image = output_image,
        alpha_level = alpha_val,
        options = list(
          title = "Logistic Regression Coefficients",
          x_label = sprintf("Log-odds estimate (%d%% CI)", selected_ci_percent),
          caption = sprintf("Log-odds coefficients with %d%% confidence intervals; intercept omitted.", selected_ci_percent)
        )
      )
      result_list$regression_publication_plot_generated <- isTRUE(publication_plot$generated)
      if (isTRUE(publication_plot$generated) && !is.null(publication_plot$path)) {
        result_list$regression_publication_plot_path <- publication_plot$path
      } else if (!is.null(publication_plot$error)) {
        result_list$regression_publication_plot_error <- publication_plot$error
      }
    } else if (analysis_mode_base == "regression_ordinal_logistic") {
      # ORDINAL LOGISTIC REGRESSION (PROPORTIONAL ODDS)
      result_list$model_type <- "Ordinal Logistic Regression"
      if (auto_mode) {
        cat(toJSON(list(error = "Auto-selection is not available for ordinal logistic regression yet."), auto_unbox = TRUE))
        quit(save = "no")
      }
      if (!requireNamespace("MASS", quietly = TRUE)) {
        cat(toJSON(list(error = "Ordinal logistic regression requires the MASS package."), auto_unbox = TRUE))
        quit(save = "no")
      }

      model_data <- data[, unique(c(response_var, predictors)), drop = FALSE]
      response_text <- trimws(as.character(model_data[[response_var]]))
      response_text[response_text == ""] <- NA
      model_data[[response_var]] <- response_text
      model_data <- model_data[!is.na(model_data[[response_var]]), , drop = FALSE]

      for (p in predictors) {
        if (is.character(model_data[[p]])) model_data[[p]] <- as.factor(model_data[[p]])
      }

      level_info <- infer_ordinal_levels(model_data[[response_var]])
      ordered_levels <- level_info$levels
      if (length(ordered_levels) < 3) {
        cat(toJSON(list(error = "Ordinal logistic regression requires an ordered response with at least 3 levels."), auto_unbox = TRUE))
        quit(save = "no")
      }

      model_data[[response_var]] <- factor(as.character(model_data[[response_var]]), levels = ordered_levels, ordered = TRUE)
      model_data <- droplevels(na.omit(model_data))
      ordered_levels <- levels(model_data[[response_var]])
      if (nrow(model_data) < 5 || length(ordered_levels) < 3) {
        cat(toJSON(list(error = "Not enough complete observations to fit ordinal logistic regression."), auto_unbox = TRUE))
        quit(save = "no")
      }

      result_list$response_levels <- ordered_levels
      result_list$response_level_order_source <- level_info$source

      formula_str <- paste(response_var, "~", paste(predictors, collapse = " + "))
      result_list$formula <- formula_str
      result_list$predictors <- predictors

      log_entry(paste0("MASS::polr(", formula_str, ", data = model_data, method = 'logistic', Hess = TRUE)"))
      model <- tryCatch(
        MASS::polr(as.formula(formula_str), data = model_data, method = "logistic", Hess = TRUE),
        error = function(e) e
      )
      if (inherits(model, "error")) {
        cat(toJSON(list(error = paste("Ordinal logistic regression failed:", model$message)), auto_unbox = TRUE))
        quit(save = "no")
      }
      model_summary <- summary(model)

      coefs <- as.data.frame(model_summary$coefficients)
      coefs$Term <- rownames(coefs)
      rownames(coefs) <- NULL
      colnames(coefs) <- c("Estimate", "StdError", "zValue", "Term")
      coefs$pValue <- 2 * pnorm(abs(coefs$zValue), lower.tail = FALSE)
      coefs$CoefficientType <- ifelse(grepl("\\|", coefs$Term), "threshold", "predictor")
      coefs$OddsRatio <- ifelse(coefs$CoefficientType == "predictor", exp(coefs$Estimate), NA_real_)

      tryCatch({
        ci <- confint.default(model, level = selected_ci_level)
        if (is.matrix(ci) && nrow(ci) == nrow(coefs)) {
          coefs$CI_2_5 <- ifelse(coefs$CoefficientType == "predictor", exp(ci[, 1]), NA_real_)
          coefs$CI_97_5 <- ifelse(coefs$CoefficientType == "predictor", exp(ci[, 2]), NA_real_)
        } else {
          coefs$CI_2_5 <- NA_real_
          coefs$CI_97_5 <- NA_real_
        }
      }, error = function(e) {
        coefs$CI_2_5 <- NA_real_
        coefs$CI_97_5 <- NA_real_
      })

      coefs$formatted_p <- vapply(coefs$pValue, function(p) {
        if (is.na(p)) return("NA")
        if (p < 0.001) "< .001" else format(round(p, 4), nsmall = 4)
      }, character(1))
      coefs$significance <- vapply(coefs$pValue, function(p) {
        if (is.na(p)) return("")
        if (p < 0.001) return("***")
        if (p < 0.01) return("**")
        if (p < alpha_val) return("*")
        if (alpha_val < 0.1 && p < 0.1) return(".")
        ""
      }, character(1))

      loglik_full <- tryCatch(as.numeric(logLik(model)), error = function(e) NA_real_)
      null_model <- tryCatch(
        MASS::polr(as.formula(paste(response_var, "~ 1")), data = model_data, method = "logistic", Hess = TRUE),
        error = function(e) NULL
      )
      loglik_null <- if (!is.null(null_model)) tryCatch(as.numeric(logLik(null_model)), error = function(e) NA_real_) else NA_real_
      model_df <- tryCatch(as.numeric(attr(logLik(model), "df")), error = function(e) NA_real_)
      null_df <- if (!is.null(null_model)) tryCatch(as.numeric(attr(logLik(null_model), "df")), error = function(e) NA_real_) else NA_real_
      n_obs <- nrow(model_data)
      lr_stat <- if (is.finite(loglik_full) && is.finite(loglik_null)) 2 * (loglik_full - loglik_null) else NA_real_
      lr_df <- if (is.finite(model_df) && is.finite(null_df)) model_df - null_df else NA_real_
      lr_p <- if (is.finite(lr_stat) && is.finite(lr_df) && lr_df > 0) 1 - pchisq(lr_stat, df = lr_df) else NA_real_
      pseudo_r2 <- if (is.finite(loglik_full) && is.finite(loglik_null) && loglik_null != 0) 1 - (loglik_full / loglik_null) else NA_real_
      cox_snell_r2 <- if (is.finite(loglik_full) && is.finite(loglik_null) && is.finite(n_obs) && n_obs > 0) {
        1 - exp((2 / n_obs) * (loglik_null - loglik_full))
      } else {
        NA_real_
      }
      nagelkerke_den <- if (is.finite(loglik_null) && is.finite(n_obs) && n_obs > 0) {
        1 - exp((2 / n_obs) * loglik_null)
      } else {
        NA_real_
      }
      nagelkerke_r2 <- if (is.finite(cox_snell_r2) && is.finite(nagelkerke_den) && nagelkerke_den != 0) {
        cox_snell_r2 / nagelkerke_den
      } else {
        NA_real_
      }
      null_dev <- if (is.finite(loglik_null)) -2 * loglik_null else NA_real_
      residual_dev <- if (is.finite(loglik_full)) -2 * loglik_full else NA_real_
      df_resid <- if (is.finite(model_df) && is.finite(n_obs)) n_obs - model_df else NA_real_

      result_list$coefficients <- coefs
      result_list$model_stats <- list(
        aic = AIC(model),
        bic = BIC(model),
        log_likelihood = loglik_full,
        log_likelihood_null = loglik_null,
        null_deviance = null_dev,
        residual_deviance = residual_dev,
        resid_deviance = residual_dev,
        df_resid = df_resid,
        pseudo_r2_mcfadden = pseudo_r2,
        pseudo_r2_cox_snell = cox_snell_r2,
        pseudo_r2_nagelkerke = nagelkerke_r2,
        lr_statistic = lr_stat,
        lr_df = lr_df,
        lr_p_value = lr_p,
        n_levels = length(ordered_levels),
        n_observations = n_obs
      )

      publication_plot <- create_regression_publication_plot(
        model = model,
        coefficients_df = coefs,
        response_var = response_var,
        predictors = predictors,
        base_output_image = output_image,
        alpha_level = alpha_val,
        options = list(
          title = "Ordinal Logistic Regression Coefficients",
          subtitle = paste0("Outcome: ", response_var),
          x_label = sprintf("Log-odds estimate (%d%% CI)", selected_ci_percent),
          caption = sprintf("Predictor log-odds with %d%% confidence intervals; threshold terms omitted.", selected_ci_percent)
        )
      )
      result_list$regression_publication_plot_generated <- isTRUE(publication_plot$generated)
      if (isTRUE(publication_plot$generated) && !is.null(publication_plot$path)) {
        result_list$regression_publication_plot_path <- publication_plot$path
      } else if (!is.null(publication_plot$error)) {
        result_list$regression_publication_plot_error <- publication_plot$error
      }
    }

    cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
    quit(save = "no")
  }
  
  # MULTIVARIATE ANALYSIS MODE
  if (startsWith(base_analysis_mode, "multivariate")) {
    invisible(load_pkgs(multivariate_pkgs))
    
    # Parse predictors from group_var
    predictors <- trimws(unlist(strsplit(group_var, ",")))
    predictors <- predictors[predictors != ""]

    is_pca_mode <- base_analysis_mode %in% c("multivariate_pca", "multivariate_pca_biplot")
    is_ca_mode <- base_analysis_mode == "multivariate_ca"
    is_mca_mode <- base_analysis_mode == "multivariate_mca"
    is_bca_mode <- base_analysis_mode == "multivariate_bca"
    is_coinertia_mode <- base_analysis_mode == "multivariate_coinertia"
    is_hclust_mode <- base_analysis_mode == "multivariate_hclust"
    ca_mca_auto_bin_numeric <- parse_logical_flag(plot_colors_list[["ca_mca_auto_bin_numeric"]], default = FALSE)
    ca_mca_bin_count <- 5L
    if (!is.null(plot_colors_list[["ca_mca_bin_count"]])) {
      parsed_bin_count <- suppressWarnings(as.integer(plot_colors_list[["ca_mca_bin_count"]][1]))
      if (is.finite(parsed_bin_count)) {
        ca_mca_bin_count <- as.integer(max(3L, min(20L, parsed_bin_count)))
      }
    }
    ca_mca_bin_variables <- character(0)
    if (!is.null(plot_colors_list[["ca_mca_bin_variables"]])) {
      raw_bin_vars <- plot_colors_list[["ca_mca_bin_variables"]]
      raw_bin_vars <- unlist(raw_bin_vars, use.names = FALSE)
      raw_bin_vars <- trimws(as.character(raw_bin_vars))
      raw_bin_vars <- raw_bin_vars[!is.na(raw_bin_vars) & raw_bin_vars != ""]
      if (length(raw_bin_vars) == 1 && grepl(",", raw_bin_vars[[1]], fixed = TRUE)) {
        raw_bin_vars <- trimws(unlist(strsplit(raw_bin_vars[[1]], ",", fixed = TRUE)))
      }
      ca_mca_bin_variables <- unique(raw_bin_vars[raw_bin_vars != ""])
    }
    coinertia_block_y <- character(0)
    if (isTRUE(is_coinertia_mode)) {
      coinertia_block_y <- trimws(unlist(strsplit(group_var2, ",")))
      coinertia_block_y <- unique(coinertia_block_y[coinertia_block_y != ""])
    }
    
    if (isTRUE(is_coinertia_mode)) {
      if (length(predictors) < 1) {
        cat(toJSON(list(error = "Co-inertia requires at least 1 variable in Block X."), auto_unbox = TRUE))
        quit(save = "no")
      }
      if (length(coinertia_block_y) < 1) {
        cat(toJSON(list(error = "Co-inertia requires at least 1 variable in Block Y."), auto_unbox = TRUE))
        quit(save = "no")
      }
      overlap_xy <- intersect(predictors, coinertia_block_y)
      if (length(overlap_xy) > 0) {
        cat(toJSON(list(error = paste0(
          "Co-inertia blocks must be disjoint. Move these variable(s) to one block only: ",
          paste(overlap_xy, collapse = ", "),
          "."
        )), auto_unbox = TRUE))
        quit(save = "no")
      }
    } else if (length(predictors) < 2) {
      cat(toJSON(list(error = "Multivariate analysis requires at least 2 variables."), auto_unbox = TRUE))
      quit(save = "no")
    }
    
    # Validate columns
    vars_for_validation <- if (isTRUE(is_coinertia_mode)) unique(c(predictors, coinertia_block_y)) else predictors
    missing <- setdiff(vars_for_validation, colnames(data))
    if (length(missing) > 0) {
      cat(toJSON(list(error = paste("Variables not found:", paste(missing, collapse=", "))), auto_unbox = TRUE))
      quit(save = "no")
    }
    
    # Prepare data subset
    vars_to_use <- predictors
    grouping_var_name <- NULL
    if (isTRUE(is_coinertia_mode)) {
      vars_to_use <- unique(c(vars_to_use, coinertia_block_y))
    }
    
    # Optional grouping/class variable for PCA/BCA/MCA (when provided and valid).
    if ((is_pca_mode || is_bca_mode || is_mca_mode) && response_var != "" && response_var != "null" && response_var %in% names(data)) {
        if (!response_var %in% vars_to_use) {
             vars_to_use <- c(predictors, response_var)
        }
        grouping_var_name <- response_var
    }
    
    # Subset and handle missing values
    data_subset <- data[, vars_to_use, drop = FALSE]
    data_subset <- na.omit(data_subset)
    
    if (nrow(data_subset) < 3) {
      cat(toJSON(list(error = "Not enough data points (need at least 3 complete cases)."), auto_unbox = TRUE))
      quit(save = "no")
    }
    
    # Extract predictor data for analysis
    predictor_data <- data_subset[, predictors, drop = FALSE]
    categorical_predictor_data <- predictor_data
    ca_mca_binned_vars <- character(0)
    ca_mca_bin_level_map <- list()

    discretize_numeric_for_ca_mca <- function(raw_values, n_bins = 5L) {
      values_chr <- trimws(as.character(raw_values))
      values_chr[values_chr == ""] <- NA_character_
      numeric_values <- suppressWarnings(as.numeric(raw_values))
      valid_numeric <- is.finite(numeric_values)
      unique_count <- length(unique(numeric_values[valid_numeric]))
      if (sum(valid_numeric) < 2 || unique_count < 2) {
        return(list(values = values_chr, binned = FALSE, levels = character(0)))
      }

      binned <- tryCatch(
        cut(numeric_values, breaks = n_bins, include.lowest = TRUE, dig.lab = 7, ordered_result = TRUE),
        error = function(e) NULL
      )
      if (is.null(binned)) {
        quantile_breaks <- tryCatch(
          unique(stats::quantile(numeric_values[valid_numeric], probs = seq(0, 1, length.out = n_bins + 1), na.rm = TRUE, type = 7)),
          error = function(e) numeric(0)
        )
        if (length(quantile_breaks) >= 2) {
          binned <- tryCatch(
            cut(numeric_values, breaks = quantile_breaks, include.lowest = TRUE, dig.lab = 7, ordered_result = TRUE),
            error = function(e) NULL
          )
        }
      }
      if (is.null(binned)) {
        return(list(values = values_chr, binned = FALSE, levels = character(0)))
      }

      binned_chr <- as.character(binned)
      binned_chr[binned_chr == ""] <- NA_character_
      if (length(unique(na.omit(binned_chr))) < 2) {
        return(list(values = values_chr, binned = FALSE, levels = character(0)))
      }
      binned_levels <- levels(binned)
      binned_levels <- trimws(as.character(binned_levels))
      binned_levels <- binned_levels[!is.na(binned_levels) & binned_levels != ""]
      list(values = binned_chr, binned = TRUE, levels = unique(binned_levels))
    }

    build_interval_summary_for_values <- function(values, level_order = character(0)) {
      values_chr <- trimws(as.character(values))
      values_chr[values_chr == ""] <- NA_character_
      values_chr <- values_chr[!is.na(values_chr)]
      if (length(values_chr) == 0) {
        return(NULL)
      }

      ordered_levels <- trimws(as.character(level_order))
      ordered_levels <- ordered_levels[!is.na(ordered_levels) & ordered_levels != ""]
      ordered_levels <- unique(ordered_levels)

      if (length(ordered_levels) > 0) {
        present_levels <- unique(values_chr)
        extra_levels <- setdiff(sort(present_levels), ordered_levels)
        final_levels <- c(ordered_levels, extra_levels)
        counts <- table(factor(values_chr, levels = final_levels), useNA = "no")
      } else {
        counts <- sort(table(values_chr, useNA = "no"), decreasing = TRUE)
      }

      data.frame(
        Interval = names(counts),
        Count = as.numeric(counts),
        stringsAsFactors = FALSE,
        row.names = NULL
      )
    }

    is_interval_like_label <- function(label_value) {
      label_text <- trimws(as.character(label_value))
      if (!nzchar(label_text)) {
        return(FALSE)
      }
      grepl(
        "^\\s*[\\[(]\\s*[-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?\\s*,\\s*[-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?\\s*[\\])]\\s*$",
        label_text,
        perl = TRUE
      )
    }

    format_interval_labels <- function(label_values, prefix = "Int", show_alias = FALSE, hide_original = FALSE) {
      labels_chr <- as.character(label_values)
      if (length(labels_chr) == 0) {
        return(character(0))
      }
      interval_mask <- vapply(labels_chr, is_interval_like_label, logical(1))
      if (!any(interval_mask)) {
        return(labels_chr)
      }
      if (!isTRUE(show_alias) && !isTRUE(hide_original)) {
        return(labels_chr)
      }
      formatted <- labels_chr
      alias_values <- paste0(prefix, seq_len(sum(interval_mask)))
      if (isTRUE(hide_original)) {
        formatted[interval_mask] <- alias_values
      } else {
        formatted[interval_mask] <- paste0(labels_chr[interval_mask], "\n", alias_values)
      }
      formatted
    }

    build_ca_contingency_table_payload <- function(tab, row_var_name, col_var_name, binned_vars = character(0)) {
      if (is.null(tab) || length(dim(tab)) != 2) {
        return(NULL)
      }

      display_table <- tab
      display_row_var <- row_var_name
      display_col_var <- col_var_name
      binned_vars <- unique(trimws(as.character(binned_vars)))
      binned_vars <- binned_vars[!is.na(binned_vars) & binned_vars != ""]

      if (length(binned_vars) > 0) {
        binned_target <- binned_vars[[1]]
        if (!identical(display_row_var, binned_target) && identical(display_col_var, binned_target)) {
          display_table <- t(display_table)
          display_row_var <- binned_target
          other_var <- setdiff(c(row_var_name, col_var_name), binned_target)
          if (length(other_var) > 0) {
            display_col_var <- other_var[[1]]
          }
        }
      }

      table_df <- as.data.frame.matrix(display_table, stringsAsFactors = FALSE)
      table_df <- data.frame(Interval = rownames(table_df), table_df, stringsAsFactors = FALSE, check.names = FALSE)
      rownames(table_df) <- NULL

      row_label <- if (display_row_var %in% binned_vars) {
        paste0(display_row_var, " interval")
      } else {
        display_row_var
      }

      list(
        title = paste0("Contingency table (", display_row_var, " category × ", display_col_var, ")"),
        row_variable = display_row_var,
        row_label = row_label,
        column_variable = display_col_var,
        column_levels = colnames(display_table),
        rows = table_df
      )
    }
    
    # Extract grouping col if applicable
    grouping_col <- NULL
    if (!is.null(grouping_var_name)) {
        grouping_col <- as.factor(data_subset[[grouping_var_name]])
    }
    
    # Numeric matrix is required for PCA/BCA/kmeans branches; CA/MCA use categorical data.
    # Hclust supports mixed predictors via internal preprocessing.
    num_data <- NULL
    if (!(is_ca_mode || is_mca_mode || is_coinertia_mode || is_hclust_mode)) {
      num_data <- predictor_data
      non_num <- !sapply(num_data, is.numeric)
      if (any(non_num)) {
        cat(toJSON(list(error = "All selected predictor variables must be numeric for this multivariate method."), auto_unbox = TRUE))
        quit(save = "no")
      }
    } else if (isTRUE(is_hclust_mode)) {
      num_data <- predictor_data
    } else if (isTRUE(is_ca_mode || is_mca_mode)) {
      for (v in predictors) {
        current_values <- predictor_data[[v]]
        should_bin_numeric <- isTRUE(is_ca_mode) &&
          isTRUE(ca_mca_auto_bin_numeric) &&
          is.numeric(current_values) &&
          (length(ca_mca_bin_variables) == 0 || v %in% ca_mca_bin_variables)
        if (isTRUE(should_bin_numeric)) {
          binned_result <- discretize_numeric_for_ca_mca(current_values, ca_mca_bin_count)
          categorical_predictor_data[[v]] <- binned_result$values
          if (isTRUE(binned_result$binned)) {
            ca_mca_binned_vars <- c(ca_mca_binned_vars, v)
            ca_mca_bin_level_map[[v]] <- binned_result$levels
          }
        } else {
          char_values <- trimws(as.character(current_values))
          char_values[char_values == ""] <- NA_character_
          categorical_predictor_data[[v]] <- char_values
        }
      }
    }
    
    result_list <- list(
      mode = base_analysis_mode,
      predictors = predictors,
      n_samples = nrow(data_subset)
    )
    if (!is.null(grouping_var_name)) {
      result_list$grouping_variable <- grouping_var_name
    }
    if (isTRUE(is_coinertia_mode)) {
      result_list$coinertia_block_y_variables <- coinertia_block_y
    }
    if (isTRUE(is_ca_mode)) {
      result_list$ca_mca_numeric_binning <- list(
        enabled = isTRUE(ca_mca_auto_bin_numeric),
        bins_requested = as.numeric(ca_mca_bin_count),
        requested_variables = unique(intersect(ca_mca_bin_variables, predictors)),
        transformed_variables = unique(ca_mca_binned_vars)
      )
    }

    if (base_analysis_mode == "multivariate_ca") {
      # CA (Correspondence Analysis) on a 2-way contingency table built from exactly two selected variables.
      if (length(predictors) != 2) {
        cat(toJSON(list(error = "CA requires exactly 2 variables."), auto_unbox = TRUE))
        quit(save = "no")
      }

      ca_vars <- predictors
      ca_notes <- character(0)
      ca_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("analysis_plot"))
      include_ca_chi_square <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_chi_square", FALSE)
      show_ca_biplot_mode <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_biplot_mode", TRUE)
      show_ca_biplot_arrows <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_biplot_arrows", FALSE)
      show_ca_row_points <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_row_points", TRUE)
      show_ca_column_points <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_column_points", TRUE)
      if (isTRUE(show_ca_biplot_mode)) {
        show_ca_row_points <- TRUE
        show_ca_column_points <- TRUE
      }
      if (isTRUE(show_ca_biplot_arrows)) {
        show_ca_row_points <- TRUE
        show_ca_column_points <- TRUE
      }
      show_ca_labels <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_labels", TRUE)
      show_ca_legend <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_legend", TRUE)
      show_ca_interval_short_names <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_interval_short_names", FALSE)
      hide_ca_interval_values <- resolve_plot_element_flag(ca_plot_labels_cfg, "hide_ca_interval_values", FALSE)
      legacy_show_ca_interval_alias <- resolve_plot_element_flag(ca_plot_labels_cfg, "show_ca_interval_alias", FALSE)
      show_ca_interval_short_names <- isTRUE(show_ca_interval_short_names) || isTRUE(legacy_show_ca_interval_alias) || isTRUE(hide_ca_interval_values)
      ca_label_nudge_x <- resolve_plot_element_numeric(ca_plot_labels_cfg, "point_label_nudge_x", 0, -2, 2)
      ca_label_nudge_y <- resolve_plot_element_numeric(ca_plot_labels_cfg, "point_label_nudge_y", 0, -2, 2)
      result_list$ca_chi_square_enabled <- isTRUE(include_ca_chi_square)
      ca_binned_vars <- intersect(ca_vars, ca_mca_binned_vars)
      if (length(ca_binned_vars) > 0) {
        ca_notes <- c(
          ca_notes,
          paste0(
            "Numeric variable(s) discretized into ",
            as.integer(ca_mca_bin_count),
            " intervals before CA: ",
            paste(ca_binned_vars, collapse = ", "),
            "."
          )
        )
      }

       x_vals <- trimws(as.character(categorical_predictor_data[[ca_vars[1]]]))
       y_vals <- trimws(as.character(categorical_predictor_data[[ca_vars[2]]]))
       valid_mask <- !is.na(x_vals) & !is.na(y_vals) & x_vals != "" & y_vals != ""
       x_vals <- x_vals[valid_mask]
       y_vals <- y_vals[valid_mask]

      build_present_level_order <- function(var_name, values_chr) {
        present_levels <- unique(values_chr[!is.na(values_chr) & values_chr != ""])
        if (length(present_levels) == 0) {
          return(character(0))
        }
        if (!(var_name %in% ca_binned_vars)) {
          return(sort(present_levels))
        }
        mapped_levels <- ca_mca_bin_level_map[[var_name]]
        mapped_levels <- trimws(as.character(mapped_levels))
        mapped_levels <- mapped_levels[!is.na(mapped_levels) & mapped_levels != ""]
        mapped_levels <- unique(mapped_levels)
        if (length(mapped_levels) == 0) {
          return(sort(present_levels))
        }
        ordered_present <- mapped_levels[mapped_levels %in% present_levels]
        extras <- present_levels[!present_levels %in% ordered_present]
        c(ordered_present, extras)
      }

      x_level_order <- build_present_level_order(ca_vars[1], x_vals)
      y_level_order <- build_present_level_order(ca_vars[2], y_vals)
      x_vals_for_table <- factor(x_vals, levels = x_level_order, ordered = TRUE)
      y_vals_for_table <- factor(y_vals, levels = y_level_order, ordered = TRUE)
       result_list$n_samples <- as.numeric(length(x_vals))

       if (length(x_vals) < 5) {
         cat(toJSON(list(error = "CA requires at least 5 non-missing paired observations."), auto_unbox = TRUE))
         quit(save = "no")
       }

      cont_table <- table(x_vals_for_table, y_vals_for_table, useNA = "no")
      if (nrow(cont_table) < 2 || ncol(cont_table) < 2) {
        cat(toJSON(list(error = "CA requires at least 2 row levels and 2 column levels."), auto_unbox = TRUE))
        quit(save = "no")
      }
      ca_contingency_payload <- build_ca_contingency_table_payload(
        cont_table,
        ca_vars[1],
        ca_vars[2],
        ca_binned_vars
      )
      if (!is.null(ca_contingency_payload)) {
        result_list$ca_interval_contingency_table <- ca_contingency_payload
      }
      max_dims_theoretical <- max(1, min(nrow(cont_table) - 1, ncol(cont_table) - 1))

      total_n <- as.numeric(sum(cont_table))
      if (isTRUE(include_ca_chi_square)) {
        chi_sq_res <- tryCatch(suppressWarnings(stats::chisq.test(cont_table, correct = FALSE)), error = function(e) NULL)
        if (!is.null(chi_sq_res)) {
          expected_mat <- chi_sq_res$expected
          expected_total <- as.numeric(length(expected_mat))
          expected_lt5 <- as.numeric(sum(expected_mat < 5, na.rm = TRUE))
          expected_lt1 <- as.numeric(sum(expected_mat < 1, na.rm = TRUE))
          expected_lt5_pct <- if (is.finite(expected_total) && expected_total > 0) {
            round((expected_lt5 / expected_total) * 100, 2)
          } else {
            NA_real_
          }
          min_dim_for_v <- min(nrow(cont_table) - 1, ncol(cont_table) - 1)
          chi_sq_stat <- as.numeric(chi_sq_res$statistic)
          cramers_v <- if (is.finite(chi_sq_stat) && is.finite(total_n) && total_n > 0 && min_dim_for_v > 0) {
            sqrt(chi_sq_stat / (total_n * min_dim_for_v))
          } else {
            NA_real_
          }
          result_list$ca_chi_square <- list(
            statistic = chi_sq_stat,
            df = as.numeric(chi_sq_res$parameter),
            p_value = as.numeric(chi_sq_res$p.value),
            method = as.character(chi_sq_res$method),
            cramers_v = as.numeric(cramers_v),
            expected_cells_lt_5 = expected_lt5,
            expected_cells_lt_1 = expected_lt1,
            expected_cells_total = expected_total,
            expected_cells_lt_5_pct = expected_lt5_pct,
            expected_min = as.numeric(min(expected_mat, na.rm = TRUE))
          )
          if ((is.finite(expected_lt1) && expected_lt1 > 0) || (is.finite(expected_lt5_pct) && expected_lt5_pct > 20)) {
            ca_notes <- c(ca_notes, "Chi-square approximation caution: expected counts are low in part of the table.")
          }
        } else {
          result_list$ca_chi_square <- list(error = "Chi-square test could not be computed.")
          ca_notes <- c(ca_notes, "Chi-square test could not be computed for this contingency table.")
        }
      }
      p_mat <- cont_table / total_n
      row_margins <- as.numeric(rowSums(p_mat))
      col_margins <- as.numeric(colSums(p_mat))

       if (any(row_margins <= 0) || any(col_margins <= 0)) {
         cat(toJSON(list(error = "CA failed: contingency table has empty margins."), auto_unbox = TRUE))
         quit(save = "no")
       }

       dr_inv_sqrt <- diag(1 / sqrt(row_margins), nrow = length(row_margins), ncol = length(row_margins))
       dc_inv_sqrt <- diag(1 / sqrt(col_margins), nrow = length(col_margins), ncol = length(col_margins))
       centered <- p_mat - row_margins %*% t(col_margins)
       s_mat <- dr_inv_sqrt %*% centered %*% dc_inv_sqrt
       sv <- svd(s_mat)

      singular_vals <- as.numeric(sv$d)
      eigen_vals_all <- singular_vals^2
      keep_idx <- which(is.finite(eigen_vals_all) & eigen_vals_all > .Machine$double.eps)
      if (length(keep_idx) == 0) {
        cat(toJSON(list(error = "CA failed: no positive dimensions were found."), auto_unbox = TRUE))
        quit(save = "no")
      }
      retained_dims <- length(keep_idx)
      if (retained_dims <= 1) {
        ca_notes <- c(
          ca_notes,
          paste0(
            "Only one informative CA dimension was retained (table size: ",
            nrow(cont_table), " x ", ncol(cont_table),
            ", theoretical maximum: ", max_dims_theoretical, ")."
          )
        )
      } else if (retained_dims < max_dims_theoretical) {
        ca_notes <- c(
          ca_notes,
          paste0(
            "CA retained ", retained_dims,
            " informative dimensions (theoretical maximum: ", max_dims_theoretical, ")."
          )
        )
      }

       singular_keep <- singular_vals[keep_idx]
       eigen_vals <- eigen_vals_all[keep_idx]
       variance_pct <- round((eigen_vals / sum(eigen_vals)) * 100, 2)
       cum_variance <- cumsum(variance_pct)
       dim_names <- paste0("Dim", seq_along(eigen_vals))

       d_keep <- diag(singular_keep, nrow = length(singular_keep), ncol = length(singular_keep))
       row_coords <- dr_inv_sqrt %*% sv$u[, keep_idx, drop = FALSE] %*% d_keep
       col_coords <- dc_inv_sqrt %*% sv$v[, keep_idx, drop = FALSE] %*% d_keep

       row_coord_df <- data.frame(Level = rownames(cont_table), row_coords, check.names = FALSE, stringsAsFactors = FALSE)
       col_coord_df <- data.frame(Level = colnames(cont_table), col_coords, check.names = FALSE, stringsAsFactors = FALSE)
       colnames(row_coord_df)[-1] <- dim_names
       colnames(col_coord_df)[-1] <- dim_names

      dim1_idx <- 1
      has_second_dim <- ncol(row_coords) >= 2 && ncol(col_coords) >= 2
      row_dim2_vals <- if (has_second_dim) row_coords[, 2] else rep(0.08, nrow(row_coords))
      col_dim2_vals <- if (has_second_dim) col_coords[, 2] else rep(-0.08, nrow(col_coords))
      row_plot_labels <- rownames(cont_table)
      col_plot_labels <- colnames(cont_table)
      if (isTRUE(show_ca_interval_short_names) || isTRUE(hide_ca_interval_values)) {
        row_plot_labels <- format_interval_labels(
          row_plot_labels,
          prefix = "Int",
          show_alias = isTRUE(show_ca_interval_short_names),
          hide_original = isTRUE(hide_ca_interval_values)
        )
        col_plot_labels <- format_interval_labels(
          col_plot_labels,
          prefix = "Int",
          show_alias = isTRUE(show_ca_interval_short_names),
          hide_original = isTRUE(hide_ca_interval_values)
        )
      }
      row_plot_df <- data.frame(
        label = row_plot_labels,
        Dim1 = as.numeric(row_coords[, dim1_idx]),
        Dim2 = as.numeric(row_dim2_vals),
        Type = "Row",
        stringsAsFactors = FALSE
      )
      col_plot_df <- data.frame(
        label = col_plot_labels,
        Dim1 = as.numeric(col_coords[, dim1_idx]),
        Dim2 = as.numeric(col_dim2_vals),
        Type = "Column",
        stringsAsFactors = FALSE
      )

       result_list$eigenvalues <- data.frame(
         PC = dim_names,
         Eigenvalue = round(eigen_vals, 4),
         Variance_Percent = variance_pct,
         Cumulative_Percent = cum_variance
       )
      result_list$ca_summary <- list(
        row_variable = ca_vars[1],
        column_variable = ca_vars[2],
        row_levels = as.numeric(nrow(cont_table)),
        col_levels = as.numeric(ncol(cont_table)),
        total_n = total_n,
        theoretical_max_dimensions = as.numeric(max_dims_theoretical),
        retained_dimensions = as.numeric(retained_dims)
      )
      result_list$ca_row_coordinates <- row_coord_df
      result_list$ca_col_coordinates <- col_coord_df
      if (length(ca_binned_vars) > 0) {
        interval_tables <- list()
        for (binned_var in ca_binned_vars) {
          var_values <- categorical_predictor_data[[binned_var]][valid_mask]
          interval_df <- build_interval_summary_for_values(var_values, ca_mca_bin_level_map[[binned_var]])
          if (!is.null(interval_df) && nrow(interval_df) > 0) {
            interval_tables[[length(interval_tables) + 1]] <- list(
              variable = binned_var,
              intervals = interval_df
            )
          }
        }
        if (length(interval_tables) > 0) {
          result_list$ca_mca_interval_tables <- interval_tables
        }
      }
      if (length(ca_notes) > 0) {
        result_list$ca_notes <- unique(ca_notes)
        result_list$ca_note <- result_list$ca_notes[[1]]
      }

      ca_plot_error <- NULL
      tryCatch({
        library(ggplot2)
        x_label <- paste0("Dim1 (", variance_pct[1], "%)")
        y_label <- if (length(variance_pct) >= 2) paste0("Dim2 (", variance_pct[2], "%)") else "Single CA dimension (offset display)"
        subtitle_parts <- character(0)
        if (length(variance_pct) < 2) {
          subtitle_parts <- c(subtitle_parts, "Only one CA dimension is available for this contingency table.")
        }
        ca_chi_square_result <- result_list[["ca_chi_square", exact = TRUE]]
        if (is.list(ca_chi_square_result) && is.null(ca_chi_square_result$error)) {
          chi_sq_stat <- suppressWarnings(as.numeric(ca_chi_square_result$statistic))
          chi_sq_df <- suppressWarnings(as.integer(ca_chi_square_result$df))
          chi_sq_p <- suppressWarnings(as.numeric(ca_chi_square_result$p_value))
          chi_sq_p_text <- if (is.finite(chi_sq_p) && chi_sq_p < 1e-04) {
            format(chi_sq_p, scientific = TRUE, digits = 3)
          } else if (is.finite(chi_sq_p)) {
            format(round(chi_sq_p, 4), nsmall = 4)
          } else {
            "NA"
          }
          chi_sq_text <- paste0(
            "Chi-square = ",
            if (is.finite(chi_sq_stat)) format(round(chi_sq_stat, 3), nsmall = 3) else "NA",
            " (df = ",
            if (is.finite(chi_sq_df)) chi_sq_df else "NA",
            "), p = ",
            chi_sq_p_text
          )
          subtitle_parts <- c(subtitle_parts, chi_sq_text)
        }
        subtitle_text <- if (length(subtitle_parts) > 0) paste(subtitle_parts, collapse = " | ") else NULL
        p_ca <- ggplot() +
          geom_hline(yintercept = 0, linetype = "dashed", color = "#94a3b8", linewidth = 0.4) +
          geom_vline(xintercept = 0, linetype = "dashed", color = "#94a3b8", linewidth = 0.4)

        if (isTRUE(show_ca_biplot_arrows)) {
          subtitle_parts <- c(subtitle_parts, "Biplot arrows enabled")
          p_ca <- p_ca +
            geom_segment(
              data = row_plot_df,
              aes(x = 0, y = 0, xend = Dim1, yend = Dim2, color = Type),
              linewidth = 0.42,
              alpha = 0.5,
              arrow = arrow(length = grid::unit(0.13, "cm")),
              show.legend = FALSE
            ) +
            geom_segment(
              data = col_plot_df,
              aes(x = 0, y = 0, xend = Dim1, yend = Dim2, color = Type),
              linewidth = 0.45,
              alpha = 0.55,
              linetype = "dashed",
              arrow = arrow(length = grid::unit(0.13, "cm")),
              show.legend = FALSE
            )
          subtitle_text <- if (length(subtitle_parts) > 0) paste(subtitle_parts, collapse = " | ") else NULL
        }

        if (isTRUE(show_ca_row_points)) {
          p_ca <- p_ca +
            geom_point(
              data = row_plot_df,
              aes(x = Dim1, y = Dim2, color = Type),
              size = 3.2,
              alpha = 0.85,
              shape = 16
            )
        }
        if (isTRUE(show_ca_column_points)) {
          p_ca <- p_ca +
            geom_point(
              data = col_plot_df,
              aes(x = Dim1, y = Dim2, color = Type),
              size = 3.2,
              alpha = 0.9,
              shape = 17
            )
        }
        if (isTRUE(show_ca_labels) && isTRUE(show_ca_row_points)) {
          p_ca <- p_ca +
            geom_text(
              data = row_plot_df,
              aes(x = Dim1 + ca_label_nudge_x, y = Dim2 + ca_label_nudge_y, label = label, color = Type),
              vjust = -0.8,
              size = 3.2,
              fontface = "bold",
              show.legend = FALSE
            )
        }
        if (isTRUE(show_ca_labels) && isTRUE(show_ca_column_points)) {
          p_ca <- p_ca +
            geom_text(
              data = col_plot_df,
              aes(x = Dim1 + ca_label_nudge_x, y = Dim2 + ca_label_nudge_y, label = label, color = Type),
              vjust = -0.8,
              size = 3.2,
              fontface = "bold",
              show.legend = FALSE
            )
        }

        if (isTRUE(show_ca_row_points) || isTRUE(show_ca_column_points)) {
          p_ca <- p_ca +
            scale_color_manual(
              values = c(Row = palette_main, Column = palette_accent),
              drop = FALSE
            )
        }

        p_ca <- p_ca +
          labs(
            title = paste0("Correspondence Analysis: ", ca_vars[1], " vs ", ca_vars[2]),
            subtitle = subtitle_text,
            x = x_label,
            y = y_label,
            color = "Type"
          ) +
          theme_minimal()

        if (!isTRUE(show_ca_legend)) {
          p_ca <- p_ca + theme(legend.position = "none")
        }

         custom_ggsave(output_image, plot = p_ca, plot_key = "analysis_plot", width = 10, height = 8, dpi = 300)
         result_list$plot_path <- output_image
         result_list$plot_generated <- TRUE
       }, error = function(e) {
         call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
         ca_plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
       })
      if (!is.null(ca_plot_error) && nzchar(ca_plot_error)) {
        result_list$plot_error <- ca_plot_error
      }

       tryCatch({
         library(ggplot2)
         heatmap_df <- as.data.frame(cont_table, stringsAsFactors = FALSE)
         colnames(heatmap_df) <- c("Row", "Column", "Count")
         if (isTRUE(show_ca_interval_short_names) || isTRUE(hide_ca_interval_values)) {
           row_levels_raw <- rownames(cont_table)
           col_levels_raw <- colnames(cont_table)
           row_levels_display <- format_interval_labels(
             row_levels_raw,
             prefix = "Int",
             show_alias = isTRUE(show_ca_interval_short_names),
             hide_original = isTRUE(hide_ca_interval_values)
           )
           col_levels_display <- format_interval_labels(
             col_levels_raw,
             prefix = "Int",
             show_alias = isTRUE(show_ca_interval_short_names),
             hide_original = isTRUE(hide_ca_interval_values)
           )
           row_map <- setNames(row_levels_display, row_levels_raw)
           col_map <- setNames(col_levels_display, col_levels_raw)
           heatmap_df$Row <- unname(row_map[as.character(heatmap_df$Row)])
           heatmap_df$Column <- unname(col_map[as.character(heatmap_df$Column)])
           heatmap_df$Row <- factor(heatmap_df$Row, levels = unique(row_levels_display))
           heatmap_df$Column <- factor(heatmap_df$Column, levels = unique(col_levels_display))
         }
         heatmap_path <- gsub("\\.png$", "_heatmap.png", output_image)
         heatmap_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("heatmap_plot"))
         ca_heatmap_show_values <- resolve_plot_element_flag(
           heatmap_plot_labels_cfg,
           "show_heatmap_values",
           (nrow(cont_table) * ncol(cont_table)) <= 225
         )
         ca_heatmap_show_legend <- resolve_plot_element_flag(heatmap_plot_labels_cfg, "show_legend", TRUE)
         ca_heatmap_show_row_labels <- resolve_plot_element_flag(heatmap_plot_labels_cfg, "show_heatmap_row_labels", TRUE)
         ca_heatmap_show_column_labels <- resolve_plot_element_flag(heatmap_plot_labels_cfg, "show_heatmap_column_labels", TRUE)
         ca_heatmap_show_cell_borders <- resolve_plot_element_flag(heatmap_plot_labels_cfg, "show_heatmap_cell_borders", TRUE)
         heatmap_scale_cfg <- resolve_heatmap_scale_colors(palette_cfg, centered = FALSE)
         max_count <- suppressWarnings(max(heatmap_df$Count, na.rm = TRUE))
         if (!is.finite(max_count) || max_count <= 0) max_count <- 1
         heatmap_df$label_color <- ifelse(heatmap_df$Count >= (0.62 * max_count), "#f8fafc", "#0f172a")
         p_heat <- ggplot(heatmap_df, aes(x = Column, y = Row, fill = Count)) +
           geom_tile(color = if (isTRUE(ca_heatmap_show_cell_borders)) "#ffffff" else NA) +
           scale_fill_gradient(low = heatmap_scale_cfg$low, high = heatmap_scale_cfg$high, name = "Count") +
           labs(title = "Contingency Heatmap", x = ca_vars[2], y = ca_vars[1]) +
           theme_minimal() +
           theme(
             axis.text.x = if (isTRUE(ca_heatmap_show_column_labels)) element_text(angle = 35, hjust = 1) else element_blank(),
             axis.text.y = if (isTRUE(ca_heatmap_show_row_labels)) element_text() else element_blank(),
             axis.ticks.x = if (isTRUE(ca_heatmap_show_column_labels)) element_line() else element_blank(),
             axis.ticks.y = if (isTRUE(ca_heatmap_show_row_labels)) element_line() else element_blank(),
             panel.grid = element_blank()
           )
         if (isTRUE(ca_heatmap_show_values)) {
           p_heat <- p_heat +
             geom_text(
               aes(label = Count, color = label_color),
               size = 3.0,
               show.legend = FALSE
             ) +
             scale_color_identity()
         }
         if (!isTRUE(ca_heatmap_show_legend)) {
           p_heat <- p_heat + theme(legend.position = "none")
         }
         custom_ggsave(heatmap_path, plot = p_heat, plot_key = "heatmap_plot", width = 8, height = 7, dpi = 300)
         result_list$heatmap_path <- heatmap_path
         result_list$heatmap_publication_features <- build_heatmap_publication_features(
           cont_table,
           row_labels = rownames(cont_table),
           col_labels = colnames(cont_table),
           metric_name = "Count",
           context = "ca_contingency",
           top_n = 12L,
           rank_mode = "desc",
           exclude_diagonal = FALSE
         )
       }, error = function(e) {
         result_list$heatmap_error <- e$message
       })

    } else if (base_analysis_mode == "multivariate_mca") {
      # MCA (Multiple Correspondence Analysis) on all selected categorical variables.
      if (length(predictors) < 2) {
        cat(toJSON(list(error = "MCA requires at least 2 categorical variables."), auto_unbox = TRUE))
        quit(save = "no")
      }

      mca_df <- categorical_predictor_data
      for (v in predictors) {
        mca_df[[v]] <- trimws(as.character(mca_df[[v]]))
      }
      valid_rows <- apply(mca_df, 1, function(row_vals) all(!is.na(row_vals) & row_vals != ""))
      mca_df <- mca_df[valid_rows, , drop = FALSE]
      mca_group_values <- NULL
      if (!is.null(grouping_var_name) && grouping_var_name %in% colnames(data_subset)) {
        raw_group_values <- trimws(as.character(data_subset[[grouping_var_name]]))
        raw_group_values <- raw_group_values[valid_rows]
        if (length(raw_group_values) == nrow(mca_df)) {
          raw_group_values[is.na(raw_group_values) | raw_group_values == ""] <- "Unknown"
          mca_group_values <- raw_group_values
        }
      }
      mca_observation_ids <- rownames(mca_df)
      mca_observation_ids <- as.character(mca_observation_ids)
      if (length(mca_observation_ids) != nrow(mca_df) || any(!nzchar(mca_observation_ids))) {
        mca_observation_ids <- as.character(seq_len(nrow(mca_df)))
      }
      result_list$n_samples <- as.numeric(nrow(mca_df))

      if (nrow(mca_df) < 5) {
        cat(toJSON(list(error = "MCA requires at least 5 complete rows across selected variables."), auto_unbox = TRUE))
        quit(save = "no")
      }

      mca_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("analysis_plot"))
      show_mca_biplot_mode <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_biplot_mode", TRUE)
      show_mca_biplot_arrows <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_biplot_arrows", FALSE)
      show_mca_auto_clustering <- resolve_plot_element_flag(
        mca_plot_labels_cfg,
        "show_mca_auto_clustering",
        is.null(grouping_var_name) || !nzchar(grouping_var_name)
      )
      mca_auto_cluster_method_selected <- normalize_mca_auto_cluster_method(
        mca_auto_cluster_method,
        default = "kmeans"
      )
      show_mca_individual_points <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_individual_points", TRUE)
      show_mca_category_points <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_category_points", TRUE)
      if (isTRUE(show_mca_biplot_mode)) {
        show_mca_individual_points <- TRUE
        show_mca_category_points <- TRUE
      }
      if (isTRUE(show_mca_biplot_arrows)) {
        show_mca_biplot_mode <- TRUE
        show_mca_individual_points <- TRUE
        show_mca_category_points <- TRUE
      }
      show_mca_category_labels <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_category_labels", TRUE)
      show_mca_category_ellipse <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_category_ellipse", FALSE)
      show_mca_cluster_ellipse <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_cluster_ellipse", FALSE)
      show_mca_individual_color_contrib <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_individual_color_contrib", FALSE)
      show_mca_individual_color_cos2 <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_mca_individual_color_cos2", FALSE)
      show_mca_individual_group_colors <- resolve_plot_element_flag(
        mca_plot_labels_cfg,
        "show_mca_individual_group_colors",
        !is.null(grouping_var_name) && nzchar(grouping_var_name)
      )
      show_mca_legend <- resolve_plot_element_flag(mca_plot_labels_cfg, "show_legend", TRUE)
      mca_label_nudge_x <- resolve_plot_element_numeric(mca_plot_labels_cfg, "point_label_nudge_x", 0, -2, 2)
      mca_label_nudge_y <- resolve_plot_element_numeric(mca_plot_labels_cfg, "point_label_nudge_y", 0, -2, 2)

      modality_counts <- sapply(mca_df, function(col) length(unique(col)))
      low_modality_vars <- names(modality_counts)[modality_counts < 2]
      if (length(low_modality_vars) > 0) {
        cat(toJSON(list(error = paste0("MCA requires at least 2 levels per variable. Problem variable(s): ", paste(low_modality_vars, collapse = ", "), ".")), auto_unbox = TRUE))
        quit(save = "no")
      }

      indicator_blocks <- list()
      modality_var <- character(0)
      modality_level <- character(0)
      for (v in predictors) {
        f <- as.factor(mca_df[[v]])
        mm <- model.matrix(~ f - 1)
        lvls <- levels(f)
        colnames(mm) <- paste0(v, "=", lvls)
        indicator_blocks[[v]] <- mm
        modality_var <- c(modality_var, rep(v, length(lvls)))
        modality_level <- c(modality_level, lvls)
      }

      indicator_matrix <- do.call(cbind, indicator_blocks)
      storage.mode(indicator_matrix) <- "double"

      n_obs <- nrow(indicator_matrix)
      n_modalities <- ncol(indicator_matrix)
      n_variables <- length(predictors)
      mca_cell_count <- as.numeric(n_obs) * as.numeric(n_modalities)
      # MCA SVD path materializes several dense double matrices (indicator-derived probabilities + centered/scaled forms).
      # Guard early to avoid hard OS kills (SIGKILL) on very large categorical designs.
      mca_estimated_bytes <- mca_cell_count * 8 * 5.2
      mca_guard_limit_bytes <- 1.2 * 1024^3
      if (is.finite(mca_estimated_bytes) && mca_estimated_bytes > mca_guard_limit_bytes) {
        cat(toJSON(list(
          error = paste0(
            "MCA design is too large for stable in-memory processing (rows = ", n_obs,
            ", modalities = ", n_modalities,
            ", estimated working memory ≈ ", sprintf("%.2f", mca_estimated_bytes / (1024^3)), " GB). ",
            "Reduce row count or reduce categorical cardinality (merge rare levels) before running MCA."
          )
        ), auto_unbox = TRUE))
        quit(save = "no")
      }
      grand_total <- as.numeric(n_obs * n_variables)
      p_mat <- indicator_matrix / grand_total
      row_masses <- as.numeric(rowSums(p_mat))
      col_masses <- as.numeric(colSums(p_mat))

      if (any(row_masses <= 0) || any(col_masses <= 0)) {
        cat(toJSON(list(error = "MCA failed: indicator matrix has empty margins."), auto_unbox = TRUE))
        quit(save = "no")
      }

      sqrt_row <- sqrt(pmax(row_masses, .Machine$double.eps))
      sqrt_col <- sqrt(pmax(col_masses, .Machine$double.eps))
      centered <- p_mat - row_masses %*% t(col_masses)
      s_mat <- sweep(centered, 1, sqrt_row, "/")
      s_mat <- sweep(s_mat, 2, sqrt_col, "/")
      sv <- svd(s_mat)

      singular_vals <- as.numeric(sv$d)
      eigen_vals_all <- singular_vals^2
      keep_idx <- which(is.finite(eigen_vals_all) & eigen_vals_all > .Machine$double.eps)
      if (length(keep_idx) == 0) {
        cat(toJSON(list(error = "MCA failed: no positive dimensions were found."), auto_unbox = TRUE))
        quit(save = "no")
      }

      retained_dims <- length(keep_idx)
      theoretical_max_dims <- max(1, n_modalities - n_variables)
      mca_notes <- character(0)
      if (retained_dims <= 1) {
        mca_notes <- c(
          mca_notes,
          paste0(
            "Only one informative MCA dimension was retained (variables: ",
            n_variables, ", modalities: ", n_modalities, ")."
          )
        )
      } else if (retained_dims < theoretical_max_dims) {
        mca_notes <- c(
          mca_notes,
          paste0(
            "MCA retained ", retained_dims,
            " informative dimensions (theoretical maximum: ", theoretical_max_dims, ")."
          )
        )
      }
      singular_keep <- singular_vals[keep_idx]
      eigen_vals <- eigen_vals_all[keep_idx]
      variance_pct <- round((eigen_vals / sum(eigen_vals)) * 100, 2)
      cum_variance <- cumsum(variance_pct)
      dim_names <- paste0("Dim", seq_along(eigen_vals))

      row_coords <- sv$u[, keep_idx, drop = FALSE]
      row_coords <- sweep(row_coords, 2, singular_keep, "*")
      row_coords <- sweep(row_coords, 1, sqrt_row, "/")

      col_coords <- sv$v[, keep_idx, drop = FALSE]
      col_coords <- sweep(col_coords, 2, singular_keep, "*")
      col_coords <- sweep(col_coords, 1, sqrt_col, "/")
      # Canonical sign orientation for MCA axes:
      # SVD vectors are sign-indeterminate; anchor each dimension to the
      # strongest category loading so reruns (e.g., plot toggle changes)
      # keep identical visual orientation.
      if (ncol(col_coords) > 0) {
        for (dim_i in seq_len(ncol(col_coords))) {
          axis_vals <- col_coords[, dim_i]
          if (!is.numeric(axis_vals) || length(axis_vals) == 0) next
          finite_idx <- which(is.finite(axis_vals))
          if (length(finite_idx) == 0) next
          anchor_idx_local <- finite_idx[which.max(abs(axis_vals[finite_idx]))]
          anchor_val <- axis_vals[anchor_idx_local]
          if (is.finite(anchor_val) && anchor_val < 0) {
            row_coords[, dim_i] <- -row_coords[, dim_i]
            col_coords[, dim_i] <- -col_coords[, dim_i]
          }
        }
      }

      row_coord_df <- data.frame(Observation = seq_len(n_obs), row_coords, check.names = FALSE, stringsAsFactors = FALSE)
      col_coord_df <- data.frame(
        Category = colnames(indicator_matrix),
        Variable = modality_var,
        Level = modality_level,
        col_coords,
        check.names = FALSE,
        stringsAsFactors = FALSE
      )
      colnames(row_coord_df)[2:(length(dim_names) + 1)] <- dim_names
      colnames(col_coord_df)[-(1:3)] <- dim_names

      # When no class variable is provided, derive clusters from MCA coordinates
      # using the requested method (k-means or hierarchical Ward.D2).
      mca_auto_cluster_applied <- FALSE
      result_list$mca_auto_clustering <- FALSE
      result_list$mca_auto_clustering_requested <- isTRUE(show_mca_auto_clustering) &&
        (is.null(mca_group_values) || length(mca_group_values) == 0)
      result_list$mca_auto_clustering_method_requested <- mca_auto_cluster_method_selected
      mca_auto_cluster_stage_selected <- normalize_cluster_stage(
        mca_auto_cluster_stage,
        default = "after"
      )
      mca_auto_cluster_stage_label <- if (identical(mca_auto_cluster_stage_selected, "before")) {
        "before MCA (encoded categories)"
      } else {
        "after MCA (MCA coordinates)"
      }
      result_list$mca_auto_clustering_stage_requested <- mca_auto_cluster_stage_selected
      result_list$mca_auto_cluster_optimization_method <- if (isTRUE(manual_cluster_k_enabled)) {
        "manual_k"
      } else if (identical(mca_auto_cluster_method_selected, "kmeans")) {
        mca_cluster_optimization_method
      } else {
        "silhouette"
      }
      if ((is.null(mca_group_values) || length(mca_group_values) == 0) && isTRUE(show_mca_auto_clustering)) {
        if (identical(mca_auto_cluster_stage_selected, "before")) {
          cluster_dim_count <- max(1, min(ncol(indicator_matrix), 40))
          cluster_input <- zscore_matrix_safe(indicator_matrix[, seq_len(cluster_dim_count), drop = FALSE])
        } else {
          cluster_dim_count <- max(1, min(ncol(row_coords), 5))
          cluster_input <- as.matrix(row_coords[, seq_len(cluster_dim_count), drop = FALSE])
        }
        valid_cluster_rows <- complete.cases(cluster_input)
        if (sum(valid_cluster_rows) >= 3) {
          cluster_input <- cluster_input[valid_cluster_rows, , drop = FALSE]
          cluster_observation_ids_valid <- mca_observation_ids[valid_cluster_rows]
          n_cluster_obs <- nrow(cluster_input)
          auto_method_requested <- normalize_mca_auto_cluster_method(
            mca_auto_cluster_method_selected,
            default = "kmeans"
          )
          mca_kmeans_opt_method_selected <- normalize_cluster_optimization_method(
            mca_cluster_optimization_method,
            default = "both"
          )
          # Hierarchical clustering requires an O(n^2) distance object; guard
          # large datasets to avoid hard OS kills on memory pressure.
          dist_pair_count <- as.numeric(n_cluster_obs) * (as.numeric(n_cluster_obs) - 1) / 2
          dist_estimated_bytes <- dist_pair_count * 8 * 1.15
          dist_guard_limit_bytes <- 750 * 1024^2
          max_n_safe <- floor((1 + sqrt(1 + 8 * (dist_guard_limit_bytes / (8 * 1.15)))) / 2)
          can_run_mca_auto_clustering <- is.finite(dist_estimated_bytes) &&
            dist_estimated_bytes <= dist_guard_limit_bytes
          max_k_auto <- min(10, n_cluster_obs - 1)
          manual_k_override_mca <- resolve_manual_k_override(
            enabled = manual_cluster_k_enabled,
            requested_k = manual_cluster_k_requested,
            max_allowed_k = max_k_auto
          )
          if (isTRUE(manual_k_override_mca$enabled)) {
            result_list$manual_cluster_k_enabled <- TRUE
            result_list$manual_cluster_k_requested <- as.integer(manual_k_override_mca$requested_k)
            result_list$manual_cluster_k_used <- as.integer(manual_k_override_mca$used_k)
            if (!is.null(manual_k_override_mca$warning) && nzchar(manual_k_override_mca$warning)) {
              result_list$manual_cluster_k_warning <- manual_k_override_mca$warning
            }
          }
          if (is.finite(max_k_auto) && max_k_auto >= 2) {
            if (isTRUE(can_run_mca_auto_clustering) && identical(auto_method_requested, "hierarchical")) {
              dist_auto <- tryCatch(stats::dist(cluster_input, method = "euclidean"), error = function(e) NULL)
              hc_auto <- if (!is.null(dist_auto)) tryCatch(stats::hclust(dist_auto, method = "ward.D2"), error = function(e) NULL) else NULL
              if (!is.null(hc_auto)) {
                if (isTRUE(manual_k_override_mca$enabled)) {
                  k_choice_auto <- list(
                    k = as.integer(manual_k_override_mca$used_k),
                    rule = "manual_k_override",
                    elbow_k = NA_integer_,
                    silhouette_k = NA_integer_,
                    silhouette_best = NA_real_,
                    decision_score = NA_real_
                  )
                  chosen_k_auto <- as.integer(manual_k_override_mca$used_k)
                  result_list$mca_auto_cluster_optimization_method <- "manual_k"
                } else {
                  sil_auto <- rep(NA_real_, max_k_auto)

                  for (k_try in 2:max_k_auto) {
                    part_try <- tryCatch(stats::cutree(hc_auto, k = k_try), error = function(e) NULL)
                    if (is.null(part_try) || length(part_try) != n_cluster_obs) next

                    sil_val <- tryCatch({
                      sil_obj <- cluster::silhouette(part_try, dist_auto)
                      mean(sil_obj[, 3], na.rm = TRUE)
                    }, error = function(e) NA_real_)
                    if (is.finite(sil_val)) sil_auto[k_try] <- sil_val
                  }

                  k_choice_auto <- choose_k_from_elbow_silhouette(
                    elbow_k = NA_integer_,
                    silhouette_values = sil_auto,
                    k_values = seq_len(max_k_auto),
                    method = "silhouette"
                  )
                  chosen_k_auto <- suppressWarnings(as.integer(k_choice_auto$k))
                  if (!is.finite(chosen_k_auto) || chosen_k_auto < 2) {
                    chosen_k_auto <- 2L
                  }
                }

                hc_assign <- tryCatch(stats::cutree(hc_auto, k = chosen_k_auto), error = function(e) NULL)
                final_assign <- if (!is.null(hc_assign) && length(hc_assign) == n_cluster_obs) as.integer(hc_assign) else NULL
                if (!is.null(final_assign)) {
                  assign_levels <- sort(unique(final_assign))
                  cluster_level_map <- setNames(
                    paste0("Cluster ", seq_along(assign_levels)),
                    as.character(assign_levels)
                  )
                  cluster_labels_valid <- unname(cluster_level_map[as.character(final_assign)])
                  full_cluster_labels <- rep("Unknown", n_obs)
                  full_cluster_labels[which(valid_cluster_rows)] <- cluster_labels_valid

                  mca_group_values <- full_cluster_labels
                  grouping_var_name <- "MCA Auto Clusters"
                  result_list$grouping_variable <- grouping_var_name
                  result_list$mca_grouping_source <- "auto_clustering"
                  result_list$mca_auto_clustering <- TRUE
                  result_list$mca_auto_clustering_method_requested <- auto_method_requested
                  result_list$mca_auto_clustering_stage_used <- mca_auto_cluster_stage_selected
                  result_list$mca_auto_clustering_method <- "hierarchical"
                  result_list$mca_auto_cluster_optimization_method <- if (isTRUE(manual_k_override_mca$enabled)) "manual_k" else "silhouette"
                  result_list$mca_auto_clustering_kmeans_consolidation <- FALSE
                  result_list$mca_auto_clustering_distance <- "euclidean"
                  result_list$mca_auto_clustering_hclust_method <- "ward.D2"
                  result_list$mca_auto_clustering_strategy <- "hierarchical_ward"
                  result_list$mca_auto_clustering_dims_used <- as.numeric(cluster_dim_count)
                  result_list$mca_auto_cluster_k <- as.numeric(length(unique(cluster_labels_valid)))
                  result_list$mca_auto_cluster_elbow_k <- NA_real_
                  result_list$mca_auto_cluster_silhouette_k <- if (!isTRUE(manual_k_override_mca$enabled) && is.finite(k_choice_auto$silhouette_k)) as.numeric(k_choice_auto$silhouette_k) else NA_real_
                  result_list$mca_auto_cluster_decision_rule <- as.character(k_choice_auto$rule)
                  result_list$mca_auto_cluster_decision_score <- if (is.finite(k_choice_auto$decision_score)) as.numeric(k_choice_auto$decision_score) else NA_real_
                  sil_obj_final <- tryCatch(cluster::silhouette(as.integer(final_assign), dist_auto), error = function(e) NULL)
                  sil_final <- if (!is.null(sil_obj_final)) {
                    as.numeric(mean(sil_obj_final[, 3], na.rm = TRUE))
                  } else {
                    NA_real_
                  }
                  result_list$mca_auto_cluster_avg_silhouette <- if (is.finite(sil_final)) sil_final else NA_real_
                  cluster_sizes <- table(factor(cluster_labels_valid, levels = unique(cluster_level_map)))
                  result_list$mca_auto_cluster_sizes <- as.list(as.numeric(cluster_sizes))
                  names(result_list$mca_auto_cluster_sizes) <- names(cluster_sizes)

                  mca_dendro_path <- gsub("\\.png$", "_mca_dendrogram.png", output_image)
                  tryCatch({
                    label_cfg <- resolve_base_label_config(
                      "analysis_plot",
                      default_title = "MCA Hierarchical Clustering Dendrogram",
                      default_x = "",
                      default_y = ""
                    )
                    png(mca_dendro_path, width = 900, height = 560)
                    plot(
                      hc_auto,
                      main = "",
                      xlab = "",
                      sub = "",
                      ylab = "Linkage Height (Ward.D2 on Euclidean distance)",
                      cex = 0.72,
                      hang = -1
                    )
                    rect.hclust(hc_auto, k = as.integer(chosen_k_auto), border = "#dc2626")
                    render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
                    mtext(
                      paste0(if (isTRUE(manual_k_override_mca$enabled)) "Manual k = " else "Selected k = ", as.integer(chosen_k_auto), " | Hierarchical partition"),
                      side = 1, line = 3.5, cex = 0.82, col = "#475569"
                    )
                    dev.off()
                    result_list$dendrogram_path <- mca_dendro_path
                    result_list$mca_dendrogram_path <- mca_dendro_path
                  }, error = function(e) {
                    result_list$dendrogram_error <- e$message
                    result_list$mca_dendrogram_error <- e$message
                  })
                  if (!is.null(sil_obj_final)) {
                    tryCatch({
                      sil_path <- gsub("\\.png$", "_mca_silhouette.png", output_image)
                      label_cfg <- resolve_base_label_config(
                        "silhouette_plot",
                        default_title = paste("MCA Hierarchical Silhouette Plot (k =", chosen_k_auto, ")"),
                        default_x = "",
                        default_y = ""
                      )
                      png(sil_path, width = 650, height = 430)
                      plot(sil_obj_final, main = "", col = palette_main, border = NA)
                      render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                      dev.off()
                      result_list$silhouette_plot_path <- sil_path
                      result_list$silhouette_table <- build_silhouette_table_payload(
                        sil_obj_final,
                        observation_ids = cluster_observation_ids_valid,
                        cluster_label_map = cluster_level_map,
                        scope = "full_rows"
                      )
                    }, error = function(e) {
                      result_list$silhouette_error <- e$message
                    })
                  }
                  if (isTRUE(manual_k_override_mca$enabled)) {
                    result_list$manual_cluster_validation <- run_manual_cluster_validation(
                      cluster_input = cluster_input,
                      selected_k = chosen_k_auto,
                      output_image = output_image,
                      plot_suffix = "_mca_manual_validation_silhouette_trend.png",
                      plot_title_prefix = "MCA Manual K Validation",
                      palette_main = palette_main,
                      palette_accent = palette_accent
                    )
                    if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_path)) {
                      result_list$silhouette_trend_plot_path <- result_list$manual_cluster_validation$silhouette_trend_plot_path
                    }
                    if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_error) && nzchar(result_list$manual_cluster_validation$silhouette_trend_plot_error)) {
                      result_list$silhouette_trend_plot_error <- result_list$manual_cluster_validation$silhouette_trend_plot_error
                    }
                  }

                  mca_notes <- c(
                    mca_notes,
                    paste0(
                      "Auto clustering (", mca_auto_cluster_stage_label, ") ",
                      if (isTRUE(manual_k_override_mca$enabled)) "used manual k = " else "selected k = ",
                      as.integer(chosen_k_auto),
                      "."
                    )
                  )
                  mca_auto_cluster_applied <- TRUE
                }
              } else {
                mca_notes <- c(
                  mca_notes,
                  "Hierarchical MCA auto-clustering failed while building the dendrogram."
                )
              }
            } else {
              # K-means path (directly on all rows for moderate n; sampled-k optimization for large n).
              use_large_n_mode <- !isTRUE(can_run_mca_auto_clustering)
              sample_idx <- if (isTRUE(use_large_n_mode)) {
                sample_n_k <- min(3000L, as.integer(n_cluster_obs))
                if (sample_n_k < n_cluster_obs) {
                  sort(sample(seq_len(n_cluster_obs), sample_n_k))
                } else {
                  seq_len(n_cluster_obs)
                }
              } else {
                seq_len(n_cluster_obs)
              }
              cluster_eval <- cluster_input[sample_idx, , drop = FALSE]
              max_k_eval <- min(max_k_auto, nrow(cluster_eval) - 1L)

              if (is.finite(max_k_eval) && max_k_eval >= 2) {
                dist_eval <- tryCatch(stats::dist(cluster_eval, method = "euclidean"), error = function(e) NULL)
                if (isTRUE(manual_k_override_mca$enabled)) {
                  wss_eval <- NULL
                  sil_eval <- NULL
                  elbow_k_auto <- NA_integer_
                  k_choice_auto <- list(
                    k = as.integer(manual_k_override_mca$used_k),
                    rule = "manual_k_override",
                    elbow_k = NA_integer_,
                    silhouette_k = NA_integer_,
                    silhouette_best = NA_real_,
                    decision_score = NA_real_
                  )
                  chosen_k_auto <- as.integer(manual_k_override_mca$used_k)
                  result_list$mca_auto_cluster_optimization_method <- "manual_k"
                } else {
                  wss_eval <- rep(NA_real_, max_k_eval)
                  sil_eval <- rep(NA_real_, max_k_eval)

                  eval_center <- colMeans(cluster_eval, na.rm = TRUE)
                  centered_eval <- sweep(cluster_eval, 2, eval_center, "-")
                  wss_eval[1] <- sum(rowSums(centered_eval^2), na.rm = TRUE)

                  for (k_try in 2:max_k_eval) {
                    km_try <- tryCatch(stats::kmeans(cluster_eval, centers = k_try, nstart = 10), error = function(e) NULL)
                    if (is.null(km_try) || length(km_try$cluster) != nrow(cluster_eval)) next
                    wss_eval[k_try] <- sum(km_try$withinss, na.rm = TRUE)
                    if (!is.null(dist_eval)) {
                      sil_val <- tryCatch({
                        sil_obj <- cluster::silhouette(as.integer(km_try$cluster), dist_eval)
                        mean(sil_obj[, 3], na.rm = TRUE)
                      }, error = function(e) NA_real_)
                      if (is.finite(sil_val)) sil_eval[k_try] <- sil_val
                    }
                  }

                  if (!is.finite(wss_eval[1])) {
                    wss_eval[1] <- sum(rowSums(centered_eval^2), na.rm = TRUE)
                  }
                  if (max_k_eval >= 2) {
                    for (k_fill in 2:max_k_eval) {
                      if (!is.finite(wss_eval[k_fill])) {
                        wss_eval[k_fill] <- wss_eval[k_fill - 1]
                      }
                    }
                  }

                  elbow_k_auto <- compute_elbow_k(seq_len(max_k_eval), wss_eval)
                  k_choice_auto <- choose_k_from_elbow_silhouette(
                    elbow_k = elbow_k_auto,
                    silhouette_values = sil_eval,
                    k_values = seq_len(max_k_eval),
                    method = mca_kmeans_opt_method_selected
                  )
                  chosen_k_auto <- suppressWarnings(as.integer(k_choice_auto$k))
                  if (!is.finite(chosen_k_auto) || chosen_k_auto < 2) {
                    chosen_k_auto <- 2L
                  }
                  chosen_k_auto <- as.integer(min(chosen_k_auto, max_k_eval))
                }

                km_auto <- tryCatch(stats::kmeans(cluster_input, centers = chosen_k_auto, nstart = 25), error = function(e) NULL)
                final_assign <- if (!is.null(km_auto) && length(km_auto$cluster) == n_cluster_obs) as.integer(km_auto$cluster) else NULL
                if (!is.null(final_assign)) {
                  assign_levels <- sort(unique(final_assign))
                  cluster_level_map <- setNames(
                    paste0("Cluster ", seq_along(assign_levels)),
                    as.character(assign_levels)
                  )
                  cluster_labels_valid <- unname(cluster_level_map[as.character(final_assign)])
                  full_cluster_labels <- rep("Unknown", n_obs)
                  full_cluster_labels[which(valid_cluster_rows)] <- cluster_labels_valid

                  mca_group_values <- full_cluster_labels
                  grouping_var_name <- "MCA Auto Clusters"
                  result_list$grouping_variable <- grouping_var_name
                  result_list$mca_grouping_source <- "auto_clustering"
                  result_list$mca_auto_clustering <- TRUE
                  result_list$mca_auto_clustering_method_requested <- auto_method_requested
                  result_list$mca_auto_clustering_stage_used <- mca_auto_cluster_stage_selected
                  result_list$mca_auto_clustering_method <- "kmeans"
                  result_list$mca_auto_cluster_optimization_method <- if (isTRUE(manual_k_override_mca$enabled)) "manual_k" else mca_kmeans_opt_method_selected
                  result_list$mca_auto_clustering_kmeans_consolidation <- FALSE
                  result_list$mca_auto_clustering_distance <- "euclidean"
                  result_list$mca_auto_clustering_hclust_method <- if (isTRUE(use_large_n_mode)) "not_run_large_n" else "not_run"
                  result_list$mca_auto_clustering_strategy <- if (isTRUE(use_large_n_mode)) "kmeans_large_n" else "kmeans"
                  result_list$mca_auto_clustering_dims_used <- as.numeric(cluster_dim_count)
                  result_list$mca_auto_cluster_k <- as.numeric(length(unique(cluster_labels_valid)))
                  result_list$mca_auto_cluster_elbow_k <- if (!isTRUE(manual_k_override_mca$enabled) && is.finite(elbow_k_auto)) as.numeric(elbow_k_auto) else NA_real_
                  result_list$mca_auto_cluster_silhouette_k <- if (!isTRUE(manual_k_override_mca$enabled) && is.finite(k_choice_auto$silhouette_k)) as.numeric(k_choice_auto$silhouette_k) else NA_real_
                  result_list$mca_auto_cluster_decision_rule <- as.character(k_choice_auto$rule)
                  result_list$mca_auto_cluster_decision_score <- if (is.finite(k_choice_auto$decision_score)) as.numeric(k_choice_auto$decision_score) else NA_real_
                  if (!isTRUE(manual_k_override_mca$enabled)) {
                    result_list$mca_auto_cluster_optimization <- list(
                      k_values = as.numeric(seq_len(max_k_eval)),
                      wss = as.numeric(wss_eval),
                      silhouette = as.numeric(sil_eval)
                    )
                  }
                  show_mca_elbow_plot <- !isTRUE(manual_k_override_mca$enabled) && mca_kmeans_opt_method_selected %in% c("both", "elbow")
                  show_mca_silhouette_trend_plot <- !isTRUE(manual_k_override_mca$enabled) && mca_kmeans_opt_method_selected %in% c("both", "silhouette")
                  if (isTRUE(show_mca_elbow_plot)) {
                    elbow_path <- gsub("\\.png$", "_mca_auto_elbow.png", output_image)
                    tryCatch({
                      label_cfg <- resolve_base_label_config(
                        "elbow_plot",
                        default_title = "MCA Auto-Clustering Elbow Method",
                        default_x = "Number of Clusters K",
                        default_y = "Total WSS"
                      )
                      png(elbow_path, width = 700, height = 450)
                      plot(
                        seq_len(max_k_eval),
                        wss_eval,
                        type = "b",
                        pch = 19,
                        frame = FALSE,
                        xlab = "",
                        ylab = "",
                        main = "",
                        col = palette_main
                      )
                      render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                      dev.off()
                      result_list$elbow_plot_path <- elbow_path
                    }, error = function(e) {
                      result_list$elbow_plot_error <- e$message
                    })
                  }
                  if (isTRUE(show_mca_silhouette_trend_plot)) {
                    silhouette_trend_path <- gsub("\\.png$", "_mca_auto_silhouette_trend.png", output_image)
                    tryCatch({
                      valid_sil_idx <- which(is.finite(sil_eval) & seq_along(sil_eval) >= 2)
                      best_k_eval <- if (length(valid_sil_idx) > 0) valid_sil_idx[which.max(sil_eval[valid_sil_idx])] else NA_integer_
                      best_sil_eval <- if (is.finite(best_k_eval)) sil_eval[best_k_eval] else NA_real_
                      label_cfg <- resolve_base_label_config(
                        "silhouette_trend_plot",
                        default_title = "MCA Auto-Clustering Silhouette Method",
                        default_x = "Number of Clusters K",
                        default_y = "Avg Silhouette Width"
                      )
                      png(silhouette_trend_path, width = 700, height = 450)
                      if (max_k_eval >= 2) {
                        plot(
                          2:max_k_eval,
                          sil_eval[2:max_k_eval],
                          type = "b",
                          pch = 19,
                          frame = FALSE,
                          xlab = "",
                          ylab = "",
                          main = "",
                          col = palette_accent
                        )
                        if (is.finite(best_k_eval) && is.finite(best_sil_eval)) {
                          points(best_k_eval, best_sil_eval, col = palette_main, pch = 19, cex = 1.4)
                        }
                      } else {
                        plot.new()
                        text(0.5, 0.5, "Silhouette trend unavailable (need at least k=2).")
                      }
                      render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                      dev.off()
                      result_list$silhouette_trend_plot_path <- silhouette_trend_path
                    }, error = function(e) {
                      result_list$silhouette_trend_plot_error <- e$message
                    })
                  }

                  sil_obj_final <- if (!is.null(dist_eval)) {
                    tryCatch({
                      eval_assign <- as.integer(final_assign[sample_idx])
                      cluster::silhouette(eval_assign, dist_eval)
                    }, error = function(e) NULL)
                  } else {
                    NULL
                  }
                  sil_final <- if (!is.null(sil_obj_final)) {
                    as.numeric(mean(sil_obj_final[, 3], na.rm = TRUE))
                  } else {
                    NA_real_
                  }
                  result_list$mca_auto_cluster_avg_silhouette <- if (is.finite(sil_final)) sil_final else NA_real_
                  cluster_sizes <- table(factor(cluster_labels_valid, levels = unique(cluster_level_map)))
                  result_list$mca_auto_cluster_sizes <- as.list(as.numeric(cluster_sizes))
                  names(result_list$mca_auto_cluster_sizes) <- names(cluster_sizes)
                  if (!is.null(sil_obj_final)) {
                    tryCatch({
                      sil_path <- gsub("\\.png$", "_mca_auto_silhouette.png", output_image)
                      label_cfg <- resolve_base_label_config(
                        "silhouette_plot",
                        default_title = paste("MCA Auto-Clustering Silhouette Plot (k =", chosen_k_auto, ")"),
                        default_x = "",
                        default_y = ""
                      )
                      png(sil_path, width = 650, height = 430)
                      plot(sil_obj_final, main = "", col = palette_main, border = NA)
                      render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                      dev.off()
                      result_list$silhouette_plot_path <- sil_path
                      result_list$silhouette_table <- build_silhouette_table_payload(
                        sil_obj_final,
                        observation_ids = cluster_observation_ids_valid[sample_idx],
                        cluster_label_map = cluster_level_map,
                        scope = if (isTRUE(use_large_n_mode)) "sampled_rows" else "full_rows"
                      )
                    }, error = function(e) {
                      result_list$silhouette_error <- e$message
                    })
                  }
                  if (isTRUE(manual_k_override_mca$enabled)) {
                    result_list$manual_cluster_validation <- run_manual_cluster_validation(
                      cluster_input = cluster_input,
                      selected_k = chosen_k_auto,
                      output_image = output_image,
                      plot_suffix = "_mca_manual_validation_silhouette_trend.png",
                      plot_title_prefix = "MCA Manual K Validation",
                      palette_main = palette_main,
                      palette_accent = palette_accent
                    )
                    if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_path)) {
                      result_list$silhouette_trend_plot_path <- result_list$manual_cluster_validation$silhouette_trend_plot_path
                    }
                    if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_error) && nzchar(result_list$manual_cluster_validation$silhouette_trend_plot_error)) {
                      result_list$silhouette_trend_plot_error <- result_list$manual_cluster_validation$silhouette_trend_plot_error
                    }
                  }

                  if (isTRUE(use_large_n_mode)) {
                    fallback_prefix <- if (identical(auto_method_requested, "hierarchical")) {
                      "Requested hierarchical MCA clustering switched to scalable k-means."
                    } else {
                      "Auto clustering from MCA coordinates selected scalable k-means."
                    }
                    mca_notes <- c(
                      mca_notes,
                      paste0(
                        fallback_prefix,
                        " Selected k = ", as.integer(chosen_k_auto),
                        " (n = ", n_cluster_obs,
                        ", sampled n = ", nrow(cluster_eval),
                        "). Hierarchical distance estimate ≈ ", sprintf("%.2f", dist_estimated_bytes / (1024^3)),
                        " GB (safe limit ≈ ", sprintf("%.2f", dist_guard_limit_bytes / (1024^3)), " GB; ~", max(50, max_n_safe), " rows)."
                      )
                    )
                  } else {
                    mca_notes <- c(
                      mca_notes,
                      paste0(
                        "Auto clustering (", mca_auto_cluster_stage_label, ") ",
                        if (isTRUE(manual_k_override_mca$enabled)) "used manual k = " else "selected k = ",
                        as.integer(chosen_k_auto),
                        "."
                      )
                    )
                  }
                  mca_auto_cluster_applied <- TRUE
                } else {
                  mca_notes <- c(
                    mca_notes,
                    paste0(
                      "MCA auto-clustering failed for k-means fitting (n = ", n_cluster_obs,
                      "). Try reducing rows or set an external grouping variable."
                    )
                  )
                }
              } else {
                mca_notes <- c(
                  mca_notes,
                  paste0(
                    "MCA auto-clustering could not evaluate cluster counts (evaluation n = ",
                    nrow(cluster_eval), ")."
                  )
                )
              }
            }
          }
        }
      }
      if (!isTRUE(mca_auto_cluster_applied) && (is.null(grouping_var_name) || !nzchar(grouping_var_name))) {
        result_list$mca_grouping_source <- "none"
      } else if (!isTRUE(mca_auto_cluster_applied) && !is.null(grouping_var_name) && nzchar(grouping_var_name)) {
        result_list$mca_grouping_source <- "user_group"
      }
      if (!is.null(mca_group_values) && length(mca_group_values) == n_obs) {
        row_coord_df$Group <- as.character(mca_group_values)
      }

      result_list$eigenvalues <- data.frame(
        PC = dim_names,
        Eigenvalue = round(eigen_vals, 4),
        Variance_Percent = variance_pct,
        Cumulative_Percent = cum_variance
      )
      result_list$mca_summary <- list(
        variables = predictors,
        n_variables = as.numeric(n_variables),
        total_modalities = as.numeric(n_modalities),
        total_n = as.numeric(n_obs),
        theoretical_max_dimensions = as.numeric(theoretical_max_dims),
        retained_dimensions = as.numeric(retained_dims)
      )
      result_list$mca_category_coordinates <- col_coord_df
      result_list$mca_individual_coordinates <- utils::head(row_coord_df, 300)
      result_list$mca_individual_count_total <- as.numeric(n_obs)
      if (length(mca_notes) > 0) {
        result_list$mca_notes <- unique(mca_notes)
        result_list$mca_note <- result_list$mca_notes[[1]]
      }

      dim1_idx <- 1
      has_second_dim <- ncol(row_coords) >= 2 && ncol(col_coords) >= 2
      row_dim2_vals <- if (has_second_dim) row_coords[, 2] else rep(0, nrow(row_coords))
      col_dim2_vals <- if (has_second_dim) col_coords[, 2] else rep(0, nrow(col_coords))
      row_plot_df <- data.frame(
        Dim1 = as.numeric(row_coords[, dim1_idx]),
        Dim2 = as.numeric(row_dim2_vals),
        stringsAsFactors = FALSE
      )
      row_sq_distance <- rowSums(row_coords^2, na.rm = TRUE)
      row_plane_sq <- as.numeric(row_coords[, dim1_idx])^2 + as.numeric(row_dim2_vals)^2
      row_cos2_plane <- ifelse(
        is.finite(row_sq_distance) & row_sq_distance > .Machine$double.eps,
        row_plane_sq / row_sq_distance,
        NA_real_
      )
      row_mass_vals <- if (!is.null(row_masses) && length(row_masses) == n_obs) {
        as.numeric(row_masses)
      } else {
        rep(1 / max(1, n_obs), n_obs)
      }
      contrib_dim1 <- if (length(eigen_vals) >= 1 && is.finite(eigen_vals[1]) && eigen_vals[1] > .Machine$double.eps) {
        row_mass_vals * (as.numeric(row_coords[, 1])^2) / as.numeric(eigen_vals[1])
      } else {
        rep(0, n_obs)
      }
      contrib_dim2 <- if (isTRUE(has_second_dim) && length(eigen_vals) >= 2 && is.finite(eigen_vals[2]) && eigen_vals[2] > .Machine$double.eps) {
        row_mass_vals * (as.numeric(row_coords[, 2])^2) / as.numeric(eigen_vals[2])
      } else {
        rep(0, n_obs)
      }
      row_contrib_plane_pct <- 100 * (contrib_dim1 + contrib_dim2)
      row_plot_df$Cos2 <- as.numeric(row_cos2_plane)
      row_plot_df$Contribution <- as.numeric(row_contrib_plane_pct)
      row_coord_df$Cos2_Dim12 <- as.numeric(row_cos2_plane)
      row_coord_df$Contribution_Dim12 <- as.numeric(row_contrib_plane_pct)
      if (!is.null(mca_group_values) && length(mca_group_values) == nrow(row_plot_df)) {
        row_plot_df$Group <- as.character(mca_group_values)
      }
      result_list$mca_individual_coordinates <- utils::head(row_coord_df, 300)
      col_plot_df <- data.frame(
        label = colnames(indicator_matrix),
        Variable = modality_var,
        Level = modality_level,
        Dim1 = as.numeric(col_coords[, dim1_idx]),
        Dim2 = as.numeric(col_dim2_vals),
        stringsAsFactors = FALSE
      )

      # MCA scree plot
      scree_path <- gsub("\\.png$", "_scree.png", output_image)
      tryCatch({
         label_cfg <- resolve_base_label_config(
           "scree_plot",
           default_title = "MCA Eigenvalues (Inertia Explained)",
           default_x = "MCA Dimension",
           default_y = "Percentage of Inertia"
         )
         png(scree_path, width = 800, height = 600)
         barplot(variance_pct[1:min(10, length(variance_pct))],
                 main = "",
                 xlab = "", ylab = "",
                 col = "steelblue", border = "white", ylim = c(0, max(variance_pct) * 1.1))
         lines(x = 1:min(10, length(variance_pct)), y = variance_pct[1:min(10, length(variance_pct))], type = "b", pch = 19, col = "red")
         render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
         dev.off()
         result_list$scree_plot_path <- scree_path
      }, error = function(e) {
         result_list$scree_plot_error <- e$message
      })

      # MCA projection plot
      mca_plot_error <- NULL
      tryCatch({
        library(ggplot2)
        x_label <- paste0("Dim1 (", variance_pct[1], "%)")
        y_label <- if (length(variance_pct) >= 2) paste0("Dim2 (", variance_pct[2], "%)") else "Dim2 (0%)"
        subtitle_parts <- c(
          paste0("Variables: ", n_variables),
          paste0("Modalities: ", n_modalities),
          paste0("Rows: ", n_obs)
        )
        if (length(mca_notes) > 0) subtitle_parts <- c(subtitle_parts, mca_notes[[1]])
        var_levels <- unique(col_plot_df$Variable)
        vivid_var_cols <- grDevices::hcl.colors(max(1, length(var_levels)), palette = "Dark 3")
        var_cols <- setNames(vivid_var_cols[seq_along(var_levels)], var_levels)
        can_draw_mca_category_ellipse <- FALSE
        ellipse_candidates <- character(0)
        mca_ellipse_df <- col_plot_df[0, , drop = FALSE]
        if (isTRUE(show_mca_category_ellipse) && isTRUE(show_mca_category_points)) {
          variable_counts <- table(col_plot_df$Variable)
          ellipse_candidates <- names(variable_counts)[as.numeric(variable_counts) >= 4]
          if (length(ellipse_candidates) > 0) {
            ellipse_candidates <- ellipse_candidates[vapply(ellipse_candidates, function(var_name) {
              var_df <- col_plot_df[col_plot_df$Variable == var_name, c("Dim1", "Dim2"), drop = FALSE]
              if (nrow(var_df) < 4) return(FALSE)
              is.finite(qr(as.matrix(var_df))$rank) && qr(as.matrix(var_df))$rank >= 2
            }, logical(1))]
          }
          if (length(ellipse_candidates) > 0) {
            can_draw_mca_category_ellipse <- TRUE
            mca_ellipse_df <- col_plot_df[col_plot_df$Variable %in% ellipse_candidates, , drop = FALSE]
          }
        }
        if (isTRUE(can_draw_mca_category_ellipse)) {
          subtitle_parts <- c(subtitle_parts, "95% category confidence ellipses enabled")
        }
        group_levels <- character(0)
        if ("Group" %in% names(row_plot_df)) {
          group_levels <- unique(trimws(as.character(row_plot_df$Group)))
          group_levels <- group_levels[nzchar(group_levels)]
        }
        has_mca_grouping_context <- isTRUE(show_mca_individual_points) &&
          "Group" %in% names(row_plot_df) &&
          !is.null(grouping_var_name) &&
          nzchar(grouping_var_name)
        requested_mca_group_colors <- isTRUE(show_mca_individual_group_colors)
        requested_mca_info_colors <- isTRUE(show_mca_individual_color_cos2) || isTRUE(show_mca_individual_color_contrib)
        use_mca_individual_group_colors <- isTRUE(has_mca_grouping_context) &&
          (isTRUE(requested_mca_group_colors) || !isTRUE(requested_mca_info_colors))
        if (isTRUE(use_mca_individual_group_colors) && length(group_levels) <= 1) {
          use_mca_individual_group_colors <- FALSE
          if (length(group_levels) == 1) {
            subtitle_parts <- c(
              subtitle_parts,
              paste0("Grouping variable ", grouping_var_name, " has one level after filtering")
            )
          }
        }
        use_mca_individual_cos2_colors <- isTRUE(show_mca_individual_color_cos2) &&
          isTRUE(show_mca_individual_points) &&
          !isTRUE(use_mca_individual_group_colors) &&
          "Cos2" %in% names(row_plot_df)
        use_mca_individual_contrib_colors <- isTRUE(show_mca_individual_color_contrib) &&
          isTRUE(show_mca_individual_points) &&
          !isTRUE(show_mca_individual_color_cos2) &&
          !isTRUE(use_mca_individual_group_colors) &&
          "Contribution" %in% names(row_plot_df)
        use_mca_individual_info_colors <- isTRUE(use_mca_individual_cos2_colors) || isTRUE(use_mca_individual_contrib_colors)
        mca_group_cols <- NULL
        if (isTRUE(use_mca_individual_group_colors)) {
          if (length(group_levels) > 0) {
            mca_group_cols <- get_level_color_map(
              grouping_var_name,
              group_levels,
              fallback_cols = grDevices::hcl.colors(max(1, length(group_levels)), palette = "Dark 3")
            )
            subtitle_parts <- c(subtitle_parts, paste0("Individuals colored by ", grouping_var_name))
          } else {
            use_mca_individual_group_colors <- FALSE
          }
        }
        if (isTRUE(use_mca_individual_cos2_colors)) {
          subtitle_parts <- c(subtitle_parts, "Individuals colored by cos2 (Dim1+Dim2)")
        } else if (isTRUE(use_mca_individual_contrib_colors)) {
          subtitle_parts <- c(subtitle_parts, "Individuals colored by contribution (Dim1+Dim2)")
        }
        can_draw_mca_cluster_ellipse <- FALSE
        mca_cluster_ellipse_df <- row_plot_df[0, , drop = FALSE]
        if (isTRUE(show_mca_cluster_ellipse) &&
            isTRUE(show_mca_individual_points) &&
            isTRUE(use_mca_individual_group_colors) &&
            "Group" %in% names(row_plot_df)) {
          cluster_counts <- table(row_plot_df$Group)
          cluster_candidates <- names(cluster_counts)[as.numeric(cluster_counts) >= 4]
          if (length(cluster_candidates) > 0) {
            cluster_candidates <- cluster_candidates[vapply(cluster_candidates, function(group_name) {
              cluster_df <- row_plot_df[row_plot_df$Group == group_name, c("Dim1", "Dim2"), drop = FALSE]
              if (nrow(cluster_df) < 4) return(FALSE)
              is.finite(qr(as.matrix(cluster_df))$rank) && qr(as.matrix(cluster_df))$rank >= 2
            }, logical(1))]
          }
          if (length(cluster_candidates) > 0) {
            can_draw_mca_cluster_ellipse <- TRUE
            mca_cluster_ellipse_df <- row_plot_df[row_plot_df$Group %in% cluster_candidates, , drop = FALSE]
            subtitle_parts <- c(subtitle_parts, "95% cluster confidence ellipses enabled")
          }
        }

        p_mca <- ggplot() +
          geom_hline(yintercept = 0, linetype = "dashed", color = "#94a3b8", linewidth = 0.4) +
          geom_vline(xintercept = 0, linetype = "dashed", color = "#94a3b8", linewidth = 0.4)

        if (isTRUE(show_mca_biplot_arrows) && isTRUE(show_mca_category_points)) {
          subtitle_parts <- c(subtitle_parts, "Biplot arrows enabled")
          p_mca <- p_mca +
            geom_segment(
              data = col_plot_df,
              aes(x = 0, y = 0, xend = Dim1, yend = Dim2, color = Variable),
              linewidth = 0.42,
              alpha = 0.48,
              arrow = arrow(length = grid::unit(0.12, "cm")),
              show.legend = FALSE
            )
        }
        if (isTRUE(can_draw_mca_cluster_ellipse)) {
          p_mca <- p_mca +
            stat_ellipse(
              data = mca_cluster_ellipse_df,
              aes(x = Dim1, y = Dim2, fill = Group),
              geom = "polygon",
              alpha = 0.08,
              linewidth = 0,
              type = "norm",
              level = 0.95,
              inherit.aes = FALSE,
              show.legend = FALSE
            ) +
            stat_ellipse(
              data = mca_cluster_ellipse_df,
              aes(x = Dim1, y = Dim2, group = Group),
              geom = "path",
              color = "#334155",
              linewidth = 0.45,
              linetype = "dashed",
              type = "norm",
              level = 0.95,
              inherit.aes = FALSE,
              show.legend = FALSE
            )
        }

        if (isTRUE(show_mca_individual_points)) {
          if (isTRUE(use_mca_individual_group_colors) && !is.null(mca_group_cols) && length(mca_group_cols) > 0) {
            p_mca <- p_mca +
              geom_point(
                data = row_plot_df,
                aes(x = Dim1, y = Dim2, fill = Group),
                shape = 21,
                color = "#334155",
                stroke = 0.18,
                size = 2.2,
                alpha = 0.95
              )
          } else if (isTRUE(use_mca_individual_cos2_colors)) {
            p_mca <- p_mca +
              geom_point(
                data = row_plot_df,
                aes(x = Dim1, y = Dim2, fill = Cos2),
                shape = 21,
                color = "#334155",
                stroke = 0.18,
                size = 2.2,
                alpha = 0.95
              )
          } else if (isTRUE(use_mca_individual_contrib_colors)) {
            p_mca <- p_mca +
              geom_point(
                data = row_plot_df,
                aes(x = Dim1, y = Dim2, fill = Contribution),
                shape = 21,
                color = "#334155",
                stroke = 0.18,
                size = 2.2,
                alpha = 0.95
              )
          } else {
            p_mca <- p_mca +
              geom_point(
                data = row_plot_df,
                aes(x = Dim1, y = Dim2),
                color = "#94a3b8",
                size = 1.3,
                alpha = 0.35
              )
          }
        }
        if (isTRUE(can_draw_mca_category_ellipse)) {
          if (isTRUE(use_mca_individual_info_colors) || isTRUE(use_mca_individual_group_colors)) {
            p_mca <- p_mca +
              stat_ellipse(
                data = mca_ellipse_df,
                aes(x = Dim1, y = Dim2, color = Variable),
                geom = "path",
                linewidth = 0.5,
                linetype = "dashed",
                type = "norm",
                level = 0.95,
                inherit.aes = FALSE,
                show.legend = FALSE
              )
          } else {
            p_mca <- p_mca +
              stat_ellipse(
                data = mca_ellipse_df,
                aes(x = Dim1, y = Dim2, color = Variable, fill = Variable),
                geom = "polygon",
                alpha = 0.10,
                linewidth = 0.4,
                type = "norm",
                level = 0.95,
                inherit.aes = FALSE,
                show.legend = FALSE
              )
          }
        }
        if (isTRUE(show_mca_category_points)) {
          p_mca <- p_mca +
            geom_point(
              data = col_plot_df,
              aes(x = Dim1, y = Dim2, color = Variable),
              shape = 17,
              size = 3.2,
              alpha = 0.9
            )
        }
        if (isTRUE(show_mca_category_labels) && isTRUE(show_mca_category_points)) {
          p_mca <- p_mca +
            geom_text(
              data = col_plot_df,
              aes(x = Dim1 + mca_label_nudge_x, y = Dim2 + mca_label_nudge_y, label = label, color = Variable),
              vjust = -0.75,
              size = 3.0,
              fontface = "bold",
              show.legend = FALSE
            )
        }

        if (isTRUE(show_mca_category_points)) {
          p_mca <- p_mca + scale_color_manual(values = var_cols, drop = FALSE)
          if (isTRUE(can_draw_mca_category_ellipse) && !isTRUE(use_mca_individual_info_colors) && !isTRUE(use_mca_individual_group_colors)) {
            p_mca <- p_mca + scale_fill_manual(values = var_cols, drop = FALSE)
          }
        }
        if (isTRUE(use_mca_individual_group_colors) && !is.null(mca_group_cols) && length(mca_group_cols) > 0) {
          p_mca <- p_mca + scale_fill_manual(
            values = mca_group_cols,
            drop = FALSE,
            name = if (!is.null(grouping_var_name) && nzchar(grouping_var_name)) grouping_var_name else "Group"
          )
        } else if (isTRUE(use_mca_individual_cos2_colors)) {
          p_mca <- p_mca + scale_fill_gradientn(
            colours = c("#e2e8f0", "#38bdf8", "#0f172a"),
            na.value = "#94a3b8",
            name = "Individual cos2"
          )
        } else if (isTRUE(use_mca_individual_contrib_colors)) {
          p_mca <- p_mca + scale_fill_gradientn(
            colours = c("#e2e8f0", "#f59e0b", "#7f1d1d"),
            na.value = "#94a3b8",
            name = "Individual contribution (%)"
          )
        }

        # Keep axis scaling stable when optional layers (e.g., ellipses) are toggled.
        mca_axis_limits <- function(values, pad_ratio = 0.08, pad_min = 0.15) {
          finite_vals <- values[is.finite(values)]
          if (length(finite_vals) == 0) return(c(-1, 1))
          vmin <- min(finite_vals)
          vmax <- max(finite_vals)
          span <- vmax - vmin
          if (!is.finite(span) || span <= .Machine$double.eps) {
            center <- if (is.finite(vmin)) vmin else 0
            return(c(center - 1, center + 1))
          }
          pad <- max(pad_min, span * pad_ratio)
          c(vmin - pad, vmax + pad)
        }
        mca_xlim <- mca_axis_limits(c(row_plot_df$Dim1, col_plot_df$Dim1))
        mca_ylim <- mca_axis_limits(c(row_plot_df$Dim2, col_plot_df$Dim2))
        p_mca <- p_mca + coord_cartesian(xlim = mca_xlim, ylim = mca_ylim)

        p_mca <- p_mca +
          labs(
            title = "Multiple Correspondence Analysis (MCA)",
            subtitle = paste(subtitle_parts, collapse = " | "),
            x = x_label,
            y = y_label,
            color = "Variable"
          ) +
          theme_minimal()

        if (!isTRUE(show_mca_legend)) {
          p_mca <- p_mca + theme(legend.position = "none")
        }

        custom_ggsave(output_image, plot = p_mca, plot_key = "analysis_plot", width = 10, height = 8, dpi = 300)
        result_list$plot_path <- output_image
        result_list$plot_generated <- TRUE
      }, error = function(e) {
        call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
        mca_plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
      })
      if (!is.null(mca_plot_error) && nzchar(mca_plot_error)) {
        result_list$plot_error <- mca_plot_error
      }

    } else if (is_pca_mode) {
       # PCA
       # grouping_col is already prepared above if response_var was valid
       include_scree <- identical(base_analysis_mode, "multivariate_pca")
       is_pca_biplot_mode <- identical(base_analysis_mode, "multivariate_pca_biplot")
       pca_plot_title <- if (is_pca_biplot_mode) "PCA Biplot (Individuals + Variables)" else "PCA Individuals Map"
       auto_cluster_pre_pca <- FALSE
       auto_cluster_post_pca <- FALSE
       pca_res_for_auto <- NULL
       result_list$auto_cluster_before_pca <- FALSE
       result_list$auto_cluster_after_pca <- FALSE
       if (is_pca_biplot_mode) {
         result_list$auto_cluster_before_pca_biplot <- FALSE
         result_list$auto_cluster_after_pca_biplot <- FALSE
       }
       result_list$auto_cluster_requested <- isTRUE(pca_auto_clustering_enabled)

       pca_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("analysis_plot"))
       show_biplot_vectors <- resolve_plot_element_flag(
         pca_plot_labels_cfg,
         "show_biplot_vectors",
         is_pca_biplot_mode
       )
       show_group_ellipse <- resolve_plot_element_flag(pca_plot_labels_cfg, "show_group_ellipse", TRUE)
       show_ellipse_significance <- resolve_plot_element_flag(pca_plot_labels_cfg, "show_ellipse_significance", FALSE)
       pca_label_nudge_x <- resolve_plot_element_numeric(pca_plot_labels_cfg, "point_label_nudge_x", 0, -2, 2)
       pca_label_nudge_y <- resolve_plot_element_numeric(pca_plot_labels_cfg, "point_label_nudge_y", 0, -2, 2)
       ellipse_conf_level <- 0.95
       ellipse_conf_raw <- suppressWarnings(as.numeric(pca_plot_labels_cfg$ellipse_conf_level))
       if (length(ellipse_conf_raw) > 0) {
         ellipse_conf_val <- ellipse_conf_raw[1]
         if (isTRUE(is.finite(ellipse_conf_val)) && ellipse_conf_val > 0.5 && ellipse_conf_val < 0.999) {
           ellipse_conf_level <- ellipse_conf_val
         }
       }

       # For PCA/PCA Biplot: if no grouping variable is provided, run clustering first
       # and use cluster labels as groups.
       if (is.null(grouping_col) && isTRUE(pca_auto_clustering_enabled)) {
        auto_cluster_method_selected <- normalize_pca_auto_cluster_method(
          pca_auto_cluster_method,
          default = "kmeans"
        )
        auto_cluster_stage_selected <- normalize_cluster_stage(
          pca_auto_cluster_stage,
          default = "before"
        )
        result_list$auto_cluster_method_requested <- auto_cluster_method_selected
        result_list$auto_cluster_stage_requested <- auto_cluster_stage_selected
        result_list$auto_cluster_optimization_method <- if (identical(auto_cluster_method_selected, "kmeans")) {
          cluster_optimization_method
        } else {
          "not_applicable"
        }

        cluster_data_auto <- NULL
        if (identical(auto_cluster_stage_selected, "after")) {
          pca_res_for_auto <- tryCatch(prcomp(num_data, center = TRUE, scale. = TRUE), error = function(e) NULL)
          if (!is.null(pca_res_for_auto) && !is.null(pca_res_for_auto$x)) {
            pca_cluster_space <- select_pca_clustering_scores(
              pca_res = pca_res_for_auto,
              max_dims = 2L
            )
            cluster_data_auto <- pca_cluster_space$scores
            result_list$auto_cluster_dims_used <- as.numeric(pca_cluster_space$dims_used)
            result_list$auto_cluster_dims_total <- as.numeric(pca_cluster_space$total_dims)
            result_list$auto_cluster_dim_selection_rule <- as.character(pca_cluster_space$rule)
            result_list$auto_cluster_retained_variance_pct <- if (is.finite(pca_cluster_space$retained_variance_percent)) {
              as.numeric(pca_cluster_space$retained_variance_percent)
            } else {
              NA_real_
            }
            result_list$auto_cluster_scale <- if (
              is.finite(pca_cluster_space$total_dims) &&
              is.finite(pca_cluster_space$dims_used) &&
              pca_cluster_space$dims_used < pca_cluster_space$total_dims
            ) {
              "pca_scores_first_two"
            } else {
              "pca_scores"
            }
          } else {
            result_list$auto_cluster_warning <- "Auto-clustering after PCA failed while computing PCA scores."
          }
        } else {
          cluster_data_auto <- zscore_matrix_safe(num_data)
          result_list$auto_cluster_scale <- "zscore"
          result_list$auto_cluster_dims_used <- as.numeric(ncol(cluster_data_auto))
        }
        if (is.null(cluster_data_auto)) {
          cluster_data_auto <- matrix(numeric(0), nrow = 0, ncol = 0)
        }
        validation_cluster_data_auto <- if (identical(auto_cluster_stage_selected, "after")) {
          cluster_data_auto
        } else {
          zscore_matrix_safe(num_data)
        }
        n_obs_auto <- nrow(cluster_data_auto)
        max_k_auto <- if (identical(auto_cluster_method_selected, "hierarchical")) {
          min(10, n_obs_auto - 1)
        } else {
          min(8, n_obs_auto - 1)
        }
        manual_k_override <- resolve_manual_k_override(
          enabled = manual_cluster_k_enabled,
          requested_k = manual_cluster_k_requested,
          max_allowed_k = max_k_auto
        )
        if (isTRUE(manual_k_override$enabled)) {
          result_list$manual_cluster_k_enabled <- TRUE
          result_list$manual_cluster_k_requested <- as.integer(manual_k_override$requested_k)
          result_list$manual_cluster_k_used <- as.integer(manual_k_override$used_k)
          if (!is.null(manual_k_override$warning) && nzchar(manual_k_override$warning)) {
            result_list$manual_cluster_k_warning <- manual_k_override$warning
          }
        }
        if (is.finite(max_k_auto) && max_k_auto >= 2) {
          dist_auto <- tryCatch(stats::dist(cluster_data_auto), error = function(e) NULL)
          if (!is.null(dist_auto)) {
            if (identical(auto_cluster_method_selected, "hierarchical")) {
              hc_auto <- tryCatch(stats::hclust(dist_auto, method = "ward.D2"), error = function(e) NULL)
              if (!is.null(hc_auto)) {
                if (isTRUE(manual_k_override$enabled)) {
                  k_choice_auto <- list(
                    k = as.integer(manual_k_override$used_k),
                    rule = "manual_k_override",
                    elbow_k = NA_integer_,
                    silhouette_k = NA_integer_,
                    silhouette_best = NA_real_,
                    decision_score = NA_real_
                  )
                  chosen_k_auto <- as.integer(manual_k_override$used_k)
                  result_list$auto_cluster_optimization_method <- "manual_k"
                } else {
                  sil_auto <- rep(NA_real_, max_k_auto)

                  for (k_try in 2:max_k_auto) {
                    part_try <- tryCatch(stats::cutree(hc_auto, k = k_try), error = function(e) NULL)
                    if (is.null(part_try) || length(part_try) != n_obs_auto) next

                    sil_avg <- tryCatch({
                      sil_obj <- cluster::silhouette(part_try, dist_auto)
                      mean(sil_obj[, 3], na.rm = TRUE)
                    }, error = function(e) NA_real_)
                    if (is.finite(sil_avg)) sil_auto[k_try] <- sil_avg
                  }

                  result_list$auto_cluster_optimization_data <- list(
                    k_values = seq_len(max_k_auto),
                    wss = rep(NA_real_, max_k_auto),
                    silhouette = sil_auto
                  )

                  k_choice_auto <- choose_k_from_elbow_silhouette(
                    elbow_k = NA_integer_,
                    silhouette_values = sil_auto,
                    k_values = seq_len(max_k_auto),
                    method = "silhouette"
                  )
                  chosen_k_auto <- suppressWarnings(as.integer(k_choice_auto$k))
                  if (!is.finite(chosen_k_auto) || chosen_k_auto < 2) {
                    chosen_k_auto <- 2L
                  }
                }

                best_cluster_assign <- tryCatch(stats::cutree(hc_auto, k = chosen_k_auto), error = function(e) NULL)
                if (!is.null(best_cluster_assign) && length(best_cluster_assign) == n_obs_auto) {
                  best_cluster_assign <- as.integer(best_cluster_assign)
                  cluster_levels <- sort(unique(best_cluster_assign))
                  grouping_col <- factor(
                    paste0("Cluster ", best_cluster_assign),
                    levels = paste0("Cluster ", cluster_levels)
                  )
                  grouping_var_name <- "Auto Clusters"
                  if (identical(auto_cluster_stage_selected, "after")) {
                    auto_cluster_post_pca <- TRUE
                    result_list$auto_cluster_after_pca <- TRUE
                    if (is_pca_biplot_mode) {
                      result_list$auto_cluster_after_pca_biplot <- TRUE
                    }
                  } else {
                    auto_cluster_pre_pca <- TRUE
                    result_list$auto_cluster_before_pca <- TRUE
                    if (is_pca_biplot_mode) {
                      result_list$auto_cluster_before_pca_biplot <- TRUE
                    }
                  }
                  result_list$auto_cluster_stage_used <- if (isTRUE(result_list$auto_cluster_after_pca)) "after" else "before"

                  result_list$auto_cluster_method <- "hierarchical"
                  result_list$auto_cluster_strategy <- "hierarchical_ward"
                  result_list$auto_cluster_hclust_method <- "ward.D2"
                  result_list$auto_cluster_decision_rule <- k_choice_auto$rule
                  result_list$auto_cluster_k <- as.integer(chosen_k_auto)
                  result_list$auto_cluster_elbow_k <- NA_integer_
                  result_list$auto_cluster_silhouette_k <- if (!isTRUE(manual_k_override$enabled) && is.finite(k_choice_auto$silhouette_k)) as.integer(k_choice_auto$silhouette_k) else NA_integer_
                  sil_obj_final <- tryCatch(cluster::silhouette(best_cluster_assign, dist_auto), error = function(e) NULL)
                  sil_final <- if (!is.null(sil_obj_final)) {
                    as.numeric(mean(sil_obj_final[, 3], na.rm = TRUE))
                  } else {
                    NA_real_
                  }
                  result_list$auto_cluster_avg_silhouette <- if (is.finite(sil_final)) sil_final else NA_real_
                  result_list$auto_cluster_decision_score <- if (is.finite(k_choice_auto$decision_score)) as.numeric(k_choice_auto$decision_score) else NA_real_
                  auto_sizes <- table(grouping_col)
                  result_list$auto_cluster_sizes <- as.list(as.numeric(auto_sizes))
                  names(result_list$auto_cluster_sizes) <- names(auto_sizes)
                  tryCatch({
                    dendro_path <- gsub("\\.png$", "_auto_dendrogram.png", output_image)
                    label_cfg <- resolve_base_label_config(
                      "analysis_plot",
                      default_title = "PCA Hierarchical Clustering Dendrogram",
                      default_x = "",
                      default_y = ""
                    )
                    png(dendro_path, width = 920, height = 580)
                    plot(
                      hc_auto,
                      main = "",
                      xlab = "",
                      sub = "",
                      ylab = "Linkage Height (Ward.D2 on Euclidean distance)",
                      cex = 0.8,
                      hang = -1
                    )
                    rect.hclust(hc_auto, k = as.integer(chosen_k_auto), border = "#dc2626")
                    render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
                    mtext(
                      paste0(
                        if (isTRUE(manual_k_override$enabled)) "Manual k = " else "Selected k = ",
                        as.integer(chosen_k_auto),
                        " | Stage = ", if (identical(auto_cluster_stage_selected, "after")) "after PCA" else "before PCA"
                      ),
                      side = 1,
                      line = 3.6,
                      cex = 0.82,
                      col = "#475569"
                    )
                    dev.off()
                    result_list$dendrogram_path <- dendro_path
                  }, error = function(e) {
                    result_list$dendrogram_error <- e$message
                  })
                  if (!is.null(sil_obj_final)) {
                    tryCatch({
                      sil_path <- gsub("\\.png$", "_auto_silhouette.png", output_image)
                      label_cfg <- resolve_base_label_config(
                        "silhouette_plot",
                        default_title = paste("PCA Auto-Clustering Silhouette Plot (k =", chosen_k_auto, ")"),
                        default_x = "",
                        default_y = ""
                      )
                      png(sil_path, width = 650, height = 430)
                      plot(sil_obj_final, main = "", col = palette_main, border = NA)
                      render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                      dev.off()
                      result_list$silhouette_plot_path <- sil_path
                      result_list$silhouette_table <- build_silhouette_table_payload(
                        sil_obj_final,
                        observation_ids = rownames(cluster_data_auto),
                        cluster_label_map = setNames(paste0("Cluster ", cluster_levels), as.character(cluster_levels)),
                        scope = "full_rows"
                      )
                    }, error = function(e) {
                      result_list$silhouette_error <- e$message
                    })
                  }
                  if (isTRUE(manual_k_override$enabled)) {
                    result_list$manual_cluster_validation <- run_manual_cluster_validation(
                      cluster_input = validation_cluster_data_auto,
                      selected_k = chosen_k_auto,
                      output_image = output_image,
                      plot_suffix = "_auto_manual_validation_silhouette_trend.png",
                      plot_title_prefix = "PCA Manual K Validation",
                      palette_main = palette_main,
                      palette_accent = palette_accent
                    )
                    if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_path)) {
                      result_list$silhouette_trend_plot_path <- result_list$manual_cluster_validation$silhouette_trend_plot_path
                    }
                    if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_error) && nzchar(result_list$manual_cluster_validation$silhouette_trend_plot_error)) {
                      result_list$silhouette_trend_plot_error <- result_list$manual_cluster_validation$silhouette_trend_plot_error
                    }
                  }
                } else {
                  result_list$auto_cluster_warning <- "Hierarchical auto-clustering for PCA/PCA biplot could not find a valid cluster solution."
                }
              } else {
                result_list$auto_cluster_warning <- "Hierarchical auto-clustering for PCA/PCA biplot failed while building dendrogram."
              }
            } else {
              best_cluster_assign <- NULL
              chosen_k_auto <- NA_integer_
              k_choice_auto <- list(rule = "manual_k_override", silhouette_k = NA_integer_, decision_score = NA_real_)
              elbow_k_auto <- NA_integer_
              if (isTRUE(manual_k_override$enabled)) {
                chosen_k_auto <- as.integer(manual_k_override$used_k)
                km_manual <- tryCatch(stats::kmeans(cluster_data_auto, centers = chosen_k_auto, nstart = 25), error = function(e) NULL)
                best_cluster_assign <- if (!is.null(km_manual) && length(km_manual$cluster) == n_obs_auto) as.integer(km_manual$cluster) else NULL
                result_list$auto_cluster_optimization_method <- "manual_k"
              } else {
                wss_auto <- rep(NA_real_, max_k_auto)
                sil_auto <- rep(NA_real_, max_k_auto)
                km_assignments <- list()

                wss_auto[1] <- tryCatch({
                  km_one <- stats::kmeans(cluster_data_auto, centers = 1, nstart = 20)
                  sum(km_one$withinss)
                }, error = function(e) NA_real_)

                for (k_try in 2:max_k_auto) {
                  km_try <- tryCatch(stats::kmeans(cluster_data_auto, centers = k_try, nstart = 20), error = function(e) NULL)
                  if (is.null(km_try)) next
                  wss_auto[k_try] <- sum(km_try$withinss)
                  km_assignments[[as.character(k_try)]] <- as.integer(km_try$cluster)
                  sil_avg <- tryCatch({
                    sil_obj <- cluster::silhouette(km_try$cluster, dist_auto)
                    mean(sil_obj[, 3], na.rm = TRUE)
                  }, error = function(e) NA_real_)
                  if (is.finite(sil_avg)) sil_auto[k_try] <- sil_avg
                }
                result_list$auto_cluster_optimization_data <- list(
                  k_values = seq_len(max_k_auto),
                  wss = wss_auto,
                  silhouette = sil_auto
                )
                show_auto_elbow_plot <- cluster_optimization_method %in% c("both", "elbow")
                show_auto_silhouette_plot <- cluster_optimization_method %in% c("both", "silhouette")
                if (isTRUE(show_auto_elbow_plot)) {
                auto_elbow_path <- gsub("\\.png$", "_auto_elbow.png", output_image)
                tryCatch({
                  label_cfg <- resolve_base_label_config(
                    "elbow_plot",
                    default_title = "PCA Auto-Clustering Elbow Method",
                    default_x = "Number of Clusters K",
                    default_y = "Total WSS"
                  )
                  png(auto_elbow_path, width = 700, height = 450)
                  plot(
                    seq_len(max_k_auto),
                    wss_auto,
                    type = "b",
                    pch = 19,
                    frame = FALSE,
                    xlab = "",
                    ylab = "",
                    main = "",
                    col = palette_main
                  )
                  render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                  dev.off()
                  result_list$elbow_plot_path <- auto_elbow_path
                }, error = function(e) {
                  result_list$elbow_plot_error <<- e$message
                })
              }
              if (isTRUE(show_auto_silhouette_plot)) {
                auto_silhouette_path <- gsub("\\.png$", "_auto_silhouette_trend.png", output_image)
                tryCatch({
                  valid_sil_idx <- which(is.finite(sil_auto) & seq_along(sil_auto) >= 2)
                  best_k_auto <- if (length(valid_sil_idx) > 0) valid_sil_idx[which.max(sil_auto[valid_sil_idx])] else NA_integer_
                  best_sil_auto <- if (is.finite(best_k_auto)) sil_auto[best_k_auto] else NA_real_
                  label_cfg <- resolve_base_label_config(
                    "silhouette_trend_plot",
                    default_title = "PCA Auto-Clustering Silhouette Method",
                    default_x = "Number of Clusters K",
                    default_y = "Avg Silhouette Width"
                  )
                  png(auto_silhouette_path, width = 700, height = 450)
                  if (max_k_auto >= 2) {
                    plot(
                      2:max_k_auto,
                      sil_auto[2:max_k_auto],
                      type = "b",
                      pch = 19,
                      frame = FALSE,
                      xlab = "",
                      ylab = "",
                      main = "",
                      col = palette_accent
                    )
                    if (is.finite(best_k_auto) && is.finite(best_sil_auto)) {
                      points(best_k_auto, best_sil_auto, col = palette_main, pch = 19, cex = 1.4)
                    }
                  } else {
                    plot.new()
                    text(0.5, 0.5, "Silhouette trend unavailable (need at least k=2).")
                  }
                  render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                  dev.off()
                  result_list$silhouette_trend_plot_path <- auto_silhouette_path
                }, error = function(e) {
                  result_list$silhouette_trend_plot_error <<- e$message
                })
              }

                elbow_k_auto <- compute_elbow_k(seq_len(max_k_auto), wss_auto)
                k_choice_auto <- choose_k_from_elbow_silhouette(
                  elbow_k = elbow_k_auto,
                  silhouette_values = sil_auto,
                  k_values = seq_len(max_k_auto),
                  method = cluster_optimization_method
                )
                chosen_k_auto <- suppressWarnings(as.integer(k_choice_auto$k))
                chosen_key <- as.character(chosen_k_auto)
                best_cluster_assign <- if (nzchar(chosen_key) && !is.null(km_assignments[[chosen_key]])) {
                  as.integer(km_assignments[[chosen_key]])
                } else {
                  NULL
                }
              }

              if (!is.null(best_cluster_assign) && length(best_cluster_assign) == n_obs_auto) {
                cluster_levels <- sort(unique(best_cluster_assign))
                grouping_col <- factor(
                  paste0("Cluster ", best_cluster_assign),
                  levels = paste0("Cluster ", cluster_levels)
                )
                grouping_var_name <- "Auto Clusters"
                if (identical(auto_cluster_stage_selected, "after")) {
                  auto_cluster_post_pca <- TRUE
                  result_list$auto_cluster_after_pca <- TRUE
                  if (is_pca_biplot_mode) {
                    result_list$auto_cluster_after_pca_biplot <- TRUE
                  }
                } else {
                  auto_cluster_pre_pca <- TRUE
                  result_list$auto_cluster_before_pca <- TRUE
                  if (is_pca_biplot_mode) {
                    result_list$auto_cluster_before_pca_biplot <- TRUE
                  }
                }
                result_list$auto_cluster_stage_used <- if (isTRUE(result_list$auto_cluster_after_pca)) "after" else "before"
                result_list$auto_cluster_method <- "kmeans"
                result_list$auto_cluster_strategy <- "kmeans"
                result_list$auto_cluster_optimization_method <- if (isTRUE(manual_k_override$enabled)) "manual_k" else cluster_optimization_method
                result_list$auto_cluster_decision_rule <- k_choice_auto$rule
                result_list$auto_cluster_k <- as.integer(chosen_k_auto)
                result_list$auto_cluster_elbow_k <- if (!isTRUE(manual_k_override$enabled) && is.finite(elbow_k_auto)) as.integer(elbow_k_auto) else NA_integer_
                result_list$auto_cluster_silhouette_k <- if (!isTRUE(manual_k_override$enabled) && is.finite(k_choice_auto$silhouette_k)) as.integer(k_choice_auto$silhouette_k) else NA_integer_
                result_list$auto_cluster_avg_silhouette <- NA_real_
                result_list$auto_cluster_decision_score <- if (is.finite(k_choice_auto$decision_score)) as.numeric(k_choice_auto$decision_score) else NA_real_
                auto_sizes <- table(grouping_col)
                result_list$auto_cluster_sizes <- as.list(as.numeric(auto_sizes))
                names(result_list$auto_cluster_sizes) <- names(auto_sizes)
                if (chosen_k_auto >= 2) {
                  tryCatch({
                    sil_obj_final <- cluster::silhouette(best_cluster_assign, dist_auto)
                    sil_path <- gsub("\\.png$", "_auto_silhouette.png", output_image)
                    label_cfg <- resolve_base_label_config(
                      "silhouette_plot",
                      default_title = paste("PCA Auto-Clustering Silhouette Plot (k =", chosen_k_auto, ")"),
                      default_x = "",
                      default_y = ""
                    )
                    png(sil_path, width = 650, height = 430)
                    plot(sil_obj_final, main = "", col = palette_main, border = NA)
                    render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
                    dev.off()
                    result_list$silhouette_plot_path <- sil_path
                    result_list$auto_cluster_avg_silhouette <- as.numeric(mean(sil_obj_final[, 3], na.rm = TRUE))
                    result_list$silhouette_table <- build_silhouette_table_payload(
                      sil_obj_final,
                      observation_ids = rownames(cluster_data_auto),
                      cluster_label_map = setNames(paste0("Cluster ", cluster_levels), as.character(cluster_levels)),
                      scope = "full_rows"
                    )
                  }, error = function(e) {
                    result_list$silhouette_error <- e$message
                  })
                }
                if (isTRUE(manual_k_override$enabled)) {
                  result_list$manual_cluster_validation <- run_manual_cluster_validation(
                    cluster_input = validation_cluster_data_auto,
                    selected_k = chosen_k_auto,
                    output_image = output_image,
                    plot_suffix = "_auto_manual_validation_silhouette_trend.png",
                    plot_title_prefix = "PCA Manual K Validation",
                    palette_main = palette_main,
                    palette_accent = palette_accent
                  )
                  if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_path)) {
                    result_list$silhouette_trend_plot_path <- result_list$manual_cluster_validation$silhouette_trend_plot_path
                  }
                  if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_error) && nzchar(result_list$manual_cluster_validation$silhouette_trend_plot_error)) {
                    result_list$silhouette_trend_plot_error <- result_list$manual_cluster_validation$silhouette_trend_plot_error
                  }
                }
              } else {
                result_list$auto_cluster_warning <- "Auto-clustering for PCA/PCA biplot could not find a valid cluster solution."
              }
            }
          } else {
            result_list$auto_cluster_warning <- "Auto-clustering for PCA/PCA biplot failed while computing distances."
          }
        } else {
          result_list$auto_cluster_warning <- "Auto-clustering for PCA/PCA biplot needs at least 3 complete rows."
        }
       } else if (is.null(grouping_col) && !isTRUE(pca_auto_clustering_enabled)) {
         result_list$auto_cluster_note <- "Auto-clustering for PCA/PCA biplot is disabled."
       }

       if (!is.null(grouping_var_name)) {
         result_list$grouping_variable <- grouping_var_name
       }
       if (is_pca_biplot_mode && isTRUE(auto_cluster_pre_pca)) {
         pca_plot_title <- "PCA Biplot (Clustered Before PCA)"
       } else if (!is_pca_biplot_mode && isTRUE(auto_cluster_pre_pca)) {
         pca_plot_title <- "PCA Individuals Map (Clustered Before PCA)"
       } else if (is_pca_biplot_mode && isTRUE(auto_cluster_post_pca)) {
         pca_plot_title <- "PCA Biplot (Clustered After PCA)"
       } else if (!is_pca_biplot_mode && isTRUE(auto_cluster_post_pca)) {
         pca_plot_title <- "PCA Individuals Map (Clustered After PCA)"
       }
       result_list$pca_visualization <- if (is_pca_biplot_mode) "biplot" else "individuals"
       result_list$pca_show_biplot_vectors <- isTRUE(show_biplot_vectors)
       result_list$pca_show_group_ellipse <- isTRUE(show_group_ellipse)
       result_list$pca_show_ellipse_significance <- isTRUE(show_ellipse_significance)
       result_list$pca_ellipse_level <- as.numeric(ellipse_conf_level)
       result_list$pca_grouping_source <- if (isTRUE(auto_cluster_pre_pca)) "auto_clustering_before" else if (isTRUE(auto_cluster_post_pca)) "auto_clustering_after" else if (!is.null(grouping_var_name)) "user_group" else "none"
       
       pca_res <- if (!is.null(pca_res_for_auto)) pca_res_for_auto else prcomp(num_data, center = TRUE, scale. = TRUE)
       
       # Variance explained
       eig_vals <- pca_res$sdev^2
       variance_pct <- round(eig_vals / sum(eig_vals) * 100, 2)
       cum_variance <- cumsum(variance_pct)
       
       result_list$eigenvalues <- data.frame(
         PC = paste0("PC", 1:length(eig_vals)),
         Eigenvalue = round(eig_vals, 3),
         Variance_Percent = variance_pct,
         Cumulative_Percent = cum_variance
       )
       
       # Loadings (Rotation) - Top 5 PCs or all
       n_pc <- min(ncol(num_data), 5)
       loadings_df <- as.data.frame(pca_res$rotation[, 1:n_pc])
       loadings_df$Variable <- rownames(loadings_df)
       result_list$loadings <- loadings_df
       
       # Scores (Individuals) - Top 5 PCs
       scores_df <- as.data.frame(pca_res$x[, 1:n_pc])
       # result_list$scores <- scores_df # Too large to send all? Maybe send summary or subset?
       # We'll rely on the plot.
       
       # Generate PLOTS
       # 1. Scree Plot (Secondary) - PCA mode only
       if (isTRUE(include_scree)) {
         scree_path <- gsub("\\.png$", "_scree.png", output_image)
         tryCatch({
            label_cfg <- resolve_base_label_config(
              "scree_plot",
              default_title = "Scree Plot (Variance Explained)",
              default_x = "Principal Component",
              default_y = "Percentage of Variance"
            )
            png(scree_path, width = 800, height = 600)
            barplot(variance_pct[1:min(10, length(variance_pct))], 
                    main = "",
                    xlab = "", ylab = "",
                    col = "steelblue", border = "white", ylim = c(0, max(variance_pct)*1.1))
            lines(x = 1:min(10, length(variance_pct)), y = variance_pct[1:min(10, length(variance_pct))], type="b", pch=19, col="red")
            render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
            dev.off()
            result_list$scree_plot_path <- scree_path
            result_list$plot_generated <- TRUE
         }, error = function(e) {
            result_list$scree_plot_error <<- e$message
         })
       }
       
       # 2. Main PCA projection (Individuals or Biplot based on mode/element toggles)
       # output_image is the main path
       tryCatch({
          library(ggplot2)
          
          pc_data <- data.frame(pca_res$x[, 1:2], stringsAsFactors = FALSE)
          colnames(pc_data) <- c("PC1", "PC2")
          if (!is.null(grouping_col)) {
             pc_data$Group <- droplevels(grouping_col)
          }
          
          xlab <- paste0("PC1 (", variance_pct[1], "%)")
          ylab <- paste0("PC2 (", variance_pct[2], "%)")
          base_cols <- pick_cols(ifelse(is.null(grouping_col), 1, nlevels(pc_data$Group)))

          can_draw_ellipse <- FALSE
          if (!is.null(grouping_col) && isTRUE(show_group_ellipse)) {
             if (nlevels(pc_data$Group) <= 10) {
               obs_per_group <- table(pc_data$Group)
               if (all(obs_per_group >= 3)) {
                 can_draw_ellipse <- TRUE
               }
             }
          }
          result_list$pca_group_ellipse_supported <- isTRUE(can_draw_ellipse)

          fmt_p <- function(pv) {
            if (!is.finite(pv)) return("N/A")
            if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
            format(round(pv, 4), nsmall = 4)
          }

          ellipse_sig_text <- NULL
          if (isTRUE(show_ellipse_significance) && !is.null(grouping_col) && nlevels(pc_data$Group) >= 2) {
            ellipse_p_val <- tryCatch({
              manova_fit <- stats::manova(cbind(PC1, PC2) ~ Group, data = pc_data)
              manova_stats <- summary(manova_fit, test = "Pillai")$stats
              as.numeric(manova_stats[1, "Pr(>F)"])
            }, error = function(e) NA_real_)
            if (is.finite(ellipse_p_val)) {
              ellipse_sig_text <- paste0("Group-separation p (Pillai MANOVA): ", fmt_p(ellipse_p_val))
              result_list$ellipse_significance_test <- "Pillai MANOVA on PC1-PC2"
              result_list$ellipse_significance_p <- as.numeric(ellipse_p_val)
              result_list$ellipse_significance_formatted_p <- fmt_p(ellipse_p_val)
              result_list$ellipse_significant <- ellipse_p_val < alpha_val
            }
          }

          subtitle_parts <- c(
            if (isTRUE(show_biplot_vectors)) "Individuals + variable vectors" else "Individuals projection"
          )
          if (isTRUE(auto_cluster_pre_pca) && isTRUE(is.finite(result_list$auto_cluster_avg_silhouette))) {
            subtitle_parts <- c(
              subtitle_parts,
              paste0(
                "Auto-clustered first (k = ",
                as.integer(result_list$auto_cluster_k),
                ", silhouette = ",
                format(round(as.numeric(result_list$auto_cluster_avg_silhouette), 4), nsmall = 4),
                ")"
              )
            )
          }
          if (isTRUE(can_draw_ellipse)) {
            subtitle_parts <- c(subtitle_parts, paste0(round(ellipse_conf_level * 100, 1), "% confidence ellipses"))
          }
          if (!is.null(ellipse_sig_text) && nzchar(ellipse_sig_text)) {
            subtitle_parts <- c(subtitle_parts, ellipse_sig_text)
          }

          p <- ggplot(pc_data, aes(x = PC1, y = PC2)) +
               geom_hline(yintercept = 0, linetype = "dashed", color = "gray") +
               geom_vline(xintercept = 0, linetype = "dashed", color = "gray") +
               labs(
                 title = pca_plot_title,
                 subtitle = paste(subtitle_parts, collapse = " | "),
                 x = xlab,
                 y = ylab
               ) +
               theme_minimal()
          
          if (!is.null(grouping_col)) {
             p <- p + geom_point(aes(color = Group), alpha = 0.7) +
                 scale_color_manual(values = base_cols)
          } else {
             p <- p + geom_point(color = palette_main, alpha = 0.7)
          }

          if (isTRUE(can_draw_ellipse)) {
            p <- p + stat_ellipse(
              aes(color = Group, fill = Group),
              geom = "polygon",
              alpha = 0.1,
              linewidth = 0.45,
              type = "norm",
              level = ellipse_conf_level
            )
          }

          if (isTRUE(show_biplot_vectors)) {
            pc1_scores_span <- max(abs(pc_data$PC1), na.rm = TRUE)
            pc2_scores_span <- max(abs(pc_data$PC2), na.rm = TRUE)
            pc1_load_span <- max(abs(pca_res$rotation[, 1]), na.rm = TRUE)
            pc2_load_span <- max(abs(pca_res$rotation[, 2]), na.rm = TRUE)
            loadings_mult <- min(
              if (is.finite(pc1_load_span) && pc1_load_span > 0) pc1_scores_span / pc1_load_span else Inf,
              if (is.finite(pc2_load_span) && pc2_load_span > 0) pc2_scores_span / pc2_load_span else Inf
            ) * 0.8
            if (!is.finite(loadings_mult) || loadings_mult <= 0) loadings_mult <- 1
            arrow_data <- data.frame(pca_res$rotation[, 1:2] * loadings_mult, stringsAsFactors = FALSE)
            colnames(arrow_data) <- c("x", "y")
            arrow_data$var <- rownames(arrow_data)

            p <- p +
              geom_segment(
                data = arrow_data,
                aes(x = 0, y = 0, xend = x, yend = y),
                arrow = arrow(length = grid::unit(0.2, "cm")),
                color = palette_accent
              ) +
              geom_text(
                data = arrow_data,
                aes(x = x + pca_label_nudge_x, y = y + pca_label_nudge_y, label = var),
                color = palette_main,
                vjust = -0.5,
                fontface = "bold"
              )
          }

          custom_ggsave(output_image, plot = p, plot_key = "analysis_plot", width = 10, height = 8, dpi = 300)
          result_list$biplot_path <- output_image
          result_list$plot_path <- output_image
          result_list$plot_generated <- TRUE
       }, error = function(e) {
          result_list$biplot_error <<- paste("PCA Plot Error:", e$message)
          result_list$plot_error <- result_list$biplot_error
       })

    } else if (base_analysis_mode == "multivariate_coinertia") {
       # Co-inertia analysis on two numeric variable blocks measured on the same observations.
       x_vars <- predictors
       y_vars <- coinertia_block_y

       if (length(x_vars) < 1 || length(y_vars) < 1) {
         cat(toJSON(list(error = "Co-inertia requires non-empty Block X and Block Y variable sets."), auto_unbox = TRUE))
         quit(save = "no")
       }

       x_data <- data_subset[, x_vars, drop = FALSE]
       y_data <- data_subset[, y_vars, drop = FALSE]

       non_num_x <- names(x_data)[!sapply(x_data, is.numeric)]
       non_num_y <- names(y_data)[!sapply(y_data, is.numeric)]
       if (length(non_num_x) > 0 || length(non_num_y) > 0) {
         non_num_all <- unique(c(non_num_x, non_num_y))
         cat(toJSON(list(error = paste0(
           "Co-inertia requires numeric variables in both blocks. Non-numeric variable(s): ",
           paste(non_num_all, collapse = ", "),
           "."
         )), auto_unbox = TRUE))
         quit(save = "no")
       }

       coinertia_notes <- character(0)
       x_sd <- sapply(x_data, function(v) stats::sd(v, na.rm = TRUE))
       y_sd <- sapply(y_data, function(v) stats::sd(v, na.rm = TRUE))
       keep_x <- is.finite(x_sd) & x_sd > .Machine$double.eps
       keep_y <- is.finite(y_sd) & y_sd > .Machine$double.eps

       removed_x <- names(x_sd)[!keep_x]
       removed_y <- names(y_sd)[!keep_y]
       if (length(removed_x) > 0) {
         coinertia_notes <- c(
           coinertia_notes,
           paste0("Dropped near-constant Block X variable(s): ", paste(removed_x, collapse = ", "), ".")
         )
       }
       if (length(removed_y) > 0) {
         coinertia_notes <- c(
           coinertia_notes,
           paste0("Dropped near-constant Block Y variable(s): ", paste(removed_y, collapse = ", "), ".")
         )
       }

       x_data <- x_data[, keep_x, drop = FALSE]
       y_data <- y_data[, keep_y, drop = FALSE]
       x_vars_used <- colnames(x_data)
       y_vars_used <- colnames(y_data)
       if (length(x_vars_used) < 1 || length(y_vars_used) < 1) {
         cat(toJSON(list(error = "Co-inertia failed: one block became empty after removing near-constant variables."), auto_unbox = TRUE))
         quit(save = "no")
       }

       x_scaled <- scale(as.matrix(x_data), center = TRUE, scale = TRUE)
       y_scaled <- scale(as.matrix(y_data), center = TRUE, scale = TRUE)
       x_scaled[!is.finite(x_scaled)] <- 0
       y_scaled[!is.finite(y_scaled)] <- 0
       n_obs <- nrow(x_scaled)
       if (!is.finite(n_obs) || n_obs < 3) {
         cat(toJSON(list(error = "Co-inertia requires at least 3 complete observations."), auto_unbox = TRUE))
         quit(save = "no")
       }

       cross_cov <- crossprod(x_scaled, y_scaled) / max(1, (n_obs - 1))
       sv <- svd(cross_cov)
       singular_vals <- as.numeric(sv$d)
       keep_idx <- which(is.finite(singular_vals) & singular_vals > .Machine$double.eps)
       if (length(keep_idx) == 0) {
         cat(toJSON(list(error = "Co-inertia failed: no shared structure dimensions were found."), auto_unbox = TRUE))
         quit(save = "no")
       }

       singular_keep <- singular_vals[keep_idx]
       eigen_vals <- singular_keep^2
       variance_pct <- round((eigen_vals / sum(eigen_vals)) * 100, 2)
       cum_variance <- cumsum(variance_pct)
       dim_names <- paste0("Axis", seq_along(eigen_vals))

       x_weights <- sv$u[, keep_idx, drop = FALSE]
       y_weights <- sv$v[, keep_idx, drop = FALSE]
       x_scores <- x_scaled %*% x_weights
       y_scores <- y_scaled %*% y_weights
       x_scores <- sweep(x_scores, 2, singular_keep, "*")
       y_scores <- sweep(y_scores, 2, singular_keep, "*")
       compromise_scores <- (x_scores + y_scores) / 2

       has_second_dim <- ncol(compromise_scores) >= 2
       x_dim2_vals <- if (has_second_dim) x_scores[, 2] else rep(0.08, n_obs)
       y_dim2_vals <- if (has_second_dim) y_scores[, 2] else rep(-0.08, n_obs)
       c_dim2_vals <- if (has_second_dim) compromise_scores[, 2] else rep(0, n_obs)
       co_plot_df <- data.frame(
         Observation = seq_len(n_obs),
         X1 = as.numeric(x_scores[, 1]),
         X2 = as.numeric(x_dim2_vals),
         Y1 = as.numeric(y_scores[, 1]),
         Y2 = as.numeric(y_dim2_vals),
         C1 = as.numeric(compromise_scores[, 1]),
         C2 = as.numeric(c_dim2_vals),
         stringsAsFactors = FALSE
       )

       x_loading_df <- data.frame(
         Variable = paste0("X:", x_vars_used),
         Block = "X",
         PC1 = as.numeric(x_weights[, 1]),
         PC2 = if (ncol(x_weights) >= 2) as.numeric(x_weights[, 2]) else rep(0, nrow(x_weights)),
         stringsAsFactors = FALSE
       )
       y_loading_df <- data.frame(
         Variable = paste0("Y:", y_vars_used),
         Block = "Y",
         PC1 = as.numeric(y_weights[, 1]),
         PC2 = if (ncol(y_weights) >= 2) as.numeric(y_weights[, 2]) else rep(0, nrow(y_weights)),
         stringsAsFactors = FALSE
       )

       result_list$coinertia_summary <- list(
         x_variables = x_vars_used,
         y_variables = y_vars_used,
         x_variable_count = as.numeric(length(x_vars_used)),
         y_variable_count = as.numeric(length(y_vars_used)),
         total_n = as.numeric(n_obs),
         retained_dimensions = as.numeric(length(keep_idx))
       )
       result_list$coinertia_total_covariance <- as.numeric(sum(eigen_vals))
       result_list$coinertia_x_loadings <- x_loading_df
       result_list$coinertia_y_loadings <- y_loading_df
       result_list$coinertia_individual_coordinates <- utils::head(data.frame(
         Observation = as.numeric(co_plot_df$Observation),
         Dim1 = as.numeric(co_plot_df$C1),
         Dim2 = as.numeric(co_plot_df$C2),
         X_Dim1 = as.numeric(co_plot_df$X1),
         X_Dim2 = as.numeric(co_plot_df$X2),
         Y_Dim1 = as.numeric(co_plot_df$Y1),
         Y_Dim2 = as.numeric(co_plot_df$Y2),
         check.names = FALSE
       ), 300)
       result_list$coinertia_individual_count_total <- as.numeric(n_obs)
       result_list$loadings <- rbind(x_loading_df, y_loading_df)
       result_list$eigenvalues <- data.frame(
         PC = dim_names,
         Eigenvalue = round(eigen_vals, 4),
         Variance_Percent = variance_pct,
         Cumulative_Percent = cum_variance
       )
       if (length(coinertia_notes) > 0) {
         result_list$coinertia_notes <- unique(coinertia_notes)
         result_list$coinertia_note <- result_list$coinertia_notes[[1]]
       }

       # Co-inertia scree plot
       scree_path <- gsub("\\.png$", "_scree.png", output_image)
       tryCatch({
          label_cfg <- resolve_base_label_config(
            "scree_plot",
            default_title = "Co-Inertia Eigenvalues (Shared Structure)",
            default_x = "Co-Inertia Axis",
            default_y = "Percentage of Shared Covariance"
          )
          png(scree_path, width = 800, height = 600)
          barplot(variance_pct[1:min(10, length(variance_pct))],
                  main = "",
                  xlab = "", ylab = "",
                  col = "steelblue", border = "white", ylim = c(0, max(variance_pct) * 1.1))
          lines(x = 1:min(10, length(variance_pct)), y = variance_pct[1:min(10, length(variance_pct))], type = "b", pch = 19, col = "red")
          render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
          dev.off()
          result_list$scree_plot_path <- scree_path
       }, error = function(e) {
          result_list$scree_plot_error <- e$message
       })

       # Co-inertia projection plot
       coinertia_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("analysis_plot"))
      show_coinertia_links <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_links", TRUE)
      show_coinertia_link_arrows <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_link_arrows", TRUE)
      show_coinertia_compromise <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_compromise_points", TRUE)
      show_coinertia_block_x <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_block_x_points", TRUE)
      show_coinertia_block_y <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_block_y_points", TRUE)
      show_coinertia_shapes <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_shapes", TRUE)
      show_coinertia_zero_lines <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_zero_lines", TRUE)
      show_coinertia_origin_point <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_origin_point", TRUE)
      show_coinertia_equal_scaling <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_equal_scaling", TRUE)
      show_coinertia_stats <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_stats", TRUE)
      show_coinertia_permutation <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_permutation", FALSE)
      show_coinertia_x_arrows <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_x_arrows", FALSE)
      show_coinertia_y_arrows <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_y_arrows", FALSE)
      show_coinertia_arrow_labels <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_arrow_labels", TRUE)
      show_coinertia_labels <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_labels", FALSE)
      show_coinertia_publication_legend <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_publication_legend", TRUE)
      show_coinertia_label_reduction <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_label_reduction", TRUE)
      show_coinertia_link_emphasis <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_link_emphasis", TRUE)
      show_coinertia_arrow_emphasis <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_arrow_emphasis", TRUE)
      show_coinertia_arrow_legend <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_arrow_legend", TRUE)
      show_coinertia_compromise_emphasis <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_compromise_emphasis", TRUE)
      show_coinertia_publication_theme <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_publication_theme", TRUE)
      show_coinertia_colorblind_palette <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_colorblind_palette", TRUE)
      show_coinertia_vector_export <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_vector_export", TRUE)
      show_coinertia_full_size <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_coinertia_full_size", TRUE)
      show_coinertia_legend <- resolve_plot_element_flag(coinertia_plot_labels_cfg, "show_legend", TRUE)
      coinertia_label_nudge_x <- resolve_plot_element_numeric(coinertia_plot_labels_cfg, "point_label_nudge_x", 0, -2, 2)
      coinertia_label_nudge_y <- resolve_plot_element_numeric(coinertia_plot_labels_cfg, "point_label_nudge_y", 0, -2, 2)
      coinertia_point_label_nudge_x <- resolve_plot_element_numeric(coinertia_plot_labels_cfg, "coinertia_point_label_nudge_x", 0, -2, 2) + coinertia_label_nudge_x
      coinertia_point_label_nudge_y <- resolve_plot_element_numeric(coinertia_plot_labels_cfg, "coinertia_point_label_nudge_y", 0, -2, 2) + coinertia_label_nudge_y
      coinertia_arrow_label_nudge_x <- resolve_plot_element_numeric(coinertia_plot_labels_cfg, "coinertia_arrow_label_nudge_x", 0, -2, 2) + coinertia_label_nudge_x
      coinertia_arrow_label_nudge_y <- resolve_plot_element_numeric(coinertia_plot_labels_cfg, "coinertia_arrow_label_nudge_y", 0, -2, 2) + coinertia_label_nudge_y

       tryCatch({
         library(ggplot2)
         x_axis_label <- paste0("Axis1 (", variance_pct[1], "%)")
         y_axis_label <- if (length(variance_pct) >= 2) paste0("Axis2 (", variance_pct[2], "%)") else "Axis2 (single-dimension offset view)"
         subtitle_parts <- c(
           paste0("Block X vars: ", length(x_vars_used)),
           paste0("Block Y vars: ", length(y_vars_used)),
           paste0("Rows: ", n_obs)
         )
         if (length(coinertia_notes) > 0) subtitle_parts <- c(subtitle_parts, coinertia_notes[[1]])
        if (!has_second_dim) subtitle_parts <- c(subtitle_parts, "Only one informative shared axis retained")

         palette_publication <- c(
           "Block X" = "#0072B2",
           "Block Y" = "#E69F00",
           "Compromise" = "#000000",
           "Pairing" = "#9CA3AF",
           "Loadings" = "#374151"
         )
         palette_default <- c(
           "Block X" = "#2563eb",
           "Block Y" = "#ea580c",
           "Compromise" = "#0f172a",
           "Pairing" = "#cbd5e1",
           "Loadings" = "#334155"
         )
         palette_active <- if (isTRUE(show_coinertia_colorblind_palette)) palette_publication else palette_default
         block_point_size <- if (isTRUE(show_coinertia_publication_theme)) 2.1 else 1.9
         block_point_alpha <- if (isTRUE(show_coinertia_publication_theme)) 0.68 else 0.72
         compromise_point_size <- if (isTRUE(show_coinertia_compromise_emphasis)) 2.8 else 2.3
         compromise_alpha <- 0.95
         link_linewidth <- if (isTRUE(show_coinertia_link_emphasis)) 0.5 else 0.35
         link_alpha <- if (isTRUE(show_coinertia_link_emphasis)) 0.5 else 0.4
         arrow_linewidth <- if (isTRUE(show_coinertia_arrow_emphasis)) 0.7 else 0.5
         arrow_head_size <- if (isTRUE(show_coinertia_arrow_emphasis)) 0.2 else 0.16
         arrow_label_size <- if (isTRUE(show_coinertia_arrow_emphasis)) 3.1 else 2.8
         arrow_label_factor <- if (isTRUE(show_coinertia_arrow_emphasis)) 1.12 else 1.04
         subtitle_size <- if (isTRUE(show_coinertia_publication_theme)) 8.5 else 9.5
         legend_text_size <- if (isTRUE(show_coinertia_publication_theme)) 8.5 else 9
         legend_title_size <- if (isTRUE(show_coinertia_publication_theme)) 9.5 else 10
         zero_line_color <- if (isTRUE(show_coinertia_publication_theme)) "#cbd5e1" else "#94a3b8"
         zero_line_width <- if (isTRUE(show_coinertia_publication_theme)) 0.35 else 0.4
         grid_major_color <- if (isTRUE(show_coinertia_publication_theme)) "#f1f5f9" else "#e5e7eb"

         p_coinertia <- ggplot()
        if (isTRUE(show_coinertia_zero_lines)) {
          p_coinertia <- p_coinertia +
             geom_hline(yintercept = 0, linetype = "dashed", color = zero_line_color, linewidth = zero_line_width) +
             geom_vline(xintercept = 0, linetype = "dashed", color = zero_line_color, linewidth = zero_line_width)
        }
         if (isTRUE(show_coinertia_origin_point)) {
           p_coinertia <- p_coinertia +
             geom_point(aes(x = 0, y = 0), color = "#64748b", size = 1.5, shape = 3, stroke = 0.7)
         }

         if (isTRUE(show_coinertia_links)) {
           link_arrow <- if (isTRUE(show_coinertia_link_arrows)) arrow(length = grid::unit(0.12, "cm")) else NULL
           if (isTRUE(show_coinertia_publication_legend)) {
             p_coinertia <- p_coinertia +
               geom_segment(
                 data = co_plot_df,
                 aes(x = X1, y = X2, xend = Y1, yend = Y2, color = "Pairing"),
                 linewidth = link_linewidth,
                 alpha = link_alpha,
                 arrow = link_arrow,
                 show.legend = isTRUE(show_coinertia_legend)
               )
           } else {
             p_coinertia <- p_coinertia +
               geom_segment(
                 data = co_plot_df,
                 aes(x = X1, y = X2, xend = Y1, yend = Y2, linetype = "Pairing"),
                 color = palette_active[["Pairing"]],
                 linewidth = link_linewidth,
                 alpha = link_alpha,
                 arrow = link_arrow,
                 show.legend = isTRUE(show_coinertia_legend)
               )
           }
         }

         arrow_df <- NULL
         if (isTRUE(show_coinertia_x_arrows) || isTRUE(show_coinertia_y_arrows)) {
           arrow_parts <- list()
           if (isTRUE(show_coinertia_x_arrows)) {
             arrow_parts <- c(arrow_parts, list(data.frame(
               x = as.numeric(x_weights[, 1]),
               y = if (ncol(x_weights) >= 2) as.numeric(x_weights[, 2]) else rep(0, nrow(x_weights)),
               Label = x_vars_used,
               Block = "Block X",
               stringsAsFactors = FALSE
             )))
           }
           if (isTRUE(show_coinertia_y_arrows)) {
             arrow_parts <- c(arrow_parts, list(data.frame(
               x = as.numeric(y_weights[, 1]),
               y = if (ncol(y_weights) >= 2) as.numeric(y_weights[, 2]) else rep(0, nrow(y_weights)),
               Label = y_vars_used,
               Block = "Block Y",
               stringsAsFactors = FALSE
             )))
           }
           if (length(arrow_parts) > 0) {
             arrow_df <- do.call(rbind, arrow_parts)
             point_span_x <- max(abs(c(co_plot_df$X1, co_plot_df$Y1, co_plot_df$C1)), na.rm = TRUE)
             point_span_y <- max(abs(c(co_plot_df$X2, co_plot_df$Y2, co_plot_df$C2)), na.rm = TRUE)
             arrow_span_x <- max(abs(arrow_df$x), na.rm = TRUE)
             arrow_span_y <- max(abs(arrow_df$y), na.rm = TRUE)
             scale_x <- if (is.finite(point_span_x) && is.finite(arrow_span_x) && arrow_span_x > 0) point_span_x / arrow_span_x else Inf
             scale_y <- if (is.finite(point_span_y) && is.finite(arrow_span_y) && arrow_span_y > 0) point_span_y / arrow_span_y else Inf
             arrow_scale <- min(scale_x, scale_y) * 0.55
             if (!is.finite(arrow_scale) || arrow_scale <= 0) arrow_scale <- 1
             arrow_df$x <- arrow_df$x * arrow_scale
             arrow_df$y <- arrow_df$y * arrow_scale

             if (isTRUE(show_coinertia_publication_legend)) {
               p_coinertia <- p_coinertia +
                 geom_segment(
                   data = arrow_df,
                   aes(x = 0, y = 0, xend = x, yend = y, color = "Loadings"),
                   arrow = arrow(length = grid::unit(arrow_head_size, "cm")),
                   linewidth = arrow_linewidth,
                   alpha = 0.85,
                   show.legend = isTRUE(show_coinertia_legend) && isTRUE(show_coinertia_arrow_legend)
                 )
             } else if (isTRUE(show_coinertia_arrow_legend)) {
               p_coinertia <- p_coinertia +
                 geom_segment(
                   data = arrow_df,
                   aes(x = 0, y = 0, xend = x, yend = y, linetype = "Loadings"),
                   color = palette_active[["Loadings"]],
                   arrow = arrow(length = grid::unit(arrow_head_size, "cm")),
                   linewidth = arrow_linewidth,
                   alpha = 0.85,
                   show.legend = isTRUE(show_coinertia_legend)
                 )
             } else {
               p_coinertia <- p_coinertia +
                 geom_segment(
                   data = arrow_df,
                   aes(x = 0, y = 0, xend = x, yend = y),
                   color = palette_active[["Loadings"]],
                   arrow = arrow(length = grid::unit(arrow_head_size, "cm")),
                   linewidth = arrow_linewidth,
                   alpha = 0.85,
                   show.legend = FALSE
                 )
             }
           }
         }

         xy_parts <- list()
         if (isTRUE(show_coinertia_block_x)) {
           xy_parts <- c(xy_parts, list(data.frame(Dim1 = co_plot_df$X1, Dim2 = co_plot_df$X2, Type = "Block X", stringsAsFactors = FALSE)))
         }
         if (isTRUE(show_coinertia_block_y)) {
           xy_parts <- c(xy_parts, list(data.frame(Dim1 = co_plot_df$Y1, Dim2 = co_plot_df$Y2, Type = "Block Y", stringsAsFactors = FALSE)))
         }
         if (length(xy_parts) > 0) {
           xy_points_df <- do.call(rbind, xy_parts)
           if (isTRUE(show_coinertia_shapes)) {
             p_coinertia <- p_coinertia +
               geom_point(
                 data = xy_points_df,
                 aes(x = Dim1, y = Dim2, color = Type, shape = Type),
                 alpha = block_point_alpha,
                 size = block_point_size,
                 stroke = 0.9,
                 show.legend = isTRUE(show_coinertia_legend)
               )
           } else {
             p_coinertia <- p_coinertia +
               geom_point(
                 data = xy_points_df,
                 aes(x = Dim1, y = Dim2, color = Type),
                 alpha = block_point_alpha,
                 size = block_point_size,
                 shape = 16,
                 show.legend = isTRUE(show_coinertia_legend)
               )
           }
         }

         if (isTRUE(show_coinertia_compromise)) {
            if (isTRUE(show_coinertia_shapes)) {
              p_coinertia <- p_coinertia +
                geom_point(
                  data = co_plot_df,
                  aes(x = C1, y = C2, color = "Compromise", shape = "Compromise"),
                  size = compromise_point_size,
                  alpha = compromise_alpha,
                  show.legend = isTRUE(show_coinertia_legend)
                )
            } else {
              p_coinertia <- p_coinertia +
                geom_point(
                  data = co_plot_df,
                  aes(x = C1, y = C2, color = "Compromise"),
                  size = compromise_point_size,
                  alpha = compromise_alpha,
                  shape = 16,
                  show.legend = isTRUE(show_coinertia_legend)
                )
            }
         }
         if (!is.null(arrow_df) && isTRUE(show_coinertia_arrow_labels)) {
           label_df <- arrow_df
           label_df$label_x <- label_df$x * arrow_label_factor + coinertia_arrow_label_nudge_x
           label_df$label_y <- label_df$y * arrow_label_factor + coinertia_arrow_label_nudge_y
           use_repel <- isTRUE(show_coinertia_publication_theme) && requireNamespace("ggrepel", quietly = TRUE)
           if (isTRUE(show_coinertia_publication_legend)) {
             if (isTRUE(use_repel)) {
               p_coinertia <- p_coinertia +
                 ggrepel::geom_text_repel(
                   data = label_df,
                   aes(x = label_x, y = label_y, label = Label, color = "Loadings"),
                   size = arrow_label_size,
                   alpha = 0.9,
                   fontface = "bold",
                   box.padding = 0.15,
                   point.padding = 0.15,
                   max.overlaps = Inf,
                   show.legend = FALSE
                 )
             } else {
               p_coinertia <- p_coinertia +
                 geom_text(
                   data = label_df,
                   aes(x = label_x, y = label_y, label = Label, color = "Loadings"),
                   size = arrow_label_size,
                   alpha = 0.9,
                   fontface = "bold",
                   show.legend = FALSE,
                   check_overlap = isTRUE(show_coinertia_arrow_emphasis) || isTRUE(show_coinertia_publication_theme)
                 )
             }
           } else {
             if (isTRUE(use_repel)) {
               p_coinertia <- p_coinertia +
                 ggrepel::geom_text_repel(
                   data = label_df,
                   aes(x = label_x, y = label_y, label = Label),
                   color = palette_active[["Loadings"]],
                   size = arrow_label_size,
                   alpha = 0.9,
                   fontface = "bold",
                   box.padding = 0.15,
                   point.padding = 0.15,
                   max.overlaps = Inf,
                   show.legend = FALSE
                 )
             } else {
               p_coinertia <- p_coinertia +
                 geom_text(
                   data = label_df,
                   aes(x = label_x, y = label_y, label = Label),
                   color = palette_active[["Loadings"]],
                   size = arrow_label_size,
                   alpha = 0.9,
                   fontface = "bold",
                   show.legend = FALSE,
                   check_overlap = isTRUE(show_coinertia_arrow_emphasis) || isTRUE(show_coinertia_publication_theme)
                 )
             }
           }
         }
         if (isTRUE(show_coinertia_labels) && isTRUE(show_coinertia_compromise)) {
           if (isTRUE(show_coinertia_label_reduction)) {
             max_labels <- min(12, nrow(co_plot_df))
             label_radius <- sqrt(co_plot_df$C1^2 + co_plot_df$C2^2)
             idx_pick <- order(label_radius, decreasing = TRUE)[seq_len(max_labels)]
             label_df <- co_plot_df[idx_pick, , drop = FALSE]
           } else {
             label_df <- co_plot_df
           }
           label_size <- if (isTRUE(show_coinertia_publication_theme)) 2.3 else 2.6
           use_repel <- isTRUE(show_coinertia_publication_theme) && requireNamespace("ggrepel", quietly = TRUE)
           if (isTRUE(use_repel)) {
             p_coinertia <- p_coinertia +
               ggrepel::geom_text_repel(
                 data = label_df,
                 aes(x = C1 + coinertia_point_label_nudge_x, y = C2 + coinertia_point_label_nudge_y, label = Observation, color = "Compromise"),
                 size = label_size,
                 alpha = 0.8,
                 box.padding = 0.2,
                 point.padding = 0.15,
                 max.overlaps = Inf,
                 show.legend = FALSE
               )
           } else {
             p_coinertia <- p_coinertia +
               geom_text(
                 data = label_df,
                 aes(x = C1 + coinertia_point_label_nudge_x, y = C2 + coinertia_point_label_nudge_y, label = Observation, color = "Compromise"),
                 vjust = -0.8,
                 size = label_size,
                 alpha = 0.8,
                 show.legend = FALSE,
                 check_overlap = isTRUE(show_coinertia_label_reduction)
               )
           }
         }

         rv_value <- NA_real_
         rv_p_value <- NA_real_
         rv_perm_n <- NA_integer_
         tryCatch({
           sxx <- crossprod(x_scaled) / max(1, (n_obs - 1))
           syy <- crossprod(y_scaled) / max(1, (n_obs - 1))
           rv_num <- sum(cross_cov^2)
           rv_den <- sqrt(sum(sxx^2) * sum(syy^2))
           if (is.finite(rv_den) && rv_den > 0) rv_value <- rv_num / rv_den
           if (isTRUE(show_coinertia_permutation)) {
             rv_perm_n <- 199L
             rv_perm_vals <- numeric(rv_perm_n)
             for (i in seq_len(rv_perm_n)) {
               perm_idx <- sample.int(n_obs)
               y_perm <- y_scaled[perm_idx, , drop = FALSE]
               cross_perm <- crossprod(x_scaled, y_perm) / max(1, (n_obs - 1))
               rv_perm_vals[i] <- sum(cross_perm^2) / rv_den
             }
             rv_p_value <- (1 + sum(rv_perm_vals >= rv_value, na.rm = TRUE)) / (1 + rv_perm_n)
           }
         }, error = function(e) {
           rv_value <<- NA_real_
           rv_p_value <<- NA_real_
           rv_perm_n <<- NA_integer_
         })
         result_list$coinertia_rv_coefficient <- if (is.finite(rv_value)) as.numeric(rv_value) else NA_real_
         result_list$coinertia_rv_p_value <- if (is.finite(rv_p_value)) as.numeric(rv_p_value) else NA_real_
         result_list$coinertia_rv_perm_n <- if (is.finite(rv_perm_n)) as.numeric(rv_perm_n) else NA_real_

         if (isTRUE(show_coinertia_stats)) {
           stat_bits <- character(0)
           if (is.finite(result_list$coinertia_total_covariance)) {
             stat_bits <- c(stat_bits, paste0("Total co-inertia: ", round(result_list$coinertia_total_covariance, 4)))
           }
           if (is.finite(rv_value)) {
             stat_bits <- c(stat_bits, paste0("RV = ", round(rv_value, 4)))
           }
           if (is.finite(rv_p_value)) {
             stat_bits <- c(stat_bits, paste0("p = ", format(rv_p_value, digits = 3)))
             if (is.finite(rv_perm_n)) {
               stat_bits <- c(stat_bits, paste0("perm = ", rv_perm_n))
             }
           }
           if (length(stat_bits) > 0) subtitle_parts <- c(subtitle_parts, paste(stat_bits, collapse = " | "))
         }

         has_loadings <- isTRUE(show_coinertia_x_arrows) || isTRUE(show_coinertia_y_arrows)
         pub_legend_labels <- c(
           "Block X" = "Block X (filled blue circles)",
           "Block Y" = "Block Y (open orange circles)",
           "Compromise" = "Compromise (black squares)",
           "Pairing" = "Links between paired observations",
           "Loadings" = "Variable loadings (arrows)"
         )
         std_legend_labels <- c(
           "Block X" = "Block X",
           "Block Y" = "Block Y",
           "Compromise" = "Compromise"
         )

         pub_breaks <- character(0)
         if (isTRUE(show_coinertia_block_x)) pub_breaks <- c(pub_breaks, "Block X")
         if (isTRUE(show_coinertia_block_y)) pub_breaks <- c(pub_breaks, "Block Y")
         if (isTRUE(show_coinertia_compromise)) pub_breaks <- c(pub_breaks, "Compromise")
         if (isTRUE(show_coinertia_links)) pub_breaks <- c(pub_breaks, "Pairing")
         if (isTRUE(has_loadings) && isTRUE(show_coinertia_arrow_legend)) pub_breaks <- c(pub_breaks, "Loadings")

        p_coinertia <- p_coinertia +
          labs(
            title = "Co-Inertia Analysis",
            subtitle = paste(subtitle_parts, collapse = " | "),
            x = x_axis_label,
            y = y_axis_label
          ) +
          theme_minimal(base_size = if (isTRUE(show_coinertia_publication_theme)) 11 else 12)

         export_width <- if (isTRUE(show_coinertia_full_size)) 12 else 10
         export_height <- 8

         if (isTRUE(show_coinertia_publication_legend)) {
           p_coinertia <- p_coinertia +
             scale_color_manual(
               values = palette_active,
               breaks = pub_breaks,
               labels = pub_legend_labels[pub_breaks],
               name = "Legend"
             )
           if (isTRUE(show_coinertia_shapes)) {
             p_coinertia <- p_coinertia +
               scale_shape_manual(
                 values = c("Block X" = 16, "Block Y" = 1, "Compromise" = 15),
                 breaks = c("Block X", "Block Y", "Compromise"),
                 guide = "none"
               )
           }
           if (isTRUE(show_coinertia_legend) && length(pub_breaks) > 0) {
             legend_override <- list(
               size = c("Block X" = block_point_size, "Block Y" = block_point_size, "Compromise" = compromise_point_size, "Pairing" = 0.7, "Loadings" = 0.8),
               alpha = c("Block X" = 0.9, "Block Y" = 0.9, "Compromise" = 0.95, "Pairing" = link_alpha, "Loadings" = 0.85),
               shape = c("Block X" = 16, "Block Y" = 1, "Compromise" = 15, "Pairing" = NA, "Loadings" = NA),
               linetype = c("Block X" = "blank", "Block Y" = "blank", "Compromise" = "blank", "Pairing" = "solid", "Loadings" = "solid")
             )
             p_coinertia <- p_coinertia +
               guides(color = guide_legend(override.aes = list(
                 size = unname(legend_override$size[pub_breaks]),
                 alpha = unname(legend_override$alpha[pub_breaks]),
                 shape = unname(legend_override$shape[pub_breaks]),
                 linetype = unname(legend_override$linetype[pub_breaks])
               )))
           }
         } else {
           dataset_breaks <- character(0)
           if (isTRUE(show_coinertia_block_x)) dataset_breaks <- c(dataset_breaks, "Block X")
           if (isTRUE(show_coinertia_block_y)) dataset_breaks <- c(dataset_breaks, "Block Y")
           if (isTRUE(show_coinertia_compromise)) dataset_breaks <- c(dataset_breaks, "Compromise")
           p_coinertia <- p_coinertia +
             scale_color_manual(
               values = palette_active,
               breaks = dataset_breaks,
               labels = std_legend_labels[dataset_breaks],
               name = "Dataset"
             )
           if (isTRUE(show_coinertia_shapes)) {
             p_coinertia <- p_coinertia +
               scale_shape_manual(
                 values = c("Block X" = 16, "Block Y" = 1, "Compromise" = 15),
                 breaks = dataset_breaks,
                 labels = std_legend_labels[dataset_breaks],
                 name = "Symbol"
               )
           }
           linetype_breaks <- character(0)
           if (isTRUE(show_coinertia_links)) linetype_breaks <- c(linetype_breaks, "Pairing")
           if (isTRUE(has_loadings) && isTRUE(show_coinertia_arrow_legend)) linetype_breaks <- c(linetype_breaks, "Loadings")
           if (length(linetype_breaks) > 0) {
             p_coinertia <- p_coinertia +
               scale_linetype_manual(
                 values = setNames(rep("solid", length(linetype_breaks)), linetype_breaks),
                 breaks = linetype_breaks,
                 name = "Links"
               )
           }
           if (isTRUE(show_coinertia_legend) && length(linetype_breaks) > 0) {
             linetype_colors <- palette_active[linetype_breaks]
             p_coinertia <- p_coinertia +
               guides(linetype = guide_legend(override.aes = list(color = unname(linetype_colors))))
           }
         }
         if (isTRUE(show_coinertia_equal_scaling)) {
           p_coinertia <- p_coinertia + coord_equal()
         }

         if (isTRUE(show_coinertia_publication_legend)) {
           p_coinertia <- p_coinertia +
             theme(
               legend.position = "right",
               legend.box = "vertical",
               legend.title = element_text(size = legend_title_size, face = "bold"),
               legend.text = element_text(size = legend_text_size),
               legend.key.height = grid::unit(0.5, "cm"),
               legend.key.width = grid::unit(0.9, "cm")
             )
         }
         if (isTRUE(show_coinertia_publication_theme)) {
           p_coinertia <- p_coinertia +
             theme(
               panel.grid.major = element_line(color = grid_major_color, linewidth = 0.35),
               panel.grid.minor = element_blank(),
               axis.line = element_line(color = "#1f2937", linewidth = 0.4),
               axis.ticks = element_line(color = "#1f2937", linewidth = 0.35),
               axis.text = element_text(color = "#111827", size = 9.5),
               axis.title = element_text(size = 10.5),
               plot.title = element_text(size = 12, face = "bold", hjust = 0.5),
               plot.subtitle = element_text(size = subtitle_size, color = "#374151"),
               plot.margin = margin(8, 14, 8, 8, unit = "pt")
             )
         }
         if (!isTRUE(show_coinertia_legend)) {
           p_coinertia <- p_coinertia + theme(legend.position = "none")
         }

         custom_ggsave(output_image, plot = p_coinertia, plot_key = "analysis_plot", width = export_width, height = export_height, dpi = 300)
         result_list$plot_path <- output_image
         result_list$plot_generated <- TRUE
         if (isTRUE(show_coinertia_vector_export) && grepl("\\.png$", output_image, ignore.case = TRUE)) {
           vector_path <- sub("\\.png$", ".pdf", output_image, ignore.case = TRUE)
           tryCatch({
             custom_ggsave(vector_path, plot = p_coinertia, plot_key = "analysis_plot", width = export_width, height = export_height, device = "pdf")
             result_list$plot_path_vector <- vector_path
           }, error = function(e) {
             result_list$plot_vector_error <- e$message
           })
         }
       }, error = function(e) {
         result_list$plot_error <- e$message
       })

    } else if (base_analysis_mode == "multivariate_bca") {
       # BCA (Between-Class Analysis): supervised projection maximizing between-class structure.
       if (is.null(grouping_var_name) || !(grouping_var_name %in% names(data_subset))) {
         cat(toJSON(list(error = "BCA requires a valid class variable (select it in the Variable field)."), auto_unbox = TRUE))
         quit(save = "no")
       }

       grouping_col <- droplevels(as.factor(data_subset[[grouping_var_name]]))
       if (nlevels(grouping_col) < 2) {
         cat(toJSON(list(error = "BCA requires at least 2 class levels."), auto_unbox = TRUE))
         quit(save = "no")
       }

       x_scaled <- scale(num_data, center = TRUE, scale = TRUE)
       x_scaled <- as.matrix(x_scaled)
       global_center <- colMeans(x_scaled)

       grp_levels <- levels(grouping_col)
       grp_sizes <- as.numeric(table(grouping_col)[grp_levels])
       grp_weights <- grp_sizes / sum(grp_sizes)

       grp_means <- do.call(rbind, lapply(grp_levels, function(g) {
         colMeans(x_scaled[grouping_col == g, , drop = FALSE])
       }))
       rownames(grp_means) <- grp_levels

       centered_means <- sweep(grp_means, 2, global_center, FUN = "-")
       weighted_means <- centered_means * sqrt(grp_weights)
       between_cov <- t(weighted_means) %*% weighted_means

       eig <- eigen(between_cov)
       eig_vals <- as.numeric(Re(eig$values))
       eig_vals[eig_vals < 0] <- 0
       keep_idx <- which(is.finite(eig_vals) & eig_vals > .Machine$double.eps)
       if (length(keep_idx) == 0) {
         cat(toJSON(list(error = "BCA failed: no positive between-class dimensions found."), auto_unbox = TRUE))
         quit(save = "no")
       }

       eig_vals <- eig_vals[keep_idx]
       axes <- Re(eig$vectors[, keep_idx, drop = FALSE])
       bca_scores <- sweep(x_scaled, 2, global_center, FUN = "-") %*% axes

       axis2_vals <- if (ncol(bca_scores) >= 2) bca_scores[, 2] else rep(0, nrow(bca_scores))
       score_df <- data.frame(
         BCA1 = as.numeric(bca_scores[, 1]),
         BCA2 = as.numeric(axis2_vals),
         Group = grouping_col,
         stringsAsFactors = FALSE
       )
       centroid_df <- stats::aggregate(cbind(BCA1, BCA2) ~ Group, data = score_df, FUN = mean)

       variance_pct <- round((eig_vals / sum(eig_vals)) * 100, 2)
       cum_variance <- cumsum(variance_pct)
       dim_labels <- paste0("BCA", seq_along(eig_vals))

       total_inertia <- suppressWarnings(sum(apply(x_scaled, 2, stats::var, na.rm = TRUE)))
       between_inertia <- sum(eig_vals)
       between_ratio <- if (is.finite(total_inertia) && total_inertia > 0) between_inertia / total_inertia else NA_real_

       result_list$grouping_variable <- grouping_var_name
       result_list$between_inertia_ratio <- as.numeric(between_ratio)
       result_list$eigenvalues <- data.frame(
         PC = dim_labels,
         Eigenvalue = round(eig_vals, 4),
         Variance_Percent = variance_pct,
         Cumulative_Percent = cum_variance
       )
       result_list$bca_group_summary <- data.frame(
         Group = grp_levels,
         N = as.numeric(grp_sizes),
         Proportion = as.numeric(grp_weights)
       )

       # BCA scree plot
       scree_path <- gsub("\\.png$", "_scree.png", output_image)
       tryCatch({
          label_cfg <- resolve_base_label_config(
            "scree_plot",
            default_title = "BCA Eigenvalues (Between-Class Axes)",
            default_x = "BCA Axis",
            default_y = "Percentage of Between-Class Inertia"
          )
          png(scree_path, width = 800, height = 600)
          barplot(variance_pct[1:min(10, length(variance_pct))],
                  main = "",
                  xlab = "", ylab = "",
                  col = "steelblue", border = "white", ylim = c(0, max(variance_pct) * 1.1))
          lines(x = 1:min(10, length(variance_pct)), y = variance_pct[1:min(10, length(variance_pct))], type = "b", pch = 19, col = "red")
          render_base_label_config(label_cfg, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
          dev.off()
          result_list$scree_plot_path <- scree_path
       }, error = function(e) {
          result_list$scree_plot_error <- e$message
       })

       # BCA projection plot
       bca_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("analysis_plot"))
       bca_label_nudge_x <- resolve_plot_element_numeric(bca_plot_labels_cfg, "point_label_nudge_x", 0, -2, 2)
       bca_label_nudge_y <- resolve_plot_element_numeric(bca_plot_labels_cfg, "point_label_nudge_y", 0, -2, 2)
       tryCatch({
         library(ggplot2)
         group_cols <- pick_cols(nlevels(as.factor(score_df$Group)))
         x_axis_label <- paste0("BCA1 (", variance_pct[1], "%)")
         y_axis_label <- if (length(variance_pct) >= 2) paste0("BCA2 (", variance_pct[2], "%)") else "BCA2 (0%)"

         show_ellipse <- FALSE
         group_sizes_table <- table(score_df$Group)
         if (length(group_sizes_table) <= 12 && all(group_sizes_table >= 3)) {
           show_ellipse <- TRUE
         }

         p_bca <- ggplot(score_df, aes(x = BCA1, y = BCA2, color = Group, fill = Group)) +
           geom_hline(yintercept = 0, linetype = "dashed", color = "#94a3b8", linewidth = 0.4) +
           geom_vline(xintercept = 0, linetype = "dashed", color = "#94a3b8", linewidth = 0.4) +
           geom_point(alpha = 0.78, size = 2.2) +
           scale_color_manual(values = group_cols) +
           scale_fill_manual(values = group_cols) +
           labs(
             title = paste0("Between-Class Analysis (", grouping_var_name, ")"),
             subtitle = if (is.finite(between_ratio)) paste0("Between-class inertia ratio: ", round(between_ratio, 4)) else NULL,
             x = x_axis_label,
             y = y_axis_label
           ) +
           theme_minimal()

         if (isTRUE(show_ellipse)) {
           p_bca <- p_bca + stat_ellipse(geom = "polygon", alpha = 0.12, linewidth = 0.4)
         }

         p_bca <- p_bca +
           geom_point(data = centroid_df, aes(x = BCA1, y = BCA2, fill = Group), inherit.aes = FALSE, shape = 21, size = 4.0, stroke = 0.45, color = "#0f172a") +
           geom_text(data = centroid_df, aes(x = BCA1 + bca_label_nudge_x, y = BCA2 + bca_label_nudge_y, label = Group), inherit.aes = FALSE, vjust = -1.0, size = 3.1, fontface = "bold", color = "#0f172a")

         custom_ggsave(output_image, plot = p_bca, plot_key = "analysis_plot", width = 10, height = 8, dpi = 300)
         result_list$plot_path <- output_image
         result_list$plot_generated <- TRUE
       }, error = function(e) {
         result_list$plot_error <- e$message
       })

    } else if (base_analysis_mode == "multivariate_kmeans" || base_analysis_mode == "multivariate_clustering") {
       # K-Means
       # response_var holds "k=3" or just "3". Default to 3.
       k_centers <- 3
       num_val <- suppressWarnings(as.numeric(response_var))
       if (!is.na(num_val) && num_val > 1) {
          k_centers <- floor(num_val)
       }
       requested_k <- k_centers
       if (identical(base_analysis_mode, "multivariate_clustering")) {
         result_list$clustering_method <- "kmeans"
       }
       cluster_data <- zscore_matrix_safe(num_data)
       result_list$clustering_scaled <- TRUE
       
       # Optimal k (Elbow & Silhouette Methods)
       max_k <- min(10, nrow(cluster_data) - 1)
       if (!is.finite(max_k) || max_k < 2) {
         cat(toJSON(list(error = "Clustering requires at least 3 complete rows."), auto_unbox = TRUE))
         quit(save = "no")
       }
       k_seq <- seq_len(max_k)
       wss <- rep(NA_real_, max_k)
       avg_sil_width <- rep(NA_real_, max_k) # Index 1 is not used by silhouette
       result_list$max_k_considered <- as.numeric(max_k)
       
       # WSS for k=1
       wss[1] <- sum(kmeans(cluster_data, centers = 1, nstart = 10)$withinss)
       
       # Calculate WSS and Silhouette for k=2..max_k
       best_k <- 2
       max_sil <- -Inf
       
       for (i in 2:max_k) {
         km <- kmeans(cluster_data, centers = i, nstart = 10)
         wss[i] <- sum(km$withinss)
         
         # Silhouette
         tryCatch({
           ss <- silhouette(km$cluster, dist(cluster_data))
           avg_sil <- mean(ss[, 3])
           avg_sil_width[i] <- avg_sil
           
           if (avg_sil > max_sil) {
             max_sil <- avg_sil
             best_k <- i
           }
         }, error = function(e) {
           avg_sil_width[i] <<- 0 # Fallback
         })
       }
       
       # Derive elbow (knee) and combine both methods for final K decision
       elbow_k_raw <- compute_elbow_k(k_seq, wss)
       elbow_k <- if (is.finite(elbow_k_raw) && as.integer(elbow_k_raw) >= 2L) as.integer(elbow_k_raw) else NA_integer_
       k_choice <- choose_k_from_elbow_silhouette(
         elbow_k = elbow_k,
         silhouette_values = avg_sil_width,
         k_values = k_seq,
         method = cluster_optimization_method
       )

       k_centers <- as.integer(k_choice$k)
       if (!is.finite(k_centers) || k_centers < 2) {
         k_centers <- as.integer(best_k)
       }

       result_list$optimal_k <- as.integer(k_centers)
       result_list$cluster_optimization_method <- cluster_optimization_method
       result_list$requested_k <- requested_k
       result_list$elbow_k <- elbow_k
       result_list$k_decision_method <- k_choice$rule
       result_list$k_decision_score <- if (is.finite(k_choice$decision_score)) as.numeric(k_choice$decision_score) else NA_real_
       result_list$silhouette_k <- if (is.finite(k_choice$silhouette_k)) as.integer(k_choice$silhouette_k) else NA_integer_
       result_list$optimization_data <- list(
         k_values = k_seq,
         wss = wss,
         silhouette = avg_sil_width
       )
       
       elbow_path <- gsub("\\.png$", "_elbow.png", output_image)
       tryCatch({
          label_cfg <- resolve_base_label_config(
            "elbow_plot",
            default_title = "Elbow Method",
            default_x = "Number of Clusters K",
            default_y = "Total WSS"
          )
          png(elbow_path, width = 600, height = 400)
          # Elbow Plot
          plot(k_seq, wss, type = "b", pch = 19, frame = FALSE, 
               xlab = "", ylab = "",
               main = "", col = palette_main)
          render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
          dev.off()
          result_list$elbow_plot_path <- elbow_path
       }, error = function(e) {
          result_list$elbow_plot_error <<- e$message
       })

       silhouette_trend_path <- gsub("\\.png$", "_silhouette_trend.png", output_image)
       tryCatch({
          label_cfg <- resolve_base_label_config(
            "silhouette_trend_plot",
            default_title = "Silhouette Method",
            default_x = "Number of Clusters K",
            default_y = "Avg Silhouette Width"
          )
          png(silhouette_trend_path, width = 600, height = 400)
          # Silhouette Trend Plot
          if (max_k >= 2) {
            plot(2:max_k, avg_sil_width[2:max_k], type = "b", pch = 19, frame = FALSE,
                 xlab = "", ylab = "",
                 main = "", col = palette_accent)
            if (is.finite(max_sil) && max_sil > -Inf) {
              points(best_k, max_sil, col = palette_main, pch = 19, cex = 1.5) # Highlight optimal
            }
          } else {
            plot.new()
            text(0.5, 0.5, "Silhouette trend unavailable (need at least k=2).")
          }
          render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
          dev.off()
          result_list$silhouette_trend_plot_path <- silhouette_trend_path
       }, error = function(e) {
          result_list$silhouette_trend_plot_error <<- e$message
       })
       
       # Run Final K-Means with Optimal K
       set.seed(123)
       km_res <- kmeans(cluster_data, centers = k_centers, nstart = 25)
       
       result_list$k <- k_centers
       result_list$tot_withinss <- km_res$tot.withinss
       result_list$betweenss <- km_res$betweenss
       result_list$withinss <- as.list(km_res$withinss)
       result_list$cluster_centers <- as.data.frame(km_res$centers)
       result_list$cluster_sizes <- as.list(km_res$size)
       
       # Silhouette Analysis
       if (k_centers > 1) {
          tryCatch({
             sil <- silhouette(km_res$cluster, dist(cluster_data))
             
             sil_path <- gsub("\\.png$", "_silhouette.png", output_image)
             label_cfg <- resolve_base_label_config(
               "silhouette_plot",
               default_title = paste("Silhouette Plot (k =", k_centers, ")"),
               default_x = "",
               default_y = ""
             )
             png(sil_path, width = 600, height = 400)
             plot(sil, main = "", col = palette_main, border = NA)
             render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
             dev.off()
             
             result_list$silhouette_plot_path <- sil_path
             result_list$avg_silhouette_width <- mean(sil[, 3])
             result_list$silhouette_table <- build_silhouette_table_payload(
               sil,
               observation_ids = rownames(cluster_data),
               cluster_label_map = setNames(paste0("Cluster ", seq_len(k_centers)), as.character(seq_len(k_centers))),
               scope = "full_rows"
             )
          }, error = function(e) {
             result_list$silhouette_error <- e$message
          })
       }
       
       # Visualising Clusters using PCA
       cluster_plot_path <- output_image
       tryCatch({
         pca_vis <- prcomp(cluster_data, center = FALSE, scale. = FALSE)
         pc_data <- data.frame(pca_vis$x[, 1:2])
          pc_data$Cluster <- as.factor(km_res$cluster)
          
          library(ggplot2)
          cluster_cols <- pick_cols(nlevels(pc_data$Cluster))
          p <- ggplot(pc_data, aes(x = PC1, y = PC2, color = Cluster, fill = Cluster)) +
               geom_point(alpha = 0.7, size = 2) +
               stat_ellipse(geom = "polygon", alpha = 0.2) +
               labs(title = paste("K-Means Clustering (k =", k_centers, ")"), 
                    subtitle = "Projected on First 2 Principal Components") +
               scale_color_manual(values = cluster_cols) +
               scale_fill_manual(values = cluster_cols) +
               theme_minimal()
          
          custom_ggsave(cluster_plot_path, plot = p, plot_key = "analysis_plot", width = 10, height = 8, dpi = 300)
          result_list$plot_path <- cluster_plot_path
          result_list$plot_generated <- TRUE
       }, error = function(e) {
          result_list$plot_error <- e$message
       })

    } else if (base_analysis_mode == "multivariate_hclust") {
       # Hierarchical clustering:
       # - Fit clustering using numeric predictors only.
       # - Use categorical predictors as annotations in outputs (biplot/assignments/heatmap labels).
       predictor_names_hc <- colnames(predictor_data)
       numeric_mask_hc <- vapply(predictor_data, is.numeric, logical(1))
       numeric_predictors_hc <- predictor_names_hc[numeric_mask_hc]
       categorical_predictors_hc <- predictor_names_hc[!numeric_mask_hc]

       if (length(numeric_predictors_hc) < 2) {
         cat(toJSON(list(error = "Hierarchical clustering requires at least 2 numeric predictor variables."), auto_unbox = TRUE))
         quit(save = "no")
       }

       cluster_data_hc_raw <- predictor_data[, numeric_predictors_hc, drop = FALSE]
       complete_numeric_rows <- stats::complete.cases(cluster_data_hc_raw)
       if (!all(complete_numeric_rows)) {
         cluster_data_hc_raw <- cluster_data_hc_raw[complete_numeric_rows, , drop = FALSE]
         data_subset_hc <- data_subset[complete_numeric_rows, , drop = FALSE]
       } else {
         data_subset_hc <- data_subset
       }
       if (nrow(cluster_data_hc_raw) < 3) {
         cat(toJSON(list(error = "Hierarchical clustering needs at least 3 complete rows across selected numeric predictors."), auto_unbox = TRUE))
         quit(save = "no")
       }

       cluster_data_hc <- zscore_matrix_safe(cluster_data_hc_raw)
       result_list$hclust_scaled <- TRUE
       result_list$hclust_scale <- "zscore"
       result_list$hclust_feature_count <- as.numeric(ncol(cluster_data_hc))
       result_list$hclust_features_used <- colnames(cluster_data_hc)
       result_list$hclust_numeric_predictors <- numeric_predictors_hc
       if (length(categorical_predictors_hc) > 0) {
         result_list$hclust_categorical_predictors <- categorical_predictors_hc
       }
       result_list$hclust_linkage_method_requested <- hclust_linkage_method
       result_list$hclust_linkage_method_label <- hclust_linkage_method_label(hclust_linkage_method)
       result_list$distance <- "euclidean"
       result_list$method <- hclust_linkage_method

       d <- stats::dist(cluster_data_hc, method = result_list$distance)
       hc <- stats::hclust(d, method = result_list$method)
       n_obs_hc <- nrow(cluster_data_hc)
       max_k_hc <- as.integer(min(10L, n_obs_hc - 1L))
       manual_k_override_hc <- resolve_manual_k_override(
         enabled = manual_cluster_k_enabled,
         requested_k = manual_cluster_k_requested,
         max_allowed_k = max_k_hc
       )
       if (isTRUE(manual_k_override_hc$enabled)) {
         result_list$manual_cluster_k_enabled <- TRUE
         result_list$manual_cluster_k_requested <- as.integer(manual_k_override_hc$requested_k)
         result_list$manual_cluster_k_used <- as.integer(manual_k_override_hc$used_k)
         if (!is.null(manual_k_override_hc$warning) && nzchar(manual_k_override_hc$warning)) {
           result_list$manual_cluster_k_warning <- manual_k_override_hc$warning
         }
       }

       sil_values_hc <- if (isTRUE(manual_k_override_hc$enabled)) rep(NA_real_, max_k_hc) else rep(NA_real_, max_k_hc)
       if (!isTRUE(manual_k_override_hc$enabled) && max_k_hc >= 2) {
         for (k_try in 2:max_k_hc) {
           cl_try <- tryCatch(stats::cutree(hc, k = k_try), error = function(e) NULL)
           if (is.null(cl_try)) next
           sil_avg_try <- tryCatch({
             sil_obj_try <- cluster::silhouette(cl_try, d)
             mean(sil_obj_try[, 3], na.rm = TRUE)
           }, error = function(e) NA_real_)
           if (is.finite(sil_avg_try)) sil_values_hc[k_try] <- sil_avg_try
         }
       }

       valid_k_hc <- which(is.finite(sil_values_hc) & seq_along(sil_values_hc) >= 2)
       optimal_k_hc <- if (isTRUE(manual_k_override_hc$enabled)) {
         as.integer(manual_k_override_hc$used_k)
       } else if (length(valid_k_hc) > 0) {
         valid_k_hc[which.max(sil_values_hc[valid_k_hc])]
       } else {
         max(2L, min(3L, n_obs_hc - 1L))
       }
       optimal_k_hc <- as.integer(max(2L, min(optimal_k_hc, n_obs_hc - 1L)))
       cluster_assign_opt <- as.integer(stats::cutree(hc, k = optimal_k_hc))
       cluster_levels_opt <- sort(unique(cluster_assign_opt))
       cluster_factor_opt <- factor(
         paste0("Cluster ", cluster_assign_opt),
         levels = paste0("Cluster ", cluster_levels_opt)
       )

       cophenetic_corr_hc <- tryCatch({
         as.numeric(stats::cor(as.vector(d), as.vector(stats::cophenetic(hc))))
       }, error = function(e) NA_real_)

       avg_silhouette_hc <- if (optimal_k_hc >= 2 && optimal_k_hc <= length(sil_values_hc) && is.finite(sil_values_hc[optimal_k_hc])) {
         as.numeric(sil_values_hc[optimal_k_hc])
       } else {
         NA_real_
       }

       result_list$cluster_optimization_method <- if (isTRUE(manual_k_override_hc$enabled)) "manual_k" else "silhouette"
       if (!isTRUE(manual_k_override_hc$enabled)) {
         result_list$optimization_data <- list(
           k_values = seq_len(max_k_hc),
           wss = rep(NA_real_, max_k_hc),
           silhouette = sil_values_hc
         )
       }
       result_list$k <- as.integer(optimal_k_hc)
       result_list$optimal_k <- as.integer(optimal_k_hc)
       result_list$silhouette_k <- if (isTRUE(manual_k_override_hc$enabled)) NA_integer_ else as.integer(optimal_k_hc)
       result_list$elbow_k <- NA_integer_
       result_list$avg_silhouette_width <- avg_silhouette_hc
       result_list$hclust_cophenetic_correlation <- cophenetic_corr_hc
       result_list$hclust_preview_k <- as.integer(optimal_k_hc)
       result_list$hclust_visual_scale <- if (isTRUE(manual_k_override_hc$enabled)) {
         "Clustering is fit on standardized numeric variables; manual k is used for the final cut."
       } else {
         "Clustering is fit on standardized numeric variables; k is selected by highest average silhouette."
       }
       cluster_sizes_hc <- table(cluster_factor_opt)
       result_list$cluster_sizes <- as.list(as.numeric(cluster_sizes_hc))
       names(result_list$cluster_sizes) <- names(cluster_sizes_hc)
       result_list$cluster_labels <- as.list(as.integer(cluster_assign_opt))

       assignment_df <- data.frame(
         Observation = seq_len(nrow(cluster_data_hc)),
         Cluster = as.character(cluster_factor_opt),
         stringsAsFactors = FALSE
       )
       if (!is.null(rownames(data_subset_hc)) && length(rownames(data_subset_hc)) == nrow(assignment_df)) {
         assignment_df$RowName <- as.character(rownames(data_subset_hc))
       }
       if (length(categorical_predictors_hc) > 0) {
         for (cat_var in head(categorical_predictors_hc, 3)) {
           cat_vals <- as.character(data_subset_hc[[cat_var]])
           cat_vals[is.na(cat_vals) | trimws(cat_vals) == ""] <- "Missing"
           assignment_df[[cat_var]] <- cat_vals
         }
       }
       max_assignment_rows <- min(nrow(assignment_df), 1000L)
       result_list$cluster_assignments <- assignment_df[seq_len(max_assignment_rows), , drop = FALSE]
       result_list$cluster_assignments_truncated <- nrow(assignment_df) > max_assignment_rows

       # Silhouette profile for chosen k
       if (optimal_k_hc >= 2) {
         tryCatch({
           sil_obj_opt <- cluster::silhouette(cluster_assign_opt, d)
           avg_silhouette_hc <- as.numeric(mean(sil_obj_opt[, 3], na.rm = TRUE))
           result_list$avg_silhouette_width <- avg_silhouette_hc
           sil_path <- gsub("\\.png$", "_silhouette.png", output_image)
           label_cfg <- resolve_base_label_config(
             "silhouette_plot",
             default_title = paste("Hierarchical Silhouette Plot (k =", optimal_k_hc, ")"),
             default_x = "",
             default_y = ""
           )
           png(sil_path, width = 650, height = 430)
           plot(sil_obj_opt, main = "", col = palette_main, border = NA)
           render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
           dev.off()
           result_list$silhouette_plot_path <- sil_path
           result_list$silhouette_table <- build_silhouette_table_payload(
             sil_obj_opt,
             observation_ids = rownames(data_subset_hc),
             cluster_label_map = setNames(paste0("Cluster ", seq_along(cluster_levels_opt)), as.character(cluster_levels_opt)),
             scope = "full_rows"
           )
         }, error = function(e) {
           result_list$silhouette_error <- e$message
         })
       }
       if (isTRUE(manual_k_override_hc$enabled)) {
         validation_cluster_data_hc <- zscore_matrix_safe(cluster_data_hc_raw)
         result_list$manual_cluster_validation <- run_manual_cluster_validation(
           cluster_input = validation_cluster_data_hc,
           selected_k = optimal_k_hc,
           output_image = output_image,
           plot_suffix = "_hclust_manual_validation_silhouette_trend.png",
           plot_title_prefix = "Hierarchical Manual K Validation",
           palette_main = palette_main,
           palette_accent = palette_accent
         )
         if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_path)) {
           result_list$silhouette_trend_plot_path <- result_list$manual_cluster_validation$silhouette_trend_plot_path
         }
         if (!is.null(result_list$manual_cluster_validation$silhouette_trend_plot_error) && nzchar(result_list$manual_cluster_validation$silhouette_trend_plot_error)) {
           result_list$silhouette_trend_plot_error <- result_list$manual_cluster_validation$silhouette_trend_plot_error
         }
       }
       # Dendrogram (main)
       tryCatch({
         dendro_labels <- resolve_base_label_config(
           "analysis_plot",
           default_title = "Hierarchical Clustering Dendrogram",
           default_x = "",
           default_y = ""
         )
         png(output_image, width = 1020, height = 620)
         h_ticks <- pretty(hc$height, n = 6)
         plot(
           hc,
           main = "",
           xlab = "",
           sub = "",
           ylab = paste0("Linkage Height (", hclust_linkage_method_label(result_list$method), " on Euclidean distance)"),
           cex = 0.82,
           hang = -1
         )
         if (length(h_ticks) > 0) {
           graphics::abline(h = h_ticks, col = "#e2e8f0", lty = 3)
         }
         rect.hclust(hc, k = optimal_k_hc, border = "#dc2626")
         render_base_label_config(dendro_labels, title_line = 1.2, x_line = 2.8, y_line = 3.0, caption_line = 4.4)
         mtext(
           paste0(
             if (isTRUE(manual_k_override_hc$enabled)) "Manual k = " else "Optimal k = ",
             optimal_k_hc,
             " | Avg silhouette = ", if (is.finite(avg_silhouette_hc)) sprintf("%.4f", avg_silhouette_hc) else "NA",
             " | Cophenetic corr = ", if (is.finite(cophenetic_corr_hc)) sprintf("%.4f", cophenetic_corr_hc) else "NA"
           ),
           side = 1,
           line = 3.8,
           cex = 0.83,
           col = "#475569"
         )
         dev.off()
         result_list$plot_path <- output_image
         result_list$plot_generated <- TRUE
       }, error = function(e) {
         result_list$plot_error <- e$message
       })

       # PCA biplot of individuals + variable vectors, colored by cluster and shaped by first categorical var (if available).
       tryCatch({
         if (ncol(cluster_data_hc) >= 2) {
           biplot_path <- gsub("\\.png$", "_biplot.png", output_image)
           pca_vis_hc <- stats::prcomp(cluster_data_hc, center = FALSE, scale. = FALSE)
           pc_data_hc <- data.frame(
             PC1 = pca_vis_hc$x[, 1],
             PC2 = pca_vis_hc$x[, 2],
             Cluster = cluster_factor_opt,
             stringsAsFactors = FALSE
           )
           cat_shape_var <- NULL
           if (length(categorical_predictors_hc) > 0) {
             cat_shape_var <- categorical_predictors_hc[1]
             cat_vals <- as.character(data_subset_hc[[cat_shape_var]])
             cat_vals[is.na(cat_vals) | trimws(cat_vals) == ""] <- "Missing"
             pc_data_hc$Category <- as.factor(cat_vals)
             result_list$hclust_biplot_category <- cat_shape_var
           }

           loadings_hc <- data.frame(
             Variable = rownames(pca_vis_hc$rotation),
             PC1 = pca_vis_hc$rotation[, 1],
             PC2 = pca_vis_hc$rotation[, 2],
             stringsAsFactors = FALSE
           )
           score_range <- max(abs(c(pc_data_hc$PC1, pc_data_hc$PC2)), na.rm = TRUE)
           loading_range <- max(abs(c(loadings_hc$PC1, loadings_hc$PC2)), na.rm = TRUE)
           arrow_scale <- if (is.finite(score_range) && is.finite(loading_range) && loading_range > 0) {
             score_range * 0.35 / loading_range
           } else {
             1
           }
           loadings_hc$PC1 <- loadings_hc$PC1 * arrow_scale
           loadings_hc$PC2 <- loadings_hc$PC2 * arrow_scale

           cluster_cols_hc <- pick_cols(nlevels(cluster_factor_opt))
           p_biplot <- ggplot2::ggplot(pc_data_hc, ggplot2::aes(x = PC1, y = PC2, color = Cluster))
           if (!is.null(cat_shape_var) && "Category" %in% colnames(pc_data_hc)) {
             shape_levels <- levels(pc_data_hc$Category)
             shape_values <- setNames(rep(c(16, 15, 17, 18, 3, 4, 8, 7), length.out = length(shape_levels)), shape_levels)
             p_biplot <- p_biplot +
               ggplot2::geom_point(ggplot2::aes(shape = Category), size = 2.6, alpha = 0.88)
             p_biplot <- p_biplot + ggplot2::scale_shape_manual(values = shape_values, drop = FALSE)
           } else {
             p_biplot <- p_biplot + ggplot2::geom_point(size = 2.6, alpha = 0.88)
           }
           p_biplot <- p_biplot +
             ggplot2::geom_segment(
               data = loadings_hc,
               ggplot2::aes(x = 0, y = 0, xend = PC1, yend = PC2),
               inherit.aes = FALSE,
               arrow = grid::arrow(length = grid::unit(0.13, "cm")),
               color = "#334155",
               linewidth = 0.55
             ) +
             ggplot2::geom_text(
               data = loadings_hc,
               ggplot2::aes(x = PC1, y = PC2, label = Variable),
               inherit.aes = FALSE,
               size = 3.0,
               color = "#1e293b",
               fontface = "bold",
               vjust = -0.35
             ) +
             ggplot2::scale_color_manual(values = cluster_cols_hc, drop = FALSE) +
             ggplot2::scale_fill_manual(values = cluster_cols_hc, drop = FALSE) +
             ggplot2::labs(
              title = "Hierarchical Clustering PCA Biplot",
              subtitle = if (!is.null(cat_shape_var)) {
                paste0("Color = cluster (k=", optimal_k_hc, ", ", hclust_linkage_method_label(result_list$method), "), shape = ", cat_shape_var)
              } else {
                paste0("Color = cluster (k=", optimal_k_hc, ", ", hclust_linkage_method_label(result_list$method), ")")
              },
              x = "PC1",
              y = "PC2"
            ) +
             ggplot2::theme_minimal(base_size = 11)

           custom_ggsave(biplot_path, plot = p_biplot, plot_key = "analysis_plot", width = 10, height = 8, dpi = 300)
           result_list$biplot_path <- biplot_path
         }
       }, error = function(e) {
         result_list$biplot_error <- e$message
       })
    }
    
    cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
    quit(save = "no")
  }
  
  # PREDICTION MODE: Logistic Regression
  if (base_analysis_mode == "predict_logistic") {
     # group_var contains predictors (comma separated)
     # response_var is the target
     # group_var2 contains the PATH TO THE NEW DATA FILE
     
     new_data_path <- group_var2
     predictors <- trimws(unlist(strsplit(group_var, ",")))
     predictors <- predictors[predictors != ""]
     
     if (!file.exists(new_data_path)) {
         cat(toJSON(list(error = "New data file not found."), auto_unbox = TRUE))
         quit(save = "no")
     }
     
     # Load New Data
     new_data <- tryCatch({ read_any_file(new_data_path) }, error = function(e) NULL)
     if (is.null(new_data)) {
         cat(toJSON(list(error = "Failed to load new data file."), auto_unbox = TRUE))
         quit(save = "no")
     }
     
     # specific validation: ensure predictors exist in new_data
     missing_cols <- setdiff(predictors, colnames(new_data))
     if (length(missing_cols) > 0) {
         cat(toJSON(list(error = paste("New data is missing variables:", paste(missing_cols, collapse=", "))), auto_unbox = TRUE))
         quit(save = "no")
     }
     
     # Prepare Training Data (fit the model again)
     # We need to ensure valid data for training
     # Check for valid columns in training data
     model_data <- data[, c(predictors, response_var)]
     model_data <- na.omit(model_data)
     
     # Ensure qualitative vars are factors in both train and new data
     # We need to unify factor levels. 
     # Strategy: specific logic to match levels? 
     # Or just trust R's predict if levels match?
     # Proper way: bind rows then split? No, expensive.
     # Let's simple convert char to factor.
     
     for (col in predictors) {
         if (is.character(model_data[[col]]) || is.factor(model_data[[col]])) {
             model_data[[col]] <- as.factor(model_data[[col]])
             if (col %in% colnames(new_data)) {
                 new_data[[col]] <- factor(new_data[[col]], levels = levels(model_data[[col]]))
             }
         }
     }
     model_data[[response_var]] <- as.factor(model_data[[response_var]])

     # Fit Model
     f <- as.formula(paste(response_var, "~ ."))
     model <- tryCatch({
         glm(f, data = model_data, family = binomial)
     }, error = function(e) {
         cat(toJSON(list(error = paste("Model fitting failed:", e$message)), auto_unbox = TRUE))
         quit(save = "no")
     })
     
     # Predict
     # handle NAs in new_data? predict will return NA or omit.
     predictions <- tryCatch({
         predict(model, newdata = new_data, type = "response")
     }, error = function(e) {
         # often caused by new levels in factors
         return(NULL)
     })
     
     if (is.null(predictions)) {
         cat(toJSON(list(error = "Prediction failed. Checks new data factor levels match training data."), auto_unbox = TRUE))
         quit(save = "no")
     }
     
     # Format results
     # We return row_id, predictors, and predicted probability/class
     res_df <- new_data[, predictors, drop = FALSE]
     res_df$Predicted_Prob <- round(predictions, 4)
     res_df$Predicted_Class <- ifelse(predictions > regression_classification_threshold, 1, 0)
     # Map back to original labels if target levels known? 
     # The model fits 0/1 usually based on factor level order. 
     # levels(model_data[[response_var]]) give ["Fail", "Pass"] -> 0, 1
     lbls <- levels(model_data[[response_var]])
     if (length(lbls) == 2) {
         res_df$Predicted_Label <- ifelse(predictions > regression_classification_threshold, lbls[2], lbls[1])
     }
     
     # Limit size if too big? Send top 100 + summary?
     # User wants to see them. Let's send all, but user UI might paginate.
     # Or send first 50 preview and creating a CSV for download?
     # Result list will contain full data (assuming it's reasonable size < 10k rows)
     
     # Add row IDs
     res_df$Row_ID <- 1:nrow(res_df)
     
     result_list <- list(
         mode = "predict_logistic",
         success = TRUE,
         classification_threshold = as.numeric(regression_classification_threshold),
         prediction_results = res_df,
         count = nrow(res_df)
     )
     
     cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
     quit(save = "no")
  }

  # INFERENTIAL MODE: ONE-VALUE COMPARISON
  if (base_analysis_mode == "inferential_one_value" || (base_analysis_mode == "inferential" && inferential_workflow == "one_value_comparison")) {
      result_list <- list(
        mode = "inferential",
        test_type = "one_value_comparison",
        workflow = "one_value_comparison",
        sample_type = "One-sample"
      )
      emit_progress(12, "Pass 1", "One-value setup", "pending")

      target_var <- if (!is.null(response_var) && response_var != "" && response_var %in% colnames(data)) {
        response_var
      } else if (!is.null(group_var) && group_var != "" && group_var %in% colnames(data)) {
        group_var
      } else {
        NULL
      }

      if (is.null(target_var)) {
        cat(toJSON(list(error = "One-value comparison requires selecting a valid variable."), auto_unbox = TRUE))
        quit(save = "no")
      }

      raw_values <- data[[target_var]]
      valid_mask <- !(is.na(raw_values) | (is.character(raw_values) & trimws(raw_values) == ""))
      raw_values <- raw_values[valid_mask]
      if (length(raw_values) == 0) {
        cat(toJSON(list(error = sprintf("No valid values found for variable '%s'.", target_var)), auto_unbox = TRUE))
        quit(save = "no")
      }

      numeric_values <- suppressWarnings(as.numeric(as.character(raw_values)))
      is_numeric_target <- all(!is.na(numeric_values))

      result_list$target_variable <- target_var
      result_list$target_type <- if (is_numeric_target) "continuous" else "categorical"

      if (is_numeric_target) {
        x <- numeric_values
        n <- length(x)
        reference_mean <- suppressWarnings(as.numeric(one_value_reference_raw))
        if (!is.finite(reference_mean)) {
          cat(toJSON(list(error = "For continuous one-value comparison, provide a valid known mean."), auto_unbox = TRUE))
          quit(save = "no")
        }
        if (n < 2) {
          cat(toJSON(list(error = "At least 2 observations are required for one-sample continuous tests."), auto_unbox = TRUE))
          quit(save = "no")
        }

        shapiro_p <- NA
        shapiro_stat <- NA
        is_normal <- FALSE
        shapiro_msg <- ""

        if (n >= 3) {
          shapiro_res <- tryCatch(shapiro.test(x), error = function(e) NULL)
          if (!is.null(shapiro_res)) {
            shapiro_p <- as.numeric(shapiro_res$p.value)
            shapiro_stat <- as.numeric(shapiro_res$statistic)
            is_normal <- !is.na(shapiro_p) && shapiro_p >= alpha_val
            shapiro_msg <- if (is_normal) {
              sprintf("Shapiro-Wilk p = %s (>= %.3f): approximately normal.", fmt_p_value(shapiro_p), alpha_val)
            } else {
              sprintf("Shapiro-Wilk p = %s (< %.3f): not normal; using non-parametric alternative.", fmt_p_value(shapiro_p), alpha_val)
            }
          } else {
            shapiro_msg <- "Shapiro-Wilk test could not be computed; using non-parametric alternative."
          }
        } else {
          shapiro_msg <- sprintf("Shapiro-Wilk requires n >= 3 (current n = %d); using non-parametric alternative.", n)
        }

        result_list$shapiro <- list()
        result_list$shapiro[[target_var]] <- list(
          n = n,
          p_value = shapiro_p,
          formatted_p = fmt_p_value(shapiro_p),
          statistic = shapiro_stat,
          is_normal = is_normal,
          message = shapiro_msg
        )
        result_list$all_normal <- is_normal
        result_list$n_groups <- 1

        assumptions <- list(
          data_type = "continuous",
          independent_observations = "required",
          normality_check = if (!is.na(shapiro_p)) fmt_p_value(shapiro_p) else "N/A",
          fallback_rule = "If normality is violated, use Wilcoxon signed-rank one-sample test."
        )
        emit_progress(
          45,
          "Pass 2",
          "Shapiro-Wilk normality",
          if (is_normal) "parametric" else "non-parametric"
        )

        if (is_normal) {
          emit_progress(72, "Pass 3", "One-sample t-test", "parametric")
          t_res <- tryCatch(t.test(x, mu = reference_mean, conf.level = selected_ci_level), error = function(e) NULL)
          if (is.null(t_res)) {
            cat(toJSON(list(error = "One-sample t-test failed for the selected variable."), auto_unbox = TRUE))
            quit(save = "no")
          }

          p_val <- as.numeric(t_res$p.value)
          is_sig <- !is.na(p_val) && (p_val < alpha_val)
          mean_x <- mean(x, na.rm = TRUE)
          sd_x <- sd(x, na.rm = TRUE)
          d_val <- if (!is.na(sd_x) && sd_x > 0) (mean_x - reference_mean) / sd_x else NA
          d_label <- cohens_d_label(d_val)
          msg <- if (is_sig) {
            sprintf("One-sample t-test is significant (p = %s). The sample mean differs from the reference mean %.3f.", fmt_p_value(p_val), reference_mean)
          } else {
            sprintf("One-sample t-test is not significant (p = %s). No evidence of difference from reference mean %.3f.", fmt_p_value(p_val), reference_mean)
          }

          result_list$path_taken <- "parametric"
          result_list$ttest <- list(
            test_type = "one_sample",
            test_name = "One-sample t-test",
            statistic = as.numeric(t_res$statistic),
            df = as.numeric(t_res$parameter),
            p_value = p_val,
            formatted_p = fmt_p_value(p_val),
            message = msg,
            is_significant = is_sig,
            group1 = target_var,
            group2 = sprintf("Reference mean (mu = %.3f)", reference_mean),
            mean1 = as.numeric(mean_x),
            mean2 = as.numeric(reference_mean),
            mean_diff = as.numeric(mean_x - reference_mean),
            ci_lower = as.numeric(t_res$conf.int[1]),
            ci_upper = as.numeric(t_res$conf.int[2]),
            cohens_d = as.numeric(d_val),
            effect_size = d_label,
            sample_n = n,
            reference_mean = as.numeric(reference_mean)
          )
          result_list$one_value <- list(
            data_type = "continuous",
            selected_test = "one_sample_t_test",
            variable = target_var,
            reference_value = as.numeric(reference_mean),
            n = as.integer(n),
            mean = as.numeric(mean_x),
            sd = as.numeric(sd_x),
            median = as.numeric(median(x, na.rm = TRUE)),
            q1 = as.numeric(quantile(x, 0.25, na.rm = TRUE, names = FALSE)),
            q3 = as.numeric(quantile(x, 0.75, na.rm = TRUE, names = FALSE)),
            assumptions = assumptions,
            message = msg
          )
          result_list$message <- msg
        } else {
          emit_progress(72, "Pass 3", "Wilcoxon signed-rank", "non-parametric")
          w_res <- tryCatch(
            suppressWarnings(wilcox.test(x, mu = reference_mean, exact = FALSE, conf.int = TRUE, conf.level = selected_ci_level)),
            error = function(e) NULL
          )
          if (is.null(w_res)) {
            w_res <- tryCatch(suppressWarnings(wilcox.test(x, mu = reference_mean, exact = FALSE)), error = function(e) NULL)
          }
          if (is.null(w_res)) {
            cat(toJSON(list(error = "Wilcoxon signed-rank one-sample test failed for the selected variable."), auto_unbox = TRUE))
            quit(save = "no")
          }

          p_val <- as.numeric(w_res$p.value)
          is_sig <- !is.na(p_val) && (p_val < alpha_val)
          med_x <- median(x, na.rm = TRUE)
          pseudo_med <- if (!is.null(w_res$estimate)) as.numeric(w_res$estimate[[1]]) else NA
          msg <- if (is_sig) {
            sprintf("Wilcoxon signed-rank one-sample test is significant (p = %s). The sample distribution differs from reference median %.3f.", fmt_p_value(p_val), reference_mean)
          } else {
            sprintf("Wilcoxon signed-rank one-sample test is not significant (p = %s). No evidence of difference from reference median %.3f.", fmt_p_value(p_val), reference_mean)
          }

          result_list$path_taken <- "non-parametric"
          result_list$wilcoxon <- list(
            test_name = "Wilcoxon Signed-Rank Test (One-Sample)",
            statistic = as.numeric(w_res$statistic),
            p_value = p_val,
            formatted_p = fmt_p_value(p_val),
            message = msg,
            is_significant = is_sig,
            group1 = target_var,
            group2 = sprintf("Reference median (mu = %.3f)", reference_mean),
            median1 = as.numeric(med_x),
            median2 = as.numeric(reference_mean),
            pseudo_median = as.numeric(pseudo_med),
            rank_biserial = NA,
            rank_biserial_formatted = "N/A",
            rank_biserial_effect = "N/A",
            rank_biserial_interpretation = "Rank-biserial correlation is not reported for one-sample Wilcoxon in this workflow.",
            sample_n = n,
            reference_mu = as.numeric(reference_mean)
          )
          result_list$one_value <- list(
            data_type = "continuous",
            selected_test = "wilcoxon_signed_rank_one_sample",
            variable = target_var,
            reference_value = as.numeric(reference_mean),
            n = as.integer(n),
            mean = as.numeric(mean(x, na.rm = TRUE)),
            sd = as.numeric(sd(x, na.rm = TRUE)),
            median = as.numeric(median(x, na.rm = TRUE)),
            q1 = as.numeric(quantile(x, 0.25, na.rm = TRUE, names = FALSE)),
            q3 = as.numeric(quantile(x, 0.75, na.rm = TRUE, names = FALSE)),
            assumptions = assumptions,
            message = msg
          )
          result_list$message <- msg
        }
      } else {
        x_factor <- as.factor(as.character(raw_values))
        categories <- levels(x_factor)
        counts <- table(x_factor)
        n_total <- as.numeric(sum(counts))
        k <- length(categories)
        if (k < 2) {
          cat(toJSON(list(error = "Categorical one-value comparison requires at least 2 categories."), auto_unbox = TRUE))
          quit(save = "no")
        }

        result_list$n_groups <- k
        emit_progress(45, "Pass 2", "Categorical proportion setup", "non-parametric")

        if (k == 2) {
          reference_prop <- suppressWarnings(as.numeric(one_value_reference_raw))
          if (!is.finite(reference_prop) || reference_prop <= 0 || reference_prop >= 1) {
            cat(toJSON(list(error = "Binary proportion testing requires a reference proportion between 0 and 1."), auto_unbox = TRUE))
            quit(save = "no")
          }

          success_level <- if (!is.null(one_value_success_level) && one_value_success_level != "" && one_value_success_level %in% categories) {
            one_value_success_level
          } else {
            categories[1]
          }
          success_count <- as.numeric(counts[success_level])
          if (is.na(success_count)) success_count <- 0
          p_hat <- success_count / n_total
          approx_ok <- (n_total * reference_prop >= 5) && (n_total * (1 - reference_prop) >= 5)

          if (approx_ok) {
            emit_progress(72, "Pass 3", "One-proportion Z test", "non-parametric")
            z_res <- tryCatch(prop.test(success_count, n_total, p = reference_prop, correct = FALSE), error = function(e) NULL)
            if (is.null(z_res)) {
              cat(toJSON(list(error = "One-proportion Z test failed for the selected variable."), auto_unbox = TRUE))
              quit(save = "no")
            }

            p_val <- as.numeric(z_res$p.value)
            chi_sq <- as.numeric(z_res$statistic)
            z_stat <- sign(p_hat - reference_prop) * sqrt(chi_sq)
            is_sig <- !is.na(p_val) && (p_val < alpha_val)
            msg <- if (is_sig) {
              sprintf("One-proportion Z test is significant (p = %s). Observed proportion differs from reference %.3f.", fmt_p_value(p_val), reference_prop)
            } else {
              sprintf("One-proportion Z test is not significant (p = %s). Observed proportion is compatible with reference %.3f.", fmt_p_value(p_val), reference_prop)
            }

            result_list$path_taken <- "non-parametric"
            result_list$one_value <- list(
              data_type = "categorical_binary",
              selected_test = "one_proportion_z_test",
              variable = target_var,
              categories = as.character(categories),
              success_level = success_level,
              observed_successes = success_count,
              n_total = n_total,
              observed_proportion = as.numeric(p_hat),
              reference_proportion = as.numeric(reference_prop),
              normal_approximation_valid = TRUE,
              rationale = "Counts/frequencies are non-continuous; normality and variance-homogeneity assumptions are not required.",
              proportion_test = list(
                method = "One-proportion Z test",
                statistic_label = "Z",
                statistic = as.numeric(z_stat),
                chi_squared = chi_sq,
                df = 1,
                p_value = p_val,
                formatted_p = fmt_p_value(p_val),
                is_significant = is_sig,
                message = msg
              ),
              message = msg
            )
            result_list$message <- msg
          } else {
            emit_progress(72, "Pass 3", "Exact binomial test", "non-parametric")
            b_res <- tryCatch(binom.test(success_count, n_total, p = reference_prop), error = function(e) NULL)
            if (is.null(b_res)) {
              cat(toJSON(list(error = "Exact binomial test failed for the selected variable."), auto_unbox = TRUE))
              quit(save = "no")
            }

            p_val <- as.numeric(b_res$p.value)
            is_sig <- !is.na(p_val) && (p_val < alpha_val)
            msg <- if (is_sig) {
              sprintf("Exact binomial test is significant (p = %s). Observed proportion differs from reference %.3f.", fmt_p_value(p_val), reference_prop)
            } else {
              sprintf("Exact binomial test is not significant (p = %s). Observed proportion is compatible with reference %.3f.", fmt_p_value(p_val), reference_prop)
            }

            result_list$path_taken <- "non-parametric"
            result_list$one_value <- list(
              data_type = "categorical_binary",
              selected_test = "binomial_exact_test",
              variable = target_var,
              categories = as.character(categories),
              success_level = success_level,
              observed_successes = success_count,
              n_total = n_total,
              observed_proportion = as.numeric(p_hat),
              reference_proportion = as.numeric(reference_prop),
              normal_approximation_valid = FALSE,
              rationale = "Counts/frequencies are non-continuous; normality and variance-homogeneity assumptions are not required.",
              proportion_test = list(
                method = "Exact binomial test",
                statistic_label = "x",
                statistic = as.numeric(success_count),
                p_value = p_val,
                formatted_p = fmt_p_value(p_val),
                conf_int_lower = as.numeric(b_res$conf.int[1]),
                conf_int_upper = as.numeric(b_res$conf.int[2]),
                is_significant = is_sig,
                message = msg
              ),
              message = msg
            )
            result_list$message <- msg
          }
      } else {
        emit_progress(72, "Pass 3", "Chi-square goodness-of-fit", "non-parametric")
        parsed_probs <- parse_expected_proportions(one_value_proportions_raw, k)
        gof <- run_chisq_goodness_of_fit(
            x_factor,
            target_var,
            alpha_val,
            expected_probs = parsed_probs$probs,
            null_hypothesis = "Observed category distribution matches expected proportions"
          )

          result_list$path_taken <- "non-parametric"
          result_list$one_value <- list(
            data_type = "categorical_multiclass",
            selected_test = "chi_square_goodness_of_fit",
            variable = target_var,
            categories = as.character(categories),
            expected_proportions = as.numeric(parsed_probs$probs),
            proportions_note = parsed_probs$note,
            rationale = "Counts/frequencies are non-continuous; normality and variance-homogeneity assumptions are not required.",
            chisq_gof = gof,
            message = gof$message
          )
          result_list$chisq_gof <- gof
          result_list$message <- gof$message
        }
      }

      one_value_plot <- create_one_value_publication_plot(
        raw_values = raw_values,
        variable_name = target_var,
        one_value_summary = result_list$one_value,
        result_list = result_list,
        base_output_image = output_image,
        alpha_level = alpha_val
      )
      result_list$plot_generated <- isTRUE(one_value_plot$generated)
      if (isTRUE(one_value_plot$generated) && !is.null(one_value_plot$path)) {
        result_list$plot_path <- one_value_plot$path
      } else if (!is.null(one_value_plot$error)) {
        result_list$plot_error <- one_value_plot$error
      }

      final_test <- if (!is.null(result_list$one_value) && !is.null(result_list$one_value$selected_test)) {
        result_list$one_value$selected_test
      } else {
        result_list$test_type
      }
      final_path <- if (!is.null(result_list$path_taken) && nzchar(as.character(result_list$path_taken))) {
        result_list$path_taken
      } else {
        "non-parametric"
      }
      emit_progress(90, "Pass 4", final_test, final_path)
      emit_progress(100, "Pass Final", "Result finalized", final_path)
      cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
      quit(save = "no")
  }
  # INFERENTIAL STATISTICS MODE (all existing code below)
  
  # Check for Categorical-Categorical (Chi-Square) - BEFORE numeric conversion
  is_cat_response_chk <- is.character(data[[response_var]]) || is.factor(data[[response_var]])
  is_cat_group_chk <- is.character(data[[group_var]]) || is.factor(data[[group_var]])
  
  if (is_cat_response_chk && is_cat_group_chk && !is_factorial) {
        # CHI-SQUARE TEST OF INDEPENDENCE
        emit_progress(18, "Pass 1", "Build contingency table", "pending")
        result_list <- list()
        result_list$test_type <- "chi_squared"
        result_list$n_groups <- length(unique(data[[group_var]]))
        result_list$is_factorial <- FALSE
        result_list$mode <- "inferential"
        result_list$chi_square_adjustment <- chi_square_adjustment
        
        # Create contingency table
        tbl <- table(data[[group_var]], data[[response_var]])
        
        # Run Test with configurable continuity correction
        chisq_ctx <- run_chisq_with_adjustment(tbl, chi_square_adjustment)
        chisq_res <- chisq_ctx$result
        if (!is.null(chisq_res)) {
          emit_progress(72, "Pass 2", "Chi-square test", "non-parametric")
          # Calculate Cramer's V for effect size
          n_total <- sum(tbl)
          min_dim <- min(nrow(tbl) - 1, ncol(tbl) - 1)
          cramers_v <- sqrt(chisq_res$statistic / (n_total * min_dim))
          
          # Effect size interpretation
          es_label <- if (is.na(cramers_v)) "N/A" else if (cramers_v < 0.1) "Negligible" else if (cramers_v < 0.3) "Small" else if (cramers_v < 0.5) "Medium" else "Large"
          
          result_list$chisq <- list(
            statistic = as.numeric(chisq_res$statistic),
            p_value = as.numeric(chisq_res$p.value),
            df = as.numeric(chisq_res$parameter),
            cramers_v = as.numeric(cramers_v),
            effect_size_label = es_label,
            is_significant = (chisq_res$p.value < alpha_val),
            correction_option = chisq_ctx$correction_option,
            correction_applied = chisq_ctx$correction_applied,
            correction_label = chisq_ctx$correction_label,
            formatted_p = if (chisq_res$p.value < 0.001) "< .001" else sprintf("%.3f", chisq_res$p.value),
            message = sprintf("Chi-Square test: X2(%d) = %.2f, p = %s, V = %.2f (%s). %s", 
                              chisq_res$parameter, chisq_res$statistic, 
                              if (chisq_res$p.value < 0.001) "< .001" else sprintf("%.3f", chisq_res$p.value),
                              cramers_v, es_label, chisq_ctx$correction_label)
          )
        } else {
             result_list$chisq <- list(
               message = "Chi-Square test failed (check for empty cells or ensure valid factors)."
             )
        }

        emit_progress(100, "Pass Final", "Result finalized", "non-parametric")
        cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
        quit(save = "no")
  }

  # Convert variables to appropriate types for inferential analysis
  data[[group_var]] <- as.factor(data[[group_var]])
  if (is_factorial) {
    data[[group_var2]] <- as.factor(data[[group_var2]])
  }
  data[[response_var]] <- as.numeric(as.character(data[[response_var]]))
  data <- data[!is.na(data[[response_var]]), ]
  emit_progress(20, "Pass 1", "Shapiro-Wilk normality", "pending")
  
  # 1. Shapiro-Wilk Normality Test
  # Two-way between x between path: assess normality on ANOVA residuals.
  # Other paths: keep per-group/per-cell Shapiro checks.
  shapiro_list <- list()
  all_normal <- TRUE
  n_groups <- 0
  normality_scope <- "group_or_cell"
  normality_model_formula <- NULL
  residual_qq_plot_generated <- FALSE
  residual_qq_plot_path <- NULL
  residual_qq_plot_error <- NULL
  shapiro_group_qq_plot_generated <- FALSE
  shapiro_group_qq_plot_path <- NULL
  shapiro_group_qq_plot_error <- NULL

  if (is_factorial && factorial_design == "between") {
    normality_scope <- "anova_residuals"
    normality_model_formula <- paste(response_var, "~", group_var, "*", group_var2)
    lm_for_normality <- tryCatch({
      lm(as.formula(normality_model_formula), data = data)
    }, error = function(e) { NULL })

    residual_vals <- numeric(0)
    if (!is.null(lm_for_normality)) {
      residual_vals <- residuals(lm_for_normality)
      residual_vals <- residual_vals[is.finite(residual_vals)]
    }
    residual_n <- length(residual_vals)
    n_groups <- 1

    if (is.null(lm_for_normality) || residual_n < 3) {
      shapiro_list[["ANOVA residuals"]] <- list(
        n = residual_n,
        p_value = NA,
        formatted_p = "N/A",
        statistic = NA,
        is_normal = FALSE,
        message = if (is.null(lm_for_normality)) {
          "Could not fit two-way ANOVA model for residual normality check; using non-parametric path."
        } else {
          sprintf("ANOVA residual normality requires at least 3 residuals (current n = %d). Using non-parametric path.", residual_n)
        }
      )
      all_normal <- FALSE
    } else {
      shapiro_input <- residual_vals
      sampled_for_shapiro <- FALSE
      if (length(shapiro_input) > 5000) {
        set.seed(42)
        shapiro_input <- sample(shapiro_input, 5000)
        sampled_for_shapiro <- TRUE
      }

      test_res <- tryCatch({ shapiro.test(shapiro_input) }, error = function(e) { NULL })
      if (is.null(test_res)) {
        shapiro_list[["ANOVA residuals"]] <- list(
          n = residual_n,
          p_value = NA,
          formatted_p = "Err",
          statistic = NA,
          is_normal = FALSE,
          message = "Shapiro-Wilk failed on ANOVA residuals; using non-parametric path."
        )
        all_normal <- FALSE
      } else {
        p_val <- as.numeric(test_res$p.value)
        is_normal <- !is.na(p_val) && p_val >= alpha_val
        formatted_p <- fmt_p_value(p_val)
        shapiro_note <- if (sampled_for_shapiro) {
          sprintf(" (computed on a random subset of 5000 residuals from n=%d)", residual_n)
        } else {
          sprintf(" (n=%d)", residual_n)
        }
        msg <- if (is_normal) {
          sprintf("Shapiro-Wilk on ANOVA residuals gives p = %s (>= %.3f); residuals are approximately normal%s.", formatted_p, alpha_val, shapiro_note)
        } else {
          sprintf("Shapiro-Wilk on ANOVA residuals gives p = %s (< %.3f); residuals are not normal%s.", formatted_p, alpha_val, shapiro_note)
        }
        shapiro_list[["ANOVA residuals"]] <- list(
          n = residual_n,
          p_value = p_val,
          formatted_p = formatted_p,
          statistic = as.numeric(test_res$statistic),
          message = msg,
          is_normal = is_normal,
          sampled_for_shapiro = sampled_for_shapiro
        )
        all_normal <- is_normal
      }
    }

    qq_plot <- create_residual_qq_plot(
      residual_vals,
      output_image,
      sprintf("Residual Q-Q Plot: %s × %s ANOVA", group_var, group_var2)
    )
    residual_qq_plot_generated <- isTRUE(qq_plot$generated)
    if (isTRUE(qq_plot$generated) && !is.null(qq_plot$path)) {
      residual_qq_plot_path <- qq_plot$path
    } else if (!is.null(qq_plot$error)) {
      residual_qq_plot_error <- qq_plot$error
    }
  } else if (is_factorial && factorial_design %in% c("within", "mixed")) {
    normality_scope <- "rm_anova_residuals"
    n_groups <- 1
    residual_label <- "RM-ANOVA residuals"
    residual_vals <- numeric(0)

    if (is.null(subject_var) || !(subject_var %in% colnames(data))) {
      shapiro_list[[residual_label]] <- list(
        n = 0,
        p_value = NA,
        formatted_p = "N/A",
        statistic = NA,
        is_normal = FALSE,
        message = sprintf("Two-way %s ANOVA residual normality requires a Subject ID variable.", factorial_design)
      )
      all_normal <- FALSE
    } else {
      normality_data <- data[, c(subject_var, group_var, group_var2, response_var), drop = FALSE]
      normality_data$..SubjectID <- if (factorial_design == "mixed") {
        interaction(normality_data[[group_var]], normality_data[[subject_var]], drop = TRUE)
      } else {
        as.factor(normality_data[[subject_var]])
      }
      normality_data <- normality_data[!is.na(normality_data[[response_var]]), , drop = FALSE]
      normality_model_formula <- paste(response_var, "~", group_var, "*", group_var2, "+ ..SubjectID")

      lm_for_normality <- tryCatch({
        lm(as.formula(normality_model_formula), data = normality_data)
      }, error = function(e) { NULL })

      if (!is.null(lm_for_normality)) {
        residual_vals <- residuals(lm_for_normality)
        residual_vals <- residual_vals[is.finite(residual_vals)]
      }
      residual_n <- length(residual_vals)

      if (is.null(lm_for_normality) || residual_n < 3) {
        shapiro_list[[residual_label]] <- list(
          n = residual_n,
          p_value = NA,
          formatted_p = "N/A",
          statistic = NA,
          is_normal = FALSE,
          message = if (is.null(lm_for_normality)) {
            sprintf("Could not fit two-way %s ANOVA residual model for normality; using non-parametric path.", factorial_design)
          } else {
            sprintf("Residual normality requires at least 3 residuals (current n = %d); using non-parametric path.", residual_n)
          }
        )
        all_normal <- FALSE
      } else {
        shapiro_input <- residual_vals
        sampled_for_shapiro <- FALSE
        if (length(shapiro_input) > 5000) {
          set.seed(42)
          shapiro_input <- sample(shapiro_input, 5000)
          sampled_for_shapiro <- TRUE
        }

        test_res <- tryCatch({ shapiro.test(shapiro_input) }, error = function(e) { NULL })
        if (is.null(test_res)) {
          shapiro_list[[residual_label]] <- list(
            n = residual_n,
            p_value = NA,
            formatted_p = "Err",
            statistic = NA,
            is_normal = FALSE,
            message = sprintf("Shapiro-Wilk failed on two-way %s ANOVA residuals; using non-parametric path.", factorial_design)
          )
          all_normal <- FALSE
        } else {
          p_val <- as.numeric(test_res$p.value)
          is_normal <- !is.na(p_val) && p_val >= alpha_val
          formatted_p <- fmt_p_value(p_val)
          shapiro_note <- if (sampled_for_shapiro) {
            sprintf(" (computed on a random subset of 5000 residuals from n=%d)", residual_n)
          } else {
            sprintf(" (n=%d)", residual_n)
          }
          msg <- if (is_normal) {
            sprintf("Shapiro-Wilk on two-way %s ANOVA residuals gives p = %s (>= %.3f); residuals are approximately normal%s.", factorial_design, formatted_p, alpha_val, shapiro_note)
          } else {
            sprintf("Shapiro-Wilk on two-way %s ANOVA residuals gives p = %s (< %.3f); residuals are not normal%s.", factorial_design, formatted_p, alpha_val, shapiro_note)
          }
          shapiro_list[[residual_label]] <- list(
            n = residual_n,
            p_value = p_val,
            formatted_p = formatted_p,
            statistic = as.numeric(test_res$statistic),
            message = msg,
            is_normal = is_normal,
            sampled_for_shapiro = sampled_for_shapiro
          )
          all_normal <- is_normal
        }
      }
    }

    qq_plot <- create_residual_qq_plot(
      residual_vals,
      output_image,
      sprintf("Residual Q-Q Plot: Two-way %s ANOVA", factorial_design)
    )
    residual_qq_plot_generated <- isTRUE(qq_plot$generated)
    if (isTRUE(qq_plot$generated) && !is.null(qq_plot$path)) {
      residual_qq_plot_path <- qq_plot$path
    } else if (!is.null(qq_plot$error)) {
      residual_qq_plot_error <- qq_plot$error
    }
  } else {
    if (is_factorial) {
      groups <- split(data[[response_var]], interaction(data[[group_var]], data[[group_var2]], drop = TRUE))
    } else {
      groups <- split(data[[response_var]], data[[group_var]])
    }

    n_groups <- length(groups)
    for (grp_name in names(groups)) {
      group_data <- groups[[grp_name]]
      n <- length(group_data)

      if (n < 3) {
        shapiro_list[[grp_name]] <- list(
          n = n,
          p_value = NA,
          formatted_p = "N/A",
          statistic = NA,
          is_normal = FALSE,
          message = sprintf("%s: Too few obs (n=%d)", grp_name, n)
        )
        all_normal <- FALSE
        next
      }

      test_res <- tryCatch({ shapiro.test(group_data) }, error = function(e) { NULL })
      if (is.null(test_res)) {
        shapiro_list[[grp_name]] <- list(
          n = n,
          p_value = NA,
          formatted_p = "Err",
          statistic = NA,
          is_normal = FALSE,
          message = sprintf("%s: Test error", grp_name)
        )
        all_normal <- FALSE
      } else {
        p_val <- test_res$p.value
        is_normal <- (p_val >= alpha_val)
        formatted_p <- if (p_val < 0.0001) format(p_val, scientific = TRUE, digits = 4) else format(round(p_val, 4), nsmall = 4)

        msg <- if (is_normal) sprintf("The Shapiro-Wilk test result shows a p-value of %s, which is greater than alpha (%f). Therefore, the data is normally distributed.", formatted_p, alpha_val)
        else sprintf("The Shapiro-Wilk test result shows a p-value of %s, which is less than alpha (%f). Therefore, the data is NOT normally distributed.", formatted_p, alpha_val)

        shapiro_list[[grp_name]] <- list(
          n = n,
          p_value = p_val,
          formatted_p = formatted_p,
          statistic = as.numeric(test_res$statistic),
          message = msg,
          is_normal = is_normal
        )
        if (!is_normal) all_normal <- FALSE
      }
    }

    shapiro_group_qq_plot <- create_group_qq_plot(
      groups,
      output_image,
      if (is_factorial) {
        sprintf("Shapiro Q-Q Plot by Cell: %s × %s", group_var, group_var2)
      } else {
        sprintf("Shapiro Q-Q Plot by Group: %s", group_var)
      }
    )
    shapiro_group_qq_plot_generated <- isTRUE(shapiro_group_qq_plot$generated)
    if (isTRUE(shapiro_group_qq_plot$generated) && !is.null(shapiro_group_qq_plot$path)) {
      shapiro_group_qq_plot_path <- shapiro_group_qq_plot$path
    } else if (!is.null(shapiro_group_qq_plot$error)) {
      shapiro_group_qq_plot_error <- shapiro_group_qq_plot$error
    }
  }
  
  result_list <- list(
    mode = "inferential",
    shapiro = shapiro_list,
    all_normal = all_normal,
    n_groups = n_groups,
    normality_scope = normality_scope
  )
  if (!is.null(normality_model_formula)) {
    result_list$normality_model_formula <- normality_model_formula
  }
  result_list$residual_qq_plot_generated <- residual_qq_plot_generated
  if (!is.null(residual_qq_plot_path)) {
    result_list$residual_qq_plot_path <- residual_qq_plot_path
  } else if (!is.null(residual_qq_plot_error)) {
    result_list$residual_qq_plot_error <- residual_qq_plot_error
  }
  result_list$shapiro_group_qq_plot_generated <- shapiro_group_qq_plot_generated
  if (!is.null(shapiro_group_qq_plot_path)) {
    result_list$shapiro_group_qq_plot_path <- shapiro_group_qq_plot_path
  } else if (!is.null(shapiro_group_qq_plot_error)) {
    result_list$shapiro_group_qq_plot_error <- shapiro_group_qq_plot_error
  }
  emit_progress(40, "Pass 2", "Variance / sphericity checks", "pending")
  
  # 2. Homogeneity checks.
  # - Pure between-subject paths: check group/cell variance equality.
  # - Mixed factorial path: check variance equality for the between factor
  #   on subject-level means (independent units).
  run_homogeneity_check <- (!is_paired) || (is_factorial && factorial_design == "mixed")
  if (run_homogeneity_check) {
    if (is_factorial && factorial_design == "mixed") {
      mixed_homo_data <- NULL
      if (!is.null(subject_var) && (subject_var %in% colnames(data))) {
        mixed_homo_data <- tryCatch({
          aggregate(
            as.formula(paste(response_var, "~", subject_var, "+", group_var)),
            data = data,
            FUN = mean
          )
        }, error = function(e) { NULL })
      }

      if (!is.null(mixed_homo_data) && nrow(mixed_homo_data) > 0) {
        n_between_groups <- length(unique(mixed_homo_data[[group_var]]))
        if (n_between_groups == 2) {
          lev_res <- tryCatch({
            grp <- as.factor(mixed_homo_data[[group_var]])
            y <- mixed_homo_data[[response_var]]
            centers <- tapply(y, grp, median, na.rm = TRUE)
            z <- abs(y - centers[grp])
            lev_df <- data.frame(z = z, group = grp)
            summary(aov(z ~ group, data = lev_df))[[1]]
          }, error = function(e) { NULL })
          if (!is.null(lev_res)) {
            f_val <- as.numeric(lev_res[["F value"]][1])
            df1_val <- as.numeric(lev_res[["Df"]][1])
            df2_val <- as.numeric(lev_res[["Df"]][2])
            p_val_lev <- as.numeric(lev_res[["Pr(>F)"]][1])
            is_homogeneous <- (p_val_lev >= alpha_val)
            fmt_p_lev <- if (p_val_lev < 0.0001) format(p_val_lev, scientific = TRUE, digits = 4) else format(round(p_val_lev, 4), nsmall = 4)
            msg_lev <- if (is_homogeneous) {
              sprintf("Levene's p-value is %s (>= %f). Variances are homogeneous for the between-subject factor (%s) in the mixed design.", fmt_p_lev, alpha_val, group_var)
            } else {
              sprintf("Levene's p-value is %s (< %f). Variances are NOT homogeneous for the between-subject factor (%s) in the mixed design.", fmt_p_lev, alpha_val, group_var)
            }
            result_list$levene <- list(
              test_name = "Levene's Test",
              statistic = f_val,
              df1 = df1_val,
              df2 = df2_val,
              p_value = p_val_lev,
              formatted_p = fmt_p_lev,
              message = msg_lev,
              is_homogeneous = is_homogeneous,
              scope = "mixed_between_factor_subject_means"
            )
          }
        } else if (n_between_groups > 2) {
          bt_res <- tryCatch({
            bartlett.test(as.formula(paste(response_var, "~", group_var)), data = mixed_homo_data)
          }, error = function(e) { NULL })
          if (!is.null(bt_res)) {
            p_val_bt <- bt_res$p.value
            is_homogeneous <- (p_val_bt >= alpha_val)
            fmt_p_bt <- if (p_val_bt < 0.0001) format(p_val_bt, scientific = TRUE, digits = 4) else format(round(p_val_bt, 4), nsmall = 4)
            msg_bt <- if (is_homogeneous) {
              sprintf("Bartlett's p-value is %s (>= %f). Variances are homogeneous for the between-subject factor (%s) in the mixed design.", fmt_p_bt, alpha_val, group_var)
            } else {
              sprintf("Bartlett's p-value is %s (< %f). Variances are NOT homogeneous for the between-subject factor (%s) in the mixed design.", fmt_p_bt, alpha_val, group_var)
            }
            result_list$bartlett <- list(
              statistic = as.numeric(bt_res$statistic),
              df = as.numeric(bt_res$parameter),
              p_value = p_val_bt,
              formatted_p = fmt_p_bt,
              message = msg_bt,
              is_homogeneous = is_homogeneous,
              scope = "mixed_between_factor_subject_means"
            )
          }
        }
      }
    } else if (!is_factorial && n_groups >= 2) {
      if (n_groups == 2) {
        lev_res <- tryCatch({
          grp <- as.factor(data[[group_var]])
          y <- data[[response_var]]
          centers <- tapply(y, grp, median, na.rm = TRUE)
          z <- abs(y - centers[grp])
          lev_df <- data.frame(z = z, group = grp)
          summary(aov(z ~ group, data = lev_df))[[1]]
        }, error = function(e) { NULL })
        if (!is.null(lev_res)) {
          f_val <- as.numeric(lev_res[["F value"]][1])
          df1_val <- as.numeric(lev_res[["Df"]][1])
          df2_val <- as.numeric(lev_res[["Df"]][2])
          p_val_lev <- as.numeric(lev_res[["Pr(>F)"]][1])
          is_homogeneous <- (p_val_lev >= alpha_val)
          fmt_p_lev <- if (p_val_lev < 0.0001) format(p_val_lev, scientific = TRUE, digits = 4) else format(round(p_val_lev, 4), nsmall = 4)
          msg_lev <- if (is_homogeneous) sprintf("Levene's p-value is %s (>= %f). Variances are homogeneous.", fmt_p_lev, alpha_val)
          else sprintf("Levene's p-value is %s (< %f). Variances are NOT homogeneous.", fmt_p_lev, alpha_val)
          result_list$levene <- list(
            test_name = "Levene's Test",
            statistic = f_val,
            df1 = df1_val,
            df2 = df2_val,
            p_value = p_val_lev,
            formatted_p = fmt_p_lev,
            message = msg_lev,
            is_homogeneous = is_homogeneous
          )
        }
      } else if (n_groups > 2) {
        bt_res <- tryCatch({ bartlett.test(as.formula(paste(response_var, "~", group_var)), data = data) }, error = function(e) { NULL })
        if (!is.null(bt_res)) {
          p_val_bt <- bt_res$p.value
          is_homogeneous <- (p_val_bt >= alpha_val)
          fmt_p_bt <- if (p_val_bt < 0.0001) format(p_val_bt, scientific = TRUE, digits = 4) else format(round(p_val_bt, 4), nsmall = 4)
          msg_bt <- if (is_homogeneous) sprintf("Bartlett's p-value is %s (>= %f). Variances are homogeneous.", fmt_p_bt, alpha_val)
          else sprintf("Bartlett's p-value is %s (< %f). Variances are NOT homogeneous.", fmt_p_bt, alpha_val)
          result_list$bartlett <- list(statistic = as.numeric(bt_res$statistic), df = as.numeric(bt_res$parameter), p_value = p_val_bt, formatted_p = fmt_p_bt, message = msg_bt, is_homogeneous = is_homogeneous)
        }
      }
    } else if (is_factorial) {
      bt_res <- tryCatch({
        combo <- interaction(data[[group_var]], data[[group_var2]], drop = TRUE)
        bartlett.test(data[[response_var]] ~ combo)
      }, error = function(e) { NULL })
      if (!is.null(bt_res)) {
        p_val_bt <- bt_res$p.value
        is_homogeneous <- (p_val_bt >= alpha_val)
        fmt_p_bt <- if (p_val_bt < 0.0001) format(p_val_bt, scientific = TRUE, digits = 4) else format(round(p_val_bt, 4), nsmall = 4)
        msg_bt <- if (is_homogeneous) sprintf("Bartlett's p-value is %s (>= %f). Variances are homogeneous across factor combinations.", fmt_p_bt, alpha_val)
        else sprintf("Bartlett's p-value is %s (< %f). Variances are NOT homogeneous across factor combinations.", fmt_p_bt, alpha_val)
        result_list$bartlett <- list(statistic = as.numeric(bt_res$statistic), df = as.numeric(bt_res$parameter), p_value = p_val_bt, formatted_p = fmt_p_bt, message = msg_bt, is_homogeneous = is_homogeneous)
      }
    }
  }

  use_parametric_path <- all_normal
  emit_progress(60, "Pass 3", "Path selection", if (use_parametric_path) "parametric" else "non-parametric")

  # 2b. Sphericity checks for factorial repeated/mixed designs (Mauchly family).
  # Mauchly is only reported for parametric repeated-measures paths.
  if (use_parametric_path && is_factorial && factorial_design %in% c("within", "mixed")) {
    sphericity_checks_pre <- compute_factorial_sphericity_checks(
      data,
      factorial_design,
      subject_var,
      group_var,
      group_var2,
      response_var,
      alpha_val
    )
    if (length(sphericity_checks_pre) > 0) {
      result_list$sphericity_checks <- sphericity_checks_pre
      result_list$sphericity_messages <- lapply(sphericity_checks_pre, function(x) x$message)
      sph_plot <- create_sphericity_overview_plot(sphericity_checks_pre, output_image, alpha_val)
      result_list$sphericity_plot_generated <- isTRUE(sph_plot$generated)
      if (isTRUE(sph_plot$generated) && !is.null(sph_plot$path)) {
        result_list$sphericity_plot_path <- sph_plot$path
      } else if (!is.null(sph_plot$error)) {
        result_list$sphericity_plot_error <- sph_plot$error
      }
    }
  }

  if (use_parametric_path) {
    result_list$path_taken <- "parametric"
    
    # Check if variances are homogeneous (independent-group paths only)
    is_homogeneous <- if (!is.null(result_list$levene) && !is.null(result_list$levene$is_homogeneous)) result_list$levene$is_homogeneous else if (!is.null(result_list$bartlett) && !is.null(result_list$bartlett$is_homogeneous)) result_list$bartlett$is_homogeneous else TRUE
    
    # FACTORIAL DESIGN: Two-Way ANOVA
    if (is_factorial) {
      result_list$test_type <- "two-way-anova"
      result_list$is_factorial <- TRUE
      result_list$factor1 <- group_var
      result_list$factor2 <- group_var2

      anova_plot_error <- NULL
      tryCatch({
        if (!requireNamespace("ggplot2", quietly = TRUE)) {
          stop("Missing plotting package: ggplot2")
        }
        plot_df <- data
        plot_df[[group_var]] <- as.factor(plot_df[[group_var]])
        plot_df[[group_var2]] <- as.factor(plot_df[[group_var2]])
        factor2_levels <- levels(plot_df[[group_var2]])
        factor2_fill_values <- get_level_color_map(
          group_var2,
          factor2_levels,
          pick_cols(length(factor2_levels))
        )
        factor2_color_intensity <- get_custom_plot_intensity("anova_factorial_fill_intensity", 1)
        factor2_fill_values <- apply_intensity_to_color_map(factor2_fill_values, factor2_color_intensity)
        factorial_box_border_color <- get_custom_plot_color("anova_factorial_box_border_color", "#1f2937")
        factorial_outlier_color <- get_custom_plot_color("anova_factorial_outlier_color", "#f59e0b")

        output_image_anova <- gsub("\\.png$", "_anova.png", output_image)
        p_anova <- ggplot(plot_df, aes(x = .data[[group_var]], y = .data[[response_var]], fill = .data[[group_var2]])) +
          geom_boxplot(
            alpha = 0.78,
            color = factorial_box_border_color,
            outlier.colour = factorial_outlier_color,
            position = position_dodge(width = 0.85)
          ) +
          scale_fill_manual(values = factor2_fill_values, drop = FALSE) +
          labs(
            title = "Two-Way ANOVA Boxplot",
            x = group_var,
            y = response_var,
            fill = group_var2
          ) +
          theme_bw() +
          theme(
            panel.grid.major = element_blank(),
            panel.grid.minor = element_blank(),
            plot.title = element_text(face = "bold", size = 14),
            axis.title = element_text(face = "bold")
          )

        custom_ggsave(output_image_anova, plot = p_anova, width = 10.5, height = 8, dpi = 300, device = "png")
        result_list$anova_plot_generated <- TRUE
        result_list$anova_plot_path <- output_image_anova
      }, error = function(e) {
        call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
        anova_plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
      })
      if (!is.null(anova_plot_error)) {
        result_list$anova_plot_error <- anova_plot_error
      }
      
      if (factorial_design %in% c("within", "mixed")) {
        if (is.null(subject_var) || !(subject_var %in% colnames(data))) {
          stop(sprintf("Two-way %s ANOVA requires a Subject ID variable. Please select one in the UI.", factorial_design))
        }

        data[[subject_var]] <- as.factor(data[[subject_var]])

        fmt_p <- function(pv) {
          if (is.na(pv)) return("N/A")
          if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
          format(round(pv, 4), nsmall = 4)
        }

        eta_label <- function(val) {
          if (is.na(val)) return("unknown")
          if (val < 0.01) return("negligible")
          if (val < 0.06) return("small")
          if (val < 0.14) return("medium")
          "large"
        }

        if (factorial_design == "mixed") {
          # Mixed ANOVA: 1 Between (group_var), 1 Within (group_var2)
          # Formula: response ~ Between * Within + Error(Subject / Within)
          formula_str <- paste(response_var, "~", group_var, "*", group_var2, "+ Error(", subject_var, "/", group_var2, ")")
        } else {
          # Two-way repeated-measures ANOVA: 2 Within
          formula_str <- paste(response_var, "~", group_var, "*", group_var2, "+ Error(", subject_var, "/(", group_var, "*", group_var2, "))")
        }

        rm_model <- aov(as.formula(formula_str), data = data)
        rm_summary <- summary(rm_model)
        anova_table_rows <- list()
        anova_row_idx <- 1
        for (nm in names(rm_summary)) {
          tbl <- rm_summary[[nm]][[1]]
          if (is.null(tbl) || nrow(tbl) == 0) next
          row_names <- trimws(rownames(tbl))
          for (i in seq_len(nrow(tbl))) {
            p_val_i <- if ("Pr(>F)" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[i, "Pr(>F)"])) else NA
            anova_table_rows[[anova_row_idx]] <- list(
              source = row_names[i],
              stratum = nm,
              df = if ("Df" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[i, "Df"])) else NA,
              sum_sq = if ("Sum Sq" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[i, "Sum Sq"])) else NA,
              mean_sq = if ("Mean Sq" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[i, "Mean Sq"])) else NA,
              statistic = if ("F value" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[i, "F value"])) else NA,
              p_value = p_val_i,
              formatted_p = if (!is.na(p_val_i)) fmt_p(p_val_i) else "N/A",
              is_residual = identical(tolower(row_names[i]), "residuals")
            )
            anova_row_idx <- anova_row_idx + 1
          }
        }
        if (length(anova_table_rows) > 0) {
          result_list$anova_table_rows <- anova_table_rows
        }

        extract_rm_term <- function(term_label, factor_name = NULL, is_interaction = FALSE) {
          found_tbl <- NULL
          term_idx <- NA
          res_idx <- NA
          for (nm in names(rm_summary)) {
            tbl <- rm_summary[[nm]][[1]]
            if (!is.null(tbl)) {
              row_names <- trimws(rownames(tbl))
              if (term_label %in% row_names) {
                found_tbl <- tbl
                term_idx <- which(row_names == term_label)[1]
                res_idx <- if ("Residuals" %in% row_names) which(row_names == "Residuals")[1] else NA
                break
              }
            }
          }
          if (is.null(found_tbl)) return(NULL)

          df_num <- as.numeric(found_tbl[term_idx, "Df"])
          df_den <- if (!is.na(res_idx)) as.numeric(found_tbl[res_idx, "Df"]) else NA
          f_val <- as.numeric(found_tbl[term_idx, "F value"])
          p_val <- as.numeric(found_tbl[term_idx, "Pr(>F)"])
          ss_effect <- as.numeric(found_tbl[term_idx, "Sum Sq"])
          ss_error <- if (!is.na(res_idx)) as.numeric(found_tbl[res_idx, "Sum Sq"]) else NA

          eta_sq <- if (!is.na(ss_effect) && !is.na(ss_error) && (ss_effect + ss_error) > 0) ss_effect / (ss_effect + ss_error) else NA
          if (is.na(eta_sq)) eta_sq <- 0

          eta_lbl <- eta_label(eta_sq)
          is_sig <- !is.na(p_val) && (p_val < alpha_val)
          fmt_p_val <- fmt_p(p_val)
          df_num_label <- if (is.na(df_num)) "NA" else as.character(round(df_num))
          df_den_label <- if (is.na(df_den)) "NA" else as.character(round(df_den))

          msg <- if (is_interaction) {
            if (is_sig) {
              sprintf("Interaction effect (%s × %s) is significant (F(%s,%s) = %.3f, p = %s, η² = %.3f). The effect of one factor depends on the level of the other.",
                      group_var, group_var2, df_num_label, df_den_label, f_val, fmt_p_val, eta_sq)
            } else {
              sprintf("Interaction effect (%s × %s) is NOT significant (F(%s,%s) = %.3f, p = %s, η² = %.3f). The factors act independently.",
                      group_var, group_var2, df_num_label, df_den_label, f_val, fmt_p_val, eta_sq)
            }
          } else {
            if (is_sig) {
              sprintf("Main effect of %s is significant (F(%s,%s) = %.3f, p = %s, η² = %.3f).",
                      factor_name, df_num_label, df_den_label, f_val, fmt_p_val, eta_sq)
            } else {
              sprintf("Main effect of %s is NOT significant (F(%s,%s) = %.3f, p = %s, η² = %.3f).",
                      factor_name, df_num_label, df_den_label, f_val, fmt_p_val, eta_sq)
            }
          }

          list(
            factor_name = factor_name,
            f_statistic = as.numeric(f_val),
            df_num = df_num,
            df_den = df_den,
            p_value = p_val,
            formatted_p = fmt_p_val,
            eta_squared = eta_sq,
            effect_size_label = eta_lbl,
            is_significant = is_sig,
            message = msg
          )
        }

        main_A <- extract_rm_term(group_var, factor_name = group_var, is_interaction = FALSE)
        main_B <- extract_rm_term(group_var2, factor_name = group_var2, is_interaction = FALSE)
        inter_term <- paste(group_var, group_var2, sep = ":")
        inter <- extract_rm_term(inter_term, factor_name = "Interaction", is_interaction = TRUE)

        apply_sphericity_to_effect <- function(effect_obj, sph_obj, effect_label) {
          if (is.null(effect_obj) || is.null(sph_obj) || !isTRUE(sph_obj$applicable)) return(effect_obj)
          effect_obj$sphericity <- sph_obj
          if (!is.na(sph_obj$p_final)) {
            effect_obj$p_value <- sph_obj$p_final
            effect_obj$formatted_p <- fmt_p(sph_obj$p_final)
            effect_obj$is_significant <- sph_obj$p_final < alpha_val
          }
          if (isTRUE(sph_obj$sphericity_violated)) {
            effect_obj$message <- paste0(effect_obj$message, " ", effect_label, ": ", sph_obj$message)
          }
          effect_obj
        }

        sphericity_checks <- list()
        if (factorial_design == "mixed") {
          sph_b <- compute_sphericity_profile(data, subject_var, group_var2, response_var, alpha_val)
          sphericity_checks[[group_var2]] <- sph_b
          main_B <- apply_sphericity_to_effect(main_B, sph_b, group_var2)
          inter <- apply_sphericity_to_effect(inter, sph_b, "Interaction")
        } else {
          data_a <- aggregate(as.formula(paste(response_var, "~", subject_var, "+", group_var)), data = data, FUN = mean)
          data_b <- aggregate(as.formula(paste(response_var, "~", subject_var, "+", group_var2)), data = data, FUN = mean)
          data_ab <- data[, c(subject_var, group_var, group_var2, response_var), drop = FALSE]
          data_ab$..AB <- interaction(data_ab[[group_var]], data_ab[[group_var2]], drop = TRUE, sep = ":")
          data_ab <- data_ab[, c(subject_var, "..AB", response_var), drop = FALSE]

          sph_a <- compute_sphericity_profile(data_a, subject_var, group_var, response_var, alpha_val)
          sph_b <- compute_sphericity_profile(data_b, subject_var, group_var2, response_var, alpha_val)
          sph_ab <- compute_sphericity_profile(data_ab, subject_var, "..AB", response_var, alpha_val)
          sphericity_checks[[group_var]] <- sph_a
          sphericity_checks[[group_var2]] <- sph_b
          sphericity_checks[[paste(group_var, group_var2, sep = ":")]] <- sph_ab

          main_A <- apply_sphericity_to_effect(main_A, sph_a, group_var)
          main_B <- apply_sphericity_to_effect(main_B, sph_b, group_var2)
          inter <- apply_sphericity_to_effect(inter, sph_ab, "Interaction")
        }

        if (length(sphericity_checks) > 0) {
          result_list$sphericity_checks <- sphericity_checks
          result_list$sphericity_messages <- lapply(sphericity_checks, function(x) x$message)
        }

        if (!is.null(main_A)) result_list$main_effect_A <- main_A
        if (!is.null(main_B)) result_list$main_effect_B <- main_B
        if (!is.null(inter)) result_list$interaction <- inter

        posthoc_rows <- list()
        add_posthoc <- function(rows) {
          if (!is.null(rows) && length(rows) > 0) {
            posthoc_rows <<- c(posthoc_rows, rows)
          }
        }
        run_factorial_posthoc <- has_significant_factorial_effect(main_A, main_B, inter)

        if (run_factorial_posthoc) {
          if (factorial_design == "mixed") {
            # Main effects
            add_posthoc(calc_pairwise_independent_tukey(data, group_var, response_var, group_var, alpha_val, "holm"))
            add_posthoc(calc_pairwise_paired_t(data, subject_var, group_var2, response_var, group_var2, alpha_val, "holm"))

            # Simple effects
            lvls_a <- levels(as.factor(data[[group_var]]))
            for (lvl in lvls_a) {
              sub_df <- data[data[[group_var]] == lvl, , drop = FALSE]
              add_posthoc(calc_pairwise_paired_t(sub_df, subject_var, group_var2, response_var, paste(group_var2, "|", paste0(group_var, "=", lvl)), alpha_val, "holm"))
            }
            lvls_b <- levels(as.factor(data[[group_var2]]))
            for (lvl in lvls_b) {
              sub_df <- data[data[[group_var2]] == lvl, , drop = FALSE]
              add_posthoc(calc_pairwise_independent_tukey(sub_df, group_var, response_var, paste(group_var, "|", paste0(group_var2, "=", lvl)), alpha_val, "holm"))
            }
          } else {
            # Main effects
            add_posthoc(calc_pairwise_paired_t(data, subject_var, group_var, response_var, group_var, alpha_val, "holm"))
            add_posthoc(calc_pairwise_paired_t(data, subject_var, group_var2, response_var, group_var2, alpha_val, "holm"))

            # Simple effects
            lvls_b <- levels(as.factor(data[[group_var2]]))
            for (lvl in lvls_b) {
              sub_df <- data[data[[group_var2]] == lvl, , drop = FALSE]
              add_posthoc(calc_pairwise_paired_t(sub_df, subject_var, group_var, response_var, paste(group_var, "|", paste0(group_var2, "=", lvl)), alpha_val, "holm"))
            }
            lvls_a <- levels(as.factor(data[[group_var]]))
            for (lvl in lvls_a) {
              sub_df <- data[data[[group_var]] == lvl, , drop = FALSE]
              add_posthoc(calc_pairwise_paired_t(sub_df, subject_var, group_var2, response_var, paste(group_var2, "|", paste0(group_var, "=", lvl)), alpha_val, "holm"))
            }
          }
          result_list$posthoc_strategy <- "Effect-aware mode: post-hoc contrasts computed only after significant factorial effects."
          if (length(posthoc_rows) > 0) {
            result_list$holm_posthoc <- posthoc_rows
          }
        } else {
          result_list$posthoc_skipped_reason <- "No significant factorial effect detected; post-hoc contrasts were skipped."
        }

        result_list$is_paired_factorial <- TRUE
        result_list$factorial_design_type <- factorial_design
      } else if (!is_homogeneous) {
        # Robust two-way ANOVA for unequal variances (HC3)
        if (!requireNamespace("sandwich", quietly = TRUE, lib.loc = local_lib)) {
          stop("sandwich package is required for robust two-way ANOVA.")
        }

        formula_str <- paste(response_var, "~", group_var, "*", group_var2)
        lm_model <- lm(as.formula(formula_str), data = data)
        mm <- model.matrix(lm_model)
        assign_vec <- attr(mm, "assign")
        term_labels <- attr(terms(lm_model), "term.labels")
        beta <- coef(lm_model)
        df_resid <- df.residual(lm_model)
        V <- sandwich::vcovHC(lm_model, type = "HC3")

        fmt_p <- function(pv) {
          if (is.na(pv)) return("N/A")
          if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
          format(round(pv, 4), nsmall = 4)
        }

        eta_label <- function(val) {
          if (is.na(val)) return("unknown")
          if (val < 0.01) return("negligible")
          if (val < 0.06) return("small")
          if (val < 0.14) return("medium")
          "large"
        }

        robust_term <- function(term_label, factor_name, is_interaction = FALSE) {
          term_idx <- match(term_label, term_labels)
          if (is.na(term_idx)) return(NULL)
          cols <- which(assign_vec == term_idx)
          if (length(cols) == 0) return(NULL)
          L <- diag(length(beta))[cols, , drop = FALSE]

          wald <- tryCatch({
            lb <- L %*% beta
            Vc <- L %*% V %*% t(L)
            as.numeric(t(lb) %*% solve(Vc, lb))
          }, error = function(e) NA)

          df1 <- length(cols)
          f_val <- if (!is.na(wald)) wald / df1 else NA
          p_val <- if (!is.na(f_val) && !is.na(df_resid) && df_resid > 0) pf(f_val, df1, df_resid, lower.tail = FALSE) else NA
          eta_sq <- if (!is.na(f_val) && !is.na(df_resid)) (f_val * df1) / (f_val * df1 + df_resid) else NA
          eta_lbl <- eta_label(eta_sq)
          is_sig <- !is.na(p_val) && (p_val < alpha_val)
          fmt_p_val <- fmt_p(p_val)

          msg <- if (is_interaction) {
            if (is_sig) {
              sprintf("Robust two-way ANOVA (HC3): Interaction effect (%s × %s) is significant (F(%d,%d) = %.3f, p = %s, η² = %.3f).",
                      group_var, group_var2, df1, df_resid, f_val, fmt_p_val, eta_sq)
            } else {
              sprintf("Robust two-way ANOVA (HC3): Interaction effect (%s × %s) is NOT significant (F(%d,%d) = %.3f, p = %s, η² = %.3f).",
                      group_var, group_var2, df1, df_resid, f_val, fmt_p_val, eta_sq)
            }
          } else {
            if (is_sig) {
              sprintf("Robust two-way ANOVA (HC3): Main effect of %s is significant (F(%d,%d) = %.3f, p = %s, η² = %.3f).",
                      factor_name, df1, df_resid, f_val, fmt_p_val, eta_sq)
            } else {
              sprintf("Robust two-way ANOVA (HC3): Main effect of %s is NOT significant (F(%d,%d) = %.3f, p = %s, η² = %.3f).",
                      factor_name, df1, df_resid, f_val, fmt_p_val, eta_sq)
            }
          }

          list(
            factor_name = factor_name,
            f_statistic = as.numeric(f_val),
            df_num = df1,
            df_den = df_resid,
            p_value = p_val,
            formatted_p = fmt_p_val,
            eta_squared = eta_sq,
            effect_size_label = eta_lbl,
            is_significant = is_sig,
            message = msg
          )
        }

        main_A <- robust_term(group_var, factor_name = group_var, is_interaction = FALSE)
        main_B <- robust_term(group_var2, factor_name = group_var2, is_interaction = FALSE)
        inter_term <- paste(group_var, group_var2, sep = ":")
        inter <- robust_term(inter_term, factor_name = "Interaction", is_interaction = TRUE)

        if (!is.null(main_A)) result_list$main_effect_A <- main_A
        if (!is.null(main_B)) result_list$main_effect_B <- main_B
        if (!is.null(inter)) result_list$interaction <- inter

        result_list$anova_robust <- TRUE
        result_list$robust_method <- "HC3"
        result_list$anova_table_rows <- Filter(Negate(is.null), list(
          if (!is.null(main_A)) list(
            source = as.character(group_var),
            df = as.numeric(main_A$df_num),
            sum_sq = NA,
            mean_sq = NA,
            statistic = as.numeric(main_A$f_statistic),
            p_value = as.numeric(main_A$p_value),
            formatted_p = main_A$formatted_p,
            is_residual = FALSE
          ) else NULL,
          if (!is.null(main_B)) list(
            source = as.character(group_var2),
            df = as.numeric(main_B$df_num),
            sum_sq = NA,
            mean_sq = NA,
            statistic = as.numeric(main_B$f_statistic),
            p_value = as.numeric(main_B$p_value),
            formatted_p = main_B$formatted_p,
            is_residual = FALSE
          ) else NULL,
          if (!is.null(inter)) list(
            source = paste(group_var, group_var2, sep = ":"),
            df = as.numeric(inter$df_num),
            sum_sq = NA,
            mean_sq = NA,
            statistic = as.numeric(inter$f_statistic),
            p_value = as.numeric(inter$p_value),
            formatted_p = inter$formatted_p,
            is_residual = FALSE
          ) else NULL,
          list(
            source = "Residuals",
            df = as.numeric(df_resid),
            sum_sq = NA,
            mean_sq = NA,
            statistic = NA,
            p_value = NA,
            formatted_p = "N/A",
            is_residual = TRUE
          )
        ))

        # Games-Howell post-hoc for two-way (main effects + simple effects)
        calc_games_howell <- function(values, groups, term_label) {
          groups <- as.factor(groups)
          group_levels <- levels(groups)
          n_groups <- length(group_levels)
          if (n_groups < 2) return(list())
          results <- list()
          idx <- 1
          for (i in 1:(n_groups - 1)) {
            for (j in (i + 1):n_groups) {
              g1 <- group_levels[i]
              g2 <- group_levels[j]
              x1 <- values[groups == g1]
              x2 <- values[groups == g2]
              n1 <- length(x1)
              n2 <- length(x2)
              if (n1 < 2 || n2 < 2) next
              m1 <- mean(x1, na.rm = TRUE)
              m2 <- mean(x2, na.rm = TRUE)
              v1 <- var(x1, na.rm = TRUE)
              v2 <- var(x2, na.rm = TRUE)
              diff <- m1 - m2
              se <- sqrt(v1/n1 + v2/n2)
              t_stat <- diff / se
              df <- (v1/n1 + v2/n2)^2 / ((v1/n1)^2/(n1-1) + (v2/n2)^2/(n2-1))
              p_val <- 2 * pt(-abs(t_stat), df)
              n_comparisons <- n_groups * (n_groups - 1) / 2
              p_adj <- pmin(1, p_val * n_comparisons)
              q_crit <- qtukey(1 - alpha_val, n_groups, df) / sqrt(2)
              ci_half <- q_crit * se
              results[[idx]] <- list(
                term = term_label,
                comparison = paste(g1, "-", g2),
                diff = diff,
                se = se,
                t_stat = t_stat,
                df = df,
                lwr = diff - ci_half,
                upr = diff + ci_half,
                p_adj = p_adj,
                formatted_p = fmt_p(p_adj),
                is_significant = (!is.na(p_adj) && p_adj < alpha_val)
              )
              idx <- idx + 1
            }
          }
          if (inferential_significant_only) {
            results <- Filter(function(x) isTRUE(x$is_significant), results)
          }
          results
        }

        run_factorial_posthoc <- has_significant_factorial_effect(main_A, main_B, inter)
        if (run_factorial_posthoc) {
          gh_results <- list()
          gh_results <- c(gh_results, calc_games_howell(data[[response_var]], data[[group_var]], group_var))
          gh_results <- c(gh_results, calc_games_howell(data[[response_var]], data[[group_var2]], group_var2))
          lvls_b <- levels(as.factor(data[[group_var2]]))
          for (lvl in lvls_b) {
            idx <- data[[group_var2]] == lvl
            gh_results <- c(gh_results, calc_games_howell(
              data[[response_var]][idx],
              data[[group_var]][idx],
              paste(group_var, "|", paste0(group_var2, "=", lvl))
            ))
          }
          lvls_a <- levels(as.factor(data[[group_var]]))
          for (lvl in lvls_a) {
            idx <- data[[group_var]] == lvl
            gh_results <- c(gh_results, calc_games_howell(
              data[[response_var]][idx],
              data[[group_var2]][idx],
              paste(group_var2, "|", paste0(group_var, "=", lvl))
            ))
          }
          result_list$posthoc_strategy <- "Effect-aware mode: Games-Howell contrasts computed only after significant factorial effects."
          if (length(gh_results) > 0) result_list$games_howell <- gh_results
        } else {
          result_list$posthoc_skipped_reason <- "No significant factorial effect detected; Games-Howell post-hoc contrasts were skipped."
        }
      } else {
        # Build formula: response ~ factor1 * factor2 (includes interaction)
        formula_str <- paste(response_var, "~", group_var, "*", group_var2)
        anova_model <- aov(as.formula(formula_str), data = data)
        anova_summary <- summary(anova_model)[[1]]
        
        # Calculate total sum of squares for effect sizes
        ss_total <- sum(anova_summary[["Sum Sq"]])
        
        # Extract main effect for Factor 1
        factor1_row <- 1
        ss_factor1 <- anova_summary[["Sum Sq"]][factor1_row]
        f_factor1 <- anova_summary[["F value"]][factor1_row]
        p_factor1 <- anova_summary[["Pr(>F)"]][factor1_row]
        df_factor1 <- anova_summary[["Df"]][factor1_row]
        eta_sq_factor1 <- ss_factor1 / ss_total
        is_sig_factor1 <- (p_factor1 < alpha_val)
        fmt_p_factor1 <- if (p_factor1 < 0.0001) format(p_factor1, scientific = TRUE, digits = 4) else format(round(p_factor1, 4), nsmall = 4)
        
        msg_factor1 <- if (is_sig_factor1) {
          sprintf("Main effect of %s is significant (F(%d,%d) = %.3f, p = %s, η² = %.3f)", 
                  group_var, df_factor1, anova_summary[["Df"]][4], f_factor1, fmt_p_factor1, eta_sq_factor1)
        } else {
          sprintf("Main effect of %s is NOT significant (F(%d,%d) = %.3f, p = %s, η² = %.3f)", 
                  group_var, df_factor1, anova_summary[["Df"]][4], f_factor1, fmt_p_factor1, eta_sq_factor1)
        }
        
        result_list$main_effect_A <- list(
          factor_name = group_var,
          f_statistic = as.numeric(f_factor1),
          df_num = df_factor1,
          df_den = anova_summary[["Df"]][4],
          p_value = p_factor1,
          formatted_p = fmt_p_factor1,
          eta_squared = eta_sq_factor1,
          is_significant = is_sig_factor1,
          message = msg_factor1
        )
        
        # Extract main effect for Factor 2
        factor2_row <- 2
        ss_factor2 <- anova_summary[["Sum Sq"]][factor2_row]
        f_factor2 <- anova_summary[["F value"]][factor2_row]
        p_factor2 <- anova_summary[["Pr(>F)"]][factor2_row]
        df_factor2 <- anova_summary[["Df"]][factor2_row]
        eta_sq_factor2 <- ss_factor2 / ss_total
        is_sig_factor2 <- (p_factor2 < alpha_val)
        fmt_p_factor2 <- if (p_factor2 < 0.0001) format(p_factor2, scientific = TRUE, digits = 4) else format(round(p_factor2, 4), nsmall = 4)
        
        msg_factor2 <- if (is_sig_factor2) {
          sprintf("Main effect of %s is significant (F(%d,%d) = %.3f, p = %s, η² = %.3f)", 
                  group_var2, df_factor2, anova_summary[["Df"]][4], f_factor2, fmt_p_factor2, eta_sq_factor2)
        } else {
          sprintf("Main effect of %s is NOT significant (F(%d,%d) = %.3f, p = %s, η² = %.3f)", 
                  group_var2, df_factor2, anova_summary[["Df"]][4], f_factor2, fmt_p_factor2, eta_sq_factor2)
        }
        
        result_list$main_effect_B <- list(
          factor_name = group_var2,
          f_statistic = as.numeric(f_factor2),
          df_num = df_factor2,
          df_den = anova_summary[["Df"]][4],
          p_value = p_factor2,
          formatted_p = fmt_p_factor2,
          eta_squared = eta_sq_factor2,
          is_significant = is_sig_factor2,
          message = msg_factor2
        )
        
        # Extract interaction effect
        interaction_row <- 3
        ss_interaction <- anova_summary[["Sum Sq"]][interaction_row]
        f_interaction <- anova_summary[["F value"]][interaction_row]
        p_interaction <- anova_summary[["Pr(>F)"]][interaction_row]
        df_interaction <- anova_summary[["Df"]][interaction_row]
        eta_sq_interaction <- ss_interaction / ss_total
        is_sig_interaction <- (p_interaction < alpha_val)
        fmt_p_interaction <- if (p_interaction < 0.0001) format(p_interaction, scientific = TRUE, digits = 4) else format(round(p_interaction, 4), nsmall = 4)
        
        msg_interaction <- if (is_sig_interaction) {
          sprintf("Interaction effect (%s × %s) is significant (F(%d,%d) = %.3f, p = %s, η² = %.3f). The effect of one factor depends on the level of the other.", 
                  group_var, group_var2, df_interaction, anova_summary[["Df"]][4], f_interaction, fmt_p_interaction, eta_sq_interaction)
        } else {
          sprintf("Interaction effect (%s × %s) is NOT significant (F(%d,%d) = %.3f, p = %s, η² = %.3f). The factors act independently.", 
                  group_var, group_var2, df_interaction, anova_summary[["Df"]][4], f_interaction, fmt_p_interaction, eta_sq_interaction)
        }
        
        result_list$interaction <- list(
          f_statistic = as.numeric(f_interaction),
          df_num = df_interaction,
          df_den = anova_summary[["Df"]][4],
          p_value = p_interaction,
          formatted_p = fmt_p_interaction,
          eta_squared = eta_sq_interaction,
          is_significant = is_sig_interaction,
          message = msg_interaction
        )
        table_row_names <- rownames(anova_summary)
        anova_table_rows <- lapply(seq_len(nrow(anova_summary)), function(i) {
          source_name <- trimws(table_row_names[i])
          p_raw <- suppressWarnings(as.numeric(anova_summary[["Pr(>F)"]][i]))
          list(
            source = source_name,
            df = suppressWarnings(as.numeric(anova_summary[["Df"]][i])),
            sum_sq = suppressWarnings(as.numeric(anova_summary[["Sum Sq"]][i])),
            mean_sq = suppressWarnings(as.numeric(anova_summary[["Mean Sq"]][i])),
            statistic = suppressWarnings(as.numeric(anova_summary[["F value"]][i])),
            p_value = p_raw,
            formatted_p = if (!is.na(p_raw)) fmt_p_value(p_raw) else "N/A",
            is_residual = identical(tolower(source_name), "residuals")
          )
        })
        if (length(anova_table_rows) > 0) {
          result_list$anova_table_rows <- anova_table_rows
        }

        # Tukey HSD post-hoc for two-way (main effects + simple effects)
        tukey_list <- list()
        idx <- 1
        add_tukey_rows <- function(term_df, term_label) {
          if (is.null(term_df) || nrow(term_df) == 0) return()
          term_df$comparison <- rownames(term_df)
          for (i in 1:nrow(term_df)) {
            p_adj_val <- term_df$`p adj`[i]
            tukey_list[[idx]] <<- list(
              term = term_label,
              comparison = term_df$comparison[i],
              diff = as.numeric(term_df$diff[i]),
              lwr = as.numeric(term_df$lwr[i]),
              upr = as.numeric(term_df$upr[i]),
              p_adj = p_adj_val,
              formatted_p = if (p_adj_val < 0.0001) format(p_adj_val, scientific = TRUE, digits = 4) else format(round(p_adj_val, 4), nsmall = 4),
              is_significant = (p_adj_val < alpha_val)
            )
            idx <<- idx + 1
          }
        }

        run_factorial_posthoc <- has_significant_factorial_effect(
          result_list$main_effect_A,
          result_list$main_effect_B,
          result_list$interaction
        )
        tukey_conf_level <- resolve_conf_level_from_alpha(alpha_val)
        if (run_factorial_posthoc) {
          tukey_res_a <- TukeyHSD(anova_model, which = group_var, conf.level = tukey_conf_level)
          add_tukey_rows(as.data.frame(tukey_res_a[[group_var]]), group_var)
          tukey_res_b <- TukeyHSD(anova_model, which = group_var2, conf.level = tukey_conf_level)
          add_tukey_rows(as.data.frame(tukey_res_b[[group_var2]]), group_var2)
          lvls_b <- levels(as.factor(data[[group_var2]]))
          for (lvl in lvls_b) {
            subset_data <- data[data[[group_var2]] == lvl, , drop = FALSE]
            if (length(unique(subset_data[[group_var]])) < 2) next
            sub_aov <- aov(as.formula(paste(response_var, "~", group_var)), data = subset_data)
            sub_tukey <- TukeyHSD(sub_aov, which = group_var, conf.level = tukey_conf_level)
            add_tukey_rows(as.data.frame(sub_tukey[[group_var]]), paste(group_var, "|", paste0(group_var2, "=", lvl)))
          }
          lvls_a <- levels(as.factor(data[[group_var]]))
          for (lvl in lvls_a) {
            subset_data <- data[data[[group_var]] == lvl, , drop = FALSE]
            if (length(unique(subset_data[[group_var2]])) < 2) next
            sub_aov <- aov(as.formula(paste(response_var, "~", group_var2)), data = subset_data)
            sub_tukey <- TukeyHSD(sub_aov, which = group_var2, conf.level = tukey_conf_level)
            add_tukey_rows(as.data.frame(sub_tukey[[group_var2]]), paste(group_var2, "|", paste0(group_var, "=", lvl)))
          }
          result_list$posthoc_strategy <- "Effect-aware mode: Tukey contrasts computed only after significant factorial effects."
          if (inferential_significant_only) {
            tukey_list <- Filter(function(x) isTRUE(x$is_significant), tukey_list)
          }
          if (length(tukey_list) > 0) result_list$tukey <- tukey_list
        } else {
          result_list$posthoc_skipped_reason <- "No significant factorial effect detected; Tukey post-hoc contrasts were skipped."
        }
      }

      # Generate interaction plot
      tryCatch({
        if (!requireNamespace("ggplot2", quietly = TRUE)) {
          stop("ggplot2 package required for interaction plot")
        }
        library(ggplot2)

        factor1_levels <- levels(as.factor(data[[group_var]]))
        factor2_levels <- levels(as.factor(data[[group_var2]]))

        # Calculate cell means and selected CI for each Factor A x Factor B combination.
        interaction_data <- aggregate(
          data[[response_var]],
          by = list(factor1 = data[[group_var]], factor2 = data[[group_var2]]),
          FUN = function(x) c(
            mean = mean(x, na.rm = TRUE),
            sd = stats::sd(x, na.rm = TRUE),
            n = sum(!is.na(x))
          )
        )

        means_df <- data.frame(
          factor1 = interaction_data$factor1,
          factor2 = interaction_data$factor2,
          mean = as.numeric(interaction_data$x[, "mean"]),
          sd = as.numeric(interaction_data$x[, "sd"]),
          n = as.numeric(interaction_data$x[, "n"]),
          stringsAsFactors = FALSE
        )
        means_df$factor1 <- factor(means_df$factor1, levels = factor1_levels)
        means_df$factor2 <- factor(means_df$factor2, levels = factor2_levels)
        means_df$factor1_index <- as.numeric(means_df$factor1)
        means_df$se <- ifelse(means_df$n > 0, means_df$sd / sqrt(means_df$n), NA_real_)
        means_df$ci_half <- ifelse(means_df$n > 1, stats::qt(selected_ci_prob, df = means_df$n - 1) * means_df$se, NA_real_)
        means_df$ci_half[!is.finite(means_df$ci_half)] <- 0
        means_df$ymin <- means_df$mean - means_df$ci_half
        means_df$ymax <- means_df$mean + means_df$ci_half

        col_values <- get_level_color_map(
          group_var2,
          factor2_levels,
          pick_cols(length(factor2_levels))
        )
        shape_palette <- c(16, 15, 17, 18, 8, 3, 4, 7)
        shape_values <- setNames(shape_palette[seq_along(factor2_levels)], factor2_levels)
        line_palette <- c("solid", "dashed", "dotdash", "twodash", "longdash")
        line_values <- setNames(rep(line_palette, length.out = length(factor2_levels)), factor2_levels)

        y_bounds <- range(c(means_df$ymin, means_df$ymax), na.rm = TRUE)
        if (!all(is.finite(y_bounds))) y_bounds <- range(means_df$mean, na.rm = TRUE)
        y_span <- y_bounds[2] - y_bounds[1]
        if (!is.finite(y_span) || y_span <= 0) y_span <- max(abs(y_bounds), na.rm = TRUE)
        if (!is.finite(y_span) || y_span <= 0) y_span <- 1
        bracket_step <- y_span * 0.08
        if (!is.finite(bracket_step) || bracket_step <= 0) bracket_step <- 0.3

        p_to_stars <- function(p) {
          if (!is.finite(p)) return("ns")
          if (p >= alpha_val) return("ns")
          if (p < 0.001) return("***")
          if (p < 0.01) return("**")
          "*"
        }

        sig_annotations <- data.frame(
          xstart = numeric(0),
          xend = numeric(0),
          y = numeric(0),
          label = character(0),
          stringsAsFactors = FALSE
        )

        # Reuse post-hoc simple-effect p-values when available so stars match the reported table.
        extract_simple_effect_p <- function(level_value) {
          term_key <- paste(group_var, "|", paste0(group_var2, "=", as.character(level_value)))
          candidate_sets <- list(
            result_list$tukey,
            result_list$games_howell,
            result_list$holm_posthoc,
            result_list$dunn,
            result_list$art_posthoc
          )
          for (set_rows in candidate_sets) {
            if (is.null(set_rows) || length(set_rows) == 0) next
            matched <- Filter(function(row) {
              !is.null(row$term) && as.character(row$term) == term_key
            }, set_rows)
            if (length(matched) == 0) next

            p_candidates <- suppressWarnings(as.numeric(sapply(matched, function(row) {
              if (!is.null(row$p_adj)) return(row$p_adj)
              if (!is.null(row$p_value)) return(row$p_value)
              NA_real_
            })))
            p_candidates <- p_candidates[is.finite(p_candidates)]
            if (length(p_candidates) > 0) return(min(p_candidates, na.rm = TRUE))
          }
          NA_real_
        }

        # Add simple-effects significance brackets for the common 2 x K case.
        if (length(factor1_levels) == 2 && length(factor2_levels) >= 1) {
          ann_idx <- 1
          for (lvl in factor2_levels) {
            sub <- data[
              data[[group_var2]] == lvl &
              !is.na(data[[group_var]]) &
              !is.na(data[[response_var]]),
              ,
              drop = FALSE
            ]
            sub_levels <- unique(as.character(sub[[group_var]]))
            if (!all(factor1_levels %in% sub_levels)) next

            x_a <- sub[[response_var]][sub[[group_var]] == factor1_levels[1]]
            x_b <- sub[[response_var]][sub[[group_var]] == factor1_levels[2]]
            if (length(x_a) < 2 || length(x_b) < 2) next

            p_simple <- extract_simple_effect_p(lvl)
            if (!is.finite(p_simple)) {
              p_simple <- tryCatch(
                stats::t.test(x_a, x_b, var.equal = FALSE)$p.value,
                error = function(e) NA_real_
              )
            }
            stars <- p_to_stars(p_simple)
            if (stars == "ns") next

            local_top <- max(means_df$ymax[means_df$factor2 == lvl], na.rm = TRUE)
            if (!is.finite(local_top)) local_top <- max(means_df$mean, na.rm = TRUE)
            y_loc <- local_top + bracket_step * ann_idx

            sig_annotations <- rbind(
              sig_annotations,
              data.frame(
                xstart = 1,
                xend = 2,
                y = y_loc,
                label = stars,
                stringsAsFactors = FALSE
              )
            )
            ann_idx <- ann_idx + 1
          }
        }

        annotation_top <- if (nrow(sig_annotations) > 0) {
          max(sig_annotations$y + bracket_step * 0.35, na.rm = TRUE)
        } else {
          max(means_df$ymax, na.rm = TRUE)
        }

        interaction_plot_path <- gsub("\\.png$", "_interaction.png", output_image)

        p <- ggplot(
          means_df,
          aes(
            x = factor1_index,
            y = mean,
            color = factor2,
            linetype = factor2,
            shape = factor2,
            group = factor2
          )
        ) +
          geom_line(linewidth = 1.2, alpha = 0.95) +
          geom_point(size = 3.8, stroke = 0.5) +
          geom_errorbar(aes(ymin = ymin, ymax = ymax), width = 0.08, linewidth = 0.85, alpha = 0.9) +
          scale_x_continuous(
            breaks = seq_along(factor1_levels),
            labels = factor1_levels,
            expand = expansion(mult = c(0.08, 0.08))
          ) +
          scale_color_manual(values = col_values, drop = FALSE) +
          scale_shape_manual(values = shape_values, drop = FALSE) +
          scale_linetype_manual(values = line_values, drop = FALSE) +
          expand_limits(y = annotation_top + bracket_step * 0.35) +
          labs(
            title = sprintf("Interaction Plot of %s and %s on %s", group_var, group_var2, response_var),
            subtitle = sprintf("Cell means with %d%% confidence intervals", selected_ci_percent),
            x = group_var,
            y = sprintf("Mean %s", response_var),
            color = paste(group_var2, "levels"),
            shape = paste(group_var2, "levels"),
            linetype = paste(group_var2, "levels"),
            caption = sprintf("Error bars represent %d%% confidence intervals.", selected_ci_percent)
          ) +
          theme_classic(base_size = 15) +
          theme(
            plot.title = element_text(face = "bold", size = 22, hjust = 0.5),
            plot.subtitle = element_text(size = 12, hjust = 0.5, margin = margin(b = 8)),
            axis.title = element_text(face = "bold", size = 16),
            axis.text = element_text(size = 13, color = "#1a1a1a"),
            axis.line = element_line(linewidth = 0.6, color = "#2a2a2a"),
            legend.position = "top",
            legend.direction = "vertical",
            legend.title = element_text(face = "bold", size = 12),
            legend.text = element_text(size = 12),
            legend.key.width = grid::unit(1.4, "cm"),
            panel.grid.major.y = element_line(color = "#d6d6d6", linewidth = 0.35),
            panel.grid.minor = element_blank(),
            plot.caption = element_text(size = 10, hjust = 1),
            plot.margin = margin(10, 14, 12, 12)
          ) +
          guides(
            color = guide_legend(
              override.aes = list(
                linetype = unname(line_values),
                shape = unname(shape_values),
                linewidth = 1.2,
                size = 4
              )
            ),
            linetype = "none",
            shape = "none"
          )

        if (nrow(sig_annotations) > 0) {
          p <- p +
            geom_segment(
              data = sig_annotations,
              aes(x = xstart, xend = xend, y = y, yend = y),
              inherit.aes = FALSE,
              linewidth = 0.8,
              color = "#333333"
            ) +
            geom_text(
              data = sig_annotations,
              aes(x = (xstart + xend) / 2, y = y + bracket_step * 0.15, label = label),
              inherit.aes = FALSE,
              size = 7,
              fontface = "bold",
              color = "#1f1f1f"
            )
        }

        custom_ggsave(interaction_plot_path, plot = p, width = 12, height = 8, dpi = 320, device = "png")
        result_list$interaction_plot_generated <- TRUE
        result_list$interaction_plot_path <- interaction_plot_path
      }, error = function(e) {
        result_list$interaction_plot_error <- e$message
      })
      
    } else {
      # SINGLE-FACTOR DESIGN
      # Count number of groups
      groups <- unique(data[[group_var]])
      n_groups <- length(groups)
      result_list$n_groups <- n_groups
      result_list$is_factorial <- FALSE
    
    if (n_groups == 2) {
      # TWO-GROUP COMPARISON: Use t-test
      result_list$test_type <- "t-test"
      
      # Extract data for each group
      g1 <- groups[1]
      g2 <- groups[2]
      x1 <- data[[response_var]][data[[group_var]] == g1]
      x2 <- data[[response_var]][data[[group_var]] == g2]
      
      if (is_paired) {
        # 3c. Paired t-test
        # Ensure lengths match (basic check, real paired requires sorted/matched data)
        if (length(x1) == length(x2)) {
          t_res <- t.test(x1, x2, paired = TRUE, conf.level = selected_ci_level)
          test_name <- "Paired t-test"
        } else {
             # Fallback if lengths differ
             t_res <- if(is_homogeneous) t.test(x1, x2, var.equal=TRUE, conf.level = selected_ci_level) else t.test(x1, x2, var.equal=FALSE, conf.level = selected_ci_level)
             test_name <- paste("Student's/Welch's t-test (Paired fallback due to uneven lengths n1=", length(x1), " n2=", length(x2), ")")
        }
      } else {
         if (is_homogeneous) {
            # 3a. Student's t-test (equal variances)
            t_res <- t.test(x1, x2, var.equal = TRUE, conf.level = selected_ci_level)
            test_name <- "Student's t-test"
         } else {
            # 3b. Welch's t-test (unequal variances)
            t_res <- t.test(x1, x2, var.equal = FALSE, conf.level = selected_ci_level)
            test_name <- "Welch's t-test"
         }
      }
      
      p_val_t <- t_res$p.value
      is_sig_t <- (p_val_t < alpha_val)
      fmt_p_t <- if (p_val_t < 0.0001) format(p_val_t, scientific = TRUE, digits = 4) else format(round(p_val_t, 4), nsmall = 4)
      
      # Calculate Cohen's d (effect size)
      m1 <- mean(x1, na.rm = TRUE)
      m2 <- mean(x2, na.rm = TRUE)
      s1 <- sd(x1, na.rm = TRUE)
      s2 <- sd(x2, na.rm = TRUE)
      n1 <- length(x1)
      n2 <- length(x2)
      
      # Pooled standard deviation
      pooled_sd <- sqrt(((n1 - 1) * s1^2 + (n2 - 1) * s2^2) / (n1 + n2 - 2))
      cohens_d <- (m1 - m2) / pooled_sd
      
      # Effect size interpretation
      d_abs <- abs(cohens_d)
      if (d_abs < 0.2) {
        effect_size_interp <- "negligible"
      } else if (d_abs < 0.5) {
        effect_size_interp <- "small"
      } else if (d_abs < 0.8) {
        effect_size_interp <- "medium"
      } else {
        effect_size_interp <- "large"
      }
      
      msg_t <- if (is_sig_t) {
        sprintf("%s shows a significant difference (p = %s < %f). Effect size: %s (d = %.3f).", 
                test_name, fmt_p_t, alpha_val, effect_size_interp, cohens_d)
      } else {
        sprintf("%s shows NO significant difference (p = %s >= %f). Effect size: %s (d = %.3f).", 
                test_name, fmt_p_t, alpha_val, effect_size_interp, cohens_d)
      }
      
      result_list$ttest <- list(
        test_type = if (is_homogeneous) "student" else "welch",
        test_name = test_name,
        statistic = as.numeric(t_res$statistic),
        df = as.numeric(t_res$parameter),
        p_value = p_val_t,
        formatted_p = fmt_p_t,
        message = msg_t,
        is_significant = is_sig_t,
        group1 = g1,
        group2 = g2,
        mean1 = m1,
        mean2 = m2,
        mean_diff = m1 - m2,
        ci_lower = t_res$conf.int[1],
        ci_upper = t_res$conf.int[2],
        cohens_d = cohens_d,
        effect_size = effect_size_interp
      )
      result_list$descriptive_table_publication <- create_publication_descriptive_table(
        data,
        group_var,
        response_var,
        ci_level = selected_ci_level
      )

      # Mean ± selected CI plot for two-group t-tests (Student/Welch/Paired)
      ttest_plot_title <- if (!is.null(result_list$ttest$test_type) && identical(result_list$ttest$test_type, "welch")) {
        sprintf("Mean ± %d%% CI Plot: Welch's t-test", selected_ci_percent)
      } else if (!is.null(result_list$ttest$test_name) && grepl("Paired", result_list$ttest$test_name, ignore.case = TRUE)) {
        sprintf("Mean ± %d%% CI Plot: Paired t-test", selected_ci_percent)
      } else {
        sprintf("Mean ± %d%% CI Plot: Student's t-test", selected_ci_percent)
      }
      ttest_plot_subtitle <- paste(
        "t =",
        round(as.numeric(t_res$statistic), 3),
        "| p =",
        fmt_p_t
      )
      ttest_mean_ci_plot <- create_mean_ci_plot(
        data,
        group_var,
        response_var,
        output_image,
        ttest_plot_title,
        ttest_plot_subtitle,
        alpha_level = alpha_val
      )
      result_list$ttest_mean_ci_plot_generated <- isTRUE(ttest_mean_ci_plot$generated)
      if (isTRUE(ttest_mean_ci_plot$generated) && !is.null(ttest_mean_ci_plot$path)) {
        result_list$ttest_mean_ci_plot_path <- ttest_mean_ci_plot$path
      } else if (!is.null(ttest_mean_ci_plot$error)) {
        result_list$ttest_mean_ci_plot_error <- ttest_mean_ci_plot$error
      }

      two_group_plot <- create_two_group_publication_plot(
        data = data,
        group_var = group_var,
        response_var = response_var,
        result_list = result_list,
        base_output_image = output_image,
        alpha_level = alpha_val,
        is_paired = is_paired,
        subject_var = subject_var
      )
      result_list$two_group_publication_plot_generated <- isTRUE(two_group_plot$generated)
      result_list$two_group_publication_plot_paired_overlay <- isTRUE(two_group_plot$paired_overlay)
      if (!is.null(two_group_plot$pairing_method) && nzchar(as.character(two_group_plot$pairing_method))) {
        result_list$two_group_publication_plot_pairing_method <- as.character(two_group_plot$pairing_method)
      }
      if (!is.null(two_group_plot$paired_n) && is.finite(as.numeric(two_group_plot$paired_n))) {
        result_list$two_group_publication_plot_paired_n <- as.integer(two_group_plot$paired_n)
      }
      if (isTRUE(two_group_plot$generated) && !is.null(two_group_plot$path)) {
        result_list$two_group_publication_plot_path <- two_group_plot$path
        result_list$plot_generated <- TRUE
        result_list$plot_path <- two_group_plot$path
        result_list$ttest_mean_ci_plot_generated <- TRUE
        result_list$ttest_mean_ci_plot_path <- two_group_plot$path
      } else if (!is.null(two_group_plot$error)) {
        result_list$two_group_publication_plot_error <- two_group_plot$error
      }
      
    } else {
      # MULTI-GROUP COMPARISON
      
      if (is_paired) {
          # REPEATED MEASURES ANOVA (Parametric >2 Groups Paired)
          if (is.null(subject_var)) {
                 msg_err <- "Repeated Measures ANOVA requires a Subject ID variable. Please select one in the UI. Falling back to Standard ANOVA."
                 # Fallback logic below (standard ANOVA)
                 is_fallback_needed <- TRUE
          } else {
                 if (!subject_var %in% colnames(data)) stop(paste("Subject variable not found:", subject_var))
                 
                 fmt_p <- function(pv) {
                    if (is.na(pv)) return("N/A")
                    if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
                    format(round(pv, 4), nsmall = 4)
                 }

                 rm_base <- tryCatch({
                    rm_data <- data[, c(subject_var, group_var, response_var)]
                    colnames(rm_data) <- c("SubjectID", "Condition", "Value")
                    rm_data$SubjectID <- as.factor(rm_data$SubjectID)
                    rm_data$Condition <- as.factor(rm_data$Condition)
                    rm_data$Value <- as.numeric(as.character(rm_data$Value))
                    rm_data <- rm_data[!is.na(rm_data$Value), ]

                    cond_levels <- levels(rm_data$Condition)
                    wide <- reshape(rm_data, idvar = "SubjectID", timevar = "Condition", direction = "wide")
                    wide_cols <- paste0("Value.", cond_levels)
                    wide_cols <- wide_cols[wide_cols %in% colnames(wide)]
                    if (length(wide_cols) < 3) stop("RM-ANOVA requires at least 3 repeated conditions with complete wide mapping.")

                    wide_complete <- wide[complete.cases(wide[, wide_cols, drop = FALSE]), c("SubjectID", wide_cols), drop = FALSE]
                    if (nrow(wide_complete) < 2) stop("Not enough complete subjects after reshaping repeated-measures data.")

                    y <- as.matrix(wide_complete[, wide_cols, drop = FALSE])
                    fit <- lm(y ~ 1)
                    idata <- data.frame(Condition = factor(gsub("^Value\\.", "", wide_cols), levels = gsub("^Value\\.", "", wide_cols)))

                    rm_tbl <- anova(fit, M = ~Condition, X = ~1, idata = idata, test = "Spherical")
                    mauchly_res <- mauchly.test(fit, M = ~Condition, X = ~1, idata = idata)

                    list(
                      rm_table = rm_tbl,
                      mauchly = mauchly_res,
                      heading = attr(rm_tbl, "heading"),
                      wide_complete = wide_complete,
                      condition_labels = gsub("^Value\\.", "", wide_cols)
                    )
                 }, error = function(e) {
                    result_list$rm_anova_error <- e$message
                    NULL
                 })

                 if (is.null(rm_base) || is.null(rm_base$rm_table) || nrow(rm_base$rm_table) == 0) {
                    is_fallback_needed <- TRUE
                 } else {
                    rm_row <- rm_base$rm_table[1, , drop = FALSE]
                    f_val <- as.numeric(rm_row[["F"]][1])
                    p_unc <- as.numeric(rm_row[["Pr(>F)"]][1])
                    df1_raw <- as.numeric(rm_row[["num Df"]][1])
                    df2_raw <- as.numeric(rm_row[["den Df"]][1])
                    gg_p <- if ("G-G Pr" %in% names(rm_row)) as.numeric(rm_row[["G-G Pr"]][1]) else NA
                    hf_p <- if ("H-F Pr" %in% names(rm_row)) as.numeric(rm_row[["H-F Pr"]][1]) else NA

                    heading <- rm_base$heading
                    gg_epsilon <- NA
                    hf_epsilon <- NA
                    if (!is.null(heading)) {
                      gg_line <- heading[grep("Greenhouse-Geisser epsilon", heading)]
                      hf_line <- heading[grep("Huynh-Feldt epsilon", heading)]
                      if (length(gg_line) > 0) gg_epsilon <- suppressWarnings(as.numeric(sub(".*epsilon:\\s*", "", gg_line[1])))
                      if (length(hf_line) > 0) hf_epsilon <- suppressWarnings(as.numeric(sub(".*epsilon:\\s*", "", hf_line[1])))
                    }

                    mauchly_w <- as.numeric(rm_base$mauchly$statistic[["W"]])
                    mauchly_p <- as.numeric(rm_base$mauchly$p.value)
                    sphericity_alpha <- 0.05
                    sphericity_violated <- !is.na(mauchly_p) && mauchly_p < sphericity_alpha

                    correction_used <- "none"
                    p_final <- p_unc
                    df1_final <- df1_raw
                    df2_final <- df2_raw

                    if (sphericity_violated) {
                      use_hf <- !is.na(hf_p) && !is.na(hf_epsilon) && hf_epsilon > 0.75
                      use_gg <- !is.na(gg_p)
                      if (use_hf) {
                        correction_used <- "HF"
                        p_final <- hf_p
                        df1_final <- if (!is.na(hf_epsilon)) df1_raw * hf_epsilon else df1_raw
                        df2_final <- if (!is.na(hf_epsilon)) df2_raw * hf_epsilon else df2_raw
                      } else if (use_gg) {
                        correction_used <- "GG"
                        p_final <- gg_p
                        df1_final <- if (!is.na(gg_epsilon)) df1_raw * gg_epsilon else df1_raw
                        df2_final <- if (!is.na(gg_epsilon)) df2_raw * gg_epsilon else df2_raw
                      }
                    }

                    is_sig <- !is.na(p_final) && (p_final < alpha_val)
                    fmt_p_final <- fmt_p(p_final)
                    fmt_mauchly <- fmt_p(mauchly_p)

                    # Effect size for RM ANOVA: partial eta-squared from F and uncorrected df
                    partial_eta_sq <- NA
                    if (!is.na(f_val) && !is.na(df1_raw) && !is.na(df2_raw)) {
                      denom_eta <- (f_val * df1_raw) + df2_raw
                      if (!is.na(denom_eta) && denom_eta != 0) {
                        partial_eta_sq <- (f_val * df1_raw) / denom_eta
                      }
                    }
                    eta_label <- "unknown"
                    if (!is.na(partial_eta_sq)) {
                      if (partial_eta_sq < 0.01) {
                        eta_label <- "negligible"
                      } else if (partial_eta_sq < 0.06) {
                        eta_label <- "small"
                      } else if (partial_eta_sq < 0.14) {
                        eta_label <- "medium"
                      } else {
                        eta_label <- "large"
                      }
                    }

                    sig_effect_interp <- if (!is.na(partial_eta_sq)) {
                      if (is_sig) {
                        sprintf("Statistically significant repeated-condition effect with %s magnitude (partial eta-squared = %.3f).",
                                eta_label, partial_eta_sq)
                      } else {
                        sprintf("No statistically significant repeated-condition effect; magnitude is %s (partial eta-squared = %.3f).",
                                eta_label, partial_eta_sq)
                      }
                    } else {
                      if (is_sig) {
                        "Statistically significant repeated-condition effect; effect-size magnitude could not be estimated."
                      } else {
                        "No statistically significant repeated-condition effect; effect-size magnitude could not be estimated."
                      }
                    }

                    msg <- if (sphericity_violated && correction_used != "none") {
                      sprintf("RM-ANOVA detected sphericity violation (Mauchly p = %s). %s correction applied. Corrected p = %s.", fmt_mauchly, correction_used, fmt_p_final)
                    } else if (sphericity_violated) {
                      sprintf("RM-ANOVA detected sphericity violation (Mauchly p = %s). No correction p-value available, using uncorrected p = %s.", fmt_mauchly, fmt_p_final)
                    } else {
                      sprintf("RM-ANOVA assumptions are satisfied for sphericity (Mauchly p = %s). Uncorrected p = %s.", fmt_mauchly, fmt_p_final)
                    }

                    result_list$rm_anova <- list(
                      statistic = f_val,
                      p_value = p_final,
                      p_uncorrected = p_unc,
                      formatted_p = fmt_p_final,
                      formatted_p_uncorrected = fmt_p(p_unc),
                      df1 = df1_final,
                      df2 = df2_final,
                      df1_uncorrected = df1_raw,
                      df2_uncorrected = df2_raw,
                      correction_used = correction_used,
                      sphericity_violated = sphericity_violated,
                      mauchly_w = mauchly_w,
                      mauchly_p_value = mauchly_p,
                      mauchly_formatted_p = fmt_mauchly,
                      gg_epsilon = gg_epsilon,
                      gg_p_value = gg_p,
                      gg_formatted_p = fmt_p(gg_p),
                      hf_epsilon = hf_epsilon,
                      hf_p_value = hf_p,
                      hf_formatted_p = fmt_p(hf_p),
                      effect_size_metric = "partial_eta_squared",
                      effect_size = partial_eta_sq,
                      effect_size_label = eta_label,
                      significance_effect_interpretation = sig_effect_interp,
                      message = msg,
                      is_significant = is_sig
                    )
                    result_list$test_type <- "rm_anova"
                    is_fallback_needed <- FALSE

                    cond_labels <- rm_base$condition_labels
                    wide_complete <- rm_base$wide_complete
                    val_cols_ordered <- paste0("Value.", cond_labels)
                    val_cols_ordered <- val_cols_ordered[val_cols_ordered %in% colnames(wide_complete)]

                    # RM-ANOVA aov-style table (for R-style report presentation)
                    if (!is.null(wide_complete) && nrow(wide_complete) > 0 && length(val_cols_ordered) > 1) {
                      rm_long_complete <- data.frame(
                        SubjectID = rep(wide_complete$SubjectID, times = length(val_cols_ordered)),
                        Condition = factor(rep(gsub("^Value\\.", "", val_cols_ordered), each = nrow(wide_complete)), levels = gsub("^Value\\.", "", val_cols_ordered)),
                        Value = as.numeric(as.vector(as.matrix(wide_complete[, val_cols_ordered, drop = FALSE]))),
                        stringsAsFactors = FALSE
                      )

                      rm_aov_rows <- tryCatch({
                        aov_fit <- aov(Value ~ Condition + Error(SubjectID / Condition), data = rm_long_complete)
                        aov_sum <- summary(aov_fit)
                        rows_out <- list()
                        row_idx <- 1
                        for (nm in names(aov_sum)) {
                          tbl <- aov_sum[[nm]][[1]]
                          if (is.null(tbl) || nrow(tbl) == 0) next
                          row_names <- trimws(rownames(tbl))
                          for (ri in seq_len(nrow(tbl))) {
                            p_val_i <- if ("Pr(>F)" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[ri, "Pr(>F)"])) else NA
                            rows_out[[row_idx]] <- list(
                              stratum = nm,
                              source = row_names[ri],
                              df = if ("Df" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[ri, "Df"])) else NA,
                              sum_sq = if ("Sum Sq" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[ri, "Sum Sq"])) else NA,
                              mean_sq = if ("Mean Sq" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[ri, "Mean Sq"])) else NA,
                              statistic = if ("F value" %in% colnames(tbl)) suppressWarnings(as.numeric(tbl[ri, "F value"])) else NA,
                              p_value = p_val_i,
                              formatted_p = if (!is.na(p_val_i)) fmt_p(p_val_i) else "N/A",
                              is_residual = identical(tolower(row_names[ri]), "residuals")
                            )
                            row_idx <- row_idx + 1
                          }
                        }
                        rows_out
                      }, error = function(e) NULL)

                      if (!is.null(rm_aov_rows) && length(rm_aov_rows) > 0) {
                        result_list$rm_anova_table_rows <- rm_aov_rows
                      }
                    }

                    # RM-ANOVA visualization: spaghetti plot + mean ± selected CI
                    rm_spaghetti_plot <- NULL
                    if (!is.null(wide_complete) && nrow(wide_complete) > 0 && length(cond_labels) > 1) {
                      if (length(val_cols_ordered) > 1) {
                        rm_spaghetti_df <- data.frame(
                          SubjectID = rep(wide_complete$SubjectID, times = length(val_cols_ordered)),
                          Condition = factor(rep(gsub("^Value\\.", "", val_cols_ordered), each = nrow(wide_complete)), levels = gsub("^Value\\.", "", val_cols_ordered)),
                          Value = as.numeric(as.vector(as.matrix(wide_complete[, val_cols_ordered, drop = FALSE]))),
                          stringsAsFactors = FALSE
                        )
                        rm_spaghetti_plot <- create_rm_spaghetti_mean_ci_plot(
                          rm_spaghetti_df,
                          "SubjectID",
                          "Condition",
                          "Value",
                          output_image,
                          sprintf("Repeated Measures Spaghetti Plot + Mean ± %d%% CI", selected_ci_percent),
                          paste("RM-ANOVA F =", round(f_val, 3), "| p =", fmt_p_final),
                          alpha_level = alpha_val
                        )
                      }
                    }
                    if (!is.null(rm_spaghetti_plot)) {
                      result_list$rm_spaghetti_ci_plot_generated <- isTRUE(rm_spaghetti_plot$generated)
                      if (isTRUE(rm_spaghetti_plot$generated) && !is.null(rm_spaghetti_plot$path)) {
                        result_list$rm_spaghetti_ci_plot_path <- rm_spaghetti_plot$path
                      } else if (!is.null(rm_spaghetti_plot$error)) {
                        result_list$rm_spaghetti_ci_plot_error <- rm_spaghetti_plot$error
                      }
                    }

                    # Post-hoc: paired t-tests by condition pairs with Bonferroni correction
                    if (is_sig) {
                      raw_p <- c()
                      comp_names <- c()
                      for (i in 1:(length(cond_labels) - 1)) {
                        for (j in (i + 1):length(cond_labels)) {
                          c1 <- paste0("Value.", cond_labels[i])
                          c2 <- paste0("Value.", cond_labels[j])
                          t_res_pw <- tryCatch({
                            t.test(wide_complete[[c1]], wide_complete[[c2]], paired = TRUE, conf.level = selected_ci_level)
                          }, error = function(e) NULL)
                          raw_p <- c(raw_p, if (is.null(t_res_pw)) NA else t_res_pw$p.value)
                          comp_names <- c(comp_names, paste(cond_labels[i], "-", cond_labels[j]))
                        }
                      }

                      adj_p <- p.adjust(raw_p, method = "bonferroni")
                      pw_list <- list()
                      for (k in seq_along(comp_names)) {
                        p_adj <- adj_p[k]
                        pw_list[[k]] <- list(
                          comparison = comp_names[k],
                          p_adj = p_adj,
                          formatted_p = fmt_p(p_adj),
                          is_significant = (!is.na(p_adj) && p_adj < alpha_val)
                        )
                      }
                      if (inferential_significant_only) {
                        pw_list <- Filter(function(x) isTRUE(x$is_significant), pw_list)
                      }
                      result_list$rm_anova_posthoc <- pw_list
                    } else {
                      result_list$posthoc_skipped_reason <- "RM-ANOVA was not significant; pairwise post-hoc comparisons were skipped."
                    }
                 }
          }
      } else {
          is_fallback_needed <- TRUE # Independent Samples
      }
      
      if (!is_paired || is_fallback_needed) {
      # Use Standard ANOVA or Welch ANOVA (Independent)
      result_list$test_type <- "anova"
      signif_code_from_p <- function(pv) {
        if (is.na(pv)) return("")
        if (pv <= 0.001) return("***")
        if (pv <= 0.01) return("**")
        if (pv <= 0.05) return("*")
        if (pv <= 0.1) return(".")
        " "
      }
      result_list$anova_signif_codes_legend <- "0 '***' 0.001 '**' 0.01 '*' 0.05 '.' 0.1 ' ' 1"
      result_list$descriptive_table_publication <- create_publication_descriptive_table(
        data,
        group_var,
        response_var,
        ci_level = selected_ci_level
      )

      
      if (is_homogeneous) {
        # 3a. Standard One-Way ANOVA (homogeneous variances)
        anova_res <- aov(as.formula(paste(response_var, "~", group_var)), data = data)
        an_sum <- summary(anova_res)[[1]]
        p_val_an <- an_sum[["Pr(>F)"]][1]
        is_sig_an <- (p_val_an < alpha_val)
        fmt_p_an <- if (p_val_an < 0.0001) format(p_val_an, scientific = TRUE, digits = 4) else format(round(p_val_an, 4), nsmall = 4)

        # ANOVA effect size (eta-squared) and interpretation
        ss_between <- as.numeric(an_sum[["Sum Sq"]][1])
        ss_total <- suppressWarnings(sum(as.numeric(an_sum[["Sum Sq"]]), na.rm = TRUE))
        eta_sq <- if (!is.na(ss_between) && !is.na(ss_total) && ss_total > 0) ss_between / ss_total else NA
        eta_label <- "unknown"
        if (!is.na(eta_sq)) {
          if (eta_sq < 0.01) {
            eta_label <- "negligible"
          } else if (eta_sq < 0.06) {
            eta_label <- "small"
          } else if (eta_sq < 0.14) {
            eta_label <- "medium"
          } else {
            eta_label <- "large"
          }
        }

        sig_effect_interp <- if (!is.na(eta_sq)) {
          if (is_sig_an) {
            sprintf("ANOVA is significant with %s effect magnitude (eta-squared = %.3f).", eta_label, eta_sq)
          } else {
            sprintf("ANOVA is not significant; effect magnitude is %s (eta-squared = %.3f).", eta_label, eta_sq)
          }
        } else if (is_sig_an) {
          "ANOVA is significant; effect-size magnitude unavailable."
        } else {
          "ANOVA is not significant; effect-size magnitude unavailable."
        }

        msg_an <- if (is_sig_an) sprintf("The One-Way ANOVA test shows a significant difference (p = %s < %f).", fmt_p_an, alpha_val)
        else sprintf("The One-Way ANOVA test shows NO significant difference (p = %s >= %f).", fmt_p_an, alpha_val)
        result_list$anova <- list(
          test_type = "standard",
          statistic = as.numeric(an_sum[["F value"]][1]), 
          df_between = as.numeric(an_sum[["Df"]][1]),
          df_within = as.numeric(an_sum[["Df"]][2]),
          p_value = p_val_an, 
          formatted_p = fmt_p_an, 
          message = msg_an, 
          is_significant = is_sig_an,
          eta_squared = eta_sq,
          effect_size = eta_sq,
          effect_size_label = eta_label,
          significance_effect_interpretation = sig_effect_interp
        )
        result_list$anova_table_rows <- list(
          list(
            source = as.character(group_var),
            df = as.numeric(an_sum[["Df"]][1]),
            sum_sq = as.numeric(an_sum[["Sum Sq"]][1]),
            mean_sq = as.numeric(an_sum[["Mean Sq"]][1]),
            statistic = as.numeric(an_sum[["F value"]][1]),
            p_value = as.numeric(an_sum[["Pr(>F)"]][1]),
            formatted_p = fmt_p_value(as.numeric(an_sum[["Pr(>F)"]][1])),
            signif_code = signif_code_from_p(as.numeric(an_sum[["Pr(>F)"]][1])),
            is_residual = FALSE
          ),
          list(
            source = "Residuals",
            df = as.numeric(an_sum[["Df"]][2]),
            sum_sq = as.numeric(an_sum[["Sum Sq"]][2]),
            mean_sq = as.numeric(an_sum[["Mean Sq"]][2]),
            statistic = NA,
            p_value = NA,
            formatted_p = "N/A",
            signif_code = "",
            is_residual = TRUE
          )
        )
        
        # 4. Tukey HSD Post-hoc Test (run only when omnibus ANOVA is significant)
        if (is_sig_an) {
          tukey_conf_level <- resolve_conf_level_from_alpha(alpha_val)
          tukey_res <- TukeyHSD(anova_res, conf.level = tukey_conf_level)
          tukey_df <- as.data.frame(tukey_res[[group_var]])
          tukey_df$comparison <- rownames(tukey_df)

          tukey_list_all <- list()
          tukey_levels <- as.character(unique(as.character(data[[group_var]])))
          for (i in 1:nrow(tukey_df)) {
            p_adj_val <- tukey_df$`p adj`[i]
            comparison_txt <- as.character(tukey_df$comparison[i])
            comp_parts <- strsplit(comparison_txt, "-", fixed = TRUE)[[1]]
            comp_parts <- trimws(comp_parts)
            comp_g1 <- if (length(comp_parts) >= 1) comp_parts[1] else NA_character_
            comp_g2 <- if (length(comp_parts) >= 2) comp_parts[2] else NA_character_
            if (!(comp_g1 %in% tukey_levels)) comp_g1 <- NA_character_
            if (!(comp_g2 %in% tukey_levels)) comp_g2 <- NA_character_
            tukey_list_all[[i]] <- list(
              comparison = comparison_txt,
              group1 = comp_g1,
              group2 = comp_g2,
              diff = as.numeric(tukey_df$diff[i]),
              lwr = as.numeric(tukey_df$lwr[i]),
              upr = as.numeric(tukey_df$upr[i]),
              p_adj = p_adj_val,
              formatted_p = if (p_adj_val < 0.0001) format(p_adj_val, scientific = TRUE, digits = 4) else format(round(p_adj_val, 4), nsmall = 4),
              is_significant = (p_adj_val < alpha_val)
            )
          }
          result_list$tukey_all <- tukey_list_all
          tukey_list <- tukey_list_all
          if (inferential_significant_only) {
            tukey_list <- Filter(function(x) isTRUE(x$is_significant), tukey_list)
          }
          result_list$tukey <- tukey_list

          # 5a. Tukey boxplot with compact letters
          tukey_plot_error <- NULL
          tryCatch({
            ensure_optional_pkg("ggplot2", "Tukey post-hoc plot")
            ensure_optional_pkg("multcompView", "Tukey compact-letter display")

            # Publication-style summary statistics per group (mean, selected CI, median, whisker top)
            tukey_plot_df <- data[, c(group_var, response_var), drop = FALSE]
            colnames(tukey_plot_df) <- c("group", "value")
            tukey_plot_df$value <- suppressWarnings(as.numeric(as.character(tukey_plot_df$value)))
            tukey_plot_df <- tukey_plot_df[!is.na(tukey_plot_df$group) & is.finite(tukey_plot_df$value), , drop = FALSE]
            tukey_plot_df$group <- as.factor(as.character(tukey_plot_df$group))
            group_levels_plot <- levels(tukey_plot_df$group)
            cld_letters <- NULL
            gr2 <- tryCatch(
              multcompView::multcompLetters4(anova_res, tukey_res, threshold = alpha_val),
              error = function(e) NULL
            )
            if (!is.null(gr2) && !is.null(gr2[[group_var]]) && !is.null(gr2[[group_var]]$Letters)) {
              cld_letters <- gr2[[group_var]]$Letters
            }
            if (is.null(cld_letters) && length(tukey_list_all) > 0) {
              p_matrix <- matrix(1, nrow = length(group_levels_plot), ncol = length(group_levels_plot), dimnames = list(group_levels_plot, group_levels_plot))
              diag(p_matrix) <- 0
              for (entry in tukey_list_all) {
                g1 <- as.character(entry$group1)
                g2 <- as.character(entry$group2)
                if (!(g1 %in% group_levels_plot) || !(g2 %in% group_levels_plot) || identical(g1, g2)) next
                p_adj_val <- suppressWarnings(as.numeric(entry$p_adj))
                if (!is.finite(p_adj_val)) p_adj_val <- 1
                p_adj_val <- max(0, min(1, p_adj_val))
                p_matrix[g1, g2] <- p_adj_val
                p_matrix[g2, g1] <- p_adj_val
              }
              cld_obj <- tryCatch(multcompView::multcompLetters(p_matrix < alpha_val), error = function(e) NULL)
              if (!is.null(cld_obj) && !is.null(cld_obj$Letters)) {
                cld_letters <- cld_obj$Letters
              }
            }
            if (is.null(cld_letters)) {
              cld_letters <- stats::setNames(rep("", length(group_levels_plot)), group_levels_plot)
            }

            tukey_summary_rows <- lapply(group_levels_plot, function(g) {
              vals <- tukey_plot_df$value[tukey_plot_df$group == g]
              vals <- vals[is.finite(vals)]
              n <- length(vals)
              if (n == 0) return(NULL)
              m <- mean(vals, na.rm = TRUE)
              s <- if (n > 1) sd(vals, na.rm = TRUE) else NA_real_
              med <- median(vals, na.rm = TRUE)
              q1 <- as.numeric(stats::quantile(vals, probs = 0.25, na.rm = TRUE, names = FALSE, type = 7))
              q3 <- as.numeric(stats::quantile(vals, probs = 0.75, na.rm = TRUE, names = FALSE, type = 7))
              se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
              t_crit <- if (n > 1) stats::qt(selected_ci_prob, df = n - 1) else NA_real_
              ci_half <- if (is.finite(se) && is.finite(t_crit)) se * t_crit else NA_real_
              ci_low <- if (is.finite(ci_half)) m - ci_half else m
              ci_up <- if (is.finite(ci_half)) m + ci_half else m
              whisker_top <- as.numeric(grDevices::boxplot.stats(vals)$stats[5])
              list(
                group = as.character(g),
                n = as.numeric(n),
                mean = as.numeric(m),
                median = as.numeric(med),
                q1 = as.numeric(q1),
                q3 = as.numeric(q3),
                ci_low = as.numeric(ci_low),
                ci_up = as.numeric(ci_up),
                whisker_top = as.numeric(whisker_top)
              )
            })
            tukey_summary_rows <- Filter(Negate(is.null), tukey_summary_rows)
            tukey_summary_df <- data.frame(
              group = factor(sapply(tukey_summary_rows, function(r) r$group), levels = group_levels_plot),
              n = as.numeric(sapply(tukey_summary_rows, function(r) r$n)),
              mean = as.numeric(sapply(tukey_summary_rows, function(r) r$mean)),
              median = as.numeric(sapply(tukey_summary_rows, function(r) r$median)),
              q1 = as.numeric(sapply(tukey_summary_rows, function(r) r$q1)),
              q3 = as.numeric(sapply(tukey_summary_rows, function(r) r$q3)),
              ci_low = as.numeric(sapply(tukey_summary_rows, function(r) r$ci_low)),
              ci_up = as.numeric(sapply(tukey_summary_rows, function(r) r$ci_up)),
              whisker_top = as.numeric(sapply(tukey_summary_rows, function(r) r$whisker_top)),
              stringsAsFactors = FALSE
            )
            tukey_summary_df$letters <- cld_letters[as.character(tukey_summary_df$group)]
            y_vals_tukey <- tukey_plot_df$value
            y_range <- range(y_vals_tukey, na.rm = TRUE)
            y_span <- diff(y_range)
            if (!is.finite(y_span) || y_span <= 0) y_span <- max(abs(y_range), na.rm = TRUE)
            if (!is.finite(y_span) || y_span <= 0) y_span <- 1
            y_offset <- max(y_span * 0.04, 0.04)
            tukey_summary_df$label_y <- as.numeric(tukey_summary_df$whisker_top) + y_offset

            tukey_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("tukey_plot"))
            tukey_show_box <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_box", TRUE)
            tukey_show_raw_points <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_raw_points", TRUE)
            tukey_show_mean_ci <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_mean_ci", TRUE)
            tukey_show_mean_point <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_mean_point", TRUE)
            tukey_show_median <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_median", TRUE)
            tukey_show_violin_right <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_violin_right", FALSE)
            tukey_show_points_left <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_points_left", FALSE)
            tukey_show_violin_replace_box <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_violin_replace_box", FALSE)
            tukey_show_posthoc_letters <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_posthoc_letters", TRUE)
            tukey_show_caption <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_caption", TRUE)
            tukey_show_annotation_panel <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_annotation_panel", TRUE)
            tukey_show_effect_line <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_effect_line", TRUE)
            tukey_show_stat_guides_mean <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_mean", FALSE)
            tukey_show_stat_guides_median <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_median", FALSE)
            tukey_show_stat_guides_q1 <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_q1", FALSE)
            tukey_show_stat_guides_q3 <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_q3", FALSE)
            tukey_show_stat_guides_ci_low <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_ci_low", FALSE)
            tukey_show_stat_guides_ci_high <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_ci_high", FALSE)
            tukey_show_stat_guides_values <- resolve_plot_element_flag(tukey_plot_labels_cfg, "show_stat_guides_values", FALSE)
            use_tukey_violin_replace <- isTRUE(tukey_show_violin_replace_box)
            use_tukey_violin_side <- isTRUE(tukey_show_violin_right) && !isTRUE(use_tukey_violin_replace)

            group_fill_values <- get_level_color_map(
              group_var,
              group_levels_plot,
              pick_cols(length(group_levels_plot))
            )
            group_color_intensity <- get_custom_plot_intensity("three_group_group_color_intensity", 1)
            group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
            three_group_box_border_color <- get_custom_plot_color("three_group_box_border_color", "#1f2937")
            three_group_outlier_color <- get_custom_plot_color("three_group_outlier_color", "#f59e0b")
            three_group_mean_overlay_color <- get_custom_plot_color("three_group_mean_overlay_color", "#dc2626")
            three_group_label_color <- get_custom_plot_color("three_group_label_color", "#0f172a")
            three_group_jitter_color <- NA_character_
            three_group_jitter_size <- get_custom_plot_point_size("three_group_jitter_size", 2.4)
            three_group_jitter_use_box <- get_custom_plot_flag("three_group_jitter_use_box", FALSE)
            three_group_ci_point_color <- get_custom_plot_color("three_group_ci_point_color", three_group_mean_overlay_color)
            three_group_ci_errorbar_color <- get_custom_plot_color("three_group_ci_errorbar_color", "#334155")
            three_group_guide_mean_color <- get_custom_plot_color("three_group_guide_mean_color", "#2563eb")
            three_group_guide_median_color <- get_custom_plot_color("three_group_guide_median_color", "#0f766e")
            three_group_guide_q1_color <- get_custom_plot_color("three_group_guide_q1_color", "#7c3aed")
            three_group_guide_q3_color <- get_custom_plot_color("three_group_guide_q3_color", "#ea580c")
            three_group_guide_ci_low_color <- get_custom_plot_color("three_group_guide_ci_low_color", "#0284c7")
            three_group_guide_ci_high_color <- get_custom_plot_color("three_group_guide_ci_high_color", "#0369a1")
            three_group_guide_line_type <- get_custom_plot_line_type("three_group_guide_line_type", "dashed")
            three_group_guide_line_width <- get_custom_plot_line_width("three_group_guide_line_width", 0.62)
            use_tukey_jitter_override <- FALSE
            if (!isTRUE(three_group_jitter_use_box)) {
              three_group_jitter_override <- plot_colors_list[["three_group_jitter_color"]]
              if (!is.null(three_group_jitter_override)) {
                three_group_jitter_candidate <- trimws(as.character(three_group_jitter_override[1]))
                if (is_valid_color_value(three_group_jitter_candidate)) {
                  three_group_jitter_color <- three_group_jitter_candidate
                  use_tukey_jitter_override <- TRUE
                }
              }
            }
            if (!is_valid_color_value(three_group_ci_point_color)) three_group_ci_point_color <- three_group_mean_overlay_color
            if (!is_valid_color_value(three_group_ci_errorbar_color)) three_group_ci_errorbar_color <- "#334155"

            output_image_tukey <- gsub("\\.png$", "_tukey.png", output_image)

            tukey_caption_parts <- c(
              "Post-hoc grouping is shown with compact letters.",
              "Groups sharing the same letter are not significantly different."
            )
            if (isTRUE(tukey_show_effect_line) && is.finite(as.numeric(eta_sq))) {
              tukey_caption_parts <- c(tukey_caption_parts, paste0("Eta-squared = ", format(round(as.numeric(eta_sq), 3), nsmall = 3), "."))
            }
            tukey_caption <- paste(tukey_caption_parts, collapse = "  ")
            tukey_annotation_lines <- c(
              paste0("F = ", format(round(as.numeric(an_sum[["F value"]][1]), 3), nsmall = 3)),
              paste0("p = ", fmt_p_an),
              paste0("groups = ", length(group_levels_plot)),
              paste0("n = ", nrow(tukey_plot_df))
            )
            if (isTRUE(tukey_show_effect_line) && is.finite(as.numeric(eta_sq))) {
              tukey_annotation_lines <- c(tukey_annotation_lines, paste0("eta-squared = ", format(round(as.numeric(eta_sq), 3), nsmall = 3)))
            }
            box_width_value <- 0.56
            violin_width_value <- 0.48
            violin_nudge_value <- 0.22
            point_left_nudge_value <- -0.22
            if (isTRUE(use_tukey_violin_replace)) {
              box_width_value <- if (isTRUE(tukey_show_points_left)) 0.46 else 0.56
              violin_width_value <- if (isTRUE(tukey_show_points_left)) 0.52 else 0.62
              violin_nudge_value <- 0
              if (isTRUE(tukey_show_points_left)) point_left_nudge_value <- -0.24
            } else if (isTRUE(use_tukey_violin_side) && isTRUE(tukey_show_points_left)) {
              box_width_value <- 0.38
              violin_width_value <- 0.40
              violin_nudge_value <- 0.29
              point_left_nudge_value <- -0.29
            } else if (isTRUE(use_tukey_violin_side)) {
              box_width_value <- 0.46
              violin_width_value <- 0.44
              violin_nudge_value <- 0.24
            } else if (isTRUE(tukey_show_points_left)) {
              box_width_value <- 0.46
              point_left_nudge_value <- -0.24
            }

            p_tukey <- ggplot(tukey_plot_df, aes(x = group, y = value, fill = group))
            if (isTRUE(use_tukey_violin_replace) || isTRUE(use_tukey_violin_side)) {
              p_tukey <- p_tukey + geom_violin(
                data = tukey_plot_df,
                aes(x = group, y = value, fill = group),
                inherit.aes = FALSE,
                position = position_nudge(x = violin_nudge_value),
                width = violin_width_value,
                alpha = 0.24,
                trim = FALSE,
                color = three_group_box_border_color,
                linewidth = 0.34,
                show.legend = FALSE
              )
            }
            if (isTRUE(tukey_show_box) && !isTRUE(use_tukey_violin_replace)) {
              p_tukey <- p_tukey + geom_boxplot(
                width = box_width_value,
                alpha = 0.8,
                color = three_group_box_border_color,
                outlier.colour = three_group_outlier_color
              )
            }
            if (isTRUE(tukey_show_raw_points)) {
              if (isTRUE(tukey_show_points_left)) {
                if (use_tukey_jitter_override) {
                  p_tukey <- p_tukey + geom_point(
                    data = tukey_plot_df,
                    aes(x = group, y = value),
                    inherit.aes = FALSE,
                    position = position_nudge(x = point_left_nudge_value),
                    shape = 16,
                    color = three_group_jitter_color,
                    alpha = 1.0,
                    size = three_group_jitter_size,
                    show.legend = FALSE
                  )
                } else {
                  p_tukey <- p_tukey + geom_point(
                    data = tukey_plot_df,
                    aes(x = group, y = value, color = group),
                    inherit.aes = FALSE,
                    position = position_nudge(x = point_left_nudge_value),
                    shape = 16,
                    alpha = 1.0,
                    size = three_group_jitter_size,
                    show.legend = FALSE
                  )
                }
              } else {
                if (use_tukey_jitter_override) {
                  p_tukey <- p_tukey + geom_jitter(
                    color = three_group_jitter_color,
                    shape = 16,
                    position = stable_jitter_position(width = 0.14, height = 0, seed = 202603025L),
                    alpha = 1.0,
                    size = three_group_jitter_size,
                    show.legend = FALSE
                  )
                } else {
                  p_tukey <- p_tukey +
                    geom_jitter(
                      aes(color = group),
                      position = stable_jitter_position(width = 0.14, height = 0, seed = 202603025L),
                      shape = 16,
                      alpha = 1.0,
                      size = three_group_jitter_size,
                      show.legend = FALSE
                    )
                }
              }
            }
            if (isTRUE(tukey_show_mean_ci)) {
              p_tukey <- p_tukey + geom_errorbar(
                data = tukey_summary_df,
                aes(x = group, ymin = ci_low, ymax = ci_up),
                inherit.aes = FALSE,
                width = 0.08,
                linewidth = 0.9,
                color = three_group_ci_errorbar_color
              )
            }
            if (isTRUE(tukey_show_mean_point)) {
              p_tukey <- p_tukey + geom_point(
                data = tukey_summary_df,
                aes(x = group, y = mean),
                inherit.aes = FALSE,
                shape = 23,
                fill = three_group_ci_point_color,
                color = "white",
                stroke = 0.28,
                size = 3.2
              )
            }
            if (isTRUE(tukey_show_median)) {
              p_tukey <- p_tukey + geom_point(
                data = tukey_summary_df,
                aes(x = group, y = median),
                inherit.aes = FALSE,
                shape = 95,
                size = 9,
                color = three_group_mean_overlay_color
              )
            }
            p_tukey <- add_box_to_axis_guides(
              p_tukey,
              summary_df = tukey_summary_df,
              group_levels = group_levels_plot,
              y_span = y_span,
              box_width = box_width_value,
              show_mean = tukey_show_stat_guides_mean,
              show_median = tukey_show_stat_guides_median,
              show_q1 = tukey_show_stat_guides_q1,
              show_q3 = tukey_show_stat_guides_q3,
              show_ci_low = tukey_show_stat_guides_ci_low,
              show_ci_high = tukey_show_stat_guides_ci_high,
              show_values = tukey_show_stat_guides_values,
              mean_color = three_group_guide_mean_color,
              median_color = three_group_guide_median_color,
              q1_color = three_group_guide_q1_color,
              q3_color = three_group_guide_q3_color,
              ci_low_color = three_group_guide_ci_low_color,
              ci_high_color = three_group_guide_ci_high_color,
              line_type = three_group_guide_line_type,
              line_width = three_group_guide_line_width,
              value_digits = 3
            )
            if (isTRUE(tukey_show_posthoc_letters)) {
              p_tukey <- p_tukey + geom_text(
                data = tukey_summary_df,
                aes(x = group, y = label_y, label = letters),
                size = 4.1,
                vjust = -0.15,
                fontface = "bold",
                color = three_group_label_color
              )
            }
            p_tukey <- p_tukey +
              scale_fill_manual(values = group_fill_values, drop = FALSE) +
              scale_color_manual(values = group_fill_values, drop = FALSE) +
              labs(
                title = "Tukey HSD Publication Plot",
                subtitle = paste("ANOVA F =", round(an_sum[["F value"]][1], 3), "| p =", fmt_p_an),
                x = group_var,
                y = response_var,
                caption = if (isTRUE(tukey_show_caption)) tukey_caption else NULL
              ) +
              theme_minimal(base_size = 13) +
              theme(
                panel.grid.minor = element_blank(),
                legend.position = "none",
                plot.title = element_text(face = "bold", size = 15),
                plot.subtitle = element_text(size = 11.5, color = "#334155"),
                plot.caption = element_text(size = 9.2, hjust = 0, color = "#475569"),
                axis.title = element_text(face = "bold")
              )

            if (isTRUE(tukey_show_annotation_panel)) {
              p_tukey <- p_tukey + annotate(
                "label",
                x = Inf,
                y = Inf,
                label = paste(tukey_annotation_lines, collapse = "\n"),
                hjust = 1.03,
                vjust = 1.03,
                size = 3.2,
                linewidth = 0.18,
                label.padding = grid::unit(0.20, "lines"),
                fill = grDevices::adjustcolor("#ffffff", alpha.f = 0.90),
                color = three_group_label_color
              )
            }

            custom_ggsave(output_image_tukey, plot = p_tukey, width = 10, height = 8, dpi = 300, device = "png")
            result_list$plot_generated <- TRUE
            result_list$plot_path <- output_image_tukey
            result_list$tukey_plot_generated <- TRUE
            result_list$tukey_plot_path <- output_image_tukey
          }, error = function(e) {
            call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
            tukey_plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
          })
          if (!is.null(tukey_plot_error)) {
            result_list$plot_error <- tukey_plot_error
          }
        } else {
          result_list$posthoc_skipped_reason <- "Omnibus ANOVA was not significant; Tukey post-hoc comparisons were skipped."
        }

        # 5b. One-way ANOVA test plot
        anova_plot_error <- NULL
        tryCatch({
          if (!requireNamespace("ggplot2", quietly = TRUE)) {
            stop("Missing plotting package: ggplot2")
          }

          group_levels_plot <- levels(as.factor(data[[group_var]]))
          group_fill_values <- get_level_color_map(
            group_var,
            group_levels_plot,
            pick_cols(length(group_levels_plot))
          )
          group_color_intensity <- get_custom_plot_intensity("three_group_group_color_intensity", 1)
          group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
          three_group_box_border_color <- get_custom_plot_color("three_group_box_border_color", "#1f2937")
          three_group_outlier_color <- get_custom_plot_color("three_group_outlier_color", "#f59e0b")
          three_group_mean_overlay_color <- get_custom_plot_color("three_group_mean_overlay_color", "#dc2626")

          output_image_anova <- gsub("\\.png$", "_anova.png", output_image)
          p_anova <- ggplot(data, aes(x = .data[[group_var]], y = .data[[response_var]])) +
            geom_boxplot(
              aes(fill = .data[[group_var]]),
              alpha = 0.75,
              color = three_group_box_border_color,
              outlier.colour = three_group_outlier_color
            ) +
            scale_fill_manual(values = group_fill_values, drop = FALSE) +
            stat_summary(
              fun = mean,
              geom = "point",
              color = three_group_mean_overlay_color,
              size = 2.4
            ) +
            labs(
              title = "One-Way ANOVA Test Plot",
              subtitle = paste("F =", round(an_sum[["F value"]][1], 3), "| p =", fmt_p_an),
              x = group_var,
              y = response_var
            ) +
            theme_bw() +
            theme(
              panel.grid.major = element_blank(),
              panel.grid.minor = element_blank(),
              legend.position = "none",
              plot.title = element_text(face = "bold", size = 14),
              axis.title = element_text(face = "bold")
            )

          custom_ggsave(output_image_anova, plot = p_anova, width = 10, height = 8, dpi = 300, device = "png")
          result_list$anova_plot_generated <- TRUE
          result_list$anova_plot_path <- output_image_anova
        }, error = function(e) {
          call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
          anova_plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
        })
        if (!is.null(anova_plot_error)) {
          result_list$anova_plot_error <- anova_plot_error
        }

        # 5c. Mean ± selected CI plot (group means with confidence intervals)
        mean_ci_plot <- create_mean_ci_plot(
          data,
          group_var,
          response_var,
          output_image,
          sprintf("Mean ± %d%% CI Plot: One-Way ANOVA", selected_ci_percent),
          paste("F =", round(an_sum[["F value"]][1], 3), "| p =", fmt_p_an),
          alpha_level = alpha_val
        )
        result_list$mean_ci_plot_generated <- isTRUE(mean_ci_plot$generated)
        if (isTRUE(mean_ci_plot$generated) && !is.null(mean_ci_plot$path)) {
          result_list$mean_ci_plot_path <- mean_ci_plot$path
        } else if (!is.null(mean_ci_plot$error)) {
          result_list$mean_ci_plot_error <- mean_ci_plot$error
        }

        # 5d. ANOVA residual diagnostics (Q-Q + residuals vs fitted)
        residual_vals_anova <- tryCatch(residuals(anova_res), error = function(e) numeric(0))
        fitted_vals_anova <- tryCatch(fitted(anova_res), error = function(e) numeric(0))

        qq_plot <- create_residual_qq_plot(
          residual_vals_anova,
          output_image,
          "Residual Q-Q Plot: One-way ANOVA"
        )
        result_list$residual_qq_plot_generated <- isTRUE(qq_plot$generated)
        if (isTRUE(qq_plot$generated) && !is.null(qq_plot$path)) {
          result_list$residual_qq_plot_path <- qq_plot$path
        } else if (!is.null(qq_plot$error)) {
          result_list$residual_qq_plot_error <- qq_plot$error
        }

        residual_diag_plot <- create_residual_fitted_plot(
          fitted_vals_anova,
          residual_vals_anova,
          output_image,
          "Residuals vs Fitted: One-way ANOVA"
        )
        result_list$anova_residual_plot_generated <- isTRUE(residual_diag_plot$generated)
        if (isTRUE(residual_diag_plot$generated) && !is.null(residual_diag_plot$path)) {
          result_list$anova_residual_plot_path <- residual_diag_plot$path
        } else if (!is.null(residual_diag_plot$error)) {
          result_list$anova_residual_plot_error <- residual_diag_plot$error
        }
      } else {
        # 3b. Welch's ANOVA (heterogeneous variances)
        welch_res <- oneway.test(as.formula(paste(response_var, "~", group_var)), data = data, var.equal = FALSE)
        p_val_welch <- welch_res$p.value
        is_sig_welch <- (p_val_welch < alpha_val)
        fmt_p_welch <- if (p_val_welch < 0.0001) format(p_val_welch, scientific = TRUE, digits = 4) else format(round(p_val_welch, 4), nsmall = 4)
        msg_welch <- if (is_sig_welch) sprintf("Welch's ANOVA shows a significant difference (p = %s < %f). Variances are unequal.", fmt_p_welch, alpha_val)
        else sprintf("Welch's ANOVA shows NO significant difference (p = %s >= %f). Variances are unequal.", fmt_p_welch, alpha_val)
        result_list$anova <- list(
          test_type = "welch",
          statistic = as.numeric(welch_res$statistic), 
          p_value = p_val_welch, 
          formatted_p = fmt_p_welch, 
          message = msg_welch, 
          is_significant = is_sig_welch,
          df1 = welch_res$parameter[1],
          df2 = welch_res$parameter[2],
          eta_squared = NA,
          effect_size = NA,
          effect_size_label = "N/A",
          significance_effect_interpretation = if (is_sig_welch) {
            "Welch's ANOVA is significant; eta-squared is not reported for this branch."
          } else {
            "Welch's ANOVA is not significant; eta-squared is not reported for this branch."
          }
        )
        result_list$anova_table_rows <- list(
          list(
            source = as.character(group_var),
            df = as.numeric(welch_res$parameter[1]),
            statistic = as.numeric(welch_res$statistic),
            p_value = as.numeric(welch_res$p.value),
            formatted_p = fmt_p_value(as.numeric(welch_res$p.value)),
            signif_code = signif_code_from_p(as.numeric(welch_res$p.value)),
            is_residual = FALSE
          )
        )
        
        # 4. Games-Howell Post-hoc Test (run only when omnibus Welch ANOVA is significant)
        if (is_sig_welch) {
          # Implement Games-Howell test manually
          gh_results <- list()
          idx <- 1

          for (i in 1:(n_groups - 1)) {
            for (j in (i + 1):n_groups) {
              g1 <- groups[i]
              g2 <- groups[j]

              x1 <- data[[response_var]][data[[group_var]] == g1]
              x2 <- data[[response_var]][data[[group_var]] == g2]

              n1 <- length(x1)
              n2 <- length(x2)
              m1 <- mean(x1, na.rm = TRUE)
              m2 <- mean(x2, na.rm = TRUE)
              v1 <- var(x1, na.rm = TRUE)
              v2 <- var(x2, na.rm = TRUE)

              # Mean difference
              diff <- m1 - m2

              # Standard error
              se <- sqrt(v1 / n1 + v2 / n2)

              # t-statistic
              t_stat <- diff / se

              # Welch-Satterthwaite degrees of freedom
              df <- (v1 / n1 + v2 / n2)^2 / ((v1 / n1)^2 / (n1 - 1) + (v2 / n2)^2 / (n2 - 1))

              # Two-tailed p-value
              p_val <- 2 * pt(-abs(t_stat), df)

              # Tukey adjustment for multiple comparisons
              n_comparisons <- n_groups * (n_groups - 1) / 2
              p_adj <- pmin(1, p_val * n_comparisons)

              # Confidence interval
              q_crit <- qtukey(1 - alpha_val, n_groups, df) / sqrt(2)
              ci_half <- q_crit * se

              gh_results[[idx]] <- list(
                comparison = paste(g1, "-", g2),
                group1 = as.character(g1),
                group2 = as.character(g2),
                diff = diff,
                se = se,
                t_stat = t_stat,
                df = df,
                lwr = diff - ci_half,
                upr = diff + ci_half,
                p_adj = p_adj,
                formatted_p = if (p_adj < 0.0001) format(p_adj, scientific = TRUE, digits = 4) else format(round(p_adj, 4), nsmall = 4),
                is_significant = (p_adj < alpha_val)
              )
              idx <- idx + 1
            }
          }
          if (inferential_significant_only) {
            gh_results <- Filter(function(x) isTRUE(x$is_significant), gh_results)
          }
          if (length(gh_results) > 0) result_list$games_howell <- gh_results

          # 5. Generate Boxplot with significance letters for Games-Howell
          tryCatch({
            ensure_optional_pkg("ggplot2", "Games-Howell post-hoc plot")
            ensure_optional_pkg("multcompView", "Games-Howell compact-letter display")

            group_levels <- as.character(groups)
            p_matrix <- matrix(1, nrow = length(group_levels), ncol = length(group_levels), dimnames = list(group_levels, group_levels))
            diag(p_matrix) <- 0

            for (gh_item in gh_results) {
              g1_name <- as.character(gh_item$group1)
              g2_name <- as.character(gh_item$group2)
              p_adj_val <- suppressWarnings(as.numeric(gh_item$p_adj))
              if (is.na(p_adj_val) || !is.finite(p_adj_val)) p_adj_val <- 1
              if ((g1_name %in% rownames(p_matrix)) && (g2_name %in% colnames(p_matrix))) {
                p_matrix[g1_name, g2_name] <- p_adj_val
                p_matrix[g2_name, g1_name] <- p_adj_val
              }
            }

            cld_obj <- multcompView::multcompLetters(p_matrix < alpha_val)
            cld_letters <- cld_obj$Letters
            cld_df <- data.frame(
              group = names(cld_letters),
              letter = as.character(cld_letters),
              stringsAsFactors = FALSE
            )

            max_y_df <- aggregate(as.formula(paste(response_var, "~", group_var)), data = data, max, na.rm = TRUE)
            colnames(max_y_df) <- c("group", "y_pos")
            cld_df <- merge(cld_df, max_y_df, by = "group", all.x = TRUE)

            y_range <- range(data[[response_var]], na.rm = TRUE)
            y_offset <- if (all(is.finite(y_range))) max(diff(y_range) * 0.05, .Machine$double.eps) else 0.05
            cld_df$y_pos <- as.numeric(cld_df$y_pos) + y_offset

            group_levels_plot <- levels(as.factor(data[[group_var]]))
            group_fill_values <- get_level_color_map(
              group_var,
              group_levels_plot,
              pick_cols(length(group_levels_plot))
            )
            group_color_intensity <- get_custom_plot_intensity("three_group_group_color_intensity", 1)
            group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
            three_group_box_border_color <- get_custom_plot_color("three_group_box_border_color", "#1f2937")
            three_group_outlier_color <- get_custom_plot_color("three_group_outlier_color", "#f59e0b")
            three_group_mean_overlay_color <- get_custom_plot_color("three_group_mean_overlay_color", "#dc2626")
            three_group_label_color <- get_custom_plot_color("three_group_label_color", "#0f172a")

            output_image_param <- gsub("\\.png$", "_games_howell.png", output_image)

            p <- ggplot(data, aes(x = .data[[group_var]], y = .data[[response_var]])) +
              geom_boxplot(
                aes(fill = .data[[group_var]]),
                alpha = 0.8,
                color = three_group_box_border_color,
                outlier.colour = three_group_outlier_color
              ) +
              scale_fill_manual(values = group_fill_values, drop = FALSE) +
              stat_summary(
                fun = mean,
                geom = "crossbar",
                width = 0.78,
                color = three_group_mean_overlay_color,
                linetype = "dashed",
                linewidth = 0.3
              ) +
              geom_text(
                data = cld_df,
                aes(x = group, y = y_pos, label = letter),
                size = 4,
                vjust = -0.4,
                fontface = "bold",
                color = three_group_label_color
              ) +
              labs(
                title = "Games-Howell Post-hoc Test Results",
                subtitle = paste("Welch ANOVA F =", round(as.numeric(welch_res$statistic), 2), ", p =", format(as.numeric(welch_res$p.value), digits = 4)),
                x = group_var,
                y = response_var
              ) +
              theme_bw() +
              theme(
                panel.grid.major = element_blank(),
                panel.grid.minor = element_blank(),
                legend.position = "none",
                plot.title = element_text(face = "bold", size = 14),
                axis.title = element_text(face = "bold")
              )

            custom_ggsave(output_image_param, plot = p, width = 10, height = 8, dpi = 300, device = "png")
            result_list$plot_generated <- TRUE
            result_list$plot_path <- output_image_param
          }, error = function(e) {
            result_list$plot_error <- e$message
          })
        } else {
          result_list$posthoc_skipped_reason <- "Welch ANOVA was not significant; Games-Howell post-hoc comparisons were skipped."
        }

        # 6. Mean ± selected CI plot for Welch one-way ANOVA
        mean_ci_plot <- create_mean_ci_plot(
          data,
          group_var,
          response_var,
          output_image,
          sprintf("Mean ± %d%% CI Plot: Welch One-Way ANOVA", selected_ci_percent),
          paste("Welch F =", round(as.numeric(welch_res$statistic), 3), "| p =", fmt_p_welch),
          alpha_level = alpha_val
        )
        result_list$mean_ci_plot_generated <- isTRUE(mean_ci_plot$generated)
        if (isTRUE(mean_ci_plot$generated) && !is.null(mean_ci_plot$path)) {
          result_list$mean_ci_plot_path <- mean_ci_plot$path
        } else if (!is.null(mean_ci_plot$error)) {
          result_list$mean_ci_plot_error <- mean_ci_plot$error
        }

      }
    }
  }
  }
  }

  if (!use_parametric_path) {
    result_list$path_taken <- "non-parametric"

    if (is_factorial && factorial_design %in% c("within", "mixed")) {
      if (is.null(subject_var) || !(subject_var %in% colnames(data))) {
        stop(sprintf("ART non-parametric %s design requires a Subject ID variable.", factorial_design))
      }

      result_list$test_type <- "art_factorial"
      result_list$is_factorial <- TRUE
      result_list$factor1 <- group_var
      result_list$factor2 <- group_var2
      result_list$factorial_design_type <- factorial_design
      result_list$art <- TRUE

      data[[subject_var]] <- as.factor(data[[subject_var]])

      fmt_p <- function(pv) {
        if (is.na(pv)) return("N/A")
        if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
        format(round(pv, 4), nsmall = 4)
      }

      eta_label <- function(val) {
        if (is.na(val)) return("unknown")
        if (val < 0.01) return("negligible")
        if (val < 0.06) return("small")
        if (val < 0.14) return("medium")
        "large"
      }

      # ART-like alignment by removing nuisance fixed effects, then ranking.
      align_effect <- function(which_effect) {
        if (which_effect == "A") {
          nuisance_formula <- as.formula(paste(response_var, "~", group_var2, "+", paste(group_var, group_var2, sep = ":")))
        } else if (which_effect == "B") {
          nuisance_formula <- as.formula(paste(response_var, "~", group_var, "+", paste(group_var, group_var2, sep = ":")))
        } else {
          nuisance_formula <- as.formula(paste(response_var, "~", group_var, "+", group_var2))
        }
        mod <- tryCatch(lm(nuisance_formula, data = data), error = function(e) NULL)
        if (is.null(mod)) return(rep(NA_real_, nrow(data)))
        resid(mod)
      }

      data$..art_A <- rank(align_effect("A"), ties.method = "average")
      data$..art_B <- rank(align_effect("B"), ties.method = "average")
      data$..art_AB <- rank(align_effect("AB"), ties.method = "average")

      if (factorial_design == "mixed") {
        formula_a <- paste("..art_A ~", group_var, "*", group_var2, "+ Error(", subject_var, "/", group_var2, ")")
        formula_b <- paste("..art_B ~", group_var, "*", group_var2, "+ Error(", subject_var, "/", group_var2, ")")
        formula_ab <- paste("..art_AB ~", group_var, "*", group_var2, "+ Error(", subject_var, "/", group_var2, ")")
      } else {
        formula_a <- paste("..art_A ~", group_var, "*", group_var2, "+ Error(", subject_var, "/(", group_var, "*", group_var2, "))")
        formula_b <- paste("..art_B ~", group_var, "*", group_var2, "+ Error(", subject_var, "/(", group_var, "*", group_var2, "))")
        formula_ab <- paste("..art_AB ~", group_var, "*", group_var2, "+ Error(", subject_var, "/(", group_var, "*", group_var2, "))")
      }

      art_a_summary <- summary(aov(as.formula(formula_a), data = data))
      art_b_summary <- summary(aov(as.formula(formula_b), data = data))
      art_ab_summary <- summary(aov(as.formula(formula_ab), data = data))

      extract_art_term <- function(art_summary, term_label, factor_name = NULL, is_interaction = FALSE) {
        found_tbl <- NULL
        term_idx <- NA
        res_idx <- NA
        for (nm in names(art_summary)) {
          tbl <- art_summary[[nm]][[1]]
          if (!is.null(tbl)) {
            row_names <- trimws(rownames(tbl))
            if (term_label %in% row_names) {
              found_tbl <- tbl
              term_idx <- which(row_names == term_label)[1]
              res_idx <- if ("Residuals" %in% row_names) which(row_names == "Residuals")[1] else NA
              break
            }
          }
        }
        if (is.null(found_tbl)) return(NULL)

        df_num <- as.numeric(found_tbl[term_idx, "Df"])
        df_den <- if (!is.na(res_idx)) as.numeric(found_tbl[res_idx, "Df"]) else NA
        f_val <- as.numeric(found_tbl[term_idx, "F value"])
        p_val <- as.numeric(found_tbl[term_idx, "Pr(>F)"])
        ss_effect <- as.numeric(found_tbl[term_idx, "Sum Sq"])
        ss_error <- if (!is.na(res_idx)) as.numeric(found_tbl[res_idx, "Sum Sq"]) else NA
        eta_sq <- if (!is.na(ss_effect) && !is.na(ss_error) && (ss_effect + ss_error) > 0) ss_effect / (ss_effect + ss_error) else NA
        if (is.na(eta_sq)) eta_sq <- 0
        eta_lbl <- eta_label(eta_sq)
        is_sig <- !is.na(p_val) && (p_val < alpha_val)
        fmt_p_val <- fmt_p(p_val)

        msg <- if (is_interaction) {
          if (is_sig) {
            sprintf("ART: Interaction effect (%s × %s) is significant (F = %.3f, p = %s).", group_var, group_var2, f_val, fmt_p_val)
          } else {
            sprintf("ART: Interaction effect (%s × %s) is NOT significant (F = %.3f, p = %s).", group_var, group_var2, f_val, fmt_p_val)
          }
        } else {
          if (is_sig) {
            sprintf("ART: Main effect of %s is significant (F = %.3f, p = %s).", factor_name, f_val, fmt_p_val)
          } else {
            sprintf("ART: Main effect of %s is NOT significant (F = %.3f, p = %s).", factor_name, f_val, fmt_p_val)
          }
        }

        list(
          factor_name = factor_name,
          f_statistic = as.numeric(f_val),
          df_num = df_num,
          df_den = df_den,
          p_value = p_val,
          formatted_p = fmt_p_val,
          eta_squared = eta_sq,
          effect_size_label = eta_lbl,
          is_significant = is_sig,
          message = msg
        )
      }

      inter_term <- paste(group_var, group_var2, sep = ":")
      main_A <- extract_art_term(art_a_summary, group_var, factor_name = group_var, is_interaction = FALSE)
      main_B <- extract_art_term(art_b_summary, group_var2, factor_name = group_var2, is_interaction = FALSE)
      inter <- extract_art_term(art_ab_summary, inter_term, factor_name = "Interaction", is_interaction = TRUE)
      if (!is.null(main_A)) result_list$main_effect_A <- main_A
      if (!is.null(main_B)) result_list$main_effect_B <- main_B
      if (!is.null(inter)) result_list$interaction <- inter

      art_posthoc <- list()
      add_art_posthoc <- function(rows) {
        if (!is.null(rows) && length(rows) > 0) art_posthoc <<- c(art_posthoc, rows)
      }
      run_factorial_posthoc <- has_significant_factorial_effect(main_A, main_B, inter)

      if (run_factorial_posthoc) {
        if (factorial_design == "mixed") {
          # Main effects on aligned ranks
          add_art_posthoc(calc_pairwise_independent_t(data, group_var, "..art_A", group_var, alpha_val, "holm"))
          add_art_posthoc(calc_pairwise_paired_t(data, subject_var, group_var2, "..art_B", group_var2, alpha_val, "holm"))

          # Simple effects from interaction-aligned ranks
          lvls_a <- levels(as.factor(data[[group_var]]))
          for (lvl in lvls_a) {
            sub_df <- data[data[[group_var]] == lvl, , drop = FALSE]
            add_art_posthoc(calc_pairwise_paired_t(sub_df, subject_var, group_var2, "..art_AB", paste(group_var2, "|", paste0(group_var, "=", lvl)), alpha_val, "holm"))
          }
          lvls_b <- levels(as.factor(data[[group_var2]]))
          for (lvl in lvls_b) {
            sub_df <- data[data[[group_var2]] == lvl, , drop = FALSE]
            add_art_posthoc(calc_pairwise_independent_t(sub_df, group_var, "..art_AB", paste(group_var, "|", paste0(group_var2, "=", lvl)), alpha_val, "holm"))
          }
        } else {
          # Main effects on aligned ranks
          add_art_posthoc(calc_pairwise_paired_t(data, subject_var, group_var, "..art_A", group_var, alpha_val, "holm"))
          add_art_posthoc(calc_pairwise_paired_t(data, subject_var, group_var2, "..art_B", group_var2, alpha_val, "holm"))

          # Simple effects from interaction-aligned ranks
          lvls_b <- levels(as.factor(data[[group_var2]]))
          for (lvl in lvls_b) {
            sub_df <- data[data[[group_var2]] == lvl, , drop = FALSE]
            add_art_posthoc(calc_pairwise_paired_t(sub_df, subject_var, group_var, "..art_AB", paste(group_var, "|", paste0(group_var2, "=", lvl)), alpha_val, "holm"))
          }
          lvls_a <- levels(as.factor(data[[group_var]]))
          for (lvl in lvls_a) {
            sub_df <- data[data[[group_var]] == lvl, , drop = FALSE]
            add_art_posthoc(calc_pairwise_paired_t(sub_df, subject_var, group_var2, "..art_AB", paste(group_var2, "|", paste0(group_var, "=", lvl)), alpha_val, "holm"))
          }
        }
        result_list$posthoc_strategy <- "Effect-aware mode: ART contrasts computed only after significant factorial effects."
        if (length(art_posthoc) > 0) {
          result_list$art_posthoc <- art_posthoc
        }
      } else {
        result_list$posthoc_skipped_reason <- "No significant factorial effect detected; ART post-hoc contrasts were skipped."
      }
    } else if (is_factorial) {
      result_list$test_type <- "scheirer_ray_hare"
      result_list$is_factorial <- TRUE
      result_list$factor1 <- group_var
      result_list$factor2 <- group_var2
      result_list$srh <- TRUE

      fmt_p <- function(pv) {
        if (is.na(pv)) return("N/A")
        if (pv < 0.0001) return(format(pv, scientific = TRUE, digits = 4))
        format(round(pv, 4), nsmall = 4)
      }

      eta_label <- function(val) {
        if (is.na(val)) return("unknown")
        if (val < 0.01) return("negligible")
        if (val < 0.06) return("small")
        if (val < 0.14) return("medium")
        "large"
      }

      rank_df <- data[, c(response_var, group_var, group_var2)]
      rank_df$ranked <- rank(rank_df[[response_var]], ties.method = "average")
      srh_model <- aov(as.formula(paste("ranked ~", group_var, "*", group_var2)), data = rank_df)
      srh_summary <- summary(srh_model)[[1]]
      ss_total <- sum(srh_summary[["Sum Sq"]])
      n_total <- nrow(rank_df)

      extract_srh <- function(term_label, factor_name = NULL, is_interaction = FALSE) {
        row_names <- trimws(rownames(srh_summary))
        term_idx <- which(row_names == term_label)[1]
        if (is.na(term_idx)) return(NULL)

        ss_effect <- as.numeric(srh_summary[term_idx, "Sum Sq"])
        df_val <- as.numeric(srh_summary[term_idx, "Df"])
        h_val <- if (!is.na(ss_effect) && !is.na(ss_total) && ss_total > 0) (ss_effect / ss_total) * (n_total - 1) else NA
        p_val <- if (!is.na(h_val) && !is.na(df_val)) pchisq(h_val, df_val, lower.tail = FALSE) else NA
        eta_sq <- if (!is.na(ss_effect) && !is.na(ss_total) && ss_total > 0) ss_effect / ss_total else NA
        if (is.na(eta_sq)) eta_sq <- 0
        eta_lbl <- eta_label(eta_sq)
        is_sig <- !is.na(p_val) && (p_val < alpha_val)
        fmt_p_val <- fmt_p(p_val)

        msg <- if (is_interaction) {
          if (is_sig) {
            sprintf("Scheirer-Ray-Hare: Interaction effect (%s × %s) is significant (H(%d) = %.3f, p = %s).",
                    group_var, group_var2, df_val, h_val, fmt_p_val)
          } else {
            sprintf("Scheirer-Ray-Hare: Interaction effect (%s × %s) is NOT significant (H(%d) = %.3f, p = %s).",
                    group_var, group_var2, df_val, h_val, fmt_p_val)
          }
        } else {
          if (is_sig) {
            sprintf("Scheirer-Ray-Hare: Main effect of %s is significant (H(%d) = %.3f, p = %s).",
                    factor_name, df_val, h_val, fmt_p_val)
          } else {
            sprintf("Scheirer-Ray-Hare: Main effect of %s is NOT significant (H(%d) = %.3f, p = %s).",
                    factor_name, df_val, h_val, fmt_p_val)
          }
        }

        list(
          factor_name = factor_name,
          f_statistic = as.numeric(h_val),
          df_num = df_val,
          df_den = NA,
          p_value = p_val,
          formatted_p = fmt_p_val,
          eta_squared = eta_sq,
          effect_size_label = eta_lbl,
          is_significant = is_sig,
          message = msg
        )
      }

      main_A <- extract_srh(group_var, factor_name = group_var, is_interaction = FALSE)
      main_B <- extract_srh(group_var2, factor_name = group_var2, is_interaction = FALSE)
      inter_term <- paste(group_var, group_var2, sep = ":")
      inter <- extract_srh(inter_term, factor_name = "Interaction", is_interaction = TRUE)

      if (!is.null(main_A)) result_list$main_effect_A <- main_A
      if (!is.null(main_B)) result_list$main_effect_B <- main_B
      if (!is.null(inter)) result_list$interaction <- inter

      dunn_rows <- list()
      add_dunn <- function(rows) {
        if (!is.null(rows) && length(rows) > 0) dunn_rows <<- c(dunn_rows, rows)
      }
      run_factorial_posthoc <- has_significant_factorial_effect(main_A, main_B, inter)

      if (run_factorial_posthoc) {
        add_dunn(calc_pairwise_dunn(data[[response_var]], data[[group_var]], group_var, alpha_val, "bonferroni"))
        add_dunn(calc_pairwise_dunn(data[[response_var]], data[[group_var2]], group_var2, alpha_val, "bonferroni"))

        lvls_b <- levels(as.factor(data[[group_var2]]))
        for (lvl in lvls_b) {
          sub_df <- data[data[[group_var2]] == lvl, , drop = FALSE]
          add_dunn(calc_pairwise_dunn(sub_df[[response_var]], sub_df[[group_var]], paste(group_var, "|", paste0(group_var2, "=", lvl)), alpha_val, "bonferroni"))
        }
        lvls_a <- levels(as.factor(data[[group_var]]))
        for (lvl in lvls_a) {
          sub_df <- data[data[[group_var]] == lvl, , drop = FALSE]
          add_dunn(calc_pairwise_dunn(sub_df[[response_var]], sub_df[[group_var2]], paste(group_var2, "|", paste0(group_var, "=", lvl)), alpha_val, "bonferroni"))
        }
        result_list$posthoc_strategy <- "Effect-aware mode: Dunn contrasts computed only after significant factorial effects."
        if (length(dunn_rows) > 0) {
          result_list$dunn <- dunn_rows
        }
      } else {
        result_list$posthoc_skipped_reason <- "No significant factorial effect detected; Dunn post-hoc contrasts were skipped."
      }
    } else {
      # Check number of groups
      groups <- unique(data[[group_var]])
      n_groups <- length(groups)
      result_list$n_groups <- n_groups

    # DEBUG LOGGING (REMOVE LATER)
    # cat(paste0("DEBUG: n_groups=", n_groups, ", is_paired=", is_paired, ", subject_var=", ifelse(is.null(subject_var), "NULL", subject_var), "\n"))
    
    if (n_groups == 2) {
       # 2 Groups: Mann-Whitney U or Wilcoxon Signed-Rank
       g1 <- groups[1]
       g2 <- groups[2]
       x1 <- data[[response_var]][data[[group_var]] == g1]
       x2 <- data[[response_var]][data[[group_var]] == g2]
       n1 <- length(x1)
       n2 <- length(x2)
       
       if (is_paired) {
           # Wilcoxon Signed-Rank (Paired Non-Parametric)
           if (length(x1) == length(x2)) {
                wt_res <- wilcox.test(x1, x2, paired = TRUE)
                test_name <- "Wilcoxon Signed-Rank Test"
           } else {
                wt_res <- wilcox.test(x1, x2, paired = FALSE)
                test_name <- paste("Mann-Whitney U Test (Paired fallback due to uneven lengths n1=", length(x1), " n2=", length(x2), ")")
           }
       } else {
           # Mann-Whitney U (Independent Non-Parametric)
           wt_res <- wilcox.test(x1, x2, paired = FALSE)
           test_name <- "Mann-Whitney U Test"
       }
       
       p_val_mw <- wt_res$p.value
       is_sig_mw <- (p_val_mw < alpha_val)
       fmt_p_mw <- if (p_val_mw < 0.0001) format(p_val_mw, scientific = TRUE, digits = 4) else format(round(p_val_mw, 4), nsmall = 4)
       stat_mw <- as.numeric(wt_res$statistic)

       # Effect size: rank-biserial correlation
       rank_biserial <- NA
       rank_biserial_fmt <- "N/A"
       rank_biserial_label <- "N/A"
       rank_biserial_interp <- "Rank-biserial correlation was not computed for this test."
       is_mann_whitney <- grepl("Mann-Whitney", test_name, ignore.case = TRUE)
       is_wilcoxon_signed <- grepl("Wilcoxon Signed-Rank", test_name, ignore.case = TRUE)

       classify_rb_effect <- function(rb_value) {
         rb_abs <- abs(rb_value)
         if (rb_abs < 0.10) {
           "negligible"
         } else if (rb_abs < 0.30) {
           "small"
         } else if (rb_abs < 0.50) {
           "medium"
         } else {
           "large"
         }
       }

       if (is_mann_whitney && !is.na(stat_mw) && (n1 * n2) > 0) {
         rank_biserial <- (2 * stat_mw) / (n1 * n2) - 1
         rank_biserial_fmt <- format(round(rank_biserial, 3), nsmall = 3)
         rank_biserial_label <- classify_rb_effect(rank_biserial)

         direction_text <- if (rank_biserial > 0) {
           sprintf("%s tends to have higher ranks than %s", g1, g2)
         } else if (rank_biserial < 0) {
           sprintf("%s tends to have higher ranks than %s", g2, g1)
         } else {
           sprintf("%s and %s show similar rank tendencies", g1, g2)
         }

         rank_biserial_interp <- sprintf(
           "Rank-biserial correlation = %s (%s effect); %s.",
           rank_biserial_fmt,
           rank_biserial_label,
           direction_text
         )
       }

       if (is_wilcoxon_signed && !is.na(stat_mw)) {
         paired_complete <- complete.cases(x1, x2)
         diffs <- x1[paired_complete] - x2[paired_complete]
         diffs <- diffs[!is.na(diffs)]
         diffs <- diffs[diffs != 0]
         n_eff <- length(diffs)

         if (n_eff > 0) {
           total_rank_sum <- n_eff * (n_eff + 1) / 2
           rank_biserial <- (2 * stat_mw - total_rank_sum) / total_rank_sum
           rank_biserial_fmt <- format(round(rank_biserial, 3), nsmall = 3)
           rank_biserial_label <- classify_rb_effect(rank_biserial)

           direction_text <- if (rank_biserial > 0) {
             sprintf("%s tends to be higher than %s across pairs", g1, g2)
           } else if (rank_biserial < 0) {
             sprintf("%s tends to be higher than %s across pairs", g2, g1)
           } else {
             sprintf("%s and %s show balanced paired differences", g1, g2)
           }

           rank_biserial_interp <- sprintf(
             "Rank-biserial correlation = %s (%s effect); %s.",
             rank_biserial_fmt,
             rank_biserial_label,
             direction_text
           )
         } else {
           rank_biserial_interp <- "Rank-biserial correlation was not computed because all paired differences were zero."
         }
       }
       
       msg_mw <- if (is_sig_mw) sprintf("%s shows a significant difference (p = %s < %f).", test_name, fmt_p_mw, alpha_val)
       else sprintf("%s shows NO significant difference (p = %s >= %f).", test_name, fmt_p_mw, alpha_val)
       
       res_obj <- list(
            test_name = test_name,
            statistic = stat_mw,
            p_value = p_val_mw,
            formatted_p = fmt_p_mw,
            message = msg_mw,
            is_significant = is_sig_mw,
            group1 = g1,
            group2 = g2,
            median1 = median(x1, na.rm=TRUE),
            median2 = median(x2, na.rm=TRUE),
            rank_biserial = rank_biserial,
            rank_biserial_formatted = rank_biserial_fmt,
            rank_biserial_effect = rank_biserial_label,
            rank_biserial_interpretation = rank_biserial_interp
       )
       
       if (is_paired) {
           result_list$wilcoxon <- res_obj
       } else {
           result_list$mann_whitney <- res_obj
           mw_subtitle <- paste(
             "U =",
             if (is.finite(stat_mw)) format(round(stat_mw, 3), nsmall = 3) else "NA",
             "| p =",
             fmt_p_mw
           )
           mw_plot <- create_mann_whitney_box_raw_plot(
             data,
             group_var,
             response_var,
             output_image,
             "Mann-Whitney U: Boxplot + Raw Points",
             mw_subtitle
           )
           result_list$mann_whitney_boxplot_generated <- isTRUE(mw_plot$generated)
           if (isTRUE(mw_plot$generated) && !is.null(mw_plot$path)) {
             result_list$mann_whitney_boxplot_path <- mw_plot$path
           } else if (!is.null(mw_plot$error)) {
             result_list$mann_whitney_boxplot_error <- mw_plot$error
           }
       }

       two_group_plot <- create_two_group_publication_plot(
         data = data,
         group_var = group_var,
         response_var = response_var,
         result_list = result_list,
         base_output_image = output_image,
         alpha_level = alpha_val,
         is_paired = is_paired,
         subject_var = subject_var
       )
       result_list$two_group_publication_plot_generated <- isTRUE(two_group_plot$generated)
       result_list$two_group_publication_plot_paired_overlay <- isTRUE(two_group_plot$paired_overlay)
       if (!is.null(two_group_plot$pairing_method) && nzchar(as.character(two_group_plot$pairing_method))) {
         result_list$two_group_publication_plot_pairing_method <- as.character(two_group_plot$pairing_method)
       }
       if (!is.null(two_group_plot$paired_n) && is.finite(as.numeric(two_group_plot$paired_n))) {
         result_list$two_group_publication_plot_paired_n <- as.integer(two_group_plot$paired_n)
       }
       if (isTRUE(two_group_plot$generated) && !is.null(two_group_plot$path)) {
         result_list$two_group_publication_plot_path <- two_group_plot$path
         result_list$plot_generated <- TRUE
         result_list$plot_path <- two_group_plot$path
         if (is_paired) {
           result_list$wilcoxon_plot_generated <- TRUE
           result_list$wilcoxon_plot_path <- two_group_plot$path
         } else {
           result_list$mann_whitney_boxplot_generated <- TRUE
           result_list$mann_whitney_boxplot_path <- two_group_plot$path
         }
       } else if (!is.null(two_group_plot$error)) {
         result_list$two_group_publication_plot_error <- two_group_plot$error
       }
       
    } else {
        # >2 Groups: Repeated Measures or Independent
        if (is_paired) {
             # FRIEDMAN TEST (Repeated Measures Non-Parametric)
             if (is.null(subject_var)) {
                 # Fallback if no subject ID provided
                 msg_err <- "Friedman Test requires a Subject ID variable. Please select one in the UI. Falling back to Kruskal-Wallis (Independent)."
                 # Fallback code same as K-W below
                 kw_res <- kruskal.test(as.formula(paste(response_var, "~", group_var)), data = data)
                 p_val_kw <- kw_res$p.value
                 is_sig_kw <- (p_val_kw < alpha_val)
                 fmt_p_kw <- if (p_val_kw < 0.0001) format(p_val_kw, scientific = TRUE, digits = 4) else format(round(p_val_kw, 4), nsmall = 4)
                 
                 result_list$friedman <- list(
                     error = TRUE,
                     message = msg_err,
                     fallback_kruskal = list(statistic = as.numeric(kw_res$statistic), p_value = p_val_kw, formatted_p = fmt_p_kw, is_significant = is_sig_kw)
                 )
             } else {
                 # Check if subject var exists
                 if (!subject_var %in% colnames(data)) {
                      stop(paste("Subject variable not found:", subject_var))
                 }
                 
                 # Friedman test formula: response ~ group | subject
                 # R's friedman.test uses formula: y ~ groups | blocks
                 f_res <- friedman.test(as.formula(paste(response_var, "~", group_var, "|", subject_var)), data = data)
                 
                 p_val_f <- f_res$p.value
                 is_sig_f <- (p_val_f < alpha_val)
                 fmt_p_f <- if (p_val_f < 0.0001) format(p_val_f, scientific = TRUE, digits = 4) else format(round(p_val_f, 4), nsmall = 4)
                 
                 msg_f <- if (is_sig_f) sprintf("Friedman test shows a significant difference (p = %s < %f).", fmt_p_f, alpha_val)
                 else sprintf("Friedman test shows NO significant difference (p = %s >= %f).", fmt_p_f, alpha_val)
                 
                 result_list$friedman <- list(
                     statistic = as.numeric(f_res$statistic),
                     p_value = p_val_f,
                     formatted_p = fmt_p_f,
                     df = as.numeric(f_res$parameter),
                     message = msg_f,
                     is_significant = is_sig_f
                 )
                 result_list$test_type <- "friedman"
                 
                 # Post-hoc: Nemenyi test (only when Friedman is significant)
                 wide <- reshape(data, idvar = subject_var, timevar = group_var, direction = "wide")
                 val_cols <- grep(paste0("^", response_var, "\\."), names(wide), value = TRUE)
                 if (length(val_cols) >= 2) {
                     groups <- sub(paste0("^", response_var, "\\."), "", val_cols)
                     mat <- as.matrix(wide[, val_cols])
                     complete_idx <- apply(mat, 1, function(x) all(!is.na(x)))
                     mat <- mat[complete_idx, , drop = FALSE]
                     n_blocks <- nrow(mat)
                     k_groups <- ncol(mat)
                     
                     if (n_blocks > 1 && k_groups > 1 && is_sig_f) {
                         rank_mat <- t(apply(mat, 1, function(x) rank(x, ties.method = "average")))
                         colnames(rank_mat) <- groups
                         avg_ranks <- colMeans(rank_mat)

                         denom <- sqrt(k_groups * (k_groups + 1) / (6 * n_blocks))
                         pw_list <- list()
                         idx <- 1

                         for (i in 1:(k_groups - 1)) {
                             for (j in (i + 1):k_groups) {
                                 diff_r <- abs(avg_ranks[i] - avg_ranks[j])
                                 q_stat <- diff_r / denom
                                 p_adj <- 1 - ptukey(q_stat * sqrt(2), k_groups, Inf)
                                 if (is.nan(p_adj) || is.na(p_adj)) p_adj <- 1
                                 if (p_adj < 0) p_adj <- 0
                                 if (p_adj > 1) p_adj <- 1
                                 pw_list[[idx]] <- list(
                                     comparison = paste(names(avg_ranks)[i], "-", names(avg_ranks)[j]),
                                     statistic = q_stat,
                                     p_adj = p_adj,
                                     formatted_p = if (p_adj < 0.0001) format(p_adj, scientific = TRUE, digits = 4) else format(round(p_adj, 4), nsmall = 4),
                                     is_significant = (p_adj < alpha_val)
                                 )
                                 idx <- idx + 1
                             }
                         }
                         if (inferential_significant_only) {
                           pw_list <- Filter(function(x) isTRUE(x$is_significant), pw_list)
                         }
                         result_list$friedman_posthoc <- pw_list
                     } else if (n_blocks > 1 && k_groups > 1 && !is_sig_f) {
                       result_list$posthoc_skipped_reason <- "Friedman test was not significant; Nemenyi post-hoc comparisons were skipped."
                     }

                     # Friedman visualization: spaghetti plot + median ± IQR
                     if (n_blocks > 1 && k_groups > 1) {
                         friedman_plot_df <- data.frame(
                             SubjectID = rep(wide[[subject_var]][complete_idx], times = k_groups),
                             Condition = factor(rep(groups, each = n_blocks), levels = groups),
                             Value = as.numeric(as.vector(mat)),
                             stringsAsFactors = FALSE
                         )
                         friedman_plot <- create_friedman_spaghetti_iqr_plot(
                             friedman_plot_df,
                             "SubjectID",
                             "Condition",
                             "Value",
                             output_image,
                             "Friedman Spaghetti Plot + Median ± IQR",
                             paste("Friedman chi-squared =", round(as.numeric(f_res$statistic), 3), "| p =", fmt_p_f)
                         )
                         result_list$friedman_spaghetti_iqr_plot_generated <- isTRUE(friedman_plot$generated)
                         if (isTRUE(friedman_plot$generated) && !is.null(friedman_plot$path)) {
                             result_list$friedman_spaghetti_iqr_plot_path <- friedman_plot$path
                         } else if (!is.null(friedman_plot$error)) {
                             result_list$friedman_spaghetti_iqr_plot_error <- friedman_plot$error
                         }
                     }
                 }
             }
         } else {
             # Kruskal-Wallis (Independent Non-Parametric) -> Existing Logic
             kw_res <- kruskal.test(as.formula(paste(response_var, "~", group_var)), data = data)
             p_val_kw <- kw_res$p.value
             is_sig_kw <- (p_val_kw < alpha_val)
             fmt_p_kw <- if (p_val_kw < 0.0001) format(p_val_kw, scientific = TRUE, digits = 4) else format(round(p_val_kw, 4), nsmall = 4)
             k <- as.numeric(kw_res$parameter) + 1
             n <- nrow(data)
             epsilon_squared <- (as.numeric(kw_res$statistic) - k + 1) / (n - k)
             
             # Interpretation
             epsilon_label <- "unknown"
             if (!is.na(epsilon_squared)) {
                 if (epsilon_squared < 0.01) {
                     epsilon_label <- "negligible"
                 } else if (epsilon_squared < 0.06) {
                     epsilon_label <- "small"
                 } else if (epsilon_squared < 0.14) {
                     epsilon_label <- "medium"
                 } else {
                     epsilon_label <- "large"
                 }
             }
             
             msg_kw <- if (is_sig_kw) sprintf("Kruskal-Wallis test shows a significant difference (p = %s < %f). Effect size: %s (epsilon-squared = %.3f).", fmt_p_kw, alpha_val, epsilon_label, epsilon_squared)
             else sprintf("Kruskal-Wallis test shows NO significant difference (p = %s >= %f). Effect size: %s (epsilon-squared = %.3f).", fmt_p_kw, alpha_val, epsilon_label, epsilon_squared)

             result_list$kruskal <- list(
                 statistic = as.numeric(kw_res$statistic), 
                 p_value = p_val_kw, 
                 formatted_p = fmt_p_kw, 
                 df = as.numeric(kw_res$parameter),
                 message = msg_kw,
                 is_significant = is_sig_kw,
                 epsilon_squared = epsilon_squared,
                 effect_size_label = epsilon_label
             )
             result_list$test_type <- "kruskal_wallis"
             result_list$descriptive_table_publication <- create_publication_descriptive_table(
               data,
               group_var,
               response_var,
               ci_level = selected_ci_level
             )
         }
    
         if (!is_paired) {
            run_dunn_posthoc <- !is.null(result_list$kruskal) && isTRUE(result_list$kruskal$is_significant)
            if (run_dunn_posthoc) {
              ensure_optional_pkg("dunn.test", "Kruskal Dunn post-hoc")
              d_res <- tryCatch({
                res <- NULL
                suppressWarnings(suppressMessages(capture.output({
                  res <- dunn.test::dunn.test(data[[response_var]], data[[group_var]], method = "bonferroni", list = TRUE, table = FALSE)
                })))
                res
              }, error = function(e) NULL)
              if (is.null(d_res)) {
                d_res <- list(comparisons = character(0), Z = numeric(0), P.adjusted = numeric(0))
              }

              dunn_list <- list()
              for (i in seq_along(d_res$comparisons)) {
                p_adj_val <- d_res$P.adjusted[i]
                comparison_txt <- as.character(d_res$comparisons[i])
                comp_parts <- strsplit(comparison_txt, "\\s*-\\s*")[[1]]
                comp_parts <- trimws(comp_parts)
                comp_g1 <- if (length(comp_parts) >= 1) comp_parts[1] else NA_character_
                comp_g2 <- if (length(comp_parts) >= 2) comp_parts[2] else NA_character_
                dunn_list[[i]] <- list(
                  comparison = comparison_txt,
                  group1 = comp_g1,
                  group2 = comp_g2,
                  statistic = as.numeric(d_res$Z[i]),
                  z_value = as.numeric(d_res$Z[i]),
                  p_adj = p_adj_val,
                  formatted_p = if (p_adj_val < 0.0001) format(p_adj_val, scientific = TRUE, digits = 4) else format(round(p_adj_val, 4), nsmall = 4),
                  is_significant = (p_adj_val < alpha_val)
                )
              }
              if (inferential_significant_only) {
                dunn_list <- Filter(function(x) isTRUE(x$is_significant), dunn_list)
              }
              if (length(dunn_list) > 0) result_list$dunn <- dunn_list

              # 6. Generate Dunn publication plot (CLD + mean CI + median)
              if (length(d_res$comparisons) > 0) {
                dunn_plot_error <- NULL
                tryCatch({
                  ensure_optional_pkg("ggplot2", "Dunn post-hoc plot")
                  ensure_optional_pkg("multcompView", "Dunn compact-letter display")

                  dunn_plot_df <- data[, c(group_var, response_var), drop = FALSE]
                  colnames(dunn_plot_df) <- c("group", "value")
                  dunn_plot_df$value <- suppressWarnings(as.numeric(as.character(dunn_plot_df$value)))
                  dunn_plot_df <- dunn_plot_df[!is.na(dunn_plot_df$group) & is.finite(dunn_plot_df$value), , drop = FALSE]
                  dunn_plot_df$group <- as.factor(as.character(dunn_plot_df$group))
                  group_levels_plot <- levels(dunn_plot_df$group)
                  if (length(group_levels_plot) < 2) {
                    stop("Dunn publication plot requires at least two groups with valid numeric data.")
                  }

                  p_matrix <- matrix(
                    1,
                    nrow = length(group_levels_plot),
                    ncol = length(group_levels_plot),
                    dimnames = list(group_levels_plot, group_levels_plot)
                  )
                  diag(p_matrix) <- 0
                  for (i in seq_along(d_res$comparisons)) {
                    comp_text <- as.character(d_res$comparisons[i])
                    comp_parts <- strsplit(comp_text, "\\s*-\\s*")[[1]]
                    comp_parts <- trimws(comp_parts)
                    if (length(comp_parts) < 2) next
                    g1_name <- comp_parts[1]
                    g2_name <- comp_parts[2]
                    p_adj_val <- suppressWarnings(as.numeric(d_res$P.adjusted[i]))
                    if (!is.finite(p_adj_val)) p_adj_val <- 1
                    if ((g1_name %in% rownames(p_matrix)) && (g2_name %in% colnames(p_matrix))) {
                      p_matrix[g1_name, g2_name] <- p_adj_val
                      p_matrix[g2_name, g1_name] <- p_adj_val
                    }
                  }
                  cld_obj <- multcompView::multcompLetters(p_matrix < alpha_val)
                  cld_letters <- cld_obj$Letters
                  if (is.null(cld_letters)) {
                    cld_letters <- setNames(rep("", length(group_levels_plot)), group_levels_plot)
                  }

                  dunn_summary_rows <- lapply(group_levels_plot, function(g) {
                    vals <- dunn_plot_df$value[dunn_plot_df$group == g]
                    vals <- vals[is.finite(vals)]
                    n <- length(vals)
                    if (n == 0) return(NULL)
                    m <- mean(vals, na.rm = TRUE)
                    s <- if (n > 1) sd(vals, na.rm = TRUE) else NA_real_
                    med <- median(vals, na.rm = TRUE)
                    q1 <- as.numeric(stats::quantile(vals, probs = 0.25, na.rm = TRUE, names = FALSE, type = 7))
                    q3 <- as.numeric(stats::quantile(vals, probs = 0.75, na.rm = TRUE, names = FALSE, type = 7))
                    se <- if (is.finite(s) && n > 0) s / sqrt(n) else NA_real_
                    t_crit <- if (n > 1) stats::qt(selected_ci_prob, df = n - 1) else NA_real_
                    ci_half <- if (is.finite(se) && is.finite(t_crit)) se * t_crit else NA_real_
                    ci_low <- if (is.finite(ci_half)) m - ci_half else m
                    ci_up <- if (is.finite(ci_half)) m + ci_half else m
                    whisker_top <- as.numeric(grDevices::boxplot.stats(vals)$stats[5])
                    list(
                      group = as.character(g),
                      n = as.numeric(n),
                      mean = as.numeric(m),
                      median = as.numeric(med),
                      q1 = as.numeric(q1),
                      q3 = as.numeric(q3),
                      ci_low = as.numeric(ci_low),
                      ci_up = as.numeric(ci_up),
                      whisker_top = as.numeric(whisker_top)
                    )
                  })
                  dunn_summary_rows <- Filter(Negate(is.null), dunn_summary_rows)
                  if (length(dunn_summary_rows) == 0) {
                    stop("No valid group summaries available for Dunn publication plot.")
                  }
                  dunn_summary_df <- data.frame(
                    group = factor(sapply(dunn_summary_rows, function(r) r$group), levels = group_levels_plot),
                    n = as.numeric(sapply(dunn_summary_rows, function(r) r$n)),
                    mean = as.numeric(sapply(dunn_summary_rows, function(r) r$mean)),
                    median = as.numeric(sapply(dunn_summary_rows, function(r) r$median)),
                    q1 = as.numeric(sapply(dunn_summary_rows, function(r) r$q1)),
                    q3 = as.numeric(sapply(dunn_summary_rows, function(r) r$q3)),
                    ci_low = as.numeric(sapply(dunn_summary_rows, function(r) r$ci_low)),
                    ci_up = as.numeric(sapply(dunn_summary_rows, function(r) r$ci_up)),
                    whisker_top = as.numeric(sapply(dunn_summary_rows, function(r) r$whisker_top)),
                    stringsAsFactors = FALSE
                  )
                  dunn_summary_df$letters <- cld_letters[as.character(dunn_summary_df$group)]
                  dunn_summary_df$letters[is.na(dunn_summary_df$letters)] <- ""
                  y_vals_dunn <- dunn_plot_df$value
                  y_range <- range(y_vals_dunn, na.rm = TRUE)
                  y_span <- diff(y_range)
                  if (!is.finite(y_span) || y_span <= 0) y_span <- max(abs(y_range), na.rm = TRUE)
                  if (!is.finite(y_span) || y_span <= 0) y_span <- 1
                  y_offset <- max(y_span * 0.04, 0.04)
                  dunn_summary_df$label_y <- as.numeric(dunn_summary_df$whisker_top) + y_offset

                  dunn_plot_labels_cfg <- to_plain_list(resolve_labels_for_plot("dunn_plot"))
                  dunn_show_box <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_box", TRUE)
                  dunn_show_raw_points <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_raw_points", TRUE)
                  dunn_show_mean_ci <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_mean_ci", TRUE)
                  dunn_show_mean_point <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_mean_point", TRUE)
                  dunn_show_median <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_median", TRUE)
                  dunn_show_violin_right <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_violin_right", FALSE)
                  dunn_show_points_left <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_points_left", FALSE)
                  dunn_show_violin_replace_box <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_violin_replace_box", FALSE)
                  dunn_show_posthoc_letters <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_posthoc_letters", TRUE)
                  dunn_show_caption <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_caption", TRUE)
                  dunn_show_annotation_panel <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_annotation_panel", TRUE)
                  dunn_show_effect_line <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_effect_line", TRUE)
                  dunn_show_stat_guides_mean <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_mean", FALSE)
                  dunn_show_stat_guides_median <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_median", FALSE)
                  dunn_show_stat_guides_q1 <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_q1", FALSE)
                  dunn_show_stat_guides_q3 <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_q3", FALSE)
                  dunn_show_stat_guides_ci_low <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_ci_low", FALSE)
                  dunn_show_stat_guides_ci_high <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_ci_high", FALSE)
                  dunn_show_stat_guides_values <- resolve_plot_element_flag(dunn_plot_labels_cfg, "show_stat_guides_values", FALSE)
                  use_dunn_violin_replace <- isTRUE(dunn_show_violin_replace_box)
                  use_dunn_violin_side <- isTRUE(dunn_show_violin_right) && !isTRUE(use_dunn_violin_replace)

                  group_fill_values <- get_level_color_map(
                    group_var,
                    group_levels_plot,
                    pick_cols(length(group_levels_plot))
                  )
                  group_color_intensity <- get_custom_plot_intensity("three_group_group_color_intensity", 1)
                  group_fill_values <- apply_intensity_to_color_map(group_fill_values, group_color_intensity)
                  three_group_box_border_color <- get_custom_plot_color("three_group_box_border_color", "#1f2937")
                  three_group_outlier_color <- get_custom_plot_color("three_group_outlier_color", "#f59e0b")
                  three_group_mean_overlay_color <- get_custom_plot_color("three_group_mean_overlay_color", "#dc2626")
                  three_group_label_color <- get_custom_plot_color("three_group_label_color", "#0f172a")
                  three_group_jitter_color <- NA_character_
                  three_group_jitter_size <- get_custom_plot_point_size("three_group_jitter_size", 2.4)
                  three_group_jitter_use_box <- get_custom_plot_flag("three_group_jitter_use_box", FALSE)
                  three_group_ci_point_color <- get_custom_plot_color("three_group_ci_point_color", three_group_mean_overlay_color)
                  three_group_ci_errorbar_color <- get_custom_plot_color("three_group_ci_errorbar_color", "#334155")
                  three_group_guide_mean_color <- get_custom_plot_color("three_group_guide_mean_color", "#2563eb")
                  three_group_guide_median_color <- get_custom_plot_color("three_group_guide_median_color", "#0f766e")
                  three_group_guide_q1_color <- get_custom_plot_color("three_group_guide_q1_color", "#7c3aed")
                  three_group_guide_q3_color <- get_custom_plot_color("three_group_guide_q3_color", "#ea580c")
                  three_group_guide_ci_low_color <- get_custom_plot_color("three_group_guide_ci_low_color", "#0284c7")
                  three_group_guide_ci_high_color <- get_custom_plot_color("three_group_guide_ci_high_color", "#0369a1")
                  three_group_guide_line_type <- get_custom_plot_line_type("three_group_guide_line_type", "dashed")
                  three_group_guide_line_width <- get_custom_plot_line_width("three_group_guide_line_width", 0.62)
                  use_dunn_jitter_override <- FALSE
                  if (!isTRUE(three_group_jitter_use_box)) {
                    three_group_jitter_override <- plot_colors_list[["three_group_jitter_color"]]
                    if (!is.null(three_group_jitter_override)) {
                      three_group_jitter_candidate <- trimws(as.character(three_group_jitter_override[1]))
                      if (is_valid_color_value(three_group_jitter_candidate)) {
                        three_group_jitter_color <- three_group_jitter_candidate
                        use_dunn_jitter_override <- TRUE
                      }
                    }
                  }
                  if (!is_valid_color_value(three_group_ci_point_color)) three_group_ci_point_color <- three_group_mean_overlay_color
                  if (!is_valid_color_value(three_group_ci_errorbar_color)) three_group_ci_errorbar_color <- "#334155"

                  output_image_dunn <- gsub("\\.png$", "_dunn.png", output_image)

                  kw_stat_val <- suppressWarnings(as.numeric(kw_res$statistic))
                  kw_p_val <- suppressWarnings(as.numeric(kw_res$p.value))
                  kw_p_fmt <- if (is.finite(kw_p_val) && kw_p_val < 0.0001) {
                    format(kw_p_val, scientific = TRUE, digits = 4)
                  } else if (is.finite(kw_p_val)) {
                    format(round(kw_p_val, 4), nsmall = 4)
                  } else {
                    "NA"
                  }
                  epsilon_val <- suppressWarnings(as.numeric(result_list$kruskal$epsilon_squared))

                  dunn_caption_parts <- c(
                    "Post-hoc grouping is shown with compact letters.",
                    "Groups sharing the same letter are not significantly different."
                  )
                  if (isTRUE(dunn_show_effect_line) && is.finite(epsilon_val)) {
                    dunn_caption_parts <- c(
                      dunn_caption_parts,
                      paste0("Epsilon-squared = ", format(round(epsilon_val, 3), nsmall = 3), ".")
                    )
                  }
                  dunn_caption <- paste(dunn_caption_parts, collapse = "  ")
                  dunn_annotation_lines <- c(
                    paste0("K-W chi-sq = ", if (is.finite(kw_stat_val)) format(round(kw_stat_val, 3), nsmall = 3) else "NA"),
                    paste0("p = ", kw_p_fmt),
                    paste0("groups = ", length(group_levels_plot)),
                    paste0("n = ", nrow(dunn_plot_df))
                  )
                  if (isTRUE(dunn_show_effect_line) && is.finite(epsilon_val)) {
                    dunn_annotation_lines <- c(
                      dunn_annotation_lines,
                      paste0("epsilon-squared = ", format(round(epsilon_val, 3), nsmall = 3))
                    )
                  }
                  box_width_value <- 0.56
                  violin_width_value <- 0.48
                  violin_nudge_value <- 0.22
                  point_left_nudge_value <- -0.22
                  if (isTRUE(use_dunn_violin_replace)) {
                    box_width_value <- if (isTRUE(dunn_show_points_left)) 0.46 else 0.56
                    violin_width_value <- if (isTRUE(dunn_show_points_left)) 0.52 else 0.62
                    violin_nudge_value <- 0
                    if (isTRUE(dunn_show_points_left)) point_left_nudge_value <- -0.24
                  } else if (isTRUE(use_dunn_violin_side) && isTRUE(dunn_show_points_left)) {
                    box_width_value <- 0.38
                    violin_width_value <- 0.40
                    violin_nudge_value <- 0.29
                    point_left_nudge_value <- -0.29
                  } else if (isTRUE(use_dunn_violin_side)) {
                    box_width_value <- 0.46
                    violin_width_value <- 0.44
                    violin_nudge_value <- 0.24
                  } else if (isTRUE(dunn_show_points_left)) {
                    box_width_value <- 0.46
                    point_left_nudge_value <- -0.24
                  }

                  p <- ggplot(dunn_plot_df, aes(x = group, y = value, fill = group))
                  if (isTRUE(use_dunn_violin_replace) || isTRUE(use_dunn_violin_side)) {
                    p <- p + geom_violin(
                      data = dunn_plot_df,
                      aes(x = group, y = value, fill = group),
                      inherit.aes = FALSE,
                      position = position_nudge(x = violin_nudge_value),
                      width = violin_width_value,
                      alpha = 0.24,
                      trim = FALSE,
                      color = three_group_box_border_color,
                      linewidth = 0.34,
                      show.legend = FALSE
                    )
                  }
                  if (isTRUE(dunn_show_box) && !isTRUE(use_dunn_violin_replace)) {
                    p <- p + geom_boxplot(
                      width = box_width_value,
                      alpha = 0.78,
                      outlier.alpha = 0.35,
                      color = three_group_box_border_color,
                      outlier.colour = three_group_outlier_color
                    )
                  }
                  if (isTRUE(dunn_show_raw_points)) {
                    if (isTRUE(dunn_show_points_left)) {
                      if (use_dunn_jitter_override) {
                        p <- p + geom_point(
                          data = dunn_plot_df,
                          aes(x = group, y = value),
                          inherit.aes = FALSE,
                          position = position_nudge(x = point_left_nudge_value),
                          shape = 16,
                          color = three_group_jitter_color,
                          alpha = 1.0,
                          size = three_group_jitter_size,
                          show.legend = FALSE
                        )
                      } else {
                        p <- p + geom_point(
                          data = dunn_plot_df,
                          aes(x = group, y = value, color = group),
                          inherit.aes = FALSE,
                          position = position_nudge(x = point_left_nudge_value),
                          shape = 16,
                          alpha = 1.0,
                          size = three_group_jitter_size,
                          show.legend = FALSE
                        )
                      }
                    } else {
                    if (use_dunn_jitter_override) {
                      p <- p + geom_jitter(
                        color = three_group_jitter_color,
                        shape = 16,
                        position = stable_jitter_position(width = 0.14, height = 0, seed = 202603026L),
                        alpha = 1.0,
                        size = three_group_jitter_size,
                        show.legend = FALSE
                      )
                    } else {
                      p <- p +
                        geom_jitter(
                          aes(color = group),
                          position = stable_jitter_position(width = 0.14, height = 0, seed = 202603026L),
                          shape = 16,
                          alpha = 1.0,
                          size = three_group_jitter_size,
                          show.legend = FALSE
                        )
                      }
                    }
                  }
                  if (isTRUE(dunn_show_mean_ci)) {
                    p <- p + geom_errorbar(
                      data = dunn_summary_df,
                      aes(x = group, ymin = ci_low, ymax = ci_up),
                      inherit.aes = FALSE,
                      width = 0.08,
                      linewidth = 0.9,
                      color = three_group_ci_errorbar_color
                    )
                  }
                  if (isTRUE(dunn_show_mean_point)) {
                    p <- p + geom_point(
                      data = dunn_summary_df,
                      aes(x = group, y = mean),
                      inherit.aes = FALSE,
                      shape = 23,
                      fill = three_group_ci_point_color,
                      color = "white",
                      stroke = 0.28,
                      size = 3.2
                    )
                  }
                  if (isTRUE(dunn_show_median)) {
                    p <- p + geom_point(
                      data = dunn_summary_df,
                      aes(x = group, y = median),
                      inherit.aes = FALSE,
                      shape = 95,
                      size = 9,
                      color = three_group_mean_overlay_color
                    )
                  }
                  p <- add_box_to_axis_guides(
                    p,
                    summary_df = dunn_summary_df,
                    group_levels = group_levels_plot,
                    y_span = y_span,
                    box_width = box_width_value,
                    show_mean = dunn_show_stat_guides_mean,
                    show_median = dunn_show_stat_guides_median,
                    show_q1 = dunn_show_stat_guides_q1,
                    show_q3 = dunn_show_stat_guides_q3,
                    show_ci_low = dunn_show_stat_guides_ci_low,
                    show_ci_high = dunn_show_stat_guides_ci_high,
                    show_values = dunn_show_stat_guides_values,
                    mean_color = three_group_guide_mean_color,
                    median_color = three_group_guide_median_color,
                    q1_color = three_group_guide_q1_color,
                    q3_color = three_group_guide_q3_color,
                    ci_low_color = three_group_guide_ci_low_color,
                    ci_high_color = three_group_guide_ci_high_color,
                    line_type = three_group_guide_line_type,
                    line_width = three_group_guide_line_width,
                    value_digits = 3
                  )
                  if (isTRUE(dunn_show_posthoc_letters)) {
                    p <- p + geom_text(
                      data = dunn_summary_df,
                      aes(x = group, y = label_y, label = letters),
                      size = 4.1,
                      vjust = -0.15,
                      fontface = "bold",
                      color = three_group_label_color
                    )
                  }

                  p <- p +
                    scale_fill_manual(values = group_fill_values, drop = FALSE) +
                    scale_color_manual(values = group_fill_values, drop = FALSE) +
                    labs(
                      title = "Dunn's Publication Plot",
                      subtitle = paste(
                        "K-W chi-sq =",
                        if (is.finite(kw_stat_val)) round(kw_stat_val, 3) else "NA",
                        "| p =",
                        kw_p_fmt
                      ),
                      x = group_var,
                      y = response_var,
                      caption = if (isTRUE(dunn_show_caption)) dunn_caption else NULL
                    ) +
                    theme_minimal(base_size = 13) +
                    theme(
                      panel.grid.minor = element_blank(),
                      legend.position = "none",
                      plot.title = element_text(face = "bold", size = 15),
                      plot.subtitle = element_text(size = 11.5, color = "#334155"),
                      plot.caption = element_text(size = 9.2, hjust = 0, color = "#475569"),
                      axis.title = element_text(face = "bold")
                    )

                  if (isTRUE(dunn_show_annotation_panel)) {
                    p <- p + annotate(
                      "label",
                      x = Inf,
                      y = Inf,
                      label = paste(dunn_annotation_lines, collapse = "\n"),
                      hjust = 1.03,
                      vjust = 1.03,
                      size = 3.2,
                      linewidth = 0.18,
                      label.padding = grid::unit(0.20, "lines"),
                      fill = grDevices::adjustcolor("#ffffff", alpha.f = 0.90),
                      color = three_group_label_color
                    )
                  }

                  custom_ggsave(output_image_dunn, plot = p, plot_key = "dunn_plot", width = 10, height = 8, dpi = 300, device = "png")
                  result_list$plot_generated <- TRUE
                  result_list$plot_path <- output_image_dunn
                  result_list$dunn_plot_generated <- TRUE
                  result_list$dunn_plot_path <- output_image_dunn
                }, error = function(e) {
                  call_text <- tryCatch(paste(deparse(conditionCall(e)), collapse = " "), error = function(err) "")
                  dunn_plot_error <<- paste0(e$message, if (nzchar(call_text)) paste0(" [", call_text, "]") else "")
                })
                if (!is.null(dunn_plot_error)) {
                  result_list$plot_error <- dunn_plot_error
                }
              }
            } else {
              result_list$posthoc_skipped_reason <- "Kruskal-Wallis was not significant; Dunn post-hoc comparisons were skipped."
            }

         }
  }
  }
  }

  final_test_label <- if (!is.null(result_list$test_type) && nzchar(as.character(result_list$test_type))) {
    as.character(result_list$test_type)
  } else if (!is.null(result_list$ttest) && !is.null(result_list$ttest$test_name)) {
    as.character(result_list$ttest$test_name)
  } else if (!is.null(result_list$mann_whitney) && !is.null(result_list$mann_whitney$test_name)) {
    as.character(result_list$mann_whitney$test_name)
  } else if (!is.null(result_list$anova) && !is.null(result_list$anova$test_type)) {
    paste0("anova_", as.character(result_list$anova$test_type))
  } else {
    "inferential_test"
  }
  final_path_label <- if (!is.null(result_list$path_taken) && nzchar(as.character(result_list$path_taken))) {
    as.character(result_list$path_taken)
  } else {
    "pending"
  }
  emit_progress(82, "Pass 4", final_test_label, final_path_label)
  has_posthoc <- !is.null(result_list$tukey) ||
    !is.null(result_list$games_howell) ||
    !is.null(result_list$dunn) ||
    !is.null(result_list$rm_anova_posthoc) ||
    !is.null(result_list$holm_posthoc)
  if (isTRUE(has_posthoc)) {
    emit_progress(94, "Pass 5", "Post-hoc comparisons", final_path_label)
  }
  result_list$alpha <- as.numeric(alpha_val)
  result_list$ci_level <- as.numeric(selected_ci_level)
  result_list$ci_percent <- as.integer(selected_ci_percent)
  emit_progress(100, "Pass Final", "Result finalized", final_path_label)
  cat(toJSON(result_list, auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))

}, error = function(e) {
  cat(toJSON(list(error = e$message), auto_unbox = TRUE))
})
