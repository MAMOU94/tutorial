} else {
  ""
}

# Utility function to apply custom labels before saving
normalize_position <- function(value, allowed = c("center"), fallback = "center") {
  if (is.null(value)) return(fallback)
  candidate <- tolower(trimws(as.character(value[1])))
  if (candidate %in% allowed) return(candidate)
  fallback
}

normalize_steps <- function(value, fallback = 0L, max_val = 40L) {
  if (is.null(value) || length(value) == 0) return(as.integer(fallback))
  numeric_val <- suppressWarnings(as.numeric(value[1]))
  if (length(numeric_val) == 0 || !is.finite(numeric_val[1])) return(as.integer(fallback))
  bounded <- max(0, min(max_val, round(numeric_val[1])))
  as.integer(bounded)
}

resolve_horizontal_justification <- function(position, steps, unit = 0.05) {
  base <- 0.5
  offset <- switch(
    position,
    "left" = -steps * unit,
    "right" = steps * unit,
    0
  )
  max(0, min(1, base + offset))
}

resolve_vertical_justification <- function(position, steps, unit = 0.08) {
  base <- 0.5
  offset <- switch(
    position,
    "up" = -steps * unit,
    "down" = steps * unit,
    0
  )
  base + offset
}

infer_plot_key_from_filename <- function(filename) {
  fn <- tolower(basename(filename))
  if (grepl("shapiro_group_qq", fn, fixed = TRUE)) return("shapiro_group_qq_plot")
  if (grepl("residual_qq", fn, fixed = TRUE)) return("residual_qq_plot")
  if (grepl("anova_residuals", fn, fixed = TRUE)) return("anova_residual_plot")
  if (grepl("ttest_mean_ci", fn, fixed = TRUE)) return("ttest_mean_ci_plot")
  if (grepl("mean_ci", fn, fixed = TRUE)) return("mean_ci_plot")
  if (grepl("rm_spaghetti_ci", fn, fixed = TRUE)) return("rm_spaghetti_ci_plot")
  if (grepl("friedman_spaghetti_iqr", fn, fixed = TRUE)) return("friedman_spaghetti_iqr_plot")
  if (grepl("mann_whitney", fn, fixed = TRUE)) return("mann_whitney_boxplot")
  if (grepl("interaction", fn, fixed = TRUE)) return("interaction_plot")
  if (grepl("games_howell", fn, fixed = TRUE) || grepl("games-howell", fn, fixed = TRUE)) return("games_howell_plot")
  if (grepl("tukey", fn, fixed = TRUE)) return("tukey_plot")
  if (grepl("dunn", fn, fixed = TRUE)) return("dunn_plot")
  if (grepl("one_value", fn, fixed = TRUE)) return("one_value_plot")
  if (grepl("three_group_publication", fn, fixed = TRUE)) return("three_group_publication_plot")
  if (grepl("two_group_publication", fn, fixed = TRUE)) return("two_group_publication_plot")
  if (grepl("regression_scatter", fn, fixed = TRUE)) return("regression_scatter_plot")
  if (grepl("regression_publication", fn, fixed = TRUE)) return("regression_publication_plot")
  if (grepl("spearman_linearity", fn, fixed = TRUE)) return("spearman_linearity_plot")
  if (grepl("linearity", fn, fixed = TRUE)) return("linearity_plot")
  if (grepl("spearman", fn, fixed = TRUE) && grepl("heatmap", fn, fixed = TRUE)) return("spearman_heatmap_plot")
  if (grepl("heatmap", fn, fixed = TRUE)) return("heatmap_plot")
  if (grepl("sphericity", fn, fixed = TRUE)) return("sphericity_plot")
  if (grepl("scree", fn, fixed = TRUE)) return("scree_plot")
  if (grepl("elbow", fn, fixed = TRUE)) return("elbow_plot")
  if (grepl("silhouette_trend", fn, fixed = TRUE)) return("silhouette_trend_plot")
  if (grepl("silhouette", fn, fixed = TRUE)) return("silhouette_plot")
  if (grepl("_anova.png", fn, fixed = TRUE)) return("anova_plot")
  "default"
}

compute_elbow_k <- function(k_values, metric_values) {
  ks <- suppressWarnings(as.numeric(k_values))
  ys <- suppressWarnings(as.numeric(metric_values))
  if (length(ks) == 0 || length(ys) == 0) return(NA_integer_)
  n <- min(length(ks), length(ys))
  if (n < 3) return(NA_integer_)

  ks <- ks[seq_len(n)]
  ys <- ys[seq_len(n)]
  valid_idx <- which(is.finite(ks) & is.finite(ys))
  if (length(valid_idx) < 3) return(NA_integer_)
  ks <- ks[valid_idx]
  ys <- ys[valid_idx]

  x1 <- ks[1]
  y1 <- ys[1]
  x2 <- ks[length(ks)]
  y2 <- ys[length(ys)]
  denom <- sqrt((y2 - y1)^2 + (x2 - x1)^2)
  if (!is.finite(denom) || denom <= 0) return(NA_integer_)

  distances <- abs((y2 - y1) * ks - (x2 - x1) * ys + x2 * y1 - y2 * x1) / denom
  if (length(distances) == 0 || !any(is.finite(distances))) return(NA_integer_)
  as.integer(ks[which.max(distances)])
}

normalize_cluster_optimization_method <- function(method_value, default = "both") {
  fallback <- if (is.null(default) || !nzchar(trimws(as.character(default[1])))) "both" else tolower(trimws(as.character(default[1])))
  if (!(fallback %in% c("both", "elbow", "silhouette"))) fallback <- "both"
  if (is.null(method_value) || length(method_value) == 0) return(fallback)
  raw <- tolower(trimws(as.character(method_value[1])))
  if (!nzchar(raw)) return(fallback)
  if (raw %in% c("both", "combined", "auto", "elbow_silhouette", "elbow+silhouette", "elbow_and_silhouette")) return("both")
  if (raw %in% c("elbow", "knee", "elbow_only")) return("elbow")
  if (raw %in% c("silhouette", "sil", "silhouette_only")) return("silhouette")
  fallback
}

normalize_mca_auto_cluster_method <- function(method_value, default = "kmeans") {
  fallback <- if (is.null(default) || !nzchar(trimws(as.character(default[1])))) "kmeans" else tolower(trimws(as.character(default[1])))
  if (!(fallback %in% c("kmeans", "hierarchical"))) fallback <- "kmeans"
  if (is.null(method_value) || length(method_value) == 0) return(fallback)
  raw <- tolower(trimws(as.character(method_value[1])))
  if (!nzchar(raw)) return(fallback)
  if (raw %in% c("kmeans", "k-mean", "kmean", "km", "lloyd")) return("kmeans")
  if (raw %in% c("hierarchical", "hclust", "ward", "ward.d2", "agnes")) return("hierarchical")
  fallback
}

normalize_pca_auto_cluster_method <- function(method_value, default = "kmeans") {
  normalize_mca_auto_cluster_method(method_value, default = default)
}

normalize_cluster_stage <- function(stage_value, default = "before") {
  fallback <- if (is.null(default) || !nzchar(trimws(as.character(default[1])))) "before" else tolower(trimws(as.character(default[1])))
  if (!(fallback %in% c("before", "after"))) fallback <- "before"
  if (is.null(stage_value) || length(stage_value) == 0) return(fallback)
  raw <- tolower(trimws(as.character(stage_value[1])))
  if (!nzchar(raw)) return(fallback)
  if (raw %in% c("before", "pre", "pre_pca", "pre_mca")) return("before")
  if (raw %in% c("after", "post", "post_pca", "post_mca")) return("after")
  fallback
}

normalize_hclust_linkage_method <- function(method_value, default = "ward.d2") {
  fallback_raw <- if (is.null(default) || !nzchar(trimws(as.character(default[1])))) "ward.d2" else tolower(trimws(as.character(default[1])))
  fallback <- switch(
    fallback_raw,
    "ward" = "ward.D2",
    "ward.d2" = "ward.D2",
    "single" = "single",
    "complete" = "complete",
    "average" = "average",
    "upgma" = "average",
    "centroid" = "centroid",
    "upgmc" = "centroid",
    "median" = "median",
    "wpgmc" = "median",
    "mcquitty" = "mcquitty",
    "wpgma" = "mcquitty",
    "ward.D2"
  )
  if (!(fallback %in% c("ward.D2", "single", "complete", "average", "centroid", "median", "mcquitty"))) {
    fallback <- "ward.D2"
  }
  if (is.null(method_value) || length(method_value) == 0) return(fallback)
  raw <- tolower(trimws(as.character(method_value[1])))
  if (!nzchar(raw)) return(fallback)
  if (raw %in% c("ward", "wards", "ward.d", "ward.d2", "wards method", "ward's method")) return("ward.D2")
  if (raw %in% c("single", "single linkage", "nearest", "nearest neighbor", "nearest-neighbor")) return("single")
  if (raw %in% c("complete", "complete linkage", "farthest", "farthest neighbor", "farthest-neighbor")) return("complete")
  if (raw %in% c("average", "average linkage", "upgma")) return("average")
  if (raw %in% c("centroid", "centroid linkage", "upgmc")) return("centroid")
  if (raw %in% c("median", "median linkage", "wpgmc")) return("median")
  if (raw %in% c("mcquitty", "mcquitty's method", "mcquittys method", "wpgma")) return("mcquitty")
  fallback
}

hclust_linkage_method_label <- function(method_value) {
  method_norm <- normalize_hclust_linkage_method(method_value, default = "ward.d2")
  switch(
    method_norm,
    "ward.D2" = "Ward.D2",
    "single" = "Single",
    "complete" = "Complete",
    "average" = "Average (UPGMA)",
    "centroid" = "Centroid (UPGMC)",
    "median" = "Median (WPGMC)",
    "mcquitty" = "McQuitty (WPGMA)",
    method_norm
  )
}

choose_k_from_elbow_silhouette <- function(elbow_k, silhouette_values, k_values = NULL, method = "both") {
  method_norm <- normalize_cluster_optimization_method(method, default = "both")
  sil <- suppressWarnings(as.numeric(silhouette_values))
  if (length(sil) == 0) sil <- numeric(0)

  if (is.null(k_values) || length(k_values) != length(sil)) {
    k_values <- seq_along(sil)
  }
  ks <- suppressWarnings(as.integer(k_values))

  valid_idx <- which(is.finite(sil) & is.finite(ks) & ks >= 2)
  elbow_int <- if (is.finite(suppressWarnings(as.numeric(elbow_k)))) as.integer(elbow_k) else NA_integer_
  elbow_valid <- !is.na(elbow_int) && elbow_int >= 2 && (length(ks) == 0 || elbow_int %in% ks)

  has_silhouette <- length(valid_idx) > 0
  if (has_silhouette) {
    valid_k <- as.integer(ks[valid_idx])
    valid_s <- as.numeric(sil[valid_idx])
    sil_best_idx <- which.max(valid_s)
    sil_k <- as.integer(valid_k[sil_best_idx])
    sil_best <- as.numeric(valid_s[sil_best_idx])
  } else {
    valid_k <- integer(0)
    valid_s <- numeric(0)
    sil_k <- NA_integer_
    sil_best <- NA_real_
  }

  if (identical(method_norm, "elbow")) {
    if (isTRUE(elbow_valid)) {
      return(list(
        k = as.integer(elbow_int),
        rule = "elbow_selected",
        elbow_k = elbow_int,
        silhouette_k = if (is.finite(sil_k)) sil_k else NA_integer_,
        silhouette_best = if (is.finite(sil_best)) sil_best else NA_real_,
        decision_score = 1
      ))
    }
    if (has_silhouette) {
      return(list(
        k = sil_k,
        rule = "elbow_selected_fallback_silhouette",
        elbow_k = elbow_int,
        silhouette_k = sil_k,
        silhouette_best = sil_best,
        decision_score = 1
      ))
    }
    return(list(
      k = 2L,
      rule = "elbow_selected_fallback_min_k",
      elbow_k = elbow_int,
      silhouette_k = NA_integer_,
      silhouette_best = NA_real_,
      decision_score = NA_real_
    ))
  }

  if (identical(method_norm, "silhouette")) {
    if (has_silhouette) {
      return(list(
        k = sil_k,
        rule = "silhouette_selected",
        elbow_k = elbow_int,
        silhouette_k = sil_k,
        silhouette_best = sil_best,
        decision_score = 1
      ))
    }
    if (isTRUE(elbow_valid)) {
      return(list(
        k = as.integer(elbow_int),
        rule = "silhouette_selected_fallback_elbow",
        elbow_k = elbow_int,
        silhouette_k = NA_integer_,
        silhouette_best = NA_real_,
        decision_score = 1
      ))
    }
    return(list(
      k = 2L,
      rule = "silhouette_selected_fallback_min_k",
      elbow_k = elbow_int,
      silhouette_k = NA_integer_,
      silhouette_best = NA_real_,
      decision_score = NA_real_
    ))
  }

  if (!has_silhouette) {
    fallback_k <- if (isTRUE(elbow_valid)) as.integer(elbow_int) else 2L
    return(list(
      k = fallback_k,
      rule = if (isTRUE(elbow_valid)) "elbow_only" else "fallback_min_k",
      elbow_k = elbow_int,
      silhouette_k = NA_integer_,
      silhouette_best = NA_real_,
      decision_score = NA_real_
    ))
  }

  if (!isTRUE(elbow_valid)) {
    return(list(
      k = sil_k,
      rule = "silhouette_only",
      elbow_k = elbow_int,
      silhouette_k = sil_k,
      silhouette_best = sil_best,
      decision_score = 1
    ))
  }

  if (elbow_int == sil_k) {
    return(list(
      k = sil_k,
      rule = "elbow_silhouette_agree",
      elbow_k = elbow_int,
      silhouette_k = sil_k,
      silhouette_best = sil_best,
      decision_score = 1
    ))
  }

  s_min <- suppressWarnings(min(valid_s, na.rm = TRUE))
  s_max <- suppressWarnings(max(valid_s, na.rm = TRUE))
  sil_norm <- if (is.finite(s_max - s_min) && (s_max - s_min) > 1e-9) {
    (valid_s - s_min) / (s_max - s_min)
  } else {
    rep(1, length(valid_s))
  }

  k_span <- suppressWarnings(max(valid_k, na.rm = TRUE) - min(valid_k, na.rm = TRUE))
  if (!is.finite(k_span) || k_span <= 0) k_span <- 1
  elbow_closeness <- 1 - pmin(1, abs(valid_k - elbow_int) / k_span)

  combined_score <- 0.65 * sil_norm + 0.35 * elbow_closeness
  best_combined <- suppressWarnings(max(combined_score, na.rm = TRUE))
  top_idx <- which(combined_score == best_combined)
  chosen_idx <- if (length(top_idx) > 1) top_idx[which.min(valid_k[top_idx])] else top_idx[1]
  chosen_k <- as.integer(valid_k[chosen_idx])

  list(
    k = chosen_k,
    rule = "weighted_elbow_silhouette",
    elbow_k = elbow_int,
    silhouette_k = sil_k,
    silhouette_best = sil_best,
    decision_score = as.numeric(combined_score[chosen_idx])
  )
}

build_silhouette_table_payload <- function(sil_obj, observation_ids = NULL, cluster_label_map = NULL, max_rows = 1000L, scope = "full_rows") {
  if (is.null(sil_obj)) return(NULL)

  sil_df <- tryCatch(as.data.frame(unclass(sil_obj), stringsAsFactors = FALSE), error = function(e) NULL)
  if (is.null(sil_df) || nrow(sil_df) == 0) return(NULL)

  expected_names <- c("cluster", "neighbor", "sil_width")
  if (!all(expected_names %in% colnames(sil_df)) && ncol(sil_df) >= 3) {
    colnames(sil_df)[seq_len(3)] <- expected_names
  }
  if (!all(expected_names %in% colnames(sil_df))) return(NULL)

  obs_values <- observation_ids
  if (is.null(obs_values) || length(obs_values) != nrow(sil_df)) {
    obs_values <- rownames(sil_df)
  }
  obs_values <- as.character(obs_values)
  if (length(obs_values) != nrow(sil_df) || any(!nzchar(obs_values))) {
    obs_values <- as.character(seq_len(nrow(sil_df)))
  }

  format_cluster_labels <- function(raw_values) {
    raw_chr <- trimws(as.character(raw_values))
    raw_chr[is.na(raw_chr) | raw_chr == ""] <- NA_character_
    raw_int <- suppressWarnings(as.integer(raw_values))
    mapped_chr <- rep(NA_character_, length(raw_chr))
    if (!is.null(cluster_label_map) && length(cluster_label_map) > 0) {
      mapped_chr <- unname(cluster_label_map[as.character(raw_int)])
    }
    fallback_chr <- ifelse(is.finite(raw_int), paste0("Cluster ", raw_int), raw_chr)
    fallback_chr[is.na(fallback_chr) | fallback_chr == ""] <- "N/A"
    out <- ifelse(!is.na(mapped_chr) & mapped_chr != "", mapped_chr, fallback_chr)
    as.character(out)
  }

  sil_width_values <- suppressWarnings(as.numeric(sil_df$sil_width))
  out_df <- data.frame(
    Observation = obs_values,
    Cluster = format_cluster_labels(sil_df$cluster),
    Neighbor_Cluster = format_cluster_labels(sil_df$neighbor),
    Silhouette_Width = sil_width_values,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )

  max_rows_int <- suppressWarnings(as.integer(max_rows[1]))
  if (!is.finite(max_rows_int) || max_rows_int < 1) max_rows_int <- 1000L
  preview_n <- min(nrow(out_df), max_rows_int)

  list(
    rows = out_df[seq_len(preview_n), , drop = FALSE],
    truncated = nrow(out_df) > max_rows_int,
    total_rows = as.numeric(nrow(out_df)),
    scope = as.character(scope[1])
  )
}

run_manual_kmeans_verification <- function(
  cluster_input,
  requested_k,
  output_image,
  plot_suffix = "_manual_kmeans_verification_silhouette.png",
  plot_title_prefix = "Manual K-Means Verification",
  observation_ids = NULL,
  palette_main = "#2563eb",
  max_eval_rows = 3000L
) {
  verification <- list(
    requested_k = suppressWarnings(as.integer(requested_k[1])),
    total_rows = if (!is.null(cluster_input)) as.numeric(NROW(cluster_input)) else 0
  )

  mat <- tryCatch(as.matrix(cluster_input), error = function(e) NULL)
  if (is.null(mat) || !is.matrix(mat) || nrow(mat) < 3 || ncol(mat) < 1) {
    verification$error <- "Manual k-means verification needs at least 3 complete rows and 1 numeric dimension."
    return(verification)
  }
  storage.mode(mat) <- "double"

  k_requested <- suppressWarnings(as.integer(requested_k[1]))
  max_allowed_k <- as.integer(nrow(mat) - 1L)
  if (!is.finite(k_requested) || k_requested < 2L) {
    verification$error <- "Manual k-means verification needs an integer k of at least 2."
    return(verification)
  }
  if (!is.finite(max_allowed_k) || max_allowed_k < 2L) {
    verification$error <- "Manual k-means verification needs at least 3 complete rows."
    return(verification)
  }

  used_k <- as.integer(max(2L, min(k_requested, max_allowed_k)))
  verification$used_k <- used_k
  if (!identical(used_k, k_requested)) {
    verification$warning <- paste0(
      "Requested k = ", k_requested,
      " was adjusted to ", used_k,
      " to match the available rows."
    )
  }

  set.seed(123)
  km_res <- tryCatch(stats::kmeans(mat, centers = used_k, nstart = 25), error = function(e) NULL)
  if (is.null(km_res) || length(km_res$cluster) != nrow(mat)) {
    verification$error <- "Manual k-means verification failed while fitting the requested partition."
    return(verification)
  }

  cluster_levels <- seq_len(used_k)
  cluster_label_map <- setNames(
    paste0("Cluster ", cluster_levels),
    as.character(cluster_levels)
  )
  cluster_sizes <- table(factor(as.integer(km_res$cluster), levels = cluster_levels))
  verification$cluster_sizes <- as.list(as.numeric(cluster_sizes))
  names(verification$cluster_sizes) <- unname(cluster_label_map[as.character(cluster_levels)])
  verification$tot_withinss <- if (is.finite(km_res$tot.withinss)) as.numeric(km_res$tot.withinss) else NA_real_

  max_eval_rows_int <- suppressWarnings(as.integer(max_eval_rows[1]))
  if (!is.finite(max_eval_rows_int) || max_eval_rows_int < 10L) {
    max_eval_rows_int <- 3000L
  }
  eval_idx <- if (nrow(mat) > max_eval_rows_int) {
    sort(sample(seq_len(nrow(mat)), max_eval_rows_int))
  } else {
    seq_len(nrow(mat))
  }
  eval_input <- mat[eval_idx, , drop = FALSE]
  eval_assign <- as.integer(km_res$cluster[eval_idx])
  eval_obs_ids <- if (!is.null(observation_ids) && length(observation_ids) == nrow(mat)) {
    observation_ids[eval_idx]
  } else {
    NULL
  }
  verification$evaluation_rows <- as.numeric(length(eval_idx))
  verification$evaluation_scope <- if (length(eval_idx) < nrow(mat)) "sampled_rows" else "full_rows"
  if (length(unique(eval_assign)) < 2L) {
    verification$error <- "Manual k-means verification sample does not contain at least 2 clusters for silhouette validation."
    return(verification)
  }

  dist_eval <- tryCatch(stats::dist(eval_input, method = "euclidean"), error = function(e) NULL)
  if (is.null(dist_eval)) {
    verification$error <- "Manual k-means verification failed while computing distances for silhouette validation."
    return(verification)
  }

  sil_obj <- tryCatch(cluster::silhouette(eval_assign, dist_eval), error = function(e) NULL)
  if (is.null(sil_obj)) {
    verification$error <- "Manual k-means verification failed while computing silhouette validation."
    return(verification)
  }

  verification$avg_silhouette <- as.numeric(mean(sil_obj[, 3], na.rm = TRUE))
  verification$silhouette_table <- build_silhouette_table_payload(
    sil_obj,
    observation_ids = eval_obs_ids,
    cluster_label_map = cluster_label_map,
    scope = verification$evaluation_scope
  )

  sil_path <- gsub("\\.png$", plot_suffix, output_image)
  tryCatch({
    label_cfg <- resolve_base_label_config(
      "silhouette_plot",
      default_title = paste0(plot_title_prefix, " Silhouette Plot (k = ", used_k, ")"),
      default_x = "",
      default_y = ""
    )
    png(sil_path, width = 650, height = 430)
    plot(sil_obj, main = "", col = palette_main, border = NA)
    render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
    dev.off()
    verification$silhouette_plot_path <- sil_path
  }, error = function(e) {
    verification$silhouette_error <- e$message
  })

  verification
}

run_manual_cluster_validation <- function(
  cluster_input,
  selected_k,
  output_image,
  plot_suffix = "_manual_validation_silhouette_trend.png",
  plot_title_prefix = "Manual K Validation",
  palette_main = "#2563eb",
  palette_accent = "#0f766e",
  selected_color = "#dc2626",
  max_eval_rows = 3000L
) {
  validation <- list(
    selected_k = suppressWarnings(as.integer(selected_k[1])),
    total_rows = if (!is.null(cluster_input)) as.numeric(NROW(cluster_input)) else 0
  )

  mat <- tryCatch(as.matrix(cluster_input), error = function(e) NULL)
  if (is.null(mat) || !is.matrix(mat) || nrow(mat) < 3 || ncol(mat) < 1) {
    validation$error <- "Manual k validation needs at least 3 complete rows and 1 numeric dimension."
    return(validation)
  }
  storage.mode(mat) <- "double"

  selected_k_int <- suppressWarnings(as.integer(selected_k[1]))
  if (!is.finite(selected_k_int) || selected_k_int < 2L) {
    validation$error <- "Manual k validation needs an integer k of at least 2."
    return(validation)
  }

  max_eval_rows_int <- suppressWarnings(as.integer(max_eval_rows[1]))
  if (!is.finite(max_eval_rows_int) || max_eval_rows_int < 10L) {
    max_eval_rows_int <- 3000L
  }

  set.seed(123)
  eval_idx <- if (nrow(mat) > max_eval_rows_int) {
    sort(sample(seq_len(nrow(mat)), max_eval_rows_int))
  } else {
    seq_len(nrow(mat))
  }
  eval_input <- mat[eval_idx, , drop = FALSE]
  validation$evaluation_rows <- as.numeric(nrow(eval_input))
  validation$evaluation_scope <- if (length(eval_idx) < nrow(mat)) "sampled_rows" else "full_rows"

  max_k_eval <- as.integer(min(10L, nrow(eval_input) - 1L))
  if (!is.finite(max_k_eval) || max_k_eval < 2L) {
    validation$error <- "Manual k validation needs at least 3 rows after evaluation sampling."
    return(validation)
  }

  selected_k_used <- as.integer(max(2L, min(selected_k_int, max_k_eval)))
  validation$selected_k_used <- selected_k_used
  if (!identical(selected_k_used, selected_k_int)) {
    validation$warning <- paste0(
      "Manual k = ", selected_k_int,
      " was adjusted to ", selected_k_used,
      " for validation because the evaluation subset allows at most ", max_k_eval, " clusters."
    )
  }

  wss_eval <- rep(NA_real_, max_k_eval)
  sil_eval <- rep(NA_real_, max_k_eval)

  eval_center <- suppressWarnings(colMeans(eval_input, na.rm = TRUE))
  centered_eval <- sweep(eval_input, 2, eval_center, "-")
  wss_eval[1] <- sum(rowSums(centered_eval^2), na.rm = TRUE)
  dist_eval <- tryCatch(stats::dist(eval_input, method = "euclidean"), error = function(e) NULL)

  for (k_try in 2:max_k_eval) {
    km_try <- tryCatch(stats::kmeans(eval_input, centers = k_try, nstart = 10), error = function(e) NULL)
    if (is.null(km_try) || length(km_try$cluster) != nrow(eval_input)) next
    wss_eval[k_try] <- sum(km_try$withinss, na.rm = TRUE)
    if (!is.null(dist_eval) && length(unique(km_try$cluster)) >= 2L) {
      sil_val <- tryCatch({
        sil_obj <- cluster::silhouette(as.integer(km_try$cluster), dist_eval)
        mean(sil_obj[, 3], na.rm = TRUE)
      }, error = function(e) NA_real_)
      if (is.finite(sil_val)) sil_eval[k_try] <- sil_val
    }
  }

  if (!is.finite(wss_eval[1])) {
    wss_eval[1] <- sum(rowSums(centered_eval^2), na.rm = TRUE)
  }
  if (max_k_eval >= 2L) {
    for (k_fill in 2:max_k_eval) {
      if (!is.finite(wss_eval[k_fill])) {
        wss_eval[k_fill] <- wss_eval[k_fill - 1L]
      }
    }
  }

  valid_sil_idx <- which(is.finite(sil_eval) & seq_along(sil_eval) >= 2L)
  silhouette_k <- if (length(valid_sil_idx) > 0L) {
    as.integer(valid_sil_idx[which.max(sil_eval[valid_sil_idx])])
  } else {
    NA_integer_
  }
  validation$silhouette_k <- silhouette_k
  validation$avg_silhouette_selected <- if (selected_k_used <= length(sil_eval) && is.finite(sil_eval[selected_k_used])) {
    as.numeric(sil_eval[selected_k_used])
  } else {
    NA_real_
  }
  validation$avg_silhouette_best <- if (is.finite(silhouette_k) && silhouette_k <= length(sil_eval) && is.finite(sil_eval[silhouette_k])) {
    as.numeric(sil_eval[silhouette_k])
  } else {
    NA_real_
  }
  validation$optimization_data <- list(
    k_values = as.numeric(seq_len(max_k_eval)),
    wss = as.numeric(wss_eval),
    silhouette = as.numeric(sil_eval)
  )

  sil_trend_path <- gsub("\\.png$", plot_suffix, output_image)
  tryCatch({
    label_cfg <- resolve_base_label_config(
      "silhouette_trend_plot",
      default_title = paste0(plot_title_prefix, " Silhouette Method"),
      default_x = "Number of Clusters K",
      default_y = "Avg Silhouette Width"
    )
    png(sil_trend_path, width = 700, height = 450)
    if (max_k_eval >= 2L) {
      plot(
        2:max_k_eval,
        sil_eval[2:max_k_eval],
        type = "b",
        pch = 19,
        frame = FALSE,
        xlab = "",
        ylab = "",
        main = "",
        col = palette_accent
      )
      if (is.finite(silhouette_k) && is.finite(validation$avg_silhouette_best)) {
        points(silhouette_k, validation$avg_silhouette_best, col = palette_main, pch = 19, cex = 1.5)
      }
      if (is.finite(selected_k_used) && is.finite(validation$avg_silhouette_selected)) {
        points(selected_k_used, validation$avg_silhouette_selected, col = selected_color, pch = 17, cex = 1.5)
      }
      legend_items <- c()
      legend_cols <- c()
      legend_pch <- c()
      if (is.finite(selected_k_used) && is.finite(validation$avg_silhouette_selected)) {
        legend_items <- c(legend_items, paste0("Manual k = ", selected_k_used))
        legend_cols <- c(legend_cols, selected_color)
        legend_pch <- c(legend_pch, 17)
      }
      if (is.finite(silhouette_k) && is.finite(validation$avg_silhouette_best)) {
        legend_items <- c(legend_items, paste0("Silhouette best k = ", silhouette_k))
        legend_cols <- c(legend_cols, palette_main)
        legend_pch <- c(legend_pch, 19)
      }
      if (length(legend_items) > 0L) {
        legend("bottomright", legend = legend_items, col = legend_cols, pch = legend_pch, bty = "n", cex = 0.82)
      }
    } else {
      plot.new()
      text(0.5, 0.5, "Silhouette trend unavailable (need at least k=2).")
    }
    render_base_label_config(label_cfg, title_line = 1.1, x_line = 2.6, y_line = 2.8, caption_line = 4.1)
    dev.off()
    validation$silhouette_trend_plot_path <- sil_trend_path
  }, error = function(e) {
    validation$silhouette_trend_plot_error <- e$message
  })

  validation
}

select_pca_clustering_scores <- function(pca_res, max_dims = 2L) {
  scores_mat <- tryCatch(as.matrix(pca_res$x), error = function(e) NULL)
  if (is.null(scores_mat) || !is.matrix(scores_mat) || nrow(scores_mat) < 1L || ncol(scores_mat) < 1L) {
    return(list(
      scores = NULL,
      dims_used = 0L,
      total_dims = 0L,
      retained_variance_percent = NA_real_,
      variance_threshold_percent = NA_real_,
      rule = "pca_scores_unavailable"
    ))
  }

  total_dims <- as.integer(ncol(scores_mat))
  max_dims_int <- suppressWarnings(as.integer(max_dims[1]))
  if (!is.finite(max_dims_int) || max_dims_int < 1L) max_dims_int <- 2L
  max_dims_int <- as.integer(max(1L, min(max_dims_int, total_dims)))

  eig_vals <- suppressWarnings(as.numeric(pca_res$sdev)^2)
  valid_eigs <- length(eig_vals) >= total_dims && sum(eig_vals[seq_len(total_dims)], na.rm = TRUE) > 0

  dims_used <- as.integer(max_dims_int)
  rule <- if (dims_used >= 2L) "first_two_pcs" else "single_pc_only"

  retained_variance_percent <- if (isTRUE(valid_eigs) && dims_used >= 1L) {
    as.numeric(sum(eig_vals[seq_len(dims_used)]) / sum(eig_vals[seq_len(total_dims)]) * 100)
  } else {
    NA_real_
  }

  list(
    scores = scores_mat[, seq_len(dims_used), drop = FALSE],
    dims_used = as.integer(dims_used),
    total_dims = total_dims,
    retained_variance_percent = retained_variance_percent,
    variance_threshold_percent = NA_real_,
    rule = rule
  )
}

resolve_manual_k_override <- function(enabled, requested_k, max_allowed_k) {
  enabled_flag <- isTRUE(enabled)
  requested_int <- suppressWarnings(as.integer(requested_k[1]))
  max_allowed_int <- suppressWarnings(as.integer(max_allowed_k[1]))

  if (!enabled_flag || !is.finite(requested_int) || requested_int < 2L || !is.finite(max_allowed_int) || max_allowed_int < 2L) {
    return(list(
      enabled = FALSE,
      requested_k = if (is.finite(requested_int)) requested_int else NA_integer_,
      used_k = NA_integer_,
      warning = NULL
    ))
  }

  used_k <- as.integer(max(2L, min(requested_int, max_allowed_int)))
  warning_text <- NULL
  if (!identical(used_k, requested_int)) {
    warning_text <- paste0(
      "Manual k = ", requested_int,
      " was adjusted to ", used_k,
      " to match the available rows."
    )
  }

  list(
    enabled = TRUE,
    requested_k = requested_int,
    used_k = used_k,
    warning = warning_text
  )
}

