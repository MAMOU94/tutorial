resolve_conf_level_from_alpha <- function(alpha, fallback = 0.95) {
  a <- suppressWarnings(as.numeric(alpha))
  if (!is.finite(a) || a <= 0 || a >= 1) return(fallback)
  max(0.5, min(0.9999, 1 - a))
}
selected_ci_level <- resolve_conf_level_from_alpha(alpha_val)
selected_ci_prob <- (1 + selected_ci_level) / 2
selected_ci_percent <- as.integer(round(selected_ci_level * 100))

