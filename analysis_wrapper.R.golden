wf_group_cmp_pkgs   <- c("stats", "ggplot2")
wf_anova_pkgs       <- c("stats", "ggplot2")
wf_one_value_pkgs   <- c("stats", "ggplot2")                                # simple parametric/binomial
wf_corr_pkgs        <- c("stats", "ggplot2", "reshape2")                    # inferential correlation matrices
wf_predict_log_pkgs <- c("stats", "ggplot2")                                # logistic prediction

# Kept for backward-compat references elsewhere
inferential_pkgs    <- wf_group_cmp_pkgs

load_pkgs <- function(pkgs) {
  failed <- c()
  for (pkg in pkgs) {
    if (pkg == "stats") {
      library(stats)
    } else {
      res <- load_or_install(pkg)
      if (!res) failed <- c(failed, pkg)
    }
  }
  return(failed)
}

ensure_optional_pkg <- function(pkg_name, context = "analysis branch") {
  if (pkg_name == "stats") return(TRUE)
  if (requireNamespace(pkg_name, quietly = TRUE, lib.loc = local_lib)) return(TRUE)
  if (isTRUE(load_or_install(pkg_name))) return(TRUE)
  if (requireNamespace(pkg_name, quietly = TRUE, lib.loc = local_lib)) return(TRUE)
  stop(sprintf("Missing required package '%s' for %s.", pkg_name, context))
}

has_significant_factorial_effect <- function(main_A, main_B, interaction_effect) {
  isTRUE(main_A$is_significant) || isTRUE(main_B$is_significant) || isTRUE(interaction_effect$is_significant)
}

