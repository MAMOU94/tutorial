to_plain_list <- function(x) {
  if (is.null(x)) return(list())
  if (is.atomic(x) && !is.null(names(x))) return(as.list(x))
  if (is.data.frame(x)) {
    if (nrow(x) == 1) {
      one_row <- as.list(x[1, , drop = FALSE])
      return(lapply(one_row, function(v) if (length(v) > 0) v[[1]] else NULL))
    }
    return(as.list(x))
  }
  if (is.list(x)) return(x)
  list()
}

extract_labels_by_plot <- function(x) {
  out <- list()
  if (is.null(x)) return(out)
  if (!(is.list(x) && !is.data.frame(x))) return(out)
  key_names <- names(x)
  if (is.null(key_names) || length(key_names) == 0) return(out)
  for (k in key_names) {
    normalized_key <- tolower(trimws(as.character(k)))
    if (normalized_key == "") next
    out[[normalized_key]] <- to_plain_list(x[[k]])
  }
  out
}

custom_plot_labels <- to_plain_list(custom_plot_labels)
custom_plot_labels_by_plot <- extract_labels_by_plot(custom_plot_labels$labels_by_plot)
