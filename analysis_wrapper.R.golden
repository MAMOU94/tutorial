# ── Reaction-time instrumentation ────────────────────────────────────────────
t_start      <- proc.time()   # wall-clock start (after base packages loaded)
t_mode_label <- "unknown"     # updated when mode is resolved below
embedded_mode <- identical(Sys.getenv("ANALYSIS_WRAPPER_EMBEDDED", "0"), "1")

profile_msg <- function(step_name) {
  elapsed <- round((proc.time() - t_start)[["elapsed"]], 3)
  message(sprintf("PROFILE | %-30s | %.3f s", step_name, elapsed))
}

# Override quit() so every exit path auto-emits a TIMING line first.
quit <- function(save = "default", status = 0L, runLast = TRUE) {
  elapsed <- round((proc.time() - t_start)[["elapsed"]], 3)
  message(sprintf("TIMING | mode: %-40s | %.3f s", t_mode_label, elapsed))
  if (isTRUE(embedded_mode)) {
    safe_status <- suppressWarnings(as.integer(status[1]))
    if (!is.finite(safe_status)) safe_status <- 0L
    stop(structure(
      list(message = "analysis_wrapper requested quit", status = safe_status, call = NULL),
      class = c("analysis_wrapper_quit", "condition")
    ))
  }
  base::quit(save = save, status = status, runLast = runLast)
}
