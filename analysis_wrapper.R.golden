# Mode 0: Data Preview & Metadata
if (args[1] == "--get-metadata") {
  invisible(load_pkgs(base_deps))
  input_file <- args[2]
  requested_sheet <- if (length(args) >= 3 && args[3] != "") args[3] else NULL
  tryCatch({
    if (!file.exists(input_file)) stop("File not found.")
    ext <- tolower(tools::file_ext(input_file))
    sheets <- if (ext %in% c("xlsx")) {
      tryCatch(getSheetNames(input_file), error = function(e) character(0))
    } else {
      character(0)
    }
    data <- read_any_file(input_file, requested_sheet)
    if (nrow(data) == 0 || ncol(data) == 0) stop("File is empty.")
    active_sheet <- if (ext %in% c("xlsx")) {
      if (!is.null(requested_sheet) && requested_sheet %in% sheets) requested_sheet else if (length(sheets) > 0) sheets[[1]] else ""
    } else {
      ""
    }
    cat(toJSON(list(columns = colnames(data), fullData = data, sheets = sheets, active_sheet = active_sheet), auto_unbox = TRUE, na = "null", nan = "null", inf = "null"))
  }, error = function(e) {
    cat(toJSON(list(error = e$message), auto_unbox = TRUE))
  })
  quit(save = "no")
}

